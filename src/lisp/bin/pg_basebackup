#!/bin/sh
set -eu
UTILITY_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
case "${1:-}" in
    --version|-V) echo 'pg_basebackup (PostgreSQL) 20devel'; exit 0 ;;
    --help|'-?') echo 'usage: pg_basebackup --pgdata=DIR -X stream --dbname=CONNINFO'; exit 0 ;;
esac
HELPER_RESULT=
CHILD_PID=
cleanup() {
    if [ -n "$HELPER_RESULT" ]; then
        rm -f -- "$HELPER_RESULT"
    fi
}
trap cleanup EXIT
cancel() {
    trap '' HUP INT TERM
    CHILD_PID=${CHILD_PID:-${!:-}}
    if [ -n "$CHILD_PID" ]; then
        kill -TERM "$CHILD_PID" 2>/dev/null || true
        wait "$CHILD_PID" 2>/dev/null || true
    fi
    exit 130
}
trap cancel HUP INT TERM
if [ -z "${PG_LIBPQ_HELPER:-}" ]; then
    HELPER_RESULT=$(mktemp "${TMPDIR:-/tmp}/pg-basebackup-path.XXXXXX")
    "$UTILITY_DIR/pg-libpq-helper-path" > "$HELPER_RESULT" &
    CHILD_PID=$!
    wait "$CHILD_PID"
    CHILD_PID=
    IFS= read -r PG_LIBPQ_HELPER < "$HELPER_RESULT"
    rm -f -- "$HELPER_RESULT"
    HELPER_RESULT=
    export PG_LIBPQ_HELPER
fi
"${SBCL:-sbcl}" --script "$UTILITY_DIR/pg-basebackup.lisp" "$@" &
CHILD_PID=$!
wait "$CHILD_PID"
