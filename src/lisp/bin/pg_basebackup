#!/bin/sh
set -eu
UTILITY_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
case "${1:-}" in
    --version|-V) echo 'pg_basebackup (PostgreSQL) 20devel'; exit 0 ;;
    --help|'-?') echo 'usage: pg_basebackup --pgdata=DIR -X stream --dbname=CONNINFO'; exit 0 ;;
esac
HELPER_BUILD_DIR=
CHILD_PID=
cleanup() {
    if [ -n "$HELPER_BUILD_DIR" ]; then
        rm -rf -- "$HELPER_BUILD_DIR"
    fi
}
trap cleanup EXIT
cancel() {
    trap '' HUP INT TERM
    CHILD_PID=${CHILD_PID:-${!:-}}
    if [ -n "$CHILD_PID" ]; then
        kill -TERM "$CHILD_PID" 2>/dev/null || true
        wait "$CHILD_PID" 2>/dev/null || true
    fi
    exit 130
}
trap cancel HUP INT TERM
if [ -z "${PG_LIBPQ_HELPER:-}" ]; then
    if [ -x "$UTILITY_DIR/pg-libpq-helper" ]; then
        PG_LIBPQ_HELPER="$UTILITY_DIR/pg-libpq-helper"
    else
        HELPER_BUILD_DIR=$(mktemp -d "${TMPDIR:-/tmp}/pg-basebackup-helper.XXXXXX")
        "$UTILITY_DIR/../t/build-libpq-helper.sh" "$HELPER_BUILD_DIR/helper"
        PG_LIBPQ_HELPER="$HELPER_BUILD_DIR/helper"
    fi
    export PG_LIBPQ_HELPER
fi
"${SBCL:-sbcl}" --script "$UTILITY_DIR/pg-basebackup.lisp" "$@" &
CHILD_PID=$!
wait "$CHILD_PID"
