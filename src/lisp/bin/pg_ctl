#!/usr/bin/env python3
"""Request promotion of a native pg-lisp standby.

Use C pg_ctl's promote file and SIGUSR1 interface, with native control files.
Only the promote command is implemented. A Linux pidfd binds the signal to the
validated postmaster process; a reused PID must not redirect the request.
"""
import argparse
import os
import pathlib
import re
import select
import signal
import stat
import struct
import sys
import time
import zlib


def read_regular(path, limit):
    """Read bounded native metadata without following links or blocking on a FIFO."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_size > limit:
            raise ValueError(f"invalid native metadata file: {path}")
        data = os.read(fd, limit + 1)
        if len(data) > limit:
            raise ValueError(f"oversized native metadata file: {path}")
        return data
    finally:
        os.close(fd)


def recovery_phase(root):
    """Read and check native recovery control; do not infer a role from file names."""
    data = read_regular(root / "physical-recovery.control", 196)
    ordinary = data[:8] == b"PGRSTAT3"
    pending = data[:8] == b"PGRSTAT4"
    known = ((ordinary and len(data) in (120, 136))
             or (pending and len(data) in (136, 152, 180, 196)))
    size = len(data) - (48 if known else 0)
    if not ((ordinary and size in (72, 88)) or (pending and size in (88, 104, 132, 148))):
        raise ValueError("invalid native recovery control")
    saved = struct.unpack_from("<I", data, len(data) - 4)[0]
    if zlib.crc32(data[:-4] + b"\0" * 4) != saved:
        raise ValueError("native recovery control checksum mismatch")
    if known:
        fact = data[-52:-4]
        validate_resource_tuple(fact[:32])
        origin, timeline, reserved = struct.unpack_from("<QII", fact, 32)
        applied = struct.unpack_from("<Q", data, 40)[0]
        selected = size in ((104, 148) if pending else (88,))
        timeline_offset = (84 if pending else 68) if selected else 12
        applied_timeline = struct.unpack_from("<I", data, timeline_offset)[0]
        if not (reserved == 0 and 1 <= origin <= applied and 1 <= timeline <= applied_timeline):
            raise ValueError("invalid native recovery resource fact")
    return struct.unpack_from("<I", data, 8)[0] & 0x7FFFFFFF


def open_postmaster(root):
    """Return a process handle and the unchanged ready PID metadata.

    Require the named process to hold this PGDATA's dedicated ownership flock.
    The caller closes the pidfd. Keep it open through signaling and waiting.
    """
    metadata = read_regular(root / "postmaster.pid", 8192)
    lines = metadata.decode().splitlines()
    if len(lines) < 8 or pathlib.Path(lines[1]).resolve() != root or lines[7].strip() != "ready":
        raise ValueError("native postmaster is not ready in this data directory")
    pid = int(lines[0])
    if pid <= 1:
        raise ValueError("invalid postmaster PID")
    handle = os.pidfd_open(pid)
    try:
        lock = (root / ".pg_lisp.lock").lstat()
        if not stat.S_ISREG(lock.st_mode) or lock.st_nlink != 1:
            raise ValueError("invalid native ownership lock")
        owned = False
        for entry in pathlib.Path(f"/proc/{pid}/fd").iterdir():
            try:
                info = entry.stat()
                if (info.st_dev, info.st_ino) == (lock.st_dev, lock.st_ino):
                    text = pathlib.Path(f"/proc/{pid}/fdinfo/{entry.name}").read_text()
                    owned |= bool(re.search(rf"lock:.*FLOCK\s+ADVISORY\s+WRITE\s+{pid}\s", text))
            except FileNotFoundError:
                continue
        if not owned or metadata != read_regular(root / "postmaster.pid", 8192):
            raise ValueError("PID does not own this native data directory")
        return handle, metadata
    except BaseException:
        os.close(handle)
        raise


def validate_resource_tuple(data):
    if len(data) != 32 or data[:8] != b"PGRES001" or data[28:] != b"\0" * 4:
        raise ValueError("invalid native resource parameter encoding")
    connections, workers, senders, prepared, locks = struct.unpack_from("<5I", data, 8)
    if not (1 <= connections <= 262143 and 0 <= workers <= 262143
            and 0 <= senders <= 262143 and 0 <= prepared <= 262143
            and 10 <= locks <= 2147483647 and connections + workers + senders + 3 <= 262143):
        raise ValueError("invalid native resource parameters")


def validate_resource_fields(fields):
    if len(fields) not in (15, 21):
        return
    offset = 16 if len(fields) == 21 else 10
    if fields[offset] != b"R" or len(fields[offset + 1]) != 64:
        raise ValueError("invalid native resource control extension")
    data = bytes.fromhex(fields[offset + 1].decode("ascii"))
    validate_resource_tuple(data)
    if any(re.fullmatch(rb"\+?[0-9]+", token) is None for token in fields[offset + 2:offset + 4]):
        raise ValueError("invalid native resource position encoding")
    if not (1 <= int(fields[offset + 2]) <= min(int(fields[2]), 2**64 - 1)
            and 1 <= int(fields[offset + 3]) <= min(int(fields[3]), 2**32 - 1)):
        raise ValueError("invalid native resource parameter facts")


def primary_committed(root):
    """Check durable child control and completion of pending-trigger removal.

    This is a control-file wait, like C pg_ctl's production-state wait. It does
    not probe a SQL listener or establish synchronous replication durability.
    Lifecycle metadata may include a retained reference, resource metadata,
    or both. All forms require a valid checksum; committed-child state also
    requires lifecycle metadata. Promote also verifies the PGDATA owner.
    """
    fields = read_regular(root / "global/pg_wal_control", 1025).split()
    if len(fields) not in (8, 11, 15, 17, 21) or fields[0] != b"PGWAL6":
        raise ValueError("invalid native WAL control")
    if zlib.crc32(b" ".join(fields[:-1])) != int(fields[-1], 16):
        raise ValueError("native WAL control checksum mismatch")
    validate_resource_fields(fields)
    return (int(fields[3]) > 1 and fields[3] == fields[4] and fields[5] == b"timeline"
            and len(fields) in (11, 15, 17, 21) and fields[8] == b"6"
            and not (root / "physical-recovery.control").exists())


def promote(root, wait, timeout, quiet):
    """Create the request file, signal the verified owner and optionally wait.

    -W returns once the signal is sent. A -w timeout stops only this utility's
    wait; it does not cancel the accepted request in the postmaster.
    """
    handle, metadata = open_postmaster(root)
    try:
        try:
            phase = recovery_phase(root)
        except FileNotFoundError:
            raise ValueError("server is not in standby mode") from None
        if phase not in (2, 3):
            raise ValueError("native promotion requires a streaming standby")
        path = root / "promote"
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, 0o600)
        try:
            info = os.fstat(fd)
            if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid != os.geteuid():
                raise ValueError("invalid promote signal file")
            os.ftruncate(fd, 0)
        finally:
            os.close(fd)
        if metadata != read_regular(root / "postmaster.pid", 8192):
            raise ValueError("postmaster changed before promote signal")
        signal.pidfd_send_signal(handle, signal.SIGUSR1)
        if wait:
            poller = select.poll()
            poller.register(handle, select.POLLIN)
            deadline = time.monotonic() + timeout
            while True:
                if poller.poll(0):
                    raise ValueError("postmaster exited during promotion")
                if primary_committed(root):
                    break
                if time.monotonic() >= deadline:
                    raise ValueError("server did not promote in time")
                time.sleep(0.1)
        if not quiet:
            print("server promoted" if wait else "server promoting")
    finally:
        os.close(handle)


def main():
    """Parse the supported C-style options and dispatch native promotion."""
    parser = argparse.ArgumentParser(description="Native pg-lisp promotion utility")
    parser.add_argument("command", choices=["promote"])
    parser.add_argument("-D", "--pgdata", default=os.environ.get("PGDATA"))
    parser.add_argument("-w", "--wait", dest="wait", action="store_true", default=True)
    parser.add_argument("-W", "--no-wait", dest="wait", action="store_false")
    parser.add_argument("-t", "--timeout", type=int, default=os.environ.get("PGCTLTIMEOUT", "60"))
    parser.add_argument("-s", "--silent", action="store_true")
    args = parser.parse_args()
    if not args.pgdata or args.timeout < 0:
        parser.error("an existing -D directory and a nonnegative timeout are required")
    promote(pathlib.Path(args.pgdata).resolve(strict=True), args.wait, args.timeout, args.silent)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError) as error:
        print(f"pg_ctl: {error}", file=sys.stderr)
        sys.exit(1)
