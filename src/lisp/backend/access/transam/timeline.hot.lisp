(in-package #:pg)

(defun %timeline-valid-lineage-p (history)
  (let ((newer nil) (oldest-begin nil))
    (dolist (entry history (and newer (eql oldest-begin 0)))
      (let ((timeline (timeline-history-entry-timeline entry))
            (begin (timeline-history-entry-begin entry))
            (end (timeline-history-entry-end entry)))
        (unless (and (typep timeline '(integer 1 4294967295))
                     (typep begin '(unsigned-byte 64))
                     (if end (and (typep end '(unsigned-byte 64)) (<= begin end))
                         (null newer))
                     (or (null newer)
                         (and (< timeline (timeline-history-entry-timeline newer))
                              (eql end (timeline-history-entry-begin newer)))))
          (return nil))
        (setf newer entry oldest-begin begin)))))
