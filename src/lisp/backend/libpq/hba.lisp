(in-package #:pg)

(defstruct (hba-token (:constructor %make-hba-token (text quoted-p)))
  (text "" :read-only t)
  (quoted-p nil :read-only t))

(defun hba-blank-p (character)
  (or (char= character #\Space) (char= character #\Tab)))

(defun hba-next-token (line position)
  (let ((length (length line))
        (buffer (make-array 32 :element-type 'character :adjustable t :fill-pointer 0))
        (in-quote nil) (was-quote nil) (saw-quote nil) (initial-quote nil) (comma nil))
    (loop while (and (< position length)
                     (or (hba-blank-p (char line position))
                         (char= (char line position) #\,)))
          do (incf position))
    (loop while (< position length)
          for character = (char line position)
          while (or in-quote (not (hba-blank-p character)))
          do (when (and (char= character #\#) (not in-quote))
               (setf position length)
               (return))
             (when (and (char= character #\,) (not in-quote))
               (setf comma t)
               (return))
             (when (or (not (char= character #\")) was-quote)
               (vector-push-extend character buffer))
             (setf was-quote (and in-quote (char= character #\") (not was-quote)))
             (when (char= character #\")
               (setf in-quote (not in-quote) saw-quote t)
               (when (zerop (length buffer)) (setf initial-quote t)))
             (incf position))
    (values (when (or saw-quote (plusp (length buffer)))
              (%make-hba-token (coerce buffer 'simple-string) initial-quote))
            position comma)))

(defun hba-tokenize-line (line)
  (check-type line string)
  (when (or (find (code-char 0) line) (find #\Newline line))
    (error "authentication tokenizer requires one logical line without NUL"))
  (let ((position 0) (fields nil))
    (loop
      (let ((field nil))
        (loop
          (multiple-value-bind (token next comma) (hba-next-token line position)
            (setf position next)
            (unless token (return))
            (push token field)
            (unless comma (return))))
        (unless field (return (nreverse fields)))
        (push (nreverse field) fields)))))

(defstruct hba-rule
  (transport nil :read-only t) (databases nil :read-only t) (users nil :read-only t)
  (network nil :read-only t) (mask nil :read-only t) (method nil :read-only t)
  (source nil :read-only t) (line 0 :read-only t))

(defun hba-logical-lines (text &key (source "pg_hba.conf"))
  (let ((lines nil) (number 0) (start 0) (continuing nil)
                    (buffer (make-string-output-stream)) (size 0))
    (with-input-from-string (input text)
      (loop for physical = (read-line input nil nil)
            while physical
            for line = (string-right-trim '(#\Return) physical)
            for length = (length line)
            do (incf number)
               (unless continuing (setf start number))
               (setf continuing (and (plusp length) (char= (char line (1- length)) #\\)))
               (incf size (- length (if continuing 1 0)))
               (when (> size 65536)
                 (error "~a:~d: authentication logical line exceeds its size bound" source start))
               (write-string line buffer :end (- length (if continuing 1 0)))
               (unless continuing
                 (push (cons start (get-output-stream-string buffer)) lines)
                 (setf size 0))))
    (when continuing (push (cons start (get-output-stream-string buffer)) lines))
    (nreverse lines)))

(defun hba-keyword-p (token word)
  (and (not (hba-token-quoted-p token)) (string= (hba-token-text token) word)))

(defun hba-single-token (field description)
  (unless (= (length field) 1) (error "authentication field ~a requires one value" description))
  (first field))

(defun hba-check-selectors (tokens database-p)
  (dolist (token tokens)
    (let ((text (hba-token-text token)))
      (when (or (and (plusp (length text)) (char= (char text 0) #\/))
                (and (not (hba-token-quoted-p token))
                     (or (and (> (length text) 1) (char= (char text 0) #\@))
                         (and (not database-p) (plusp (length text))
                              (char= (char text 0) #\+))
                         (and database-p
                              (member text '("samegroup" "samerole") :test #'string=)))))
        (error "unsupported authentication selector ~s" text))))
  tokens)

(sb-alien:define-alien-routine ("inet_aton" hba-inet-aton) sb-alien:int
  (text sb-alien:c-string) (address (* (sb-alien:unsigned 8))))

(defun hba-parse-ip-address (text)
  (handler-case
      (if (find #\: text)
          (progn
            (unless (every (lambda (character)
                             (find character "0123456789abcdefABCDEF:.")) text)
              (error "unsupported IPv6 address syntax"))
            (sb-bsd-sockets:make-inet6-address text))
          (let ((address (make-array 4 :element-type '(unsigned-byte 8) :initial-element 0)))
            (unless (and (plusp (length text))
                         (every (lambda (character)
                                  (find character "0123456789abcdefABCDEFxX.")) text)
                         (sb-sys:with-pinned-objects (address)
                           (= 1 (hba-inet-aton
                                 text (sb-alien:sap-alien (sb-sys:vector-sap address)
                                                          (* (sb-alien:unsigned 8)))))))
              (error "invalid IPv4 address syntax"))
            address))
    (error () (error "unsupported or invalid numeric authentication address ~s" text))))

(defun hba-parse-prefix (text)
  (let* ((length (length text))
         (start (position-if-not (lambda (character)
                                   (find (char-code character) '(9 10 11 12 13 32))) text))
         (digits (and start
                      (if (find (char text start) "+-") (1+ start) start))))
    (unless (and digits (< digits length)
                 (every (lambda (character) (find character "0123456789"))
                        (subseq text digits)))
      (error "invalid authentication CIDR prefix"))
    (parse-integer text :start start)))

(defun hba-prefix-mask (length bits)
  (unless (<= 0 bits (* 8 length)) (error "authentication address prefix is out of range"))
  (map 'vector
       (lambda (index)
         (let ((remaining (- bits (* 8 index))))
           (cond ((>= remaining 8) 255) ((<= remaining 0) 0)
                 (t (- 256 (ash 1 (- 8 remaining)))))))
       (coerce (loop for index below length collect index) 'vector)))

(defun hba-parse-network (fields)
  (let* ((token (hba-single-token (first fields) "address"))
         (text (hba-token-text token)) (slash (position #\/ text)))
    (when (hba-keyword-p token "all") (return-from hba-parse-network (values nil nil 1)))
    (let* ((address (hba-parse-ip-address (if slash (subseq text 0 slash) text)))
           (mask
             (if slash
                 (hba-prefix-mask (length address) (hba-parse-prefix (subseq text (1+ slash))))
                 (hba-parse-ip-address
                  (hba-token-text (hba-single-token (second fields) "netmask"))))))
      (unless (= (length address) (length mask))
        (error "authentication address and netmask families differ"))
      (values address mask (if slash 1 2)))))

(defun hba-parse-rule (fields source line)
  (unless (>= (length fields) 4) (error "authentication rule has too few fields"))
  (let* ((name (hba-token-text (hba-single-token (first fields) "connection type")))
         (transport (cdr (assoc name '(("local" . :local) ("host" . :host)
                                       ("hostssl" . :hostssl) ("hostnossl" . :hostnossl))
                                :test #'string=)))
         (databases (hba-check-selectors (second fields) t))
         (users (hba-check-selectors (third fields) nil))
         (remaining (cdddr fields)))
    (unless transport (error "unsupported authentication connection type ~s" name))
    (multiple-value-bind (network mask consumed)
        (if (eq transport :local) (values nil nil 0) (hba-parse-network remaining))
      (unless (= (length remaining) (1+ consumed))
        (error "authentication options or extra fields are unsupported"))
      (let* ((name (hba-token-text (hba-single-token (nth consumed remaining) "method")))
             (method (cdr (assoc name '(("trust" . :trust) ("reject" . :reject)) :test #'string=))))
        (unless method (error "unsupported authentication method ~s" name))
        (make-hba-rule :transport transport :databases databases :users users
                       :network network :mask mask :method method :source source :line line)))))

(defun hba-parse-text (text &key (source "pg_hba.conf"))
  (check-type text string)
  (when (or (> (length text) 1048576) (find (code-char 0) text))
    (error "authentication file exceeds its bound or contains NUL"))
  (let ((rules nil))
    (dolist (entry (hba-logical-lines text :source source))
      (handler-case
          (let ((fields (hba-tokenize-line (cdr entry))))
            (when fields (push (hba-parse-rule fields source (car entry)) rules)))
        (error (condition)
          (error "~a:~d: ~a" source (car entry) condition))))
    (unless rules (error "~a contains no authentication rules" source))
    (nreverse rules)))

(defun hba-user-matches-p (tokens user)
  (some (lambda (token)
          (or (hba-keyword-p token "all") (string= (hba-token-text token) user)))
        tokens))

(defun hba-database-matches-p (tokens user database replication)
  (some (lambda (token)
          (if (eq replication :physical)
              (hba-keyword-p token "replication")
              (cond ((hba-keyword-p token "all") t)
                    ((hba-keyword-p token "sameuser") (string= database user))
                    ((hba-keyword-p token "replication") nil)
                    (t (string= (hba-token-text token) database)))))
        tokens))

(defun hba-transport-matches-p (type transport ssl-p)
  (ecase type
    (:local (eq transport :local))
    (:host (eq transport :tcp))
    (:hostssl (and (eq transport :tcp) ssl-p))
    (:hostnossl (and (eq transport :tcp) (not ssl-p)))))

(defun hba-address-matches-p (rule peer)
  (let ((network (hba-rule-network rule)) (mask (hba-rule-mask rule)))
    (or (null network)
        (and peer (= (length network) (length peer))
             (loop for address across network for client across peer for bits across mask
                   always (zerop (logand (logxor address client) bits)))))))

(defun hba-match-rules (rules user database peer &key replication (transport :tcp) ssl-p)
  (check-type user string)
  (check-type database string)
  (unless (member replication '(nil :database :physical))
    (error "invalid authentication replication mode"))
  (unless (member transport '(:tcp :local)) (error "invalid authentication transport"))
  (when (and (eq transport :tcp)
             (not (and (vectorp peer) (member (length peer) '(4 16))
                       (every (lambda (octet) (typep octet '(unsigned-byte 8))) peer))))
    (error "TCP authentication requires a valid numeric peer address"))
  (dolist (rule rules (values :implicit-reject nil))
    (when (and (hba-transport-matches-p (hba-rule-transport rule) transport ssl-p)
               (hba-address-matches-p rule peer)
               (hba-user-matches-p (hba-rule-users rule) user)
               (hba-database-matches-p (hba-rule-databases rule) user database replication))
      (return (values (hba-rule-method rule) rule)))))
