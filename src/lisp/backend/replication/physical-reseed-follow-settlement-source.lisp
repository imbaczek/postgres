(in-package #:pg)

(defun physical-reseed-follow-settlement-source-action (value source active-p)
  (let* ((record (physical-reseed-follow-copy value))
         (pending (getf record :settlement))
         (source (when source (physical-backup-lease-copy source))))
    (unless (and (eq :handoff-pending (getf pending :phase)) (member active-p '(nil t)))
      (error "source settlement requires durable pending intent and explicit local authority"))
    (unless source
      (return-from physical-reseed-follow-settlement-source-action (values :wait nil)))
    (unless (and (equal (getf source :request) (getf (getf record :attempt) :request))
                 (or (null (getf source :base))
                     (equal (getf source :base) (physical-reseed-follow-settlement-base record))))
      (error "source lease differs from the exact pending request or installed base"))
    (let ((phase (getf source :phase)) (outcome (getf source :outcome)))
      (when (and (member phase '(:closing :closed)) (eq outcome :handed-off)
                 (not (equal (getf source :successor) (getf pending :successor))))
        (error "source handoff selected a different successor"))
      (cond
        ((eq phase :closed)
         (physical-reseed-follow-settlement-copy
          (list :phase (ecase outcome (:handed-off :handed-off) (:aborted :source-aborted))
                :successor (getf pending :successor) :receipt source)
          record)
         (values :terminal source))
        ((and active-p (getf source :base)
              (or (member phase '(:ready :interrupted))
                  (and (eq phase :closing) (eq outcome :handed-off))))
         (values :handoff source))
        (t (values :wait source))))))
