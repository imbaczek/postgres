(in-package #:pg)

(defun logical-slot-continuation-history (tip bytes)
  (timeline-check-lineage (timeline-parse-history tip (bytes->string bytes))))

(defun logical-slot-continuation-slot-rows-equal-p (left right)
  (and (= (logical-slot-copy-descriptor-list-count left +logical-slot-continuation-obligation-limit+)
          (logical-slot-copy-descriptor-list-count right +logical-slot-continuation-obligation-limit+))
       (every (lambda (a b) (and (string= (first a) (first b)) (equalp (second a) (second b))))
              left right)))

(defun logical-slot-continuation-work-profile (snapshot history)
  ;; Bound weighted history entry visits before geometry and cache parsed
  ;; root histories for the checks that follow.
  (let* ((uses (make-hash-table :test #'eql))
         (parsed (make-hash-table :test #'eql))
         (work (* (length history)
                  (+ 32 (* 64 (length (getf snapshot :slots)))
                     (* 8 (length (getf snapshot :transfers)))
                     (* 32 (length (getf snapshot :roots)))
                     (* 32 (length (getf snapshot :runs)))))))
    (labels ((check ()
               (when (> work +logical-slot-continuation-work-limit+)
                 (error "continuation history lookup work exceeds its profile"))))
      (check)
      (dolist (run (getf snapshot :runs)) (incf (gethash (first run) uses 0)))
      (dolist (row (getf snapshot :roots))
        (let ((selected (logical-slot-continuation-history (fourth row) (fifth row))))
          (incf work (* (length selected) (+ 16 (* 32 (gethash (first row) uses 0)))))
          (check)
          (setf (gethash (first row) parsed) selected))))
    parsed))

(defun logical-slot-continuation-position (position history end)
  (logical-slot-continuation-position-shape position)
  (let ((lsn (first position)) (owner (second position)))
    (unless (and (<= lsn end)
                 (ecase (third position)
                   (:record-start (eql owner (timeline-at-point lsn history)))
                   (:prefix-end (and (plusp lsn) (eql owner (timeline-at-point (1- lsn) history))))))
      (error "continuation position differs from selected lineage or sealed end"))
    lsn))

(defun logical-slot-continuation-slot-positions (snapshot history end)
  ;; Slot rows retain the exact P7 byte image, including its 128-bit
  ;; generation and child owner.  Transfers use canonical 32-character
  ;; lowercase hex, checked by the existing generation parser.
  (let ((prior nil) (positions nil))
    (dolist (row (getf snapshot :slots))
      (unless (or (null prior) (string< prior (first row)))
        (error "continuation slot rows are repeated or unordered"))
      (setf prior (first row))
      (let* ((slot (logical-slot-state-decode (second row) (first row)))
             (provenance (wal-replication-slot-logical-provenance slot)))
        (unless (and provenance (wal-replication-slot-child-owner slot)
                     (eql (getf snapshot :system-id) (logical-slot-provenance-system-id provenance)))
          (error "continuation obligation requires this system's exact imported slot image"))
        (logical-slot-imported-check-state slot slot history end)
        (when (eq :reserved (wal-replication-slot-wal-status slot))
          (multiple-value-bind (owner role) (logical-slot-startup-start-position slot history)
            (push (list (wal-replication-slot-restart-lsn slot) owner role) positions)))))
    (setf prior nil)
    (dolist (row (getf snapshot :transfers))
      (unless (or (null prior) (string< prior (first row)))
        (error "continuation transfer rows are repeated or unordered"))
      (setf prior (first row))
      (logical-slot-continuation-position (second row) history end)
      (push (second row) positions))
    positions))

(defun logical-slot-continuation-root-table (snapshot history end parsed)
  (let ((table (make-hash-table :test #'eql)) (seen (make-hash-table :test #'eql)) (prior 0))
    (dolist (row (getf snapshot :roots))
      (let* ((key (first row)) (reference (third row))
                               (selected (gethash key parsed)))
        (unless (and (< prior key) (not (gethash (getf reference :root-id) seen))
                     (eql (second row) (getf snapshot :system-id))
                     (<= (getf reference :end) end)
                     (timeline-prefix-boundary-p (getf reference :base-timeline) (getf reference :base) selected)
                     (physical-store-history-extends-p selected history))
          (error "continuation root has foreign identity, ancestry or order"))
        (setf prior key (gethash (getf reference :root-id) seen) t
              (gethash key table) (list row selected))))
    table))

(defun logical-slot-continuation-check-runs (snapshot history table end)
  (let ((prior 0))
    (dolist (run (getf snapshot :runs))
      (let* ((source (gethash (first run) table))
             (selected (second source)) (reference (third (first source)))
             (start (logical-slot-continuation-position (second run) history end))
             (finish (logical-slot-continuation-position (third run) history end))
             (owner (fourth run)) (carrier (fifth run))
             (first-segment (floor start +wal-segment-size+))
             (last-segment (and (< start finish) (floor (1- finish) +wal-segment-size+))))
        (unless (and source (<= prior start) (< start finish)
                     (<= (second (getf snapshot :origin)) start)
                     (<= (getf reference :base) start finish (getf reference :end))
                     (eql owner (second (second run))) (eql owner (second (third run)))
                     (eql owner (timeline-at-point start history))
                     (eql owner (timeline-at-point (1- finish) history))
                     (eql carrier (logical-wal-segment-carrier first-segment selected))
                     (eql carrier (logical-wal-segment-carrier last-segment selected))
                     (member carrier (timeline-segment-candidates first-segment history))
                     (member carrier (timeline-segment-candidates last-segment history))
                     (>= carrier owner))
          (error "continuation run lacks its declared root, owner or carrier"))
        (setf prior finish)))))

(defun logical-slot-continuation-seam (left right history)
  (let ((entry (find left history :key #'timeline-history-entry-begin)))
    (cond
      ((and entry (second (member entry history))
            (= right (logical-wal-eor-position left))) :fork-eor)
      ((= left right) :adjacent)
      ((and (< left right) (plusp (mod left +wal-segment-size+))
            (= right (* (1+ (floor left +wal-segment-size+)) +wal-segment-size+))
            (notany (lambda (item) (< left (timeline-history-entry-begin item) right)) history))
       :rotation)
      (t (error "continuation selection has an unclassified gap")))))

(defun logical-slot-continuation-make-plan (snapshot history positions)
  ;; The plan holds a detached full snapshot and proof requests; nested data
  ;; is neither immutable nor independently verified.  The floor comes from
  ;; supplied saved restart positions and transfers, not confirmed progress
  ;; or an in-memory restart.  Prove the actual durably saved rows before
  ;; publication or release.
  ;;
  ;; Each root carries its own system, base, reference and history.  A run's
  ;; logical owner can differ from its physical carrier.  The current-tip
  ;; tail is a local retention claim, not a claim about a future archive.
  (let* ((fork (second (getf snapshot :origin)))
         (floor (when positions (max fork (reduce #'min positions :key #'first))))
         (cursor floor) (carrier 0) (requests nil) (seams nil) (keys nil)
         (tail (getf snapshot :tail)))
    (when tail
      (let ((start (logical-slot-continuation-position (first tail) history
                                                       (first (getf snapshot :sealed-end))))
            (tip (getf snapshot :history-target)))
        (unless (and (eql tip (second tail)) (eql tip (timeline-at-point start history))
                     (or (null (getf snapshot :runs))
                         (<= (first (third (car (last (getf snapshot :runs))))) start)))
          (error "continuation tail is not a separate current-tip obligation"))))
    (when floor
      (unless tail (error "continuation demand lacks its live-tail retention obligation"))
      (dolist (run (getf snapshot :runs))
        (let ((start (first (second run))) (end (first (third run))))
          (when (>= end floor)
            (pushnew (first run) keys :test #'eql)
            (push (list :run (logical-slot-continuation-copy run) :from (max start floor)) requests)
            (when (> end cursor)
              (unless (<= carrier (fifth run)) (error "continuation physical carrier regresses"))
              (when (<= cursor start)
                (push (list (logical-slot-continuation-seam cursor start history) cursor start) seams))
              (setf cursor end carrier (fifth run))))))
      (let ((start (first (first tail))))
        (when (<= cursor start)
          (push (list (logical-slot-continuation-seam cursor start history) cursor start) seams))
        (unless (<= carrier (second tail)) (error "continuation tail carrier regresses"))))
    (%make-logical-slot-continuation-plan
     :snapshot (logical-slot-continuation-copy snapshot) :floor floor
     :root-requests (loop for row in (getf snapshot :roots) when (member (first row) keys :test #'eql)
                          collect (logical-slot-continuation-copy row))
     :run-requests (nreverse requests) :seam-requests (nreverse seams)
     :tail-request (and floor (logical-slot-continuation-copy tail)))))

(defun logical-slot-continuation-check (snapshot)
  ;; These are source-selection claims only.  A later held-FD proof must
  ;; match the canonical host proof and independently read roots, records,
  ;; and the local tail.  This check does no I/O, publication, GC, admission,
  ;; or readiness update.
  (let* ((size (logical-slot-continuation-shape snapshot))
         (history (logical-slot-continuation-history (getf snapshot :history-target) (getf snapshot :history)))
         (parsed (logical-slot-continuation-work-profile snapshot history))
         (sealed (getf snapshot :sealed-end))
         (end (logical-slot-continuation-position sealed history (first sealed)))
         (origin (getf snapshot :origin))
         (entry (member (first origin) history :key #'timeline-history-entry-timeline)))
    (unless (and entry (second entry) (eql (second origin) (timeline-history-entry-begin (first entry)))
                 (eq :prefix-end (third sealed)) (eql (getf snapshot :history-target) (second sealed))
                 (> end (timeline-history-entry-begin (first history))))
      (error "continuation snapshot lost its origin or current durable end"))
    (let ((positions (logical-slot-continuation-slot-positions snapshot history end))
          (table (logical-slot-continuation-root-table snapshot history end parsed)))
      (logical-slot-continuation-check-runs snapshot history table end)
      (values (logical-slot-continuation-make-plan snapshot history positions) size))))

(defun logical-slot-continuation-normalize (snapshot)
  ;; Drop only whole runs ending strictly below the floor.  Keep intersecting
  ;; and equality-boundary runs without clipping or coalescing, remove unused
  ;; roots, and renumber local keys.  The origin binding remains even when no
  ;; obligations remain.
  (let* ((plan (logical-slot-continuation-check snapshot))
         (floor (logical-slot-continuation-plan-floor plan))
         (copy (logical-slot-continuation-copy snapshot))
         (runs (and floor (remove-if (lambda (run) (< (first (third run)) floor)) (getf copy :runs))))
         (keys (mapcar #'first runs)) (mapping (make-hash-table :test #'eql)) (next 0))
    (setf (getf copy :runs) runs
          (getf copy :roots)
          (loop for row in (getf copy :roots) when (member (first row) keys :test #'eql)
                collect (progn (setf (gethash (first row) mapping) (incf next) (first row) next) row)))
    (dolist (run runs) (setf (first run) (gethash (first run) mapping)))
    (unless floor (setf (getf copy :tail) nil))
    (logical-slot-continuation-check copy)
    copy))

(defun logical-slot-continuation-plan-slot-update (snapshot name bytes)
  (logical-slot-continuation-check snapshot)
  (let* ((row (find name (getf snapshot :slots) :key #'first :test #'string=))
         (history (logical-slot-continuation-history (getf snapshot :history-target) (getf snapshot :history))))
    (unless row (error "continuation slot update has no matching durable generation"))
    (logical-slot-imported-check-state
     (logical-slot-state-decode bytes name) (logical-slot-state-decode (second row) name)
     history (first (getf snapshot :sealed-end)))
    (when (= #xffffffffffffffff (getf snapshot :generation))
      (error "continuation generation exhausted"))
    (let ((copy (logical-slot-continuation-copy snapshot)))
      (incf (getf copy :generation))
      (setf (second (find name (getf copy :slots) :key #'first :test #'string=)) (copy-seq bytes))
      (logical-slot-continuation-check copy)
      copy)))
