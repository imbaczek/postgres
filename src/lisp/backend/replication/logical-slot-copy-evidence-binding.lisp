;;; Bind recorded evidence to the certificate and copied source facts.

;;; Permanent import evidence checks describe recorded facts, not authority.
(in-package #:pg)

(defun logical-slot-copy-evidence-check-history (evidence certificate descriptor control)
  "Bind selected and child history through the applied parent and fork.
The selected tip may be newer than the applied parent."
  (let* ((target (or (getf control :history-target) (getf control :timeline)))
         (parent (getf certificate :parent-timeline))
         (fork (getf certificate :fork))
         (selected (timeline-check-lineage
                    (timeline-parse-history target (bytes->string (getf evidence :selected-history)))))
         (base (timeline-check-lineage
                (timeline-parse-history (getf certificate :base-timeline)
                                        (bytes->string (logical-slot-copy-descriptor-history descriptor)))))
         (child (timeline-check-lineage
                 (timeline-parse-history (getf certificate :child-timeline)
                                         (bytes->string (getf evidence :child-history)))))
         (prefix (mapcar #'copy-timeline-history-entry
                         (member parent selected :key #'timeline-history-entry-timeline))))
    (unless (and prefix (timeline-prefix-boundary-p parent fork selected)
                 (= (timeline-history-entry-begin (first child)) fork)
                 (second child) (= (timeline-history-entry-timeline (second child)) parent)
                 (= (timeline-history-entry-end (second child)) fork)
                 (physical-store-history-extends-p base selected))
      (error "import evidence changes source or child ancestry"))
    (setf (timeline-history-entry-end (first prefix)) nil)
    (unless (physical-store-history-extends-p prefix child)
      (error "import evidence child history changes its parent prefix"))
    (when (getf control :history-target)
      (unless (= (getf control :history-digest)
                 (logical-slot-copy-import-digest (getf evidence :selected-history)))
        (error "import evidence selected history differs from pending control")))
    selected))

(defun logical-slot-copy-evidence-check-rows (certificate descriptor control history)
  "Rebuild child PGSLOT7 images from supplied descriptor slots and frozen status.
Use the shared child-image guard to check owner and terminal cause."
  (let ((sources (logical-slot-copy-descriptor-slots descriptor))
        (owner (logical-slot-parse-generation (getf certificate :owner))))
    (unless (and (/= owner (logical-slot-parse-generation (getf certificate :copy-id)))
                 (equal (mapcar #'first sources) (mapcar #'first (getf certificate :slots))))
      (error "import evidence source slot inventory or owner differs"))
    (loop for (name bytes) in sources
          for row in (getf certificate :slots)
          for source = (logical-slot-state-decode bytes name)
          for disposition = (logical-slot-copy-import-disposition
                             source (getf control :logical-fact) history
                             (getf certificate :fork) (getf certificate :parent-timeline))
          do (unless (and (not (eq disposition :deferred)) (eq disposition (fifth row))
                          (= (third row) (logical-slot-copy-import-digest bytes))
                          (equal (second row)
                                 (logical-slot-generation-token
                                  (logical-slot-provenance-generation
                                   (wal-replication-slot-logical-provenance source))))
                          (equalp (string->bytes (fourth row))
                                  (logical-slot-copy-import-child-image
                                   source owner (if (eq disposition :eligible) :none disposition))))
               (error "import evidence planned slot differs from its actual source"))))
  t)

(defun logical-slot-copy-import-evidence-check-certificate (evidence certificate descriptor proof-bytes)
  "Check evidence against the certificate, descriptor and base proof without I/O.
This observational binding does not grant owner authority or replace D to F replay."
  (logical-slot-copy-import-check certificate)
  (logical-slot-copy-import-evidence-parts evidence)
  (multiple-value-bind (manifest digest) (recovery-decode-manifest (getf evidence :manifest))
    (let* ((control (physical-recovery-decode-control (getf evidence :control)))
           (proof (logical-slot-copy-base-proof-decode proof-bytes))
           (plan (getf evidence :plan))
           (snapshot (getf plan :snapshot)))
      (logical-slot-copy-check-binding descriptor manifest digest)
      (logical-slot-copy-check-checkpoint-bytes (getf evidence :checkpoint) manifest descriptor)
      (unless (and (= digest (getf certificate :manifest-digest) (getf control :manifest-digest))
                   (= (getf certificate :base-timeline) (getf control :timeline))
                   (= (getf manifest :checkpoint) (getf control :checkpoint))
                   (<= (getf control :next-xid) (getf snapshot :next-xid))
                   (= (getf certificate :descriptor-digest)
                      (logical-slot-copy-import-digest (logical-slot-copy-descriptor-encode descriptor)))
                   (= (getf certificate :base-proof-digest)
                      (logical-slot-copy-import-digest proof-bytes))
                   (= (getf certificate :source-history-digest)
                      (logical-slot-copy-import-digest (logical-slot-copy-descriptor-history descriptor)))
                   (= (getf certificate :selected-history-digest)
                      (logical-slot-copy-import-digest (getf evidence :selected-history)))
                   (= (getf certificate :pending-control-digest)
                      (logical-slot-copy-import-digest (getf evidence :control)))
                   (= (getf certificate :child-plan-digest)
                      (logical-slot-copy-import-plan-image-digest plan (getf evidence :child-history)))
                   (equal (getf certificate :copy-id) (getf manifest :logical-slot-copy-id))
                   (= (getf certificate :base-end) (getf manifest :end))
                   (= (getf certificate :base-timeline) (getf manifest :timeline))
                   (= 3 (getf control :phase))
                   (= (getf certificate :system-id) (getf manifest :system-id) (getf control :system-id))
                   (= (getf certificate :promotion-generation) (getf control :promotion-generation))
                   (= (getf certificate :parent-timeline)
                      (getf control :applied-timeline (getf control :timeline)))
                   (= (getf certificate :child-timeline) (getf control :promotion-child) (getf plan :child))
                   (= (getf certificate :fork) (getf control :applied) (getf plan :fork))
                   (= (getf certificate :child-end) (getf plan :end))
                   (equal (getf certificate :retained-reference) (getf control :retained-reference))
                   (loop for (left right) in '((:copy-id :copy-id) (:device :device) (:inode :inode)
                                               (:manifest-digest :manifest-digest)
                                               (:descriptor-digest :descriptor-digest) (:system-id :system-id)
                                               (:base-end :end) (:base-timeline :timeline)
                                               (:source-history-digest :history-digest))
                         always (equal (getf certificate left) (getf proof right)))
                   (= (getf proof :slots) (length (logical-slot-copy-descriptor-slots descriptor)))
                   (= (getf proof :pieces) (length (logical-slot-copy-descriptor-wal-pieces descriptor))))
        (error "import evidence differs from its certificate or base receipt"))
      (dolist (pair '((:promotion-full-page-writes :full-page-writes)
                      (:promotion-logical-decoding-enabled :logical-decoding-enabled)))
        (when (get-properties control (list (first pair)))
          (unless (and (get-properties snapshot (list (second pair)))
                       (eql (getf control (first pair)) (getf snapshot (second pair))))
            (error "import evidence child checkpoint loses frozen policy"))))
      (let* ((frame (first (getf plan :frames)))
             (eor (wal-end-of-recovery-record-info (wal-decode-record (second frame) (first frame)))))
        (unless (= (getf eor :wal-level)
                   (if (get-properties control '(:promotion-wal-level))
                       (ecase (getf control :promotion-wal-level) (:replica 1) (:logical 2)) 2))
          (error "import evidence EOR loses frozen configured WAL level")))
      (logical-slot-copy-evidence-check-rows
       certificate descriptor control
       (logical-slot-copy-evidence-check-history evidence certificate descriptor control))
      (values manifest control plan))))
