;;; Durable publication and progress for the offline installation plan.
;;;
;;; The plan is immutable after publication.  Progress is appended only after
;;; the exact namespace has been verified and both parents of a move have
;;; been synced.  A torn next STEP is truncated and rewritten on resume after
;;; validation; it never authorizes an otherwise unexplained namespace.

(in-package #:pg)

(declaim (ftype function physical-adoption-install-validate physical-adoption-install-validate-prepared
                physical-adoption-install-sync-move))
(defvar *physical-adoption-install-progress-write-limit* nil)

(defvar *physical-adoption-install-attempt-write-limit* nil)

(defun physical-adoption-install-journal-stat-p (stat plan &optional size)
  (let ((identity (getf plan :journal)))
    (and (sb-posix:s-isreg (sb-posix:stat-mode stat))
         (= #o600 (logand #o7777 (sb-posix:stat-mode stat)))
         (= 1 (sb-posix:stat-nlink stat)) (= (sb-posix:geteuid) (sb-posix:stat-uid stat))
         (= (getf identity :device) (sb-posix:stat-dev stat))
         (= (getf identity :inode) (sb-posix:stat-ino stat))
         (<= (sb-posix:stat-size stat) +physical-adoption-install-maximum-bytes+)
         (or (null size) (= size (sb-posix:stat-size stat))))))

(defun physical-adoption-install-read (owner)
  (physical-adoption-check-owner owner)
  (let* ((path (physical-adoption-install-path (physical-adoption-owner-directory owner)))
         (before (sb-posix:lstat (namestring path))))
    (unless (and (sb-posix:s-isreg (sb-posix:stat-mode before))
                 (= #o600 (logand #o7777 (sb-posix:stat-mode before)))
                 (= 1 (sb-posix:stat-nlink before))
                 (= (sb-posix:geteuid) (sb-posix:stat-uid before)))
      (error "adoption installation journal is not a private owned regular file"))
    (let* ((state (physical-adoption-install-decode
                   (read-bounded-regular-file path +physical-adoption-install-maximum-bytes+)))
           (plan (getf state :plan)))
      (physical-adoption-attempt-check-owner owner (getf plan :attempt))
      (unless (and (physical-adoption-install-journal-stat-p before plan (getf state :file-size))
                   (equal (physical-adoption-stage-stat-identity before)
                          (physical-adoption-stage-stat-identity (sb-posix:lstat (namestring path)))))
        (error "adoption installation journal changed during read"))
      state)))

(defun call-with-physical-adoption-install-fd (owner state function &key pending)
  (let* ((plan (getf state :plan))
         (root (physical-adoption-owner-directory
                (physical-adoption-attempt-check-owner owner (getf plan :attempt))))
         (workspace (pathname (getf (getf plan :workspace) :directory)))
         (path (if pending (merge-pathnames "journal.pending" workspace) (physical-adoption-install-path root)))
         (fd (sb-posix:open (namestring path)
                            (logior sb-posix:o-rdwr sb-posix:o-nofollow +postmaster-o-cloexec+))))
    (unwind-protect
         (progn
           (unless (and (physical-adoption-install-journal-stat-p
                         (sb-posix:fstat fd) plan (getf state :file-size))
                        (physical-adoption-install-journal-stat-p
                         (sb-posix:lstat (namestring path)) plan (getf state :file-size))
                        (= (physical-adoption-install-mount-id root)
                           (physical-adoption-install-mount-id path)))
             (error "adoption installation journal descriptor lost its identity"))
           (funcall function fd path))
      (sb-posix:close fd))))

(defun physical-adoption-install-write-bytes (fd bytes offset path &key limit (point :after-journal-write-chunk))
  (unless (= offset (sb-posix:lseek fd offset sb-posix:seek-set))
    (error "cannot seek to adoption installation journal append position"))
  (let ((storage (sb-ext:array-storage-vector bytes)))
    (sb-sys:with-pinned-objects (storage)
      (loop with written = 0
            while (< written (length bytes))
            for count = (min (- (length bytes) written) (or limit (length bytes)))
            do (unless (plusp count) (error "invalid adoption journal write limit"))
               (let ((actual (sb-posix:write fd (sb-sys:sap+ (sb-sys:vector-sap storage) written) count)))
                 (unless (plusp actual) (error "short adoption installation journal write"))
                 (incf written actual)
                 (physical-adoption-install-test-point point path)))))
  (values))

(defun physical-adoption-install-publish-journal (owner plan)
  (let* ((plan (physical-adoption-install-copy plan))
         (root (physical-adoption-owner-directory
                (physical-adoption-attempt-check-owner owner (getf plan :attempt))))
         (workspace (pathname (getf (getf plan :workspace) :directory)))
         (pending (merge-pathnames "journal.pending" workspace))
         (path (physical-adoption-install-path root))
         (image (physical-adoption-install-image plan 0)))
    (physical-adoption-install-validate-prepared owner plan)
    (call-with-physical-adoption-install-fd
     owner (list :plan plan :file-size 0)
     (lambda (fd file)
       (physical-adoption-install-write-bytes fd image 0 file)
       (physical-adoption-install-test-point :before-journal-file-fsync file)
       (sb-posix:fsync fd)
       (physical-adoption-install-test-point :after-journal-file-fsync file))
     :pending t)
    (physical-adoption-install-test-point :before-journal-rename path)
    (physical-adoption-install-validate-prepared owner plan)
    (physical-adoption-install-rename pending path)
    (physical-adoption-install-test-point :after-journal-rename path)
    (fsync-directory workspace)
    (physical-adoption-install-test-point :after-journal-workspace-fsync path)
    (fsync-directory root)
    (physical-adoption-install-test-point :after-journal-pgdata-fsync path)
    (let ((actual (physical-adoption-install-read owner)))
      (unless (and (equal plan (getf actual :plan)) (zerop (getf actual :step))
                   (not (getf actual :partial)))
        (error "adoption installation initial readback differs"))
      (physical-adoption-install-test-point :after-journal-readback path)
      actual)))

(defun physical-adoption-install-sync-journal (owner state)
  (let* ((plan (getf state :plan))
         (workspace (pathname (getf (getf plan :workspace) :directory)))
         (root (physical-adoption-owner-directory owner)))
    (physical-adoption-install-validate owner state)
    (call-with-physical-adoption-install-fd
     owner state (lambda (fd path) (declare (ignore path)) (sb-posix:fsync fd)))
    (fsync-directory workspace)
    (fsync-directory root)
    (unless (equal state (physical-adoption-install-read owner))
      (error "adoption installation journal changed during durability recheck"))
    state))

(defun physical-adoption-install-append-step (owner state)
  (let* ((plan (getf state :plan))
         (observed (physical-adoption-install-validate owner state))
         (step (1+ (getf state :step)))
         (last (physical-adoption-install-last-step plan))
         (root (physical-adoption-owner-directory owner)))
    (unless (and (<= step last)
                 (= observed (if (= step last) (1- last) step)))
      (error "adoption progress does not follow its verified namespace"))
    (unless (= step last)
      (physical-adoption-install-sync-move plan (1- step))
      (unless (= observed (physical-adoption-install-validate owner state))
        (error "adoption namespace changed while syncing its move")))
    (when (= step last)
      (physical-adoption-install-check-image root (getf plan :attempt) :installed t))
    (call-with-physical-adoption-install-fd
     owner state
     (lambda (fd path)
       (when (getf state :partial)
         (sb-posix:ftruncate fd (getf state :valid-length))
         (sb-posix:fsync fd)
         (physical-adoption-install-test-point :after-progress-truncate path))
       (unless (= (getf state :valid-length) (sb-posix:stat-size (sb-posix:fstat fd)))
         (error "adoption journal append position changed"))
       (physical-adoption-install-test-point :before-progress-write path)
       (physical-adoption-install-write-bytes
        fd (physical-adoption-install-step-image (getf state :body-crc) step)
        (getf state :valid-length) path :limit *physical-adoption-install-progress-write-limit*
        :point :after-progress-write-chunk)
       (physical-adoption-install-test-point :before-progress-fsync path)
       (sb-posix:fsync fd)
       (physical-adoption-install-test-point :after-progress-fsync path)))
    (let ((actual (physical-adoption-install-read owner)))
      (unless (and (equal plan (getf actual :plan)) (= step (getf actual :step))
                   (not (getf actual :partial)))
        (error "adoption installation progress readback differs"))
      (physical-adoption-install-test-point :after-progress-readback (physical-adoption-install-path root))
      actual)))
