(in-package #:pg)

(defun logical-slot-copy-source-proof-sections ()
  (list (list :installation 1 +logical-slot-copy-install-maximum-bytes+)
        (list :base-proof 1 +logical-slot-copy-base-proof-maximum-bytes+)
        (list :descriptor 1 +logical-slot-copy-descriptor-maximum-bytes+)
        (list :evidence 1 +logical-slot-copy-evidence-maximum-bytes+)
        (list :fact +physical-logical-fact-size+ +physical-logical-interval-fact-size+)
        (list :restartpoint 1 +logical-slot-copy-source-receipt-maximum-bytes+)
        (list :prefix 0 (1- +wal-segment-size+))
        (list :child-control 1 (1+ +wal-control-maximum-bytes+))))

(defun logical-slot-copy-source-proof-maximum-bytes ()
  (+ 24 (loop for section in (logical-slot-copy-source-proof-sections)
              sum (+ 4 (third section)))))

(defun logical-slot-copy-source-proof-parts (value)
  (let ((sections (logical-slot-copy-source-proof-sections)))
    (unless (and (= (* 2 (length sections))
                    (logical-slot-copy-descriptor-list-count value (* 2 (length sections))))
                 (equal (loop for key in value by #'cddr collect key)
                        (mapcar #'first sections)))
      (error "invalid permanent source proof sections"))
    (let ((parts
            (loop for (key minimum maximum) in sections
                  for bytes = (getf value key)
                  do (logical-slot-copy-descriptor-blob-size bytes minimum maximum)
                  collect bytes)))
      (values parts (+ 24 (* 4 (length sections))
                       (loop for bytes in parts sum (length bytes)))))))

(defun logical-slot-copy-source-proof-encode (value)
  (multiple-value-bind (parts size) (logical-slot-copy-source-proof-parts value)
    (let ((bytes (make-array size :element-type '(unsigned-byte 8) :initial-element 0))
          (position 20))
      (replace bytes #(80 71 76 79 71 83 79 85 82 67 69 70 65 67 84 49))
      (wal-set-u32 bytes 16 (- size 24))
      (dolist (part parts)
        (wal-set-u32 bytes position (length part))
        (incf position 4)
        (replace bytes part :start1 position)
        (incf position (length part)))
      (unless (= position (- size 4)) (error "permanent source proof size changed"))
      (wal-set-u32 bytes position (wal-crc32 bytes 0 position))
      bytes)))

(defun logical-slot-copy-source-proof-decode (bytes)
  (unless (and (typep bytes '(vector (unsigned-byte 8)))
               (<= 24 (length bytes) (logical-slot-copy-source-proof-maximum-bytes))
               (equalp (subseq bytes 0 16) #(80 71 76 79 71 83 79 85 82 67 69 70 65 67 84 49))
               (= (wal-u32 bytes 16) (- (length bytes) 24))
               (= (wal-u32 bytes (- (length bytes) 4))
                  (wal-crc32 bytes 0 (- (length bytes) 4))))
    (error "invalid permanent source proof envelope"))
  (let ((position 20) (end (- (length bytes) 4)) (value nil))
    (dolist (section (logical-slot-copy-source-proof-sections))
      (destructuring-bind (key minimum maximum) section
        (unless (<= 4 (- end position)) (error "truncated permanent source proof length"))
        (let ((size (wal-u32 bytes position)))
          (incf position 4)
          (unless (and (<= minimum size maximum) (<= size (- end position)))
            (error "invalid permanent source proof section length"))
          (setf value (list* key (subseq bytes position (+ position size)) value))
          (incf position size))))
    (setf value (loop for section in (logical-slot-copy-source-proof-sections)
                      for key = (first section)
                      append (list key (getf value key))))
    (unless (= position end) (error "trailing permanent source proof bytes"))
    (unless (equalp bytes (logical-slot-copy-source-proof-encode value))
      (error "noncanonical permanent source proof"))
    value))
