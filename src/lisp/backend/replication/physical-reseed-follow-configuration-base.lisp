(in-package #:pg)

;; Read the actual original control at its prescribed position: root before
;; its move, saved afterward.  Compare its identity and bytes with the original
;; installation evidence before decoding it.
(defun physical-reseed-follow-configuration-original-control (root-fd saved-fd value-plan value prefix)
  (multiple-value-bind (plan record) (physical-reseed-follow-configuration-install-plan value-plan value)
    (let* ((configuration (getf record :configuration))
           (maximum (if (physical-reseed-follow-configuration-selected-p
                         (physical-reseed-follow-core-projection record)) 5 4))
           (expected (assoc "physical-recovery.control" (getf plan :new) :test #'equal))
           (bytes (physical-libpq-datum-octets (getf (getf record :base) :recovery-control) +physical-recovery-control-maximum-bytes+))
           (local (getf (getf plan :attempt) :local))
           (root (physical-image-check-directory root-fd))
           (mount (physical-adoption-install-mount-id nil :directory-fd root-fd)))
      (unless (and (member (getf configuration :phase) '(:staged :installing :inert))
                   (typep prefix `(integer 0 ,maximum))
                   (= (getf local :device) (sb-posix:stat-dev root))
                   (= (getf local :inode) (sb-posix:stat-ino root)))
        (error "original control requires its bound installation root and prefix"))
      (let* ((saved (>= prefix (1- maximum)))
             (parent (if saved saved-fd root-fd))
             (leaf (if saved "recovery.original" "physical-recovery.control"))
             (stat (physical-image-check-directory parent (sb-posix:stat-dev root))))
        (when saved
          (let ((identity (getf (getf configuration :directories) :saved)))
            (unless (and (= (getf identity :device) (sb-posix:stat-dev stat))
                         (= (getf identity :inode) (sb-posix:stat-ino stat)))
              (error "saved original control directory differs from its recorded identity"))))
        (unless (= mount (physical-adoption-install-mount-id nil :directory-fd parent))
          (error "original control directory crosses the target mount"))
        (let* ((before (physical-reseed-install-old-observe parent leaf mount))
               (logical (cons "physical-recovery.control" (rest before)))
               (facts (physical-reseed-install-row-file-facts before)))
          (unless (and (= (length bytes) (seventh before))
                       (physical-reseed-install-namespace-row-matches-p expected logical t))
            (error "original recovery control differs from its original install row"))
          (call-with-physical-image-input-at
           parent leaf
           (lambda (stream)
             (let* ((fd (sb-sys:fd-stream-fd stream))
                    (actual (make-array (length bytes) :element-type '(unsigned-byte 8))))
               (unless (and (equal facts (physical-reseed-file-facts (sb-posix:fstat fd)))
                            (= mount (physical-adoption-install-mount-id nil :directory-fd fd))
                            (= (length actual) (read-sequence actual stream))
                            (eq :eof (read-byte stream nil :eof))
                            (equalp bytes actual)
                            (= (tenth expected) (physical-store-update-digest #xCBF29CE484222325 actual))
                            (equal facts (physical-reseed-file-facts (sb-posix:fstat fd)))
                            (= mount (physical-adoption-install-mount-id nil :directory-fd fd))
                            (equal before (physical-reseed-install-old-observe parent leaf mount)))
                 (error "original recovery control changed or differs from its saved bytes"))
               (let ((control (physical-recovery-decode-control actual)))
                 (unless (zerop (getf control :phase)) (error "original recovery control is not phase zero"))
                 (values control actual (append logical (list (tenth expected)))))))
           :element-type '(unsigned-byte 8)))))))

;; Verify the immutable original base with its actual original control even
;; when that control has moved aside.  The mapped namespace is proved by the
;; caller; checking the installed pending state is a separate proof.
(defun physical-reseed-follow-configuration-base-proof
    (root-fd saved-fd base-fds value-plan value prefix check)
  (multiple-value-bind (plan record) (physical-reseed-follow-configuration-install-plan value-plan value)
    (funcall check)
    (multiple-value-bind (control bytes row)
        (physical-reseed-follow-configuration-original-control root-fd saved-fd plan record prefix)
      (let ((result
              (call-with-physical-reseed-follow-held-base-directory
               root-fd (cdr (assoc :base base-fds)) (cdr (assoc :global base-fds)) (cdr (assoc :wal base-fds))
               (lambda (directory)
                 (let ((*pgdata* directory))
                   (physical-recovery-check-required-marker)
                   (multiple-value-bind (manifest digest) (recovery-read-manifest directory)
                     (unless (and (equal manifest (getf plan :manifest)) (= digest (getf plan :manifest-digest)))
                       (error "mapped original base differs from its install manifest"))
                     (multiple-value-bind (checkpoint durable snapshot insertion checkpoint-timeline namespace)
                         (wal-read-control-fields)
                       (declare (ignore checkpoint durable snapshot))
                       (let* ((*wal-segment-namespace* namespace)
                              (*wal-insert-timeline* insertion)
                              (*wal-checkpoint-timeline* checkpoint-timeline)
                              (base (physical-recovery-verify-base-control-with-namespace control)))
                         (setf (getf base :wal-namespace) namespace)
                         (authentication-check-backup-policy directory)
                         (unless (equal (physical-reseed-follow-base-projection
                                         manifest digest bytes directory (getf (getf plan :attempt) :request))
                                        (getf record :base))
                           (error "mapped original base evidence differs from the saved base"))
                         (physical-reseed-follow-check-base-intent record base directory)
                         (multiple-value-bind (binding model) (physical-reseed-follow-proof-for-base record base control)
                           (let ((images (physical-reseed-follow-configuration-images
                                          record binding model (getf (getf record :configuration) :time))))
                             (unless (equal (physical-reseed-follow-configuration-image-specifications
                                             images (physical-reseed-follow-core-projection record))
                                            (getf (getf record :configuration) :images))
                               (error "mapped original base derives different configuration images"))
                             (list base control binding model images row))))))))
               check)))
        (multiple-value-bind (after-control after-bytes after-row)
            (physical-reseed-follow-configuration-original-control root-fd saved-fd plan record prefix)
          (unless (and (equalp control after-control) (equalp bytes after-bytes) (equal row after-row))
            (error "mapped original control changed during base verification")))
        (funcall check)
        (values-list result)))))
