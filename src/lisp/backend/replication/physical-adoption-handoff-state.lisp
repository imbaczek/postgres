;;; Validate the namespace protected by a published handoff intent.
;;;
;;; Check the terminal installation, its original image, incoming tree,
;;; quarantine and immutable stage against the saved plan.  Exact PGDATA and
;;; workspace names permit the spool only at its prepared or published
;;; location.  The spool identity and empty control must match in either case.

(in-package #:pg)

(defun physical-adoption-handoff-file-fact (path maximum)
  (let* ((*pgdata* (uiop:pathname-directory-pathname path))
         (before (sb-posix:lstat (namestring path))))
    (unless (and (sb-posix:s-isreg (sb-posix:stat-mode before))
                 (= #o600 (logand #o7777 (sb-posix:stat-mode before)))
                 (= 1 (sb-posix:stat-nlink before))
                 (= (sb-posix:geteuid) (sb-posix:stat-uid before)))
      (error "adoption handoff management file is not private and owned"))
    (let ((state (physical-adoption-stage-file-state (file-namestring path) :maximum maximum)))
      (unless (equal (physical-adoption-stage-stat-identity before) (fourth state))
        (error "adoption handoff management file changed"))
      (list :device (sb-posix:stat-dev before) :inode (sb-posix:stat-ino before)
            :size (second state) :digest (third state)))))

(defun physical-adoption-handoff-read-file (owner path)
  (physical-adoption-check-owner owner)
  (let* ((before (physical-adoption-handoff-file-fact path +physical-adoption-handoff-maximum-bytes+))
         (bytes (read-bounded-regular-file path +physical-adoption-handoff-maximum-bytes+))
         (value (physical-adoption-handoff-decode bytes))
         (identity (getf value :intent-file)))
    (physical-adoption-attempt-check-owner owner (getf (getf value :installation) :attempt))
    (unless (and (equal before (physical-adoption-handoff-file-fact path +physical-adoption-handoff-maximum-bytes+))
                 (= (getf before :device) (getf identity :device))
                 (= (getf before :inode) (getf identity :inode)))
      (error "adoption handoff intent identity changed"))
    value))

(defun physical-adoption-handoff-read (owner)
  (physical-adoption-handoff-read-file owner
                                       (physical-adoption-handoff-path (physical-adoption-owner-directory owner))))

(defun physical-adoption-handoff-workspace (value)
  (pathname (getf (getf value :workspace) :directory)))

(defun physical-adoption-handoff-spool (owner value location)
  (ecase location
    (:prepared (merge-pathnames "spool/" (physical-adoption-handoff-workspace value)))
    (:ready (merge-pathnames "pg_physical_receive/" (physical-adoption-owner-directory owner)))))

(defun physical-adoption-handoff-check-workspace (owner value)
  (let* ((actual (physical-adoption-install-auxiliary-fact
                  (physical-adoption-handoff-workspace value)))
         (mount (physical-adoption-install-mount-id (physical-adoption-owner-directory owner))))
    (unless (and (equal (getf value :workspace)
                        (physical-adoption-install-persistent-fact actual :directory t))
                 (= mount (getf actual :mount)))
      (error "adoption handoff workspace identity or mount changed"))
    mount))

(defun physical-adoption-handoff-check-spool (owner value location)
  (let* ((directory (physical-adoption-handoff-spool owner value location))
         (fact (physical-adoption-install-directory-fact directory))
         (identity (getf value :spool))
         (stage (getf (getf (getf value :installation) :attempt) :stage))
         (end (getf stage :end))
         (mount (physical-adoption-handoff-check-workspace owner value)))
    (unless (and (= (getf fact :device) (getf identity :device))
                 (= (getf fact :inode) (getf identity :inode))
                 (= (getf fact :mount) mount)
                 (equal (getf value :spool-entries) (physical-adoption-install-snapshot directory)))
      (error "adoption handoff receive spool changed"))
    (let ((store (physical-store-open directory (getf stage :system-id) (getf stage :timeline)
                                      :start-lsn end :discard-tail nil :create-lock nil)))
      (unwind-protect
           (unless (and (every (lambda (position) (= end position))
                               (list (physical-store-base-lsn store) (physical-store-floor-lsn store)
                                     (physical-store-written-lsn store) (physical-store-flushed-lsn store)))
                        (every (lambda (digest) (= #xCBF29CE484222325 digest))
                               (list (physical-store-floor-digest store) (physical-store-written-digest store)
                                     (physical-store-flushed-digest store)))
                        (null (physical-store-selection store))
                        (null (physical-store-retained-root store))
                        (zerop (physical-wal-decoder-used (physical-store-decoder store))))
             (error "adoption handoff receive spool is not empty at the proved end"))
        (physical-store-close store)))
    (unless (and (equal fact (physical-adoption-install-directory-fact directory))
                 (equal (getf value :spool-entries) (physical-adoption-install-snapshot directory)))
      (error "adoption handoff receive spool changed while opening"))
    location))

(defun physical-adoption-check-preserved-trees (plan)
  (unless (physical-adoption-install-names-p
           (physical-adoption-install-directory plan :workspace)
           '(".pg_lisp.lock" "incoming" "physical-adoption.install" "quarantine"))
    (error "adoption installation workspace changed during handoff"))
  (dolist (pair (list (list :incoming nil) (list :quarantine (getf plan :old))))
    (let ((directory (physical-adoption-install-directory plan (first pair))))
      (unless (and (physical-adoption-install-names-p
                    directory (append (list ".pg_lisp.lock" "physical-adoption.install")
                                      (mapcar #'first (second pair))))
                   (equal (second pair)
                          (physical-adoption-install-snapshot
                           directory :exclude *physical-adoption-install-retained-names*)))
        (error "adoption preserved quarantine or incoming tree changed"))))
  (unless (equal (getf plan :stage-tree)
                 (physical-adoption-install-snapshot (physical-adoption-install-directory plan :stage)))
    (error "adoption immutable stage changed during handoff"))
  t)

(defun physical-adoption-check-preserved-installation (owner value)
  "Check terminal installation authority and the preserved trees it describes."
  (let* ((state (physical-adoption-install-read owner))
         (plan (getf value :installation))
         (attempt (physical-adoption-attempt-read owner))
         (normalized (copy-list attempt))
         (root (physical-adoption-owner-directory owner))
         (mount (physical-adoption-install-check-roles owner plan)))
    (setf (getf normalized :phase) :proved)
    (unless (and (equal plan (getf state :plan))
                 (= (getf state :step) (physical-adoption-install-last-step plan))
                 (not (getf state :partial))
                 (eq :installed (getf attempt :phase))
                 (equal normalized (getf plan :attempt))
                 (equal (getf value :attempt-file)
                        (physical-adoption-handoff-file-fact
                         (physical-adoption-attempt-path root) +physical-adoption-attempt-maximum-bytes+))
                 (equal (getf value :journal-file)
                        (physical-adoption-handoff-file-fact
                         (physical-adoption-install-path root) +physical-adoption-install-maximum-bytes+)))
      (error "adoption handoff lost its terminal installation authority"))
    (physical-adoption-check-preserved-trees plan)
    mount))

(defun physical-adoption-handoff-check-installation (owner value)
  (let* ((plan (getf value :installation))
         (root (physical-adoption-owner-directory owner))
         (mount (physical-adoption-check-preserved-installation owner value)))
    (let ((budget (list 100000 16777216)))
      (dolist (entry (getf plan :new))
        (unless (equal (second entry)
                       (physical-adoption-install-tree root (first entry)
                                                       (physical-adoption-owner-device owner) mount budget))
          (error "adoption installed image changed during handoff"))))
    (physical-adoption-installed-base root (getf plan :attempt))
    mount))

(defun physical-adoption-handoff-location (owner value)
  (let ((root (physical-adoption-owner-directory owner))
        (workspace (physical-adoption-handoff-workspace value))
        (root-names (append (copy-list *physical-adoption-install-root-names*)
                            (copy-list *physical-adoption-install-retained-names*)
                            (list "physical-adoption.handoff")))
        (guards '(".pg_lisp.lock" "physical-adoption.install")))
    (cond ((and (physical-adoption-install-names-p root root-names)
                (physical-adoption-install-names-p workspace (append guards (list "spool"))))
           :prepared)
          ((and (physical-adoption-install-names-p root (append root-names (list "pg_physical_receive")))
                (physical-adoption-install-names-p workspace guards))
           :ready)
          (t (error "adoption handoff has no single explained receive spool location")))))

(defun physical-adoption-handoff-validate (owner value)
  (unless (equal value (physical-adoption-handoff-read owner))
    (error "adoption handoff intent changed"))
  (let ((location (physical-adoption-handoff-location owner value))
        (mount (physical-adoption-handoff-check-installation owner value)))
    (physical-adoption-handoff-check-spool owner value location)
    (unless (and (= mount (physical-adoption-handoff-check-workspace owner value))
                 (= mount (physical-adoption-install-mount-id
                           (physical-adoption-handoff-path (physical-adoption-owner-directory owner))))
                 (eq location (physical-adoption-handoff-location owner value))
                 (equal value (physical-adoption-handoff-read owner)))
      (error "adoption handoff context changed during verification"))
    (physical-adoption-handoff-check-installation owner value)
    location))
