(in-package #:pg)

(defstruct (physical-adoption-startup-owner (:include physical-adoption-owner))
  pid-stream pid-device pid-inode)

(defun physical-adoption-check-startup-quiescence ()
  (unless (and (zerop *live-operation-depth*) (not *wal-ready*)
               (not *physical-receive-store*) (not *physical-follow-runtime*)
               (not *physical-restartpoint-worker*))
    (error "adoption startup reconciliation requires unopened storage and stopped workers")))

(defmethod physical-adoption-check-owner-role ((owner physical-adoption-startup-owner))
  (physical-adoption-check-startup-quiescence)
  (unless (and (eq (physical-adoption-owner-lock owner) *postmaster-data-lock*)
               (equal (physical-adoption-owner-directory owner) *postmaster-pid-directory*)
               (eq (physical-adoption-startup-owner-pid-stream owner) *postmaster-pid-stream*)
               *postmaster-pid-stream* (open-stream-p *postmaster-pid-stream*)
               (postmaster-pid-owned-p) (= (sb-posix:getpid) (postmaster-existing-pid)))
    (error "adoption startup no longer owns the postmaster context"))
  (let ((pid (sb-posix:lstat (namestring (postmaster-data-path "postmaster.pid"))))
        (lock (sb-posix:fstat (sb-sys:fd-stream-fd *postmaster-data-lock*))))
    (unless (and (sb-posix:s-isreg (sb-posix:stat-mode pid))
                 (= 1 (sb-posix:stat-nlink pid))
                 (= (sb-posix:geteuid) (sb-posix:stat-uid pid))
                 (= (physical-adoption-startup-owner-pid-device owner) (sb-posix:stat-dev pid))
                 (= (physical-adoption-startup-owner-pid-inode owner) (sb-posix:stat-ino pid))
                 (= (physical-adoption-owner-lock-device owner) (sb-posix:stat-dev lock))
                 (= (physical-adoption-owner-lock-inode owner) (sb-posix:stat-ino lock)))
      (error "adoption startup PID or ownership descriptor changed")))
  owner)

(defmethod physical-adoption-owner-extra-root-names ((owner physical-adoption-startup-owner))
  (physical-adoption-check-owner owner)
  (list "postmaster.pid"))

(defun call-with-physical-adoption-startup-owner (function)
  (physical-adoption-check-startup-quiescence)
  (unless (and *postmaster-data-lock* (open-stream-p *postmaster-data-lock*)
               *postmaster-pid-stream* (open-stream-p *postmaster-pid-stream*)
               (postmaster-pid-owned-p))
    (error "adoption startup requires real postmaster ownership"))
  (let* ((directory (uiop:ensure-directory-pathname (truename *pgdata*)))
         (root (sb-posix:lstat (namestring directory)))
         (lock (sb-posix:fstat (sb-sys:fd-stream-fd *postmaster-data-lock*)))
         (pid (sb-posix:fstat (sb-sys:fd-stream-fd *postmaster-pid-stream*)))
         (owner (make-physical-adoption-startup-owner
                 :directory directory :device (sb-posix:stat-dev root) :inode (sb-posix:stat-ino root)
                 :lock *postmaster-data-lock* :lock-device (sb-posix:stat-dev lock)
                 :lock-inode (sb-posix:stat-ino lock) :thread sb-thread:*current-thread* :active-p t
                 :pid-stream *postmaster-pid-stream* :pid-device (sb-posix:stat-dev pid)
                 :pid-inode (sb-posix:stat-ino pid))))
    (unwind-protect
         (progn
           (unless (zerop (physical-store-flock (sb-sys:fd-stream-fd *postmaster-data-lock*) 6))
             (error "adoption startup cannot verify exclusive data ownership"))
           (physical-adoption-check-owner owner)
           (funcall function owner))
      (setf (physical-adoption-owner-active-p owner) nil))))
