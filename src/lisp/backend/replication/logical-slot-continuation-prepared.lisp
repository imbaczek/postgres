(in-package #:pg)

(defun logical-slot-continuation-prepared-maximum-bytes ()
  (min (+ 24 #xffffffff) (+ 139 (* 2 (logical-slot-continuation-maximum-bytes)))))

(defun logical-slot-continuation-prepared-slot (bytes name)
  (let ((slot (logical-slot-state-decode bytes name)))
    (unless (and (wal-replication-slot-child-owner slot)
                 (equalp bytes (logical-slot-state-encode slot)))
      (error "prepared continuation requires a canonical P7 image"))
    slot))

(defun logical-slot-continuation-prepared-rows (rows)
  (logical-slot-copy-descriptor-list-count rows +logical-slot-continuation-obligation-limit+)
  (let ((prior nil))
    (dolist (row rows)
      (logical-slot-continuation-list row 2)
      (logical-slot-continuation-ascii-size (first row) 63)
      (logical-slot-copy-descriptor-blob-size (second row) 1 +slot-state-maximum-bytes+)
      (unless (or (null prior) (string< prior (first row)))
        (error "prepared inventory is repeated or unordered"))
      (logical-slot-continuation-prepared-slot (second row) (first row))
      (setf prior (first row))))
  rows)

(defun logical-slot-continuation-prepared-check (record)
  (logical-slot-continuation-plist
   record '(:version :kind :name :old :new :ack :restart-floor :proof-end))
  (unless (and (eql 1 (getf record :version))
               (member (getf record :kind) '(:native-ack :standard-ack)))
    (error "invalid prepared continuation operation"))
  (let* ((name (getf record :name)) (old (getf record :old)) (new (getf record :new))
                                    (name-size (logical-slot-continuation-ascii-size name 63))
                                    (old-size (nth-value 1 (logical-slot-continuation-check old)))
                                    (new-size (nth-value 1 (logical-slot-continuation-check new)))
                                    (old-rows (logical-slot-continuation-prepared-rows (getf old :slots)))
                                    (new-rows (logical-slot-continuation-prepared-rows (getf new :slots)))
                                    (before (find name old-rows :key #'first :test #'string=))
                                    (after (find name new-rows :key #'first :test #'string=))
                                    (history (logical-slot-continuation-history (getf old :history-target) (getf old :history)))
                                    (ack (getf record :ack)) (floor (getf record :restart-floor))
                                    (proof (getf record :proof-end))
                                    (size (+ 76 name-size old-size new-size)))
    (unless (and before after
                 (< (getf old :generation) #xffffffffffffffff)
                 (= (1+ (getf old :generation)) (getf new :generation))
                 (= (length old-rows) (length new-rows))
                 (every (lambda (a b) (string= (first a) (first b))) old-rows new-rows))
      (error "prepared continuation changed its generation or complete slot inventory"))
    (dolist (key '(:binding :system-id :origin :history-target :history :transfers :roots :runs :tail))
      (unless (equalp (getf old key) (getf new key))
        (error "prepared acknowledgment changed immutable continuation topology")))
    (dolist (point (list ack floor proof))
      (logical-slot-continuation-position point history (first (getf new :sealed-end)))
      (unless (or (eq :prefix-end (third point))
                  (and (eq point floor) (zerop (first floor))
                       (eq :standard-ack (getf record :kind))
                       (eq :record-start (third floor))))
        (error "prepared acknowledgment has the wrong position role")))
    (unless (and (equal proof (getf new :sealed-end))
                 (<= (first (getf old :sealed-end)) (first proof))
                 (<= (first floor) (first ack) (first proof))
                 (or (eq :standard-ack (getf record :kind)) (equal ack floor)))
      (error "prepared acknowledgment exceeds its proved positions"))
    (loop for a in old-rows for b in new-rows
          unless (string= name (first a))
            do (unless (equalp (second a) (second b))
                 (error "prepared acknowledgment changed an unrelated slot")))
    (let ((prior (logical-slot-continuation-prepared-slot (second before) name))
          (next (logical-slot-continuation-prepared-slot (second after) name)))
      (logical-slot-imported-check-state next prior history (first proof))
      (unless (and (eq :reserved (wal-replication-slot-wal-status prior))
                   (eq :reserved (wal-replication-slot-wal-status next))
                   (or (eq :native-ack (getf record :kind))
                       (and (string= "pgoutput" (wal-replication-slot-plugin prior))
                            (wal-replication-slot-confirmed-flush-lsn prior)))
                   (= (first ack) (wal-replication-slot-confirmed-flush-lsn next))
                   (eql (second ack) (wal-replication-slot-confirmed-timeline next))
                   (if (wal-replication-slot-confirmed-flush-lsn prior)
                       (> (first ack) (wal-replication-slot-confirmed-flush-lsn prior))
                       (and (= (first ack) (wal-replication-slot-consistent-lsn prior))
                            (eql (second ack)
                                 (logical-slot-provenance-birth-timeline
                                  (wal-replication-slot-logical-provenance prior)))))
                   (or (plusp (first floor))
                       (and (zerop (wal-replication-slot-restart-lsn prior))
                            (eql (second floor) (wal-replication-slot-restart-timeline prior))))
                   (<= (wal-replication-slot-restart-lsn next) (first floor)))
        (error "prepared acknowledgment changed its target or failed to advance confirmation")))
    (unless (<= size (logical-slot-continuation-prepared-maximum-bytes))
      (error "prepared continuation exceeds its byte profile"))
    (values record size)))

(defun logical-slot-continuation-prepared-classify (record observed)
  (logical-slot-continuation-prepared-check record)
  (handler-case-noninterrupt
   (progn
     (logical-slot-continuation-prepared-rows observed)
     (cond
       ((logical-slot-continuation-slot-rows-equal-p observed (getf (getf record :old) :slots)) :old)
       ((logical-slot-continuation-slot-rows-equal-p observed (getf (getf record :new) :slots)) :new)
       (t :blocked)))
   (condition :blocked)))
