(in-package #:pg)

(defun logical-slot-copy-control-fields (bytes)
  (unless (and (typep bytes '(vector (unsigned-byte 8)))
               (<= 2 (length bytes) (1+ +wal-control-maximum-bytes+))
               (= 10 (aref bytes (1- (length bytes))))
               (not (find 10 bytes :end (1- (length bytes)))))
    (error "logical copy control is not one bounded complete line"))
  (multiple-value-list (wal-decode-control-line (bytes->string bytes :end (1- (length bytes))))))

(defun logical-slot-copy-check-control-binding (descriptor manifest)
  (let* ((source (logical-slot-copy-control-fields (logical-slot-copy-descriptor-source-control descriptor)))
         (base (logical-slot-copy-control-fields (logical-slot-copy-descriptor-base-control descriptor)))
         (recovery (physical-recovery-decode-control
                    (logical-slot-copy-descriptor-recovery-control descriptor)))
         (metadata (copy-list (seventh source)))
         (reference (getf metadata :retained-reference))
         (base-bytes (logical-slot-copy-descriptor-base-control descriptor))
         (base-entry (find "global/pg_wal_control" (getf manifest :files) :key #'first :test #'equal)))
    (remf metadata :retained-reference)
    (unless (and base-entry (= (second base-entry) (length base-bytes))
                 (= (third base-entry) (physical-store-update-digest #xCBF29CE484222325 base-bytes))
                 (= (first source) (second source) (getf manifest :end))
                 (= (fourth source) (fifth source) (getf manifest :timeline))
                 (eql (getf manifest :system-id) (getf (seventh source) :system-id))
                 (= (physical-manifest-checkpoint-start manifest) (getf (third source) :start))
                 (equalp base (append (subseq source 0 6) (list metadata)))
                 (equalp (logical-slot-copy-descriptor-base-control descriptor)
                         (if reference
                             (wal-encode-control-image
                              (first source) (second source) (third source) :timeline (fourth source)
                                                                            :checkpoint-timeline (fifth source) :namespace (sixth source) :metadata metadata)
                             (logical-slot-copy-descriptor-source-control descriptor)))
                 (zerop (getf recovery :phase)) (zerop (getf recovery :manifest-digest))
                 (= (getf recovery :system-id) (getf manifest :system-id))
                 (= (getf recovery :timeline) (getf manifest :timeline))
                 (= (getf recovery :checkpoint) (getf recovery :applied) (getf manifest :end))
                 (= (getf recovery :next-xid) (getf manifest :next-xid))
                 (equalp (getf recovery :resource-fact)
                         (wal-copy-control-resource-fields (third source))))
      (error "logical copy descriptor controls differ from their immutable base")))
  t)

(defun logical-slot-copy-check-binding (descriptor manifest digest)
  (logical-slot-copy-descriptor-check descriptor)
  (recovery-check-manifest-schema manifest)
  (unless (and (equal (logical-slot-copy-descriptor-copy-id descriptor)
                      (getf manifest :logical-slot-copy-id))
               (eql digest (logical-slot-copy-descriptor-manifest-digest descriptor)))
    (error "logical copy descriptor does not match its manifest identity"))
  (logical-slot-copy-check-control-binding descriptor manifest)
  (let* ((timeline (getf manifest :timeline))
         (bytes (logical-slot-copy-descriptor-history descriptor))
         (history (timeline-check-lineage
                   (timeline-parse-history timeline (bytes->string bytes))))
         (history-entry
           (find (concatenate 'string "pg_wal/" (timeline-history-filename timeline))
                 (getf manifest :files) :key #'first :test #'equal)))
    (unless (if (= timeline 1)
                (zerop (length bytes))
                (and history-entry (= (length bytes) (second history-entry))
                     (= (third history-entry) (physical-store-update-digest #xCBF29CE484222325 bytes))))
      (error "logical copy descriptor history differs from its base"))
    (dolist (entry (logical-slot-copy-descriptor-slots descriptor))
      (let* ((slot (logical-slot-state-decode (second entry) (first entry)))
             (provenance (wal-replication-slot-logical-provenance slot)))
        (unless (and (eql (logical-slot-provenance-system-id provenance) (getf manifest :system-id))
                     (<= (wal-replication-slot-consistent-lsn slot) (getf manifest :end))
                     (<= (wal-replication-slot-restart-lsn slot) (getf manifest :end))
                     (or (null (wal-replication-slot-confirmed-flush-lsn slot))
                         (<= (wal-replication-slot-confirmed-flush-lsn slot) (getf manifest :end))))
          (error "logical copy slot is outside its captured source"))
        (logical-slot-check-primary-history slot history)))
    (dolist (piece (logical-slot-copy-descriptor-wal-pieces descriptor))
      (unless (and (= (first piece) (logical-wal-segment-carrier (second piece) history))
                   (<= (sixth piece) (getf manifest :end)))
        (error "logical copy WAL piece is outside its selected history"))))
  descriptor)

(defun logical-slot-copy-check-readback (owner context manifest metadata descriptor descriptor-p)
  (let* ((root (physical-image-context-root-path context))
         (files (getf manifest :files))
         (pieces (logical-slot-copy-descriptor-wal-pieces descriptor))
         (rows (append files
                       (loop for (name bytes) in metadata
                             collect (list name (length bytes)
                                           (physical-store-update-digest #xCBF29CE484222325 bytes)))
                       (loop for (timeline segment size digest) in pieces
                             collect (list (logical-slot-copy-piece-path timeline segment) size digest)))))
    (logical-slot-copy-target-inventory owner context files pieces descriptor-p)
    (let ((observations
            (loop for row in rows
                  for actual = (logical-slot-copy-file-row context (first row))
                  do (unless (equal (subseq actual 0 3) row)
                       (error "logical copy target readback differs from its expected image"))
                  collect actual)))
      (let ((*pgdata* root) (*physical-image-context* context))
        (recovery-check-image-metadata manifest root)
        (authentication-check-backup-policy root))
      observations)))

(defun logical-slot-copy-check-observations (owner context observations)
  (logical-slot-copy-check-target owner context)
  (dolist (row observations)
    (multiple-value-bind (parent leaf) (physical-image-parent context (first row))
      (unless (equal (fourth row) (physical-image-file-facts parent leaf))
        (error "logical copy verified target changed before publication"))))
  t)
