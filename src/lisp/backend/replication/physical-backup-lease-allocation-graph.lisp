(in-package #:pg)

(defun physical-backup-lease-allocation-check-parent (record parents)
  (let* ((checked (physical-backup-lease-allocation-copy record))
         (request (getf checked :request))
         (parent (gethash (getf request :name) parents))
         (base (getf parent :base))
         (coordinates (getf checked :coordinates)))
    (unless (and parent (equal request (getf parent :request))
                 (member (getf parent :phase) '(:ready :interrupted :closing :closed))
                 base
                 (= (getf base :base) (getf coordinates :base))
                 (= (getf base :manifest-digest) (getf coordinates :manifest-digest))
                 (not (gethash (getf checked :name) parents)))
      (error "backup lease allocation differs from its completed parent"))
    checked))

(defun physical-backup-lease-allocation-check-history (parent records)
  (let ((history (sort (copy-list records) #'< :key (lambda (row) (getf row :generation)))))
    (loop with previous = nil
          for row in history
          for expected from 1
          do (unless (and (= expected (getf row :generation))
                          (or (null previous) (eq :canceled (getf previous :state))))
               (error "backup lease allocation history has a gap or an active predecessor"))
             (setf previous row))
    (when (eq :handed-off (getf parent :outcome))
      (let ((selected (car (last history))))
        (unless (and selected (eq :live (getf selected :state))
                     (equal (getf selected :name) (getf (getf parent :successor) :name)))
          (error "backup lease handoff differs from its live allocation")))))
  (values))

(defun physical-backup-lease-allocation-check-graph (parents allocations)
  (unless (and (typep *physical-backup-lease-allocation-limit* '(integer 0 65536))
               (<= (hash-table-count allocations) *physical-backup-lease-allocation-limit*))
    (error "backup lease allocation graph exceeds capacity"))
  (let ((checked-parents (make-hash-table :test #'equal))
        (successors (make-hash-table :test #'equal))
        (histories (make-hash-table :test #'equal)))
    (maphash
     (lambda (name record)
       (let ((parent (physical-backup-lease-copy record)))
         (unless (equal name (getf (getf parent :request) :name))
           (error "backup lease graph key differs from its parent"))
         (setf (gethash name checked-parents) parent)
         (let ((successor (getf (getf parent :successor) :name)))
           (when successor
             (when (gethash successor successors)
               (error "backup lease graph shares a historical successor"))
             (setf (gethash successor successors) name)))))
     parents)
    (maphash
     (lambda (name record)
       (let* ((row (physical-backup-lease-allocation-check-parent record checked-parents))
              (parent-name (getf (getf row :request) :name))
              (historical-owner (gethash name successors)))
         (unless (and (equal name (getf row :name))
                      (or (null historical-owner) (equal historical-owner parent-name)))
           (error "backup lease allocation name belongs to another owner"))
         (push row (gethash parent-name histories))))
     allocations)
    (maphash
     (lambda (name rows)
       (physical-backup-lease-allocation-check-history (gethash name checked-parents) rows))
     histories)
    histories))