(in-package #:pg)

(defun logical-slot-copy-cold-control-bind-data (owner context binding)
  (logical-slot-copy-check-input owner context)
  (when (getf binding :data-observations) (error "cold data inventory is already bound"))
  (let ((rows nil)
        (base (cdr (assoc "base" (physical-image-context-children context) :test #'equal))))
    (dolist (entry (append (getf (getf binding :metadata) :forks) '(("pg_xact" 0))))
      (multiple-value-bind (parent leaf) (physical-image-parent context (first entry))
        (let ((facts (physical-image-file-facts parent leaf)))
          (unless (and (logical-slot-copy-import-control-private-facts-p
                        facts (physical-image-file-facts (physical-image-context-root-fd context)))
                       (>= (sixth facts) (second entry)))
            (error "cold R data file is not private or is truncated"))
          (push (list (copy-seq (first entry)) facts) rows))))
    (logical-slot-copy-check-input owner context)
    (list* :data-observations (nreverse rows)
           :data-directory-facts (physical-image-file-facts base) binding)))

(defun logical-slot-copy-cold-control-check-data (attempt)
  (let* ((context (logical-slot-copy-cold-control-attempt-context attempt))
         (binding (logical-slot-copy-cold-control-attempt-binding attempt))
         (base (cdr (assoc "base" (physical-image-context-children context) :test #'equal))))
    (unless (and (getf binding :data-observations)
                 (equal (getf binding :data-directory-facts) (physical-image-file-facts base))
                 (equal (physical-image-file-facts base)
                        (physical-image-file-facts (physical-image-context-root-fd context) "base")))
      (error "cold R data directory changed"))
    (dolist (row (getf binding :data-observations))
      (multiple-value-bind (parent leaf) (physical-image-parent context (first row))
        (unless (equal (second row) (physical-image-file-facts parent leaf))
          (error "cold R data file changed")))))
  t)

(defun logical-slot-copy-cold-control-sync-one-data (context row mark-started)
  (declare (notinline physical-image-openat sb-posix:fsync sb-posix:close))
  (multiple-value-bind (parent leaf) (physical-image-parent context (first row))
    (let ((fd nil) (complete nil) (facts (second row)))
      (sb-sys:without-interrupts
        (unwind-protect
             (progn
               (setf fd (physical-image-openat
                         parent leaf (logior sb-posix:o-rdonly sb-posix:o-nofollow
                                             sb-posix:o-nonblock +postmaster-o-cloexec+) 0))
               (when (minusp fd) (setf fd nil) (error "cannot open cold R data file for sync"))
               (unless (and (equal facts (physical-image-file-facts fd))
                            (equal facts (physical-image-file-facts parent leaf))
                            (logical-slot-copy-import-control-private-facts-p
                             facts (physical-image-file-facts parent)))
                 (error "cold data sync differs from its bound inode"))
               (funcall mark-started)
               (sb-posix:fsync fd)
               (unless (and (equal facts (physical-image-file-facts fd))
                            (equal facts (physical-image-file-facts parent leaf)))
                 (error "cold data inode changed across sync"))
               (setf complete t))
          (when fd
            (let ((closing fd) (failure nil))
              (setf fd nil)
              (handler-case (sb-posix:close closing) (error (condition) (setf failure condition)))
              (when (and complete failure) (error failure)))))))))

(defun logical-slot-copy-cold-control-sync-data (attempt runtime)
  (declare (notinline sb-posix:fsync))
  (logical-slot-copy-cold-control-runtime-record attempt runtime)
  (let* ((binding (logical-slot-copy-cold-control-attempt-binding attempt))
         (context (logical-slot-copy-cold-control-attempt-context attempt))
         (mark-started (logical-slot-copy-cold-control-attempt-mark-started attempt)))
    (unless (and (eq :parent (logical-slot-copy-cold-control-runtime-phase runtime))
                 (logical-slot-copy-cold-control-runtime-child-complete runtime)
                 (equalp (getf binding :catalog) (logical-slot-copy-cold-control-runtime-catalog-bytes runtime)))
      (error "cold data sync requires restored R catalog and complete child"))
    (funcall (logical-slot-copy-cold-control-attempt-source-check attempt))
    (logical-slot-copy-cold-control-check-data attempt)
    (unless (equalp (getf binding :catalog)
                    (logical-slot-copy-cold-wal-read
                     (logical-slot-copy-cold-control-runtime-global runtime) "pg_catalog.dat"
                     (logical-slot-copy-cold-control-runtime-catalog-facts runtime)
                     (length (getf binding :catalog))))
      (error "cold data sync catalog differs from selected R"))
    (dolist (row (append (getf binding :data-observations)
                         (list (list "global/pg_catalog.dat"
                                     (logical-slot-copy-cold-control-runtime-catalog-facts runtime)))))
      (logical-slot-copy-verification-test-point :before-cold-control-data-sync context)
      (logical-slot-copy-cold-control-sync-one-data context row mark-started)
      (logical-slot-copy-verification-test-point :after-cold-control-data-sync context))
    (dolist (fd (list (cdr (assoc "base" (physical-image-context-children context) :test #'equal))
                      (logical-slot-copy-cold-control-runtime-global runtime)
                      (physical-image-context-root-fd context)))
      (sb-sys:without-interrupts (funcall mark-started) (sb-posix:fsync fd)))
    (logical-slot-copy-cold-control-check-data attempt)
    (funcall (logical-slot-copy-cold-control-attempt-source-check attempt))
    (setf (logical-slot-copy-cold-control-runtime-data-synced runtime) t)))
