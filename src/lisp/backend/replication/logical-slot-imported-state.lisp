(in-package #:pg)

(defun logical-slot-imported-check-progress (current baseline history)
  (let* ((cause (logical-slot-effective-invalidation-cause baseline))
         (next-cause (logical-slot-effective-invalidation-cause current))
         (prior (wal-replication-slot-confirmed-flush-lsn baseline))
         (confirmed (wal-replication-slot-confirmed-flush-lsn current))
         (owner (wal-replication-slot-confirmed-timeline current))
         (birth (wal-replication-slot-consistent-lsn baseline)))
    (unless (and (>= (wal-replication-slot-restart-lsn current)
                     (wal-replication-slot-restart-lsn baseline))
                 (cond
                   ((null confirmed) (null prior))
                   ((and prior (= prior confirmed))
                    (eql owner (wal-replication-slot-confirmed-timeline baseline)))
                   ((or (null prior) (> confirmed prior))
                    (eql owner
                         (if (and (null prior) (= confirmed birth))
                             (logical-slot-provenance-birth-timeline
                              (wal-replication-slot-logical-provenance baseline))
                             (logical-slot-prefix-timeline confirmed history))))
                   (t nil)))
      (error "imported logical slot progress regressed or changed its confirmation owner"))
    (unless (or (eq cause :none)
                (and (eq cause next-cause)
                     (eql prior confirmed)
                     (eql (wal-replication-slot-confirmed-timeline baseline) owner)
                     (eql (wal-replication-slot-restart-lsn baseline)
                          (wal-replication-slot-restart-lsn current))
                     (eql (wal-replication-slot-restart-timeline baseline)
                          (wal-replication-slot-restart-timeline current))))
      (error "imported logical slot changed its original terminal cause or progress"))))

(defun logical-slot-imported-check-state (current baseline history end)
  (unless (and (logical-slot-state-valid-p current)
               (logical-slot-state-valid-p baseline)
               (wal-replication-slot-child-owner baseline)
               (wal-replication-slot-logical-provenance baseline)
               (logical-slot-state-identity-equal-p current baseline)
               (typep end '(unsigned-byte 64)))
    (error "imported logical slot differs from its certified immutable origin"))
  (wal-require-logical-slot baseline)
  (wal-require-logical-slot current)
  (timeline-check-lineage history)
  (logical-slot-check-primary-history baseline history)
  (logical-slot-check-primary-history current history)
  (unless (and (<= (wal-replication-slot-consistent-lsn current) end)
               (<= (wal-replication-slot-restart-lsn current) end)
               (or (null (wal-replication-slot-confirmed-flush-lsn current))
                   (<= (wal-replication-slot-confirmed-flush-lsn current) end)))
    (error "imported logical slot progress exceeds the frozen durable end"))
  (logical-slot-imported-check-progress current baseline history)
  current)