(in-package #:pg)

(defconstant +logical-slot-copy-descriptor-maximum-bytes+ (* 32 1024 1024))
(defconstant +logical-slot-copy-descriptor-maximum-slots+ 1024)
(defconstant +logical-slot-copy-descriptor-maximum-wal-pieces+ 65536)

(defstruct logical-slot-copy-descriptor
  copy-id manifest-digest source-control base-control recovery-control history slots wal-pieces)

(defun logical-slot-copy-descriptor-list-count (value maximum)
  (loop with rest = value
        for count from 0
        do (when (null rest) (return count))
           (unless (and (< count maximum) (consp rest))
             (error "invalid or oversized logical copy descriptor list"))
           (setf rest (cdr rest))))

(defun logical-slot-copy-descriptor-blob-size (bytes minimum maximum)
  (unless (and (typep bytes '(vector (unsigned-byte 8)))
               (<= minimum (length bytes) maximum))
    (error "invalid logical copy descriptor blob"))
  (length bytes))

(defun logical-slot-copy-descriptor-piece-key-less-p (left right)
  (or (< (first left) (first right))
      (and (= (first left) (first right)) (< (second left) (second right)))))

(defun logical-slot-copy-descriptor-check-piece (piece)
  (unless (= 6 (logical-slot-copy-descriptor-list-count piece 6))
    (error "invalid logical copy WAL piece"))
  (destructuring-bind (timeline segment size digest start end) piece
    (unless (and (typep timeline '(integer 1 4294967295))
                 (typep segment '(unsigned-byte 64))
                 (typep size '(integer 1 *)) (<= size +wal-segment-size+)
                 (typep digest '(unsigned-byte 64))
                 (typep start '(unsigned-byte 64)) (typep end '(unsigned-byte 64))
                 (<= (* segment +wal-segment-size+) start end
                     (+ (* segment +wal-segment-size+) size))
                 (<= (+ (* segment +wal-segment-size+) size) (1- (ash 1 64))))
      (error "invalid logical copy WAL piece interval")))
  piece)

(defun logical-slot-copy-descriptor-check (descriptor)
  (unless (logical-slot-copy-descriptor-p descriptor)
    (error "invalid logical copy descriptor"))
  (logical-slot-parse-generation (logical-slot-copy-descriptor-copy-id descriptor))
  (unless (typep (logical-slot-copy-descriptor-manifest-digest descriptor) '(unsigned-byte 64))
    (error "invalid logical copy manifest digest"))
  (let ((size 88) (previous-name nil) (previous-piece nil))
    (incf size (logical-slot-copy-descriptor-blob-size
                (logical-slot-copy-descriptor-source-control descriptor)
                1 (1+ +wal-control-maximum-bytes+)))
    (incf size (logical-slot-copy-descriptor-blob-size
                (logical-slot-copy-descriptor-base-control descriptor)
                1 (1+ +wal-control-maximum-bytes+)))
    (incf size (logical-slot-copy-descriptor-blob-size
                (logical-slot-copy-descriptor-recovery-control descriptor)
                1 +physical-recovery-control-maximum-bytes+))
    (incf size (logical-slot-copy-descriptor-blob-size
                (logical-slot-copy-descriptor-history descriptor)
                0 +physical-store-history-maximum-bytes+))
    (logical-slot-copy-descriptor-list-count
     (logical-slot-copy-descriptor-slots descriptor) +logical-slot-copy-descriptor-maximum-slots+)
    (dolist (entry (logical-slot-copy-descriptor-slots descriptor))
      (unless (= 2 (logical-slot-copy-descriptor-list-count entry 2))
        (error "invalid logical copy slot entry"))
      (destructuring-bind (name bytes) entry
        (unless (and (slot-state-valid-name-p name)
                     (or (null previous-name) (string< previous-name name)))
          (error "logical copy slot names are not strictly ordered"))
        (incf size (+ 5 (length name)
                      (logical-slot-copy-descriptor-blob-size bytes 1 +slot-state-maximum-bytes+)))
        (unless (wal-replication-slot-logical-provenance (logical-slot-state-decode bytes name))
          (error "logical copy requires known logical slot provenance"))
        (setf previous-name name)))
    (logical-slot-copy-descriptor-list-count
     (logical-slot-copy-descriptor-wal-pieces descriptor)
     +logical-slot-copy-descriptor-maximum-wal-pieces+)
    (dolist (piece (logical-slot-copy-descriptor-wal-pieces descriptor))
      (logical-slot-copy-descriptor-check-piece piece)
      (unless (or (null previous-piece)
                  (logical-slot-copy-descriptor-piece-key-less-p previous-piece piece))
        (error "logical copy WAL pieces are not strictly ordered"))
      (incf size 40)
      (setf previous-piece piece))
    (unless (<= size +logical-slot-copy-descriptor-maximum-bytes+)
      (error "logical copy descriptor exceeds its reopen bound"))
    size))

(defun logical-slot-copy-descriptor-encode (descriptor)
  (let* ((size (logical-slot-copy-descriptor-check descriptor))
         (bytes (make-array size :element-type '(unsigned-byte 8) :initial-element 0))
         (position 20))
    (replace bytes #(80 71 76 79 71 73 67 65 76 67 79 80 89 49 0 0))
    (wal-set-u32 bytes 16 (- size 24))
    (labels ((u32 (value) (wal-set-u32 bytes position value) (incf position 4))
             (u64 (value) (wal-set-u64 bytes position value) (incf position 8))
             (text (value)
               (loop for character across value
                     do (setf (aref bytes position) (char-code character)) (incf position)))
             (blob (value)
               (u32 (length value))
               (replace bytes value :start1 position)
               (incf position (length value))))
      (text (logical-slot-copy-descriptor-copy-id descriptor))
      (u64 (logical-slot-copy-descriptor-manifest-digest descriptor))
      (blob (logical-slot-copy-descriptor-source-control descriptor))
      (blob (logical-slot-copy-descriptor-base-control descriptor))
      (blob (logical-slot-copy-descriptor-recovery-control descriptor))
      (blob (logical-slot-copy-descriptor-history descriptor))
      (u32 (length (logical-slot-copy-descriptor-slots descriptor)))
      (dolist (entry (logical-slot-copy-descriptor-slots descriptor))
        (setf (aref bytes position) (length (first entry)))
        (incf position)
        (text (first entry))
        (blob (second entry)))
      (u32 (length (logical-slot-copy-descriptor-wal-pieces descriptor)))
      (dolist (piece (logical-slot-copy-descriptor-wal-pieces descriptor))
        (destructuring-bind (timeline segment raw-size digest start end) piece
          (u32 timeline) (u64 segment) (u32 raw-size) (u64 digest) (u64 start) (u64 end))))
    (unless (= position (- size 4)) (error "logical copy descriptor length changed"))
    (wal-set-u32 bytes position (wal-crc32 bytes))
    bytes))

(defun logical-slot-copy-descriptor-check-envelope (bytes)
  (unless (and (typep bytes '(vector (unsigned-byte 8)))
               (<= 24 (length bytes) +logical-slot-copy-descriptor-maximum-bytes+)
               (equalp (subseq bytes 0 16) #(80 71 76 79 71 73 67 65 76 67 79 80 89 49 0 0))
               (= (wal-u32 bytes 16) (- (length bytes) 24)))
    (error "invalid logical copy descriptor envelope"))
  (let ((copy (copy-seq bytes)) (offset (- (length bytes) 4)))
    (wal-set-u32 copy offset 0)
    (unless (= (wal-u32 bytes offset) (wal-crc32 copy))
      (error "logical copy descriptor checksum mismatch")))
  bytes)

(defun logical-slot-copy-descriptor-decode (bytes)
  (logical-slot-copy-descriptor-check-envelope bytes)
  (let ((position 20) (end (- (length bytes) 4)))
    (labels ((take (count)
               (unless (<= count (- end position))
                 (error "truncated logical copy descriptor"))
               (prog1 position (incf position count)))
             (u32 () (wal-u32 bytes (take 4)))
             (u64 () (wal-u64 bytes (take 8)))
             (text (count)
               (map 'string #'code-char (subseq bytes (take count) position)))
             (blob (minimum maximum)
               (let ((size (u32)))
                 (unless (<= minimum size maximum) (error "oversized logical copy descriptor blob"))
                 (subseq bytes (take size) position)))
             (entry-count (maximum)
               (let ((value (u32)))
                 (unless (<= value maximum) (error "oversized logical copy descriptor inventory"))
                 value)))
      (let* ((copy-id (text 32)) (digest (u64))
                                 (source (blob 1 (1+ +wal-control-maximum-bytes+)))
                                 (base (blob 1 (1+ +wal-control-maximum-bytes+)))
                                 (recovery (blob 1 +physical-recovery-control-maximum-bytes+))
                                 (history (blob 0 +physical-store-history-maximum-bytes+))
                                 (slots
                                   (loop repeat (entry-count +logical-slot-copy-descriptor-maximum-slots+)
                                         collect (let ((size (aref bytes (take 1))))
                                                   (unless (<= 1 size 63) (error "invalid logical copy slot name size"))
                                                   (list (text size) (blob 1 +slot-state-maximum-bytes+)))))
                                 (pieces
                                   (loop repeat (entry-count +logical-slot-copy-descriptor-maximum-wal-pieces+)
                                         collect (list (u32) (u64) (u32) (u64) (u64) (u64))))
                                 (descriptor
                                   (make-logical-slot-copy-descriptor
                                    :copy-id copy-id :manifest-digest digest :source-control source :base-control base
                                    :recovery-control recovery :history history :slots slots :wal-pieces pieces)))
        (unless (= position end) (error "trailing logical copy descriptor data"))
        (unless (equalp bytes (logical-slot-copy-descriptor-encode descriptor))
          (error "noncanonical logical copy descriptor"))
        descriptor))))
