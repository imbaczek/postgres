(in-package #:pg)

(defun physical-adoption-install-check-attempt-publication (owner state previous candidate)
  (let* ((observed (physical-adoption-install-validate owner state))
         (plan (getf state :plan))
         (last (physical-adoption-install-last-step plan))
         (pair (list (getf previous :phase) (getf candidate :phase))))
    (unless (and previous (equal previous (physical-adoption-attempt-read owner))
                 (or (and (equal pair '(:proved :installing))
                          (zerop (getf state :step)) (zerop observed) (not (getf state :partial)))
                     (and (equal pair '(:installing :installed))
                          (= (getf state :step) last) (= observed (1- last)))))
      (error "adoption journal does not authorize this attempt phase publication"))
    (physical-adoption-attempt-check-transition previous candidate)
    (physical-adoption-install-directory plan :workspace)))

(defun physical-adoption-install-publish-attempt (owner candidate previous supplied-state)
  (let* ((candidate (physical-adoption-attempt-copy candidate))
         (previous (physical-adoption-attempt-copy previous))
         (state (physical-adoption-install-read owner))
         (root (physical-adoption-owner-directory
                (physical-adoption-attempt-check-owner owner candidate)))
         (workspace (physical-adoption-install-directory (getf state :plan) :workspace))
         (pending (merge-pathnames "attempt.pending" workspace))
         (path (physical-adoption-attempt-path root))
         (image (physical-adoption-attempt-image candidate))
         (created nil))
    (unless (equal supplied-state state) (error "adoption installation authority changed"))
    (physical-adoption-install-check-attempt-publication owner state previous candidate)
    (when (member "attempt.pending" (physical-adoption-install-entry-names workspace) :test #'equal)
      (physical-adoption-install-test-point :before-attempt-scratch-unlink pending)
      (physical-adoption-install-check-attempt-publication owner state previous candidate)
      (sb-posix:unlink (namestring pending))
      (fsync-directory workspace)
      (physical-adoption-install-test-point :after-attempt-scratch-unlink pending))
    (let ((fd (sb-posix:open (namestring pending)
                             (logior sb-posix:o-rdwr sb-posix:o-creat sb-posix:o-excl
                                     sb-posix:o-nofollow +postmaster-o-cloexec+) #o600)))
      (unwind-protect
           (progn
             (sb-posix:fchmod fd #o600)
             (let ((stat (sb-posix:fstat fd)))
               (setf created (list (sb-posix:stat-dev stat) (sb-posix:stat-ino stat))))
             (physical-adoption-install-write-bytes fd image 0 pending :point :after-attempt-write-chunk :limit *physical-adoption-install-attempt-write-limit*)
             (physical-adoption-attempt-test-point :before-file-fsync path)
             (physical-adoption-install-test-point :before-attempt-file-fsync path)
             (sb-posix:fsync fd)
             (physical-adoption-attempt-test-point :after-file-fsync path)
             (physical-adoption-install-test-point :after-attempt-file-fsync path))
        (sb-posix:close fd)))
    (physical-adoption-attempt-test-point :before-rename path)
    (physical-adoption-install-test-point :before-attempt-rename path)
    (physical-adoption-install-check-attempt-publication owner state previous candidate)
    (let ((stat (sb-posix:lstat (namestring pending))))
      (unless (and (equal created (list (sb-posix:stat-dev stat) (sb-posix:stat-ino stat)))
                   (equalp image (read-bounded-regular-file pending +physical-adoption-attempt-maximum-bytes+)))
        (error "adoption attempt output changed before phase publication")))
    (sb-posix:rename (namestring pending) (namestring path))
    (physical-adoption-attempt-test-point :after-rename path)
    (physical-adoption-install-test-point :after-attempt-rename path)
    (fsync-directory workspace)
    (physical-adoption-install-test-point :after-attempt-workspace-fsync path)
    (fsync-directory root)
    (physical-adoption-install-test-point :after-attempt-pgdata-fsync path)
    (physical-adoption-attempt-test-point :after-directory-fsync path)
    (physical-adoption-attempt-test-point :before-readback path)
    (let ((actual (physical-adoption-attempt-read owner)))
      (unless (equal candidate actual) (error "adoption installation attempt readback differs"))
      (physical-adoption-attempt-test-point :after-readback path)
      (physical-adoption-install-test-point :after-attempt-readback path)
      actual)))

(defun physical-adoption-install-publish-phase (owner state phase)
  (let* ((previous (physical-adoption-attempt-read owner))
         (candidate (copy-list previous)))
    (setf (getf candidate :phase) phase)
    (physical-adoption-attempt-publish owner candidate :previous previous :install-state state)))

(defun physical-adoption-install-move (plan index)
  (let ((old (length (getf plan :old))))
    (if (< index old)
        (values (physical-adoption-install-directory plan :root)
                (physical-adoption-install-directory plan :quarantine)
                (nth index (getf plan :old)) :evacuation)
        (values (physical-adoption-install-directory plan :incoming)
                (physical-adoption-install-directory plan :root)
                (nth (- index old) (getf plan :new)) :installation))))

(defun physical-adoption-install-sync-move (plan index)
  (multiple-value-bind (from to entry kind) (physical-adoption-install-move plan index)
    (declare (ignore kind))
    (fsync-directory from)
    (physical-adoption-install-test-point :after-move-source-fsync
                                          (physical-adoption-install-entry-path from (first entry)))
    (fsync-directory to)
    (physical-adoption-install-test-point :after-move-target-fsync
                                          (physical-adoption-install-entry-path to (first entry)))))

(defun physical-adoption-install-resume (owner)
  (let* ((state (physical-adoption-install-read owner))
         (plan (getf state :plan))
         (moves (1- (physical-adoption-install-last-step plan))))
    (physical-adoption-install-sync-journal owner state)
    (when (eq :proved (getf (physical-adoption-attempt-read owner) :phase))
      (physical-adoption-install-publish-phase owner state :installing))
    (loop
      for step = (getf state :step)
      for observed = (physical-adoption-install-validate owner state)
      do (cond
           ((= step (1+ moves))
            (when (eq :installing (getf (physical-adoption-attempt-read owner) :phase))
              (physical-adoption-install-publish-phase owner state :installed))
            (physical-adoption-install-validate owner state)
            (return state))
           ((> observed step)
            (setf state (physical-adoption-install-append-step owner state)))
           ((< step moves)
            (multiple-value-bind (from to entry kind) (physical-adoption-install-move plan step)
              (let ((source (physical-adoption-install-entry-path from (first entry)))
                    (target (physical-adoption-install-entry-path to (first entry))))
                (physical-adoption-install-test-point
                 (if (eq kind :evacuation) :before-evacuation-rename :before-installation-rename) source)
                (unless (= step (physical-adoption-install-validate owner state))
                  (error "adoption namespace advanced before its planned move"))
                (physical-adoption-install-rename source target)
                (physical-adoption-install-test-point
                 (if (eq kind :evacuation) :after-evacuation-rename :after-installation-rename) target)
                (setf state (physical-adoption-install-append-step owner state)))))
           (t
            (physical-adoption-install-test-point :before-installed-verification
                                                  (physical-adoption-owner-directory owner))
            (setf state (physical-adoption-install-append-step owner state)))))))

(defun physical-adoption-install-start (owner directory &key client)
  (physical-adoption-install-prepare owner directory :client client)
  (physical-adoption-install-resume owner))
