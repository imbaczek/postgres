(in-package #:pg)

(defconstant +logical-slot-copy-install-maximum-bytes+
  (+ 240 +logical-slot-copy-import-maximum-bytes+
     (* +logical-slot-copy-descriptor-maximum-slots+ 115)))

(defun logical-slot-copy-install-identity-keys ()
  '(:container :slot-root :slot-work :slot-container :journal :pending-file :active-file))

(defun logical-slot-copy-install-check-identity (identity)
  (unless (and (= 3 (logical-slot-copy-descriptor-list-count identity 3))
               (every (lambda (number) (typep number '(unsigned-byte 64))) identity)
               (plusp (second identity)) (plusp (third identity)))
    (error "invalid logical slot installation inode identity"))
  identity)

(defun logical-slot-copy-install-active-image (certificate)
  (unless (eq :pending (getf certificate :phase))
    (error "logical slot installation requires its original pending certificate"))
  (let ((active (copy-list certificate)))
    (setf (getf active :phase) :active)
    (logical-slot-copy-import-image active)))

(defun logical-slot-copy-install-parts (value)
  (unless (and (= 22 (logical-slot-copy-descriptor-list-count value 22))
               (equal (loop for key in value by #'cddr collect key)
                      '(:certificate :evidence-digest :stage-id :container :slot-root :slot-work
                        :slot-container :journal :pending-file :active-file :entries))
               (typep (getf value :evidence-digest) '(unsigned-byte 64)))
    (error "invalid logical slot installation fields"))
  (let* ((bytes (getf value :certificate))
         (certificate (logical-slot-copy-import-decode bytes))
         (token (getf value :stage-id))
         (stage (logical-slot-parse-generation token))
         (identities (loop for key in (logical-slot-copy-install-identity-keys)
                           collect (logical-slot-copy-install-check-identity (getf value key))))
         (entries (getf value :entries))
         (seen (make-hash-table :test #'equal))
         (size (+ 240 (length bytes))))
    (logical-slot-copy-install-active-image certificate)
    (unless (and (equal token (logical-slot-generation-token stage))
                 (not (member token (list (getf certificate :copy-id) (getf certificate :owner))
                              :test #'equal))
                 (not (member token (getf certificate :slots) :key #'second :test #'equal))
                 (= (logical-slot-copy-descriptor-list-count
                     entries +logical-slot-copy-descriptor-maximum-slots+)
                    (length (getf certificate :slots))))
      (error "logical slot installation stage or row count differs"))
    (labels ((same-mount (identity expected)
               (unless (and (= (first identity) (first expected))
                            (= (third identity) (third expected)))
                 (error "logical slot installation inode is on a different mount")))
             (distinct (identity)
               (let ((key (subseq identity 0 2)))
                 (when (or (gethash key seen)
                           (equal key (list (getf certificate :device) (getf certificate :inode))))
                   (error "logical slot installation aliases another recorded inode"))
                 (setf (gethash key seen) t))))
      (dolist (identity identities) (distinct identity))
      (let ((container (getf value :container)) (slot-root (getf value :slot-root)))
        (unless (= (first container) (getf certificate :device))
          (error "logical slot installation journal is outside its recorded PGDATA device"))
        (dolist (key '(:journal :pending-file :active-file))
          (same-mount (getf value key) container))
        (dolist (key '(:slot-work :slot-container))
          (same-mount (getf value key) slot-root))
        (loop for row in entries for source in (getf certificate :slots)
              do (unless (and (= 3 (logical-slot-copy-descriptor-list-count row 3))
                              (slot-state-valid-name-p (first row))
                              (equal (first row) (first source)))
                   (error "logical slot installation row differs from its certificate"))
                 (dolist (identity (rest row))
                   (logical-slot-copy-install-check-identity identity)
                   (same-mount identity slot-root)
                   (distinct identity))
                 (incf size (+ 52 (length (first row)))))))
    (unless (<= size +logical-slot-copy-install-maximum-bytes+)
      (error "logical slot installation exceeds its encoded bound"))
    (values certificate size)))

(defun logical-slot-copy-install-encode (value)
  (multiple-value-bind (certificate size) (logical-slot-copy-install-parts value)
    (declare (ignore certificate))
    (let ((bytes (make-array size :element-type '(unsigned-byte 8) :initial-element 0))
          (position 20))
      (replace bytes #(80 71 76 79 71 83 76 79 84 73 78 83 84 65 76 49))
      (wal-set-u32 bytes 16 (- size 24))
      (labels ((u32 (number) (wal-set-u32 bytes position number) (incf position 4))
               (u64 (number) (wal-set-u64 bytes position number) (incf position 8))
               (inode-id (value) (dolist (number value) (u64 number)))
               (text (value)
                 (loop for character across value
                       do (setf (aref bytes position) (char-code character)) (incf position))))
        (let ((certificate (getf value :certificate)))
          (u32 (length certificate))
          (replace bytes certificate :start1 position)
          (incf position (length certificate)))
        (u64 (getf value :evidence-digest))
        (text (getf value :stage-id))
        (dolist (key (logical-slot-copy-install-identity-keys)) (inode-id (getf value key)))
        (u32 (length (getf value :entries)))
        (dolist (row (getf value :entries))
          (u32 (length (first row))) (text (first row))
          (inode-id (second row)) (inode-id (third row))))
      (unless (= position (- size 4)) (error "logical slot installation size changed"))
      (wal-set-u32 bytes position (wal-crc32 bytes 0 position))
      bytes)))

(defun logical-slot-copy-install-decode (bytes)
  (unless (and (typep bytes '(vector (unsigned-byte 8)))
               (<= 240 (length bytes) +logical-slot-copy-install-maximum-bytes+)
               (equalp (subseq bytes 0 16) #(80 71 76 79 71 83 76 79 84 73 78 83 84 65 76 49))
               (= (wal-u32 bytes 16) (- (length bytes) 24))
               (= (wal-u32 bytes (- (length bytes) 4))
                  (wal-crc32 bytes 0 (- (length bytes) 4))))
    (error "invalid logical slot installation envelope"))
  (let ((position 20) (end (- (length bytes) 4)))
    (labels ((take (count)
               (unless (<= count (- end position)) (error "truncated logical slot installation"))
               (prog1 position (incf position count))))
      (labels ((u32 () (wal-u32 bytes (take 4)))
               (u64 () (wal-u64 bytes (take 8)))
               (text (count) (map 'string #'code-char (subseq bytes (take count) position))))
        (labels ((inode-id () (list (u64) (u64) (u64))))
          (let* ((size (u32))
                 (certificate (progn
                                (unless (<= 1 size +logical-slot-copy-import-maximum-bytes+)
                                  (error "oversized logical slot installation certificate"))
                                (subseq bytes (take size) position)))
                 (digest (u64)) (token (text 32))
                 (identities (loop repeat (length (logical-slot-copy-install-identity-keys))
                                   collect (inode-id)))
                 (count (u32)))
            (unless (<= 1 count +logical-slot-copy-descriptor-maximum-slots+)
              (error "invalid logical slot installation row count"))
            (let* ((entries
                     (loop repeat count
                           collect (let ((length (u32)))
                                     (unless (<= 1 length 63)
                                       (error "invalid logical slot installation name length"))
                                     (list (text length) (inode-id) (inode-id)))))
                   (value
                     (append (list :certificate certificate :evidence-digest digest :stage-id token)
                             (loop for key in (logical-slot-copy-install-identity-keys)
                                   for identity in identities append (list key identity))
                             (list :entries entries))))
              (unless (= position end) (error "trailing logical slot installation bytes"))
              (unless (equalp bytes (logical-slot-copy-install-encode value))
                (error "noncanonical logical slot installation"))
              value)))))))
