(in-package #:pg)

(defun logical-slot-copy-catalog-create (attempt)
  (with-logical-slot-copy-catalog-guard (attempt)
    (let ((fd (funcall (logical-slot-copy-catalog-attempt-file-operation attempt) :create-temp attempt)))
      (sb-sys:without-interrupts
        (setf (logical-slot-copy-catalog-attempt-temp-facts attempt) (physical-image-file-facts fd))
        (logical-slot-copy-catalog-seal-operation attempt)))
    (logical-slot-copy-catalog-check-files attempt)))

(defun logical-slot-copy-catalog-write (attempt)
  (declare (notinline sb-posix:write))
  (with-logical-slot-copy-catalog-guard (attempt)
    (unless (and (eq :writing (logical-slot-copy-catalog-attempt-phase attempt))
                 (logical-slot-copy-catalog-attempt-temp-fd attempt))
      (error "catalog write requires its bound writable temporary"))
    (funcall (logical-slot-copy-catalog-attempt-mark-started attempt))
    (let* ((fd (logical-slot-copy-catalog-attempt-temp-fd attempt))
           (bytes (getf (logical-slot-copy-catalog-attempt-binding attempt) :catalog)))
      (unless (zerop (sb-posix:lseek fd 0 sb-posix:seek-set))
        (error "cannot position catalog temporary"))
      (sb-sys:with-pinned-objects (bytes)
        (loop with offset = 0 while (< offset (length bytes))
              for count = (sb-posix:write fd (sb-sys:sap+ (sb-sys:vector-sap bytes) offset)
                                          (- (length bytes) offset))
              do (unless (<= 1 count (- (length bytes) offset))
                   (error "short catalog restoration write"))
                 (incf offset count)))
      (sb-sys:without-interrupts
        (setf (logical-slot-copy-catalog-attempt-temp-facts attempt) (physical-image-file-facts fd)
              (logical-slot-copy-catalog-attempt-phase attempt) :ready
              (logical-slot-copy-catalog-attempt-temp-synced attempt) nil
              (logical-slot-copy-catalog-attempt-old-synced attempt) nil)
        (logical-slot-copy-catalog-seal-operation attempt)))
    (logical-slot-copy-catalog-check-files attempt)))

(defun logical-slot-copy-catalog-remove-residue (attempt)
  (declare (notinline logical-slot-copy-unlinkat sb-posix:fsync))
  (with-logical-slot-copy-catalog-guard (attempt)
    (logical-slot-copy-catalog-point :before-cold-catalog-unlink attempt)
    (logical-slot-copy-catalog-check attempt)
    (unless (and (eq :residue (logical-slot-copy-catalog-attempt-phase attempt))
                 (logical-slot-copy-catalog-attempt-temp-fd attempt))
      (error "catalog residue removal requires its bound residue"))
    (sb-sys:without-interrupts
      (funcall (logical-slot-copy-catalog-attempt-mark-started attempt))
      (unless (zerop (logical-slot-copy-unlinkat
                      (logical-slot-copy-catalog-attempt-global attempt) "pg_catalog.tmp" 0))
        (error "cannot remove authenticated catalog temporary"))
      (setf (logical-slot-copy-catalog-attempt-phase attempt) :unlinked
            (logical-slot-copy-catalog-attempt-global-changed attempt) t)
      (logical-slot-copy-catalog-seal-operation attempt))
    (logical-slot-copy-catalog-point :after-cold-catalog-unlink attempt)
    (logical-slot-copy-catalog-check attempt)
    (logical-slot-copy-catalog-close-one attempt t)
    (sb-posix:fsync (logical-slot-copy-catalog-attempt-global attempt))
    (logical-slot-copy-catalog-point :after-cold-catalog-unlink-sync attempt)
    (logical-slot-copy-catalog-check attempt)))

(defun logical-slot-copy-catalog-rename (attempt)
  (declare (notinline port-renameat))
  (with-logical-slot-copy-catalog-guard (attempt)
    (logical-slot-copy-catalog-point :before-cold-catalog-rename attempt)
    (logical-slot-copy-catalog-check attempt)
    (unless (and (eq :ready (logical-slot-copy-catalog-attempt-phase attempt))
                 (logical-slot-copy-catalog-attempt-temp-fd attempt)
                 (logical-slot-copy-catalog-attempt-temp-synced attempt)
                 (logical-slot-copy-catalog-attempt-old-synced attempt))
      (error "catalog rename requires its complete bound temporary"))
    (funcall (logical-slot-copy-catalog-attempt-mark-started attempt))
    (sb-sys:without-interrupts
      (unless (zerop (port-renameat
                      (logical-slot-copy-catalog-attempt-global attempt) "pg_catalog.tmp"
                      (logical-slot-copy-catalog-attempt-global attempt) "pg_catalog.dat"))
        (error "cannot publish restored catalog"))
      (let ((before (logical-slot-copy-catalog-attempt-temp-facts attempt))
            (now (physical-image-file-facts (logical-slot-copy-catalog-attempt-temp-fd attempt))))
        (unless (loop for a in before for c in now for index from 0
                      always (or (= index 7) (eql a c)))
          (error "catalog restoration inode changed during rename"))
        (setf (logical-slot-copy-catalog-attempt-phase attempt) :installed
              (logical-slot-copy-catalog-attempt-target-facts attempt) now
              (logical-slot-copy-catalog-attempt-temp-facts attempt) now
              (logical-slot-copy-catalog-attempt-file-synced attempt) nil
              (logical-slot-copy-catalog-attempt-directory-synced attempt) nil)
        (logical-slot-copy-catalog-seal-operation attempt)))
    (logical-slot-copy-catalog-point :after-cold-catalog-rename attempt)
    (logical-slot-copy-catalog-check attempt)))

(defun logical-slot-copy-catalog-sync (attempt fd point)
  (declare (notinline sb-posix:fsync))
  (with-logical-slot-copy-catalog-guard (attempt)
    (let ((phase (logical-slot-copy-catalog-attempt-phase attempt))
          (global (logical-slot-copy-catalog-attempt-global attempt))
          (old (logical-slot-copy-catalog-attempt-old-fd attempt))
          (temporary (logical-slot-copy-catalog-attempt-temp-fd attempt)))
      (unless (and fd
                   (cond ((eql fd global)
                          (and (member phase '(:installed :synced))
                               (logical-slot-copy-catalog-attempt-file-synced attempt)))
                         ((eql fd old) (member phase '(:ready :synced)))
                         ((eql fd temporary) (member phase '(:ready :installed)))))
        (error "catalog sync requires its owned descriptor and proof phase"))
      (sb-sys:without-interrupts
        (funcall (logical-slot-copy-catalog-attempt-mark-started attempt))
        (sb-posix:fsync fd)
        (cond ((eql fd global) (setf (logical-slot-copy-catalog-attempt-directory-synced attempt) t))
              ((eql fd old)
               (setf (logical-slot-copy-catalog-attempt-old-synced attempt) t)
               (when (eq phase :synced) (setf (logical-slot-copy-catalog-attempt-file-synced attempt) t)))
              ((eq phase :ready) (setf (logical-slot-copy-catalog-attempt-temp-synced attempt) t))
              (t (setf (logical-slot-copy-catalog-attempt-file-synced attempt) t)))
        (logical-slot-copy-catalog-seal-operation attempt)))
    (logical-slot-copy-catalog-point point attempt)
    (logical-slot-copy-catalog-check attempt)))

(defun logical-slot-copy-catalog-restore (attempt)
  (with-logical-slot-copy-catalog-guard (attempt)
    (let ((b (logical-slot-copy-catalog-attempt-binding attempt))
          (restored nil))
      (logical-slot-copy-catalog-point :after-cold-catalog-open attempt)
      (logical-slot-copy-catalog-check attempt)
      (when (eq :residue (logical-slot-copy-catalog-attempt-phase attempt))
        (logical-slot-copy-catalog-remove-residue attempt))
      (unless (equalp (getf b :old-bytes) (getf b :catalog))
        (logical-slot-copy-catalog-point :before-cold-catalog-create attempt)
        (logical-slot-copy-catalog-check attempt)
        (logical-slot-copy-catalog-create attempt)
        (logical-slot-copy-catalog-point :after-cold-catalog-create attempt)
        (logical-slot-copy-catalog-check attempt)
        (logical-slot-copy-catalog-write attempt)
        (logical-slot-copy-catalog-point :after-cold-catalog-write attempt)
        (logical-slot-copy-catalog-sync
         attempt (logical-slot-copy-catalog-attempt-temp-fd attempt) :after-cold-catalog-temp-sync)
        (logical-slot-copy-catalog-sync
         attempt (logical-slot-copy-catalog-attempt-old-fd attempt) :after-cold-catalog-old-sync)
        (logical-slot-copy-catalog-rename attempt)
        (setf restored t))
      (unless restored
        (setf (logical-slot-copy-catalog-attempt-phase attempt) :synced)
        (logical-slot-copy-catalog-seal-operation attempt))
      (logical-slot-copy-catalog-sync
       attempt (if restored (logical-slot-copy-catalog-attempt-temp-fd attempt)
                   (logical-slot-copy-catalog-attempt-old-fd attempt))
       :after-cold-catalog-file-sync)
      (logical-slot-copy-catalog-sync
       attempt (logical-slot-copy-catalog-attempt-global attempt) :after-cold-catalog-directory-sync)
      (logical-slot-copy-catalog-point :before-cold-catalog-close attempt)
      (logical-slot-copy-catalog-check attempt)
      (logical-slot-copy-catalog-close attempt)
      (logical-slot-copy-catalog-point :after-cold-catalog-close attempt)
      (logical-slot-copy-catalog-check attempt)
      (if restored :restored :synced))))
