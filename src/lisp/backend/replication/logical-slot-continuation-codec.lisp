(in-package #:pg)

(defun logical-slot-continuation-encode (snapshot)
  (multiple-value-bind (plan size) (logical-slot-continuation-check snapshot)
    (declare (ignore plan))
    (let ((bytes (make-array size :element-type '(unsigned-byte 8) :initial-element 0))
          (position 20))
      (replace bytes #(80 71 76 79 71 67 79 78 84 83 78 65 80 49 0 0))
      (wal-set-u32 bytes 16 (- size 24))
      (labels ((u8 (value) (setf (aref bytes position) value) (incf position))
               (u32 (value) (wal-set-u32 bytes position value) (incf position 4))
               (u64 (value) (wal-set-u64 bytes position value) (incf position 8))
               (blob (value)
                 (u32 (length value)) (replace bytes value :start1 position) (incf position (length value)))
               (text (value)
                 (u32 (length value))
                 (loop for character across value
                       do (u8 (char-code character))))
               (point (value)
                 (u64 (first value)) (u32 (second value))
                 (u8 (ecase (third value) (:record-start 1) (:prefix-end 2)))))
        (u64 (getf snapshot :generation)) (u64 (getf snapshot :system-id))
        (u32 (first (getf snapshot :origin))) (u64 (second (getf snapshot :origin)))
        (blob (getf snapshot :binding))
        (u32 (getf snapshot :history-target)) (blob (getf snapshot :history))
        (point (getf snapshot :sealed-end))
        (u32 (length (getf snapshot :slots)))
        (dolist (row (getf snapshot :slots)) (text (first row)) (blob (second row)))
        (u32 (length (getf snapshot :transfers)))
        (dolist (row (getf snapshot :transfers)) (text (first row)) (point (second row)))
        (u32 (length (getf snapshot :roots)))
        (dolist (root (getf snapshot :roots))
          (u64 (first root)) (u64 (second root))
          (let ((reference (third root)))
            (u64 (getf reference :root-id)) (u32 (getf reference :base-timeline))
            (u64 (getf reference :base)) (u64 (getf reference :manifest-digest))
            (u64 (getf reference :end)) (u64 (getf reference :end-digest)))
          (u32 (fourth root)) (blob (fifth root)))
        (u32 (length (getf snapshot :runs)))
        (dolist (run (getf snapshot :runs))
          (u64 (first run)) (point (second run)) (point (third run))
          (u32 (fourth run)) (u32 (fifth run)))
        (let ((tail (getf snapshot :tail)))
          (u8 (if tail 1 0))
          (when tail (point (first tail)) (u32 (second tail)))))
      (unless (= position (- size 4)) (error "continuation snapshot size changed"))
      (wal-set-u32 bytes position (wal-crc32 bytes 0 position))
      bytes)))

(defun logical-slot-continuation-check-envelope (bytes)
  (unless (and (typep bytes '(vector (unsigned-byte 8)))
               (<= 24 (length bytes) (logical-slot-continuation-maximum-bytes))
               (equalp (subseq bytes 0 16) #(80 71 76 79 71 67 79 78 84 83 78 65 80 49 0 0))
               (= (wal-u32 bytes 16) (- (length bytes) 24))
               (= (wal-u32 bytes (- (length bytes) 4)) (wal-crc32 bytes 0 (- (length bytes) 4))))
    (error "invalid continuation snapshot envelope"))
  bytes)

(defun logical-slot-continuation-decode (bytes)
  ;; Check the fixed envelope, length and CRC, then bound table counts and
  ;; require canonical re-encoding.  CRC detects corruption; it is not proof.
  (logical-slot-continuation-check-envelope bytes)
  (let ((position 20) (end (- (length bytes) 4)))
    (labels ((take (count)
               (unless (<= count (- end position)) (error "truncated continuation snapshot"))
               (prog1 position (incf position count)))
             (u8 () (aref bytes (take 1)))
             (u32 () (wal-u32 bytes (take 4)))
             (u64 () (wal-u64 bytes (take 8)))
             (blob (minimum maximum)
               (let ((size (u32)))
                 (unless (<= minimum size maximum) (error "oversized continuation blob"))
                 (subseq bytes (take size) position)))
             (text (maximum) (map 'string #'code-char (blob 1 maximum)))
             (point () (list (u64) (u32) (ecase (u8) (1 :record-start) (2 :prefix-end))))
             (entry-count (maximum minimum)
               (let ((count (u32)))
                 (unless (and (<= count maximum) (<= (* count minimum) (- end position)))
                   (error "oversized or truncated continuation table"))
                 count)))
      (let* ((generation (u64)) (system-id (u64)) (origin (list (u32) (u64)))
                                (binding (blob 1 (logical-slot-copy-source-proof-maximum-bytes)))
                                (tip (u32)) (history (blob 0 +physical-store-history-maximum-bytes+))
                                (sealed (point))
                                (slots (loop repeat (entry-count +logical-slot-continuation-obligation-limit+ 10)
                                             collect (list (text 63) (blob 1 +slot-state-maximum-bytes+))))
                                (transfers (loop repeat (entry-count +logical-slot-continuation-obligation-limit+ 49)
                                                 collect (list (text 32) (point))))
                                (roots
                                  (loop repeat (entry-count +logical-slot-continuation-root-limit+ 68)
                                        collect (list (u64) (u64)
                                                      (list :root-id (u64) :base-timeline (u32) :base (u64)
                                                            :manifest-digest (u64) :end (u64) :end-digest (u64))
                                                      (u32) (blob 0 +physical-store-history-maximum-bytes+))))
                                (runs (loop repeat (entry-count +logical-slot-continuation-run-limit+ 42)
                                            collect (list (u64) (point) (point) (u32) (u32))))
                                (tail (ecase (u8) (0 nil) (1 (list (point) (u32)))))
                                (snapshot (list :version 1 :binding binding :generation generation :system-id system-id
                                                :origin origin :history-target tip :history history :sealed-end sealed
                                                :slots slots :transfers transfers :roots roots :runs runs :tail tail)))
        (unless (= position end) (error "trailing continuation snapshot bytes"))
        (unless (equalp bytes (logical-slot-continuation-encode snapshot))
          (error "noncanonical continuation snapshot"))
        snapshot))))
