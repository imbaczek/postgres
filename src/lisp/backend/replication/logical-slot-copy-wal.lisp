(in-package #:pg)

(defstruct (logical-slot-copy-wal-state
            (:constructor make-logical-slot-copy-wal-state (capture owner target archive))
            (:print-object (lambda (object stream)
                             (print-unreadable-object (object stream :type t :identity t)))))
  (capture nil :read-only t) (owner nil :read-only t)
  (target nil :read-only t) (archive nil :read-only t)
  (pieces (make-hash-table :test #'equal)) cache-key cache-bytes)

(defun logical-slot-copy-live-piece (capture segment carrier)
  (logical-slot-copy-check-capture capture)
  (let* ((context (logical-slot-copy-capture-context capture))
         (parent (cdr (assoc "pg_wal" (physical-image-context-children context) :test #'equal)))
         (namespace (getf (logical-slot-copy-capture-expected capture) :namespace))
         (leaf (wal-segment-filename segment carrier namespace)))
    (call-with-physical-image-input-at
     parent leaf
     (lambda (stream)
       (when stream
         (let* ((fd (sb-sys:fd-stream-fd stream))
                (before (physical-image-file-facts fd))
                (size (min (sixth before)
                           (- (getf (logical-slot-copy-capture-expected capture) :end)
                              (* segment +wal-segment-size+)))))
           (unless (and (sb-posix:s-isreg (third before)) (= 1 (fourth before))
                        (= (sb-posix:geteuid) (fifth before))
                        (= #o600 (logand #o7777 (third before)))
                        (<= 1 size (sixth before) +wal-segment-size+))
             (error "logical copy WAL carrier is not a bounded private regular file"))
           (let ((bytes (make-array size :element-type '(unsigned-byte 8))))
             (unless (and (= size (read-sequence bytes stream))
                          (equal before (physical-image-file-facts fd))
                          (equal before (physical-image-file-facts parent leaf)))
               (error "logical copy WAL source changed during capture"))
             (physical-image-check-children context)
             (values bytes before)))))
     :element-type '(unsigned-byte 8) :if-does-not-exist nil)))

(defun logical-slot-copy-archive-piece (state segment carrier)
  (let ((archive (logical-slot-copy-wal-state-archive state)))
    (unless archive (error "logical copy lacks its exact retained WAL carrier"))
    (logical-wal-archive-prepare archive segment carrier)
    (sb-thread:with-mutex (*wal-lock*)
      (logical-slot-copy-check-captured-source-under-lock
       (logical-slot-copy-wal-state-capture state))
      (logical-wal-archive-check archive)
      (unless (eql segment (logical-wal-archive-cache-segment archive))
        (error "logical copy retained WAL cache changed"))
      (values (copy-seq (logical-wal-archive-cache-bytes archive))
              (list (logical-wal-archive-cache-start archive)
                    (logical-wal-archive-cache-end archive))))))

(defun logical-slot-copy-ensure-piece (state position history)
  (let* ((segment (floor position +wal-segment-size+))
         (carrier (logical-wal-segment-carrier segment history))
         (key (list carrier segment))
         (pieces (logical-slot-copy-wal-state-pieces state))
         (info (gethash key pieces))
         (bytes nil)
         (path (logical-slot-copy-piece-path carrier segment)))
    (logical-slot-copy-check-capture (logical-slot-copy-wal-state-capture state))
    (logical-slot-copy-check-target (logical-slot-copy-wal-state-owner state)
                                    (logical-slot-copy-wal-state-target state))
    (cond
      ((equal key (logical-slot-copy-wal-state-cache-key state))
       (setf bytes (logical-slot-copy-wal-state-cache-bytes state)))
      (info
       (let ((row (getf info :row)))
         (setf bytes (logical-slot-copy-read-file
                      (logical-slot-copy-wal-state-target state) path (third row)))
         (unless (and (= (length bytes) (third row))
                      (= (fourth row) (physical-store-update-digest #xCBF29CE484222325 bytes)))
           (error "logical copy WAL target changed"))))
      (t
       (when (>= (hash-table-count pieces) +logical-slot-copy-descriptor-maximum-wal-pieces+)
         (error "logical copy has too many WAL pieces"))
       (multiple-value-bind (live facts)
           (logical-slot-copy-live-piece (logical-slot-copy-wal-state-capture state) segment carrier)
         (let ((bounds nil))
           (if live
               (setf bytes live
                     bounds (list (* segment +wal-segment-size+)
                                  (+ (* segment +wal-segment-size+) (length live))))
               (multiple-value-setq (bytes bounds) (logical-slot-copy-archive-piece state segment carrier)))
           (unless (<= (first bounds) position (second bounds))
             (error "logical copy start is outside certified carrier coverage"))
           (let* ((entry (logical-slot-copy-write-bytes (logical-slot-copy-wal-state-target state) path bytes))
                  (row (list carrier segment (second entry) (third entry) position position)))
             (setf info (list :row row :source (if live :live :archive) :facts facts :bounds bounds)
                   (gethash key pieces) info))))))
    (unless (<= (first (getf info :bounds)) position (second (getf info :bounds)))
      (error "logical copy position exceeds its checked carrier"))
    (setf (logical-slot-copy-wal-state-cache-key state) key
          (logical-slot-copy-wal-state-cache-bytes state) bytes)
    (values info bytes)))

(defun logical-slot-copy-validate-payload (reader record kind)
  (when (eq kind :end-of-recovery)
    (when (logical-reader-state-batch-open-p reader)
      (error "logical copy end-of-recovery interrupts a logical batch"))
    (return-from logical-slot-copy-validate-payload (values)))
  (wal-note-recovery-batch-record record)
  (let ((type (wal-record-type record)))
    (cond
      ((= type +wal-record-batch-start+) (wal-logical-reader-start-batch reader))
      ((not (logical-reader-state-batch-open-p reader))
       (error "logical copy WAL appears outside a batch"))
      ((= type +wal-record-logical-changes+) (wal-logical-reader-add-chunk reader record))
      ((= type +wal-record-logical-catalog-event+) (wal-logical-reader-add-catalog-event reader record))
      ((= type +wal-record-pages+)
       (wal-decode-page-images (wal-record-payload record) (wal-record-end record)
                               (wal-record-version record)))
      ((wal-terminal-record-type-p type) (wal-logical-reader-finish-batch reader record nil))))
  (values))

(defun logical-slot-copy-proven-start (slot start owner history)
  (let ((role (if (logical-slot-wal-start-proven-p slot start owner :record-start)
                  :record-start :prefix-end)))
    (unless (and (logical-slot-wal-start-proven-p slot start owner role)
                 (ecase role
                   (:record-start (= owner (timeline-at-point start history)))
                   (:prefix-end (and (plusp start) (= owner (timeline-at-point (1- start) history))))))
      (error "logical copy restart lacks its persisted position proof"))
    (values owner role)))

(defun logical-slot-copy-captured-start (capture slot history)
  (sb-thread:with-mutex (*wal-lock*)
    (logical-slot-copy-check-captured-source-under-lock capture)
    (let ((row (assoc (wal-replication-slot-name slot)
                      (logical-slot-copy-capture-owners capture) :test #'equal)))
      (unless (and row
                   (some (lambda (entry) (eq slot (logical-slot-startup-entry-slot entry)))
                         (logical-slot-startup-source-entries (logical-slot-copy-capture-source capture))))
        (error "logical copy restart is not from its captured inventory"))
      (logical-slot-copy-proven-start
       (second row) (wal-replication-slot-restart-lsn slot)
       (wal-replication-slot-restart-timeline slot) history))))

(defun logical-slot-copy-transfer-slot-wal (state slot history)
  (let* ((capture (logical-slot-copy-wal-state-capture state))
         (facts (logical-slot-copy-capture-expected capture))
         (reader (make-logical-reader-state :database-oid (wal-replication-slot-database-oid slot)))
         (*wal-recovery-reservation-batch-clean-p* nil))
    (multiple-value-bind (owner role) (logical-slot-copy-captured-start capture slot history)
      (unwind-protect
           (call-with-logical-reader-spools
            (lambda ()
              (call-with-logical-wal-cursor
               history (getf facts :namespace) (wal-replication-slot-restart-lsn slot) (getf facts :end)
               owner role (lambda () (logical-slot-copy-check-captured-source-under-lock capture))
               (lambda (cursor)
                 (loop while (< (logical-wal-cursor-position cursor) (getf facts :end)) do
                   (logical-slot-copy-ensure-piece state (logical-wal-cursor-position cursor) history)
                   (multiple-value-bind (record bytes record-owner carrier kind)
                       (logical-wal-cursor-next cursor)
                     (unless record (error "logical copy cursor ended before its frozen horizon"))
                     (unless (= record-owner (timeline-at-point (wal-record-start record) history))
                       (error "logical copy record owner changed"))
                     (multiple-value-bind (info raw)
                         (logical-slot-copy-ensure-piece state (wal-record-start record) history)
                       (let* ((row (getf info :row))
                              (offset (mod (wal-record-start record) +wal-segment-size+)))
                         (unless (and (= carrier (first row))
                                      (<= (wal-record-end record) (second (getf info :bounds)))
                                      (<= (+ offset (length bytes)) (length raw))
                                      (equalp bytes (subseq raw offset (+ offset (length bytes)))))
                           (error "logical copy raw carrier differs from its decoded record"))
                         (logical-slot-copy-validate-payload reader record kind)
                         (setf (fifth row) (min (fifth row) (wal-record-start record))
                               (sixth row) (max (sixth row) (wal-record-end record)))))))
                 (unless (= (logical-wal-cursor-position cursor) (getf facts :end))
                   (error "logical copy cursor did not reach its checkpoint")))
               :archive (logical-slot-copy-wal-state-archive state) :batch-policy :logical-reader)))
        (wal-logical-reader-reset-batch reader nil)))))

(defun logical-slot-copy-check-piece-source (state info)
  (let* ((capture (logical-slot-copy-wal-state-capture state))
         (context (logical-slot-copy-capture-context capture))
         (row (getf info :row)))
    (logical-slot-copy-check-capture capture)
    (ecase (getf info :source)
      (:live
       (let* ((parent (cdr (assoc "pg_wal" (physical-image-context-children context) :test #'equal)))
              (leaf (wal-segment-filename (second row) (first row)
                                          (getf (logical-slot-copy-capture-expected capture) :namespace))))
         (unless (equal (getf info :facts) (physical-image-file-facts parent leaf))
           (error "logical copy live WAL changed before finalization"))))
      (:archive
       (let ((archive (logical-slot-copy-wal-state-archive state)))
         (sb-thread:with-mutex (*wal-lock*)
           (logical-wal-archive-check archive)
           (logical-wal-archive-clear-cache archive))
         (multiple-value-bind (bytes bounds)
             (logical-slot-copy-archive-piece state (second row) (first row))
           (unless (and (equal bounds (getf info :bounds)) (= (length bytes) (third row))
                        (= (fourth row) (physical-store-update-digest #xCBF29CE484222325 bytes)))
             (error "logical copy archived WAL changed before finalization"))))))
    t))

(defun logical-slot-copy-transfer-wal (capture owner target archive)
  (let* ((facts (logical-slot-copy-capture-expected capture))
         (history (timeline-check-lineage
                   (timeline-parse-history (getf facts :timeline) (bytes->string (getf facts :history)))))
         (state (make-logical-slot-copy-wal-state capture owner target archive)))
    (dolist (entry (logical-slot-startup-source-entries (logical-slot-copy-capture-source capture)))
      (let ((slot (logical-slot-startup-entry-slot entry)))
        (when (and (wal-logical-slot-p slot) (eq :reserved (wal-replication-slot-wal-status slot)))
          (logical-slot-copy-transfer-slot-wal state slot history))))
    (setf (logical-slot-copy-wal-state-cache-key state) nil
          (logical-slot-copy-wal-state-cache-bytes state) nil)
    (maphash (lambda (key info) (declare (ignore key)) (logical-slot-copy-check-piece-source state info))
             (logical-slot-copy-wal-state-pieces state))
    (values (sort (loop for info being the hash-values of (logical-slot-copy-wal-state-pieces state)
                        collect (copy-list (getf info :row)))
                  #'logical-slot-copy-descriptor-piece-key-less-p)
            state)))
