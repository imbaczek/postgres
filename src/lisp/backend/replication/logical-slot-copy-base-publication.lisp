(in-package #:pg)

(defun logical-slot-copy-check-base-proof-input (owner context observations)
  (unless (logical-slot-copy-startup-owner-p owner)
    (error "base verification publication requires the real startup owner"))
  (logical-slot-copy-input-check-observations owner context observations))

(defun logical-slot-copy-sync-base-proof (owner context bytes observations)
  (let ((root (physical-image-context-root-fd context))
        (name "logical-slot-copy.base-verified"))
    (logical-slot-copy-check-base-proof-input owner context observations)
    (call-with-physical-image-input-at
     root name
     (lambda (stream)
       (let ((fd (sb-sys:fd-stream-fd stream)))
         (unless (equal (physical-image-file-facts fd) (physical-image-file-facts root name))
           (error "logical copy base verification proof changed before sync"))
         (sb-posix:fsync fd)
         (logical-slot-copy-verification-test-point :before-base-proof-root-fsync context)
         (logical-slot-copy-check-base-proof-input owner context observations)
         (sb-posix:fsync root)
         (logical-slot-copy-verification-test-point :after-base-proof-root-fsync context)
         (multiple-value-bind (actual facts)
             (logical-slot-copy-read-file context name +logical-slot-copy-base-proof-maximum-bytes+)
           (unless (and (equalp bytes actual)
                        (equal facts (physical-image-file-facts fd)))
             (error "logical copy base verification proof failed readback")))
         (logical-slot-copy-check-base-proof-input owner context observations)))
     :element-type '(unsigned-byte 8))))

(defun logical-slot-copy-publish-base-proof (owner context value observations)
  (let* ((bytes (logical-slot-copy-base-proof-image value))
         (existing (logical-slot-copy-startup-owner-existing-proof owner))
         (root (physical-image-context-root-fd context))
         (pending "logical-slot-copy.base-verified.tmp")
         (name "logical-slot-copy.base-verified")
         (fd nil) (stream nil))
    (logical-slot-copy-check-base-proof-input owner context observations)
    (when existing
      (unless (equalp bytes existing)
        (error "existing logical copy base verification proof differs from verified input"))
      (logical-slot-copy-sync-base-proof owner context bytes observations)
      (return-from logical-slot-copy-publish-base-proof value))
    (sb-sys:without-interrupts
      (unwind-protect
           (progn
             (setf fd (physical-image-openat
                       root pending (logior sb-posix:o-wronly sb-posix:o-creat sb-posix:o-excl
                                            sb-posix:o-nofollow +postmaster-o-cloexec+) #o600))
             (when (minusp fd) (setf fd nil) (error "cannot create exclusive base verification proof"))
             (setf stream (sb-sys:make-fd-stream fd :output t :element-type '(unsigned-byte 8)))
             (sb-sys:with-local-interrupts
               (write-sequence bytes stream)
               (force-output stream)
               (logical-slot-copy-verification-test-point :before-base-proof-file-fsync context)
               (logical-slot-copy-check-base-proof-input owner context observations)
               (sb-posix:fsync fd)
               (logical-slot-copy-verification-test-point :after-base-proof-file-fsync context)
               (logical-slot-copy-check-base-proof-input owner context observations)
               (unless (let ((stat (sb-posix:fstat fd)))
                         (and (sb-posix:s-isreg (sb-posix:stat-mode stat))
                              (= 1 (sb-posix:stat-nlink stat))
                              (= (sb-posix:geteuid) (sb-posix:stat-uid stat))
                              (= #o600 (logand #o7777 (sb-posix:stat-mode stat)))
                              (equal (physical-image-file-facts fd) (physical-image-file-facts root pending))))
                 (error "logical copy pending base verification proof changed"))
               (unless (zerop (physical-adoption-renameat2
                               root pending root name +physical-adoption-rename-noreplace+))
                 (error "cannot publish exclusive logical copy base verification proof"))
               (logical-slot-copy-verification-test-point :after-base-proof-rename context)
               (logical-slot-copy-sync-base-proof owner context bytes observations)
               (setf (logical-slot-copy-startup-owner-existing-proof owner) (copy-seq bytes))))
        (if stream (close stream) (when fd (sb-posix:close fd)))))
    value))

(defun logical-slot-copy-record-base-verification (scratch)
  (call-with-logical-slot-copy-startup-input
   (lambda (owner context)
     (multiple-value-bind (manifest descriptor results records observations)
         (logical-slot-copy-verify-input owner context scratch)
       (declare (ignore results records))
       (logical-slot-copy-verification-test-point :before-base-proof-publication context)
       (let ((value (logical-slot-copy-base-proof-value context manifest descriptor)))
         (logical-slot-copy-publish-base-proof owner context value observations)
         (logical-slot-copy-input-inventory owner context manifest descriptor)
         value)))))
