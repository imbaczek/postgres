(in-package #:pg)

(defun logical-slot-continuation-cold-cleanup-directory-delta (before after root links)
  (logical-slot-continuation-cold-plan-facts-key after root t)
  (unless (and (equal (logical-slot-copy-source-proof-directory-identity before)
                      (logical-slot-copy-source-proof-directory-identity after))
               (= (fourth after) links))
    (error "cold cleanup changed directory identity or link count"))
  t)

(defun logical-slot-continuation-cold-cleanup-check-unlinked-facts (before after directory-p)
  (logical-slot-continuation-list before 9)
  (logical-slot-continuation-list after 9)
  (unless (and (equal (logical-slot-copy-source-proof-directory-identity before)
                      (logical-slot-copy-source-proof-directory-identity after))
               (zerop (fourth after))
               (if directory-p
                   (sb-posix:s-isdir (third after))
                   (and (sb-posix:s-isreg (third after))
                        (= (sixth before) (sixth after))
                        (= (seventh before) (seventh after)))))
    (error "cold cleanup lost or changed an unlinked descriptor"))
  t)

(defun logical-slot-continuation-cold-cleanup-next-ledger
    (root rows event observed-root observed-rows)
  (logical-slot-continuation-list event (case (first event) (:observe 1) (:rmdir 2) (t 3)))
  (let* ((operation (first event)) (name (second event)) (argument (third event))
                                   (expected (logical-slot-continuation-copy rows))
                                   (row (find name expected :key (lambda (entry) (getf entry :name)) :test #'equal))
                                   (root-change nil) (child-change nil) (root-links (fourth root)))
    (unless (or (eq operation :observe) row)
      (error "cold cleanup event has no captured directory"))
    (ecase operation
      (:observe)
      (:rename
       (unless (and (not (getf row :staging))
                    (equal argument (concatenate 'string name ".tmp"))
                    (not (find argument expected :key (lambda (entry) (getf entry :name))
                                                 :test #'equal)))
         (error "cold cleanup rename is not a disjoint canonical tombstone"))
       (setf (getf row :name) (copy-seq argument) (getf row :staging) t
             root-change t child-change t))
      (:unlink
       (unless (and (member argument '("state" "state.tmp") :test #'equal)
                    (or (getf row :staging) (equal argument "state.tmp"))
                    (assoc argument (getf row :files) :test #'equal))
         (error "cold cleanup unlink has no captured removable file"))
       (setf (getf row :files)
             (remove argument (getf row :files) :key #'first :test #'equal)
             child-change t))
      (:rmdir
       (unless (and (getf row :staging) (null (getf row :files)))
         (error "cold cleanup directory removal requires an empty tombstone"))
       (setf expected (remove row expected :test #'eq) root-change t)
       (unless (= 1 root-links) (decf root-links))))
    (if root-change
        (logical-slot-continuation-cold-cleanup-directory-delta root observed-root root root-links)
        (unless (equal root observed-root)
          (error "cold cleanup changed an unaffected root")))
    (when child-change
      (let ((observed (find (getf row :name) observed-rows
                            :key (lambda (entry) (getf entry :name)) :test #'equal)))
        (unless observed (error "cold cleanup lost its affected directory"))
        (logical-slot-continuation-cold-cleanup-directory-delta
         (getf row :directory) (getf observed :directory) root (fourth (getf row :directory)))
        (setf (getf row :directory) (copy-list (getf observed :directory)))))
    (setf expected (sort expected #'string< :key (lambda (entry) (getf entry :name))))
    (unless (equalp expected observed-rows)
      (error "cold cleanup changed resources outside its exact event"))
    (logical-slot-continuation-cold-check-plan-ledger expected observed-root nil nil)
    (values (copy-list observed-root) expected)))

(defun logical-slot-continuation-cold-cleanup-action-steps (action)
  (let* ((operation (getf action :operation)) (row (getf action :before))
                                              (name (getf action :name))
                                              (temporary (concatenate 'string name ".tmp"))
                                              (scratch (eq operation :remove-scratch))
                                              (retire (eq operation :retire-temporary))
                                              (current (if retire temporary name)))
    (unless (and (member operation '(:remove-staging :remove-scratch :retire-temporary))
                 (equal name (getf row :name))
                 (eq (not (null (getf row :staging))) (eq operation :remove-staging))
                 (or (not scratch) (assoc "state.tmp" (getf row :files) :test #'equal)))
      (error "cold cleanup action is not a checked removable resource"))
    (append
     (list (list :open-directory name))
     (when retire (list (list :rename name temporary)
                        (list :sync-directory temporary) (list :sync-root)))
     (loop for file in (if scratch '("state.tmp")
                           (sort (mapcar #'first (getf row :files)) #'string>))
           append (list (list :open-file current file)
                        (list :unlink current file)
                        (list :close-file current file)))
     (list (list :sync-directory current))
     (unless scratch (list (list :rmdir current) (list :sync-root)))
     (list (list :close-directory current)))))
