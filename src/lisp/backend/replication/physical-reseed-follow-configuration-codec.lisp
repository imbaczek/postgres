(in-package #:pg)

(defun physical-reseed-follow-configuration-selected-p (core)
  (let ((anchor (physical-reseed-follow-generation-anchor (car (last (getf core :generations))))))
    (and (eq :descendant (physical-follow-anchor-kind anchor))
         (= (getf anchor :base) (nth-value 1 (physical-follow-anchor-check anchor))))))

(defun physical-reseed-follow-configuration-image-size-p (name size)
  (cond
    ((equal name "follow.pending") (<= 1 size +physical-follow-config-maximum-bytes+))
    ((equal name "receive.lock") (zerop size))
    ((equal name "receive.initial") (= 68 size))
    ((equal name "receive.selected") (= 80 size))
    ((equal name "recovery.initial") (member size '(72 120)))
    ((equal name "recovery.selected") (member size '(88 136)))
    ((equal name "history.receive") (<= 16 size +physical-store-history-maximum-bytes+))
    ((equal name "history.wal") (<= 1 size +physical-store-history-maximum-bytes+))))

(defun physical-reseed-follow-configuration-images-copy (images selected)
  (let ((names (if selected
                   '("follow.pending" "history.receive" "history.wal" "receive.initial" "receive.lock"
                     "receive.selected" "recovery.initial" "recovery.selected")
                   '("follow.pending" "receive.initial" "receive.lock" "recovery.initial"))))
    (unless (and (listp images) (= (length names) (length images))
                 (every (lambda (spec) (and (listp spec) (= 3 (length spec)) (stringp (first spec)))) images)
                 (equal names (mapcar #'first images)))
      (error "configuration has missing, reordered or unrelated images"))
    (loop for (name size digest) in images collect
                                           (progn
                                             (unless (and (typep size '(unsigned-byte 64)) (typep digest '(unsigned-byte 64))
                                                          (physical-reseed-follow-configuration-image-size-p name size)
                                                          (or (not (equal name "receive.lock")) (= digest #xCBF29CE484222325)))
                                               (error "invalid configuration image specification"))
                                             (list (copy-seq name) size digest)))))

(defun physical-reseed-follow-configuration-directories-copy (value device identities)
  (physical-follow-check-plist value '(:lock-inode :fence-inode :staged :saved :receive))
  (dolist (key '(:lock-inode :fence-inode))
    (physical-reseed-install-register device (getf value key) device identities))
  (list :lock-inode (getf value :lock-inode) :fence-inode (getf value :fence-inode)
        :staged (physical-reseed-install-control-copy (getf value :staged) device identities)
        :saved (physical-reseed-install-control-copy (getf value :saved) device identities)
        :receive (physical-reseed-install-control-copy (getf value :receive) device identities)))

(defun physical-reseed-follow-configuration-entries-copy (entries images device identities)
  (let ((entries (physical-adoption-install-trees-copy entries device identities)))
    (unless (equal (mapcar #'first images) (mapcar #'first entries))
      (error "configuration file identities differ from its image names"))
    (loop for (name rows) in entries for (image size digest) in images
          do (unless (and (equal name image) (= 1 (length rows)) (eq :file (second (first rows)))
                          (= #o600 (third (first rows)))
                          (= size (sixth (first rows))) (= digest (seventh (first rows))))
               (error "configuration file identity differs from its image")))
    entries))

(defun physical-reseed-follow-configuration-protected-identities (core)
  (let* ((local (getf (getf core :attempt) :local))
         (stage (getf (getf core :attempt) :stage))
         (device (getf local :device)) (identities (make-hash-table :test #'equal)))
    (dolist (inode (list (getf local :inode) (getf local :lock-inode) (getf stage :inode)
                         (second (getf (getf core :install) :identity))))
      (physical-reseed-install-register device inode device identities))
    identities))

(defun physical-reseed-follow-configuration-copy (value core)
  (physical-reseed-install-check-literal (list value core))
  (setf core (physical-reseed-follow-core-copy core))
  (physical-follow-check-plist value
                               '(:phase :generation :anchor-digest :time :workspace :directories :images :entries :step))
  (let* ((generation (car (last (getf core :generations))))
         (phase (getf value :phase)) (step (getf value :step))
         (local (getf (getf core :attempt) :local)) (device (getf local :device)))
    (unless (and generation (eq :proved (getf generation :phase))
                 (eql (getf value :generation) (getf generation :generation))
                 (typep (getf value :anchor-digest) '(unsigned-byte 64))
                 (= (getf value :anchor-digest)
                    (physical-follow-anchor-digest (physical-reseed-follow-generation-anchor generation)))
                 (member phase '(:building :staged :installing :inert))
                 (typep (getf value :time) '(signed-byte 64)) (typep step '(integer 0 5)))
      (error "configuration does not select its proved generation"))
    (let* ((selected (physical-reseed-follow-configuration-selected-p core))
           (identities (physical-reseed-follow-configuration-protected-identities core))
           (workspace (physical-adoption-install-fact-copy (getf value :workspace) device identities :directory t))
           (work (pathname (getf workspace :directory)))
           (images (physical-reseed-follow-configuration-images-copy (getf value :images) selected))
           (directories nil) (entries nil) (maximum (if selected 5 4)))
      (dolist (other (list (getf local :directory) (getf (getf (getf core :attempt) :stage) :directory)))
        (when (or (uiop:subpathp work (pathname other)) (uiop:subpathp (pathname other) work))
          (error "configuration workspace overlaps protected target or stage")))
      (if (eq phase :building)
          (unless (and (null (getf value :directories)) (null (getf value :entries)) (zerop step))
            (error "building configuration cannot claim staged identities or installation progress"))
          (progn
            (setf directories (physical-reseed-follow-configuration-directories-copy
                               (getf value :directories) device identities)
                  entries (physical-reseed-follow-configuration-entries-copy
                           (getf value :entries) images device identities))
            (unless (case phase (:staged (zerop step)) (:installing (<= step maximum)) (:inert (= step maximum)))
              (error "configuration phase differs from its installation prefix"))))
      (list :phase phase :generation (getf value :generation) :anchor-digest (getf value :anchor-digest)
            :time (getf value :time) :workspace workspace :directories directories
            :images images :entries entries :step step))))

(defun physical-reseed-follow-configuration-check-transition (previous candidate core)
  (let ((before (and previous (physical-reseed-follow-configuration-copy previous core)))
        (after (and candidate (physical-reseed-follow-configuration-copy candidate core))))
    (unless after
      (when before (error "configuration intent cannot be removed"))
      (return-from physical-reseed-follow-configuration-check-transition t))
    (unless before
      (unless (eq :building (getf after :phase))
        (error "configuration selection must begin with building intent"))
      (return-from physical-reseed-follow-configuration-check-transition t))
    (unless (every (lambda (key) (equal (getf before key) (getf after key)))
                   '(:generation :anchor-digest :time :workspace :images))
      (error "configuration intent cannot be rebound"))
    (let ((old (getf before :phase)) (new (getf after :phase))
                                     (old-step (getf before :step)) (new-step (getf after :step)))
      (unless (or (and (eq old :building) (eq new :staged))
                  (and (equal (getf before :directories) (getf after :directories))
                       (equal (getf before :entries) (getf after :entries))))
        (error "staged configuration identities cannot change"))
      (unless (cond
                ((eq old new)
                 (if (eq old :installing) (<= old-step new-step (1+ old-step)) (= old-step new-step)))
                ((and (eq old :building) (eq new :staged)) t)
                ((and (eq old :staged) (eq new :installing)) (zerop new-step))
                ((and (eq old :installing) (eq new :inert)) (= old-step new-step)))
        (error "configuration cannot reverse phases or skip its installation prefix")))
    t))
