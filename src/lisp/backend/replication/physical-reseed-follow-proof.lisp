(in-package #:pg)

(defun physical-reseed-follow-proof-at (owner root-fd value)
  (let* ((record (physical-reseed-follow-copy value))
         (generations (getf record :generations))
         (request (getf (getf record :attempt) :request)))
    (unless (and (= 1 (length generations)) (eq :proved (getf (first generations) :phase)))
      (error "target follow historical proof requires one proved generation"))
    (physical-reseed-check-owner owner)
    (let ((stat (sb-posix:fstat root-fd)))
      (unless (and (= (physical-adoption-owner-device owner) (sb-posix:stat-dev stat))
                   (= (physical-adoption-owner-inode owner) (sb-posix:stat-ino stat)))
        (error "target follow proof descriptor differs from its owner")))
    (call-with-physical-backup-image-directory
     root-fd
     (lambda (directory)
       (let ((*pgdata* directory))
         (multiple-value-bind (checked base control)
             (physical-reseed-follow-check-local-intent owner root-fd record)
           (declare (ignore checked))
           (unless (and (zerop (getf control :phase))
                        (= (getf base :manifest-digest) (getf (getf record :base) :manifest-digest))
                        (equal (getf base :cluster-identity) (getf request :cluster-identity)))
             (error "target follow proof differs from its immutable phase-zero base"))
           (let ((anchor (physical-reseed-follow-generation-anchor (first generations))))
             (multiple-value-bind (binding model) (physical-follow-empty-base-binding base anchor)
               (values binding model (physical-follow-validate-empty-base-replay model base binding))))))))))

(defun physical-reseed-follow-check-stable-record-at (owner root-fd value)
  (let* ((record (physical-reseed-follow-copy value))
         (generations (getf record :generations)))
    (if (and (= 1 (length generations)) (eq :proved (getf (first generations) :phase)))
        (physical-reseed-follow-proof-at owner root-fd record)
        (progn
          (physical-reseed-follow-intent-copy record)
          (physical-reseed-follow-check-active-attempt owner)
          (physical-reseed-follow-check-local-intent owner root-fd record)))
    record))

(defun physical-reseed-follow-recovery-candidate-at (owner root-fd value previous)
  (let* ((record (physical-reseed-follow-copy value))
         (generations (getf record :generations)))
    (physical-reseed-follow-check-active-attempt owner)
    (if (and (= 1 (length generations)) (eq :proved (getf (first generations) :phase)))
        (progn
          (unless (and previous
                       (= 1 (length (getf (physical-reseed-follow-intent-copy previous) :generations))))
            (error "target follow proved recovery requires its durable preparing predecessor"))
          (physical-reseed-follow-check-transition previous record)
          (physical-reseed-follow-proof-at owner root-fd record))
        (progn
          (physical-reseed-follow-intent-copy record previous)
          (physical-reseed-follow-check-local-intent owner root-fd record)))
    record))
