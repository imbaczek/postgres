(in-package #:pg)

(defun logical-slot-continuation-prepared-encode (record)
  ;; Encode a checked transition in the bounded, checksummed envelope.
  ;; Encoding is pure and does not publish or authorize the transition.
  (multiple-value-bind (checked size) (logical-slot-continuation-prepared-check record)
    (declare (ignore checked))
    (let ((bytes (make-array size :element-type '(unsigned-byte 8) :initial-element 0))
          (position 20)
          (old (logical-slot-continuation-encode (getf record :old)))
          (new (logical-slot-continuation-encode (getf record :new))))
      (replace bytes #(80 71 76 79 71 67 79 78 84 80 82 69 80 49 0 0))
      (wal-set-u32 bytes 16 (- size 24))
      (labels ((u8 (value) (setf (aref bytes position) value) (incf position))
               (u32 (value) (wal-set-u32 bytes position value) (incf position 4))
               (u64 (value) (wal-set-u64 bytes position value) (incf position 8))
               (blob (value)
                 (u32 (length value)) (replace bytes value :start1 position) (incf position (length value)))
               (point (value)
                 (u64 (first value)) (u32 (second value))
                 (u8 (ecase (third value) (:record-start 1) (:prefix-end 2)))))
        (u8 (ecase (getf record :kind) (:native-ack 1) (:standard-ack 2)))
        (blob (map '(vector (unsigned-byte 8)) #'char-code (getf record :name)))
        (blob old) (blob new)
        (point (getf record :ack))
        (point (getf record :restart-floor))
        (point (getf record :proof-end)))
      (unless (= position (- size 4)) (error "prepared continuation size changed"))
      (wal-set-u32 bytes position (wal-crc32 bytes 0 position))
      bytes)))

(defun logical-slot-continuation-prepared-check-envelope (bytes)
  ;; Check the envelope bounds, framing and checksum before decoding fields.
  (unless (and (typep bytes '(vector (unsigned-byte 8)))
               (<= 24 (length bytes) (logical-slot-continuation-prepared-maximum-bytes))
               (equalp (subseq bytes 0 16) #(80 71 76 79 71 67 79 78 84 80 82 69 80 49 0 0))
               (= (wal-u32 bytes 16) (- (length bytes) 24))
               (= (wal-u32 bytes (- (length bytes) 4)) (wal-crc32 bytes 0 (- (length bytes) 4))))
    (error "invalid prepared continuation envelope"))
  bytes)

(defun logical-slot-continuation-prepared-decode (bytes)
  ;; Decode bounded fields and require an exact canonical re-encoding.
  ;; A valid record still needs the caller's live authority checks.
  (logical-slot-continuation-prepared-check-envelope bytes)
  (let ((position 20) (end (- (length bytes) 4)))
    (labels ((take (count)
               (unless (<= count (- end position)) (error "truncated prepared continuation"))
               (prog1 position (incf position count)))
             (u8 () (aref bytes (take 1)))
             (u32 () (wal-u32 bytes (take 4)))
             (u64 () (wal-u64 bytes (take 8)))
             (blob (minimum maximum)
               (let ((size (u32)))
                 (unless (<= minimum size maximum) (error "oversized prepared continuation blob"))
                 (subseq bytes (take size) position)))
             (point () (list (u64) (u32) (ecase (u8) (1 :record-start) (2 :prefix-end)))))
      (let* ((kind (ecase (u8) (1 :native-ack) (2 :standard-ack)))
             (name (map 'string #'code-char (blob 1 63)))
             (old (logical-slot-continuation-decode
                   (blob 24 (logical-slot-continuation-maximum-bytes))))
             (new (logical-slot-continuation-decode
                   (blob 24 (logical-slot-continuation-maximum-bytes))))
             (ack (point)) (floor (point)) (proof (point))
             (record (list :version 1 :kind kind :name name :old old :new new
                           :ack ack :restart-floor floor :proof-end proof)))
        (unless (= position end) (error "trailing prepared continuation bytes"))
        (unless (equalp bytes (logical-slot-continuation-prepared-encode record))
          (error "noncanonical prepared continuation"))
        record))))
