(in-package #:pg)

(defun print-logical-slot-copy-capture (capture stream)
  (print-unreadable-object (capture stream :type t :identity t)))

(defstruct (logical-slot-copy-capture (:constructor %make-logical-slot-copy-capture)
                                      (:print-object print-logical-slot-copy-capture))
  (source nil :read-only t) (context nil :read-only t)
  (catalog nil :read-only t) (registry nil :read-only t)
  (policy nil :read-only t) (owners nil :read-only t)
  (facts nil :read-only t) (expected nil :read-only t))

(defvar *logical-slot-copy-captures* nil)

(defun logical-slot-copy-clone-facts (value)
  (typecase value
    (cons (mapcar #'logical-slot-copy-clone-facts value))
    (vector (copy-seq value))
    ((or symbol integer) value)
    (t (error "unsupported logical copy fact"))))

(defun logical-slot-copy-checkpoint-policy-under-lock (source)
  (assert (sb-thread:holding-mutex-p *wal-lock*))
  (logical-slot-startup-check-source source)
  (let* ((end (logical-slot-startup-source-end source))
         (snapshot *wal-checkpoint-snapshot*)
         (policy (wal-checked-logical-policy-under-lock))
         (state (and policy (wal-logical-policy-state policy)))
         (present (get-properties snapshot '(:logical-decoding-enabled))))
    (unless (and (= end *wal-checkpoint-lsn* *wal-durable-lsn* (getf snapshot :end))
                 (if state
                     (and present (= end (wal-logical-status-end state))
                          (= *wal-insert-timeline* (wal-logical-status-timeline state))
                          (eq (getf snapshot :logical-decoding-enabled)
                              (wal-logical-status-enabled state))
                          (eql (getf snapshot :logical-on-start-lsn)
                               (wal-logical-status-on-start-lsn state))
                          (eql (getf snapshot :logical-on-start-timeline)
                               (wal-logical-status-on-start-timeline state)))
                     (not present)))
      (error "logical copy requires the published checkpoint policy at its exact durable end"))
    policy))

(defun logical-slot-copy-file-row (context relative &optional limit)
  (let* ((*physical-image-context* context)
         (path (pgdata-resolve-path relative (physical-image-context-root-path context))))
    (physical-image-check-children context)
    (with-physical-image-input (input path :element-type '(unsigned-byte 8))
      (let* ((fd (sb-sys:fd-stream-fd input))
             (before (physical-image-file-facts fd))
             (size (or limit (sixth before)))
             (digest #xCBF29CE484222325)
             (buffer (make-array 65536 :element-type '(unsigned-byte 8))))
        (unless (and (typep size '(unsigned-byte 64)) (<= size (sixth before)))
          (error "logical copy source prefix exceeds its file"))
        (loop with remaining = size
              while (plusp remaining)
              for count = (read-sequence buffer input :end (min remaining (length buffer)))
              do (when (zerop count) (error "logical copy source prefix was truncated"))
                 (setf digest (physical-store-update-digest-span digest buffer 0 count))
                 (decf remaining count))
        (unless (and (or limit (eq :eof (read-byte input nil :eof)))
                     (equal before (physical-image-file-facts fd))
                     (equal before (physical-image-file-facts -100 (namestring path))))
          (error "logical copy source file changed while capturing its prefix"))
        (physical-image-check-children context)
        (list (copy-seq relative) size digest before)))))

(defun logical-slot-copy-registry-owners-under-lock (source)
  (assert (sb-thread:holding-mutex-p *wal-lock*))
  (loop for entry in (logical-slot-startup-source-entries source)
        for slot = (logical-slot-startup-entry-slot entry)
        when (wal-logical-slot-p slot)
          collect
          (let* ((name (wal-replication-slot-name slot))
                 (live (gethash name *wal-replication-slots*)))
            (unless (and live (wal-logical-slot-p live)
                         (null (wal-replication-slot-active-owner live))
                         (equalp (logical-slot-startup-entry-bytes entry)
                                 (wal-encode-replication-slot live)))
              (error "logical copy requires its exact inactive registered logical slots"))
            (list (copy-seq name) live (wal-slot-profile live)
                  (wal-replication-slot-logical-provenance live)
                  (copy-seq (logical-slot-startup-entry-bytes entry))
                  (wal-replication-slot-pending-xids live)
                  (let ((copy (make-hash-table :test #'eql)))
                    (maphash (lambda (xid value) (setf (gethash xid copy) (copy-tree value)))
                             (wal-replication-slot-pending-xids live))
                    copy)))))

(defun logical-slot-copy-check-slot-lifetime (slot state history end)
  (unless (and (wal-logical-slot-p slot) (wal-replication-slot-logical-provenance slot))
    (error "logical copy requires known logical slot provenance"))
  (logical-slot-check-primary-history slot history)
  (when (eq :reserved (wal-replication-slot-wal-status slot))
    (let* ((provenance (wal-replication-slot-logical-provenance slot))
           (birth (wal-replication-slot-consistent-lsn slot))
           (owner (logical-slot-provenance-birth-timeline provenance))
           (on (logical-slot-provenance-on-start-lsn provenance)))
      (unless (and (eq :proved-on
                       (logical-slot-on-coverage state history birth owner :prefix-end
                                                 end (timeline-at-point (1- end) history)))
                   (or (null on)
                       (and (eql on (wal-logical-status-on-start-lsn state))
                            (eql (logical-slot-provenance-on-start-timeline provenance)
                                 (wal-logical-status-on-start-timeline state)))))
        (error "logical copy cannot prove the slot birth inside the current ON interval"))))
  slot)

(defun logical-slot-copy-check-slot-lifetime-under-lock (source policy history)
  (assert (sb-thread:holding-mutex-p *wal-lock*))
  (let ((state (and policy (wal-logical-policy-state policy)))
        (end (logical-slot-startup-source-end source)))
    (dolist (entry (logical-slot-startup-source-entries source))
      (let ((slot (logical-slot-startup-entry-slot entry)))
        (when (wal-logical-slot-p slot)
          (logical-slot-copy-check-slot-lifetime slot state history end))))))

(defun logical-slot-copy-check-capture-scope (capture)
  (unless (and (logical-slot-copy-capture-p capture)
               (member capture *logical-slot-copy-captures* :test #'eq))
    (error "logical copy capture scope has ended or changed thread"))
  (logical-slot-startup-check-live (logical-slot-copy-capture-source capture))
  capture)

(defun call-with-logical-slot-copy-capture-check (capture function)
  (logical-slot-copy-check-capture-scope capture)
  (let ((source (logical-slot-copy-capture-source capture)))
    (flet ((revoke (condition)
             (declare (ignore condition))
             (setf (logical-slot-startup-source-active-p source) nil)))
      (handler-bind ((error #'revoke)
                     (sb-ext:timeout #'revoke))
        (funcall function source)))))

(defun logical-slot-copy-check-captured-source-under-lock (capture)
  (assert (sb-thread:holding-mutex-p *wal-lock*))
  (call-with-logical-slot-copy-capture-check
   capture
   (lambda (source)
     (let ((facts (logical-slot-copy-capture-expected capture)))
       (logical-slot-startup-check-source source)
       (unless (and (eq *catalog* (logical-slot-copy-capture-catalog capture))
                    (eq *wal-replication-slots* (logical-slot-copy-capture-registry capture))
                    (= (length (logical-slot-copy-capture-owners capture))
                       (loop for slot being the hash-values of *wal-replication-slots*
                             count (wal-logical-slot-p slot)))
                    (eq (logical-slot-copy-capture-policy capture)
                        (logical-slot-copy-checkpoint-policy-under-lock source))
                    (equalp (logical-slot-copy-capture-facts capture) facts)
                    (eql (getf facts :next-xid) *next-xid*)
                    (equalp (getf facts :cluster-identity) (catalog-cluster-identity *catalog*))
                    (eql (getf facts :system-id) (physical-slot-startup-system-id))
                    (equalp (getf facts :history)
                            (if (= 1 (getf facts :timeline))
                                (make-array 0 :element-type '(unsigned-byte 8))
                                (timeline-history-bytes (getf facts :timeline)))))
         (error "logical copy frozen source changed"))
       (dolist (row (logical-slot-copy-capture-owners capture))
         (destructuring-bind (name slot profile provenance image pending pending-image) row
           (unless (and (eq slot (gethash name *wal-replication-slots*))
                        (null (wal-replication-slot-active-owner slot))
                        (eq profile (wal-slot-profile slot))
                        (eq provenance (wal-replication-slot-logical-provenance slot))
                        (eq pending (wal-replication-slot-pending-xids slot))
                        (equalp pending-image pending)
                        (equalp image (wal-encode-replication-slot slot)))
             (error "logical copy registered slot changed"))))
       t))))

(defun logical-slot-copy-check-capture (capture &key (files t))
  (call-with-logical-slot-copy-capture-check
   capture
   (lambda (source)
     (let* ((context (logical-slot-copy-capture-context capture))
            (*pgdata* (physical-image-context-root-path context))
            (*physical-image-context* context))
       (logical-slot-startup-check-authority source)
       (logical-slot-copy-check-identity (logical-slot-startup-source-gate-owner source)
                                         (logical-slot-startup-source-ownership source))
       (physical-image-check-context context)
       (physical-image-check-children context)
       (let ((expected
               (loop for entry in (logical-slot-startup-source-entries source)
                     collect (cons (wal-replication-slot-name (logical-slot-startup-entry-slot entry))
                                   (logical-slot-startup-entry-bytes entry))))
             (actual (slot-state-map
                      (merge-pathnames
                       "pg_replslot/"
                       (postmaster-ownership-directory
                        (logical-slot-startup-source-ownership source)))
                      (lambda (bytes name) (cons name bytes))
                      :parent-fd (physical-image-context-root-fd context) :local-workspace t)))
         (unless (equalp (sort expected #'string< :key #'car) (sort actual #'string< :key #'car))
           (error "logical copy disk slot inventory changed")))
       (when files
         (unless (equal (mapcar #'first (getf (logical-slot-copy-capture-expected capture) :files))
                        (physical-bootstrap-inventory))
           (error "logical copy base file inventory changed"))
         (dolist (row (getf (logical-slot-copy-capture-expected capture) :files))
           (unless (equal (fourth row)
                          (physical-image-file-facts
                           -100 (namestring (pgdata-resolve-path (first row) *pgdata*))))
             (error "logical copy captured base file changed"))))
       (sb-thread:with-mutex (*wal-lock*)
         (logical-slot-copy-check-captured-source-under-lock capture))
       t))))

(defun call-with-logical-slot-copy-capture (gate-owner ownership context function)
  (unless (physical-image-read-context-p context)
    (error "logical copy capture requires its held read scope"))
  (physical-image-check-context context)
  (let ((system-id (logical-slot-copy-check-identity gate-owner ownership))
        (entries
          (logical-slot-startup-read-inventory
           :cleanup nil :local-workspace t
           :root (merge-pathnames "pg_replslot/" (postmaster-ownership-directory ownership))
           :parent-fd (physical-image-context-root-fd context))))
    (call-with-logical-slot-startup-source
     gate-owner ownership entries
     (lambda (source)
       (let* ((timeline (logical-slot-startup-source-timeline source))
              (history-bytes (if (= timeline 1) (make-array 0 :element-type '(unsigned-byte 8))
                                 (timeline-history-bytes timeline)))
              (history (timeline-check-lineage
                        (timeline-parse-history timeline (bytes->string history-bytes))))
              (policy nil) (owners nil)
              (end (logical-slot-startup-source-end source))
              (last (concatenate 'string "pg_wal/"
                                 (file-namestring (wal-segment-path (floor (1- end) +wal-segment-size+)))))
              (facts nil))
         (sb-thread:with-mutex (*wal-lock*)
           (setf policy (logical-slot-copy-checkpoint-policy-under-lock source))
           (logical-slot-copy-check-slot-lifetime-under-lock source policy history)
           (setf owners (logical-slot-copy-registry-owners-under-lock source))
           (unless (= (length owners)
                      (loop for slot being the hash-values of *wal-replication-slots*
                            count (wal-logical-slot-p slot)))
             (error "logical copy registered inventory differs from disk")))
         (setf facts
               (list :system-id system-id :timeline timeline :namespace (logical-slot-startup-source-namespace source)
                     :end end :checkpoint *wal-checkpoint-lsn*
                     :checkpoint-start (wal-checkpoint-record-start end) :next-xid *next-xid*
                     :cluster-identity (copy-seq (catalog-cluster-identity *catalog*))
                     :control (copy-seq (logical-slot-startup-source-control source))
                     :history (copy-seq history-bytes)
                     :slots (sort (loop for entry in entries
                                        for slot = (logical-slot-startup-entry-slot entry)
                                        when (wal-logical-slot-p slot)
                                          collect (list (copy-seq (wal-replication-slot-name slot))
                                                        (copy-seq (logical-slot-startup-entry-bytes entry))))
                                  #'string< :key #'first)
                     :files (loop for name in (physical-bootstrap-inventory)
                                  collect (logical-slot-copy-file-row
                                           context name (when (equal name last)
                                                          (1+ (mod (1- end) +wal-segment-size+)))))))
         (let* ((capture (%make-logical-slot-copy-capture
                          :source source :context context :catalog *catalog* :registry *wal-replication-slots*
                          :policy policy :owners owners :facts facts
                          :expected (logical-slot-copy-clone-facts facts)))
                (*logical-slot-copy-captures* (cons capture *logical-slot-copy-captures*)))
           (logical-slot-copy-check-capture capture :files t)
           (multiple-value-prog1 (funcall function capture)
             (logical-slot-copy-check-capture capture :files t))))))))
