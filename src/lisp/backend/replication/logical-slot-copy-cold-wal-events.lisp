(in-package #:pg)

(defun logical-slot-copy-cold-wal-leaf (ledger path)
  (multiple-value-bind (parent leaf)
      (physical-image-input-parent (logical-slot-copy-cold-wal-ledger-context ledger) (pathname path))
    (unless (= parent (logical-slot-copy-cold-wal-ledger-directory ledger))
      (error "cold WAL observer path escaped its held directory"))
    leaf))

(defun logical-slot-copy-cold-wal-begin (ledger kind)
  (let ((step (first (logical-slot-copy-cold-wal-ledger-schedule ledger))))
    (unless (and step (null (logical-slot-copy-cold-wal-ledger-operation ledger))
                 (eq kind (case (first step) ((:history-create :history-sync) :history)
                                (otherwise (first step)))))
      (error "cold WAL observer operation is out of order"))
    (setf (logical-slot-copy-cold-wal-ledger-operation ledger)
          (list :step step :phase :begin :row nil :victim nil :after nil))
    step))

(defun logical-slot-copy-cold-wal-require (ledger kinds phases)
  (let* ((operation (logical-slot-copy-cold-wal-ledger-operation ledger))
         (step (getf operation :step)))
    (unless (and operation (member (first step) kinds) (member (getf operation :phase) phases))
      (error "cold WAL observer event has the wrong phase"))
    operation))

(defun logical-slot-copy-cold-wal-witness (ledger row &optional borrowed)
  (unless row (error "cold WAL observer lost its bound inode"))
  (unless (fourth row)
    (setf (fourth row) (funcall (logical-slot-copy-cold-wal-ledger-acquire ledger)
                                (if borrowed :dup :open) (or borrowed (first row)))))
  (unless (and (equal (second row) (physical-image-file-facts (fourth row)))
               (or (null borrowed) (equal (second row) (physical-image-file-facts borrowed))))
    (error "cold WAL observer descriptor differs from its bound inode"))
  row)

(defun logical-slot-copy-cold-wal-finish (ledger)
  (setf (logical-slot-copy-cold-wal-ledger-operation ledger) nil)
  (pop (logical-slot-copy-cold-wal-ledger-schedule ledger)))

(defun logical-slot-copy-cold-wal-created (ledger kind name fd)
  (unless fd (error "cold WAL creation has no descriptor"))
  (let* ((step (logical-slot-copy-cold-wal-begin ledger kind))
         (directory (logical-slot-copy-cold-wal-ledger-directory ledger))
         (facts (physical-image-file-facts fd))
         (operation (logical-slot-copy-cold-wal-ledger-operation ledger)))
    (unless (and (not (logical-slot-copy-cold-wal-row ledger name))
                 (case (first step)
                   (:prefix (eq :timeline (logical-slot-copy-cold-scratch-kind name)))
                   (:history-create (eq :history (logical-slot-copy-cold-scratch-kind name)))
                   (:frame (equal name (second step))))
                 (zerop (sixth facts))
                 (logical-slot-copy-import-control-private-facts-p
                  facts (logical-slot-copy-cold-wal-ledger-directory-facts ledger))
                 (equal facts (physical-image-file-facts directory name)))
      (error "cold WAL creation differs from scheduled empty private inode"))
    (let ((row (list name facts (make-array 0 :element-type '(unsigned-byte 8))
                     (funcall (logical-slot-copy-cold-wal-ledger-acquire ledger) :dup fd))))
      (push row (logical-slot-copy-cold-wal-ledger-rows ledger))
      (setf (getf operation :row) row
            (getf operation :phase) :opened
            (getf operation :after)
            (if (eq :frame (first step))
                (logical-slot-copy-cold-wal-frame-postimage (third row) (fourth step) (third step))
                (third step))))
    (logical-slot-copy-cold-wal-check-rows ledger t)))

(defun logical-slot-copy-cold-wal-opened (ledger kind name fd)
  (unless fd (error "cold WAL open has no descriptor"))
  (let* ((step (logical-slot-copy-cold-wal-begin ledger kind))
         (operation (logical-slot-copy-cold-wal-ledger-operation ledger))
         (row (logical-slot-copy-cold-wal-row ledger name)))
    (unless (and (member (first step) '(:history-sync :frame)) (equal name (second step)))
      (error "cold WAL open differs from scheduled path"))
    (logical-slot-copy-cold-wal-check-rows ledger)
    (logical-slot-copy-cold-wal-witness ledger row fd)
    (when (and (eq :history-sync (first step)) (not (equalp (third row) (third step))))
      (error "cold WAL history resync differs from immutable history"))
    (setf (getf operation :row) row (getf operation :phase) :opened
          (getf operation :after)
          (if (eq :frame (first step))
              (logical-slot-copy-cold-wal-frame-postimage (third row) (fourth step) (third step))
              (third step)))))

(defun logical-slot-copy-cold-wal-written (ledger kind name fd)
  (let* ((operation (logical-slot-copy-cold-wal-require
                     ledger '(:prefix :history-create :history-sync :frame) '(:opened)))
         (step (getf operation :step)) (row (getf operation :row))
         (before (second row)) (after (physical-image-file-facts (fourth row)))
         (bytes (getf operation :after)) (changed (not (equalp (third row) bytes))))
    (unless (and fd (equal name (first row))
                 (eq kind (case (first step) ((:history-create :history-sync) :history)
                                (otherwise (first step))))
                 (= (sixth after) (length bytes))
                 (logical-slot-copy-cold-facts-match-p before after (when changed '(5 6 7)))
                 (equal after (physical-image-file-facts fd))
                 (equal after (physical-image-file-facts (logical-slot-copy-cold-wal-ledger-directory ledger) name))
                 (equalp bytes (logical-slot-copy-cold-wal-read
                                (logical-slot-copy-cold-wal-ledger-directory ledger) name after (length bytes))))
      (error "cold WAL written inode or postimage differs from planned write"))
    (setf (second row) after (third row) (copy-seq bytes) (getf operation :phase) :written)
    (logical-slot-copy-cold-wal-check-rows ledger)
    (when (member (first step) '(:history-sync :frame)) (logical-slot-copy-cold-wal-finish ledger))))

(defun logical-slot-copy-cold-wal-before-unlink (ledger kind name)
  (when (eq kind :orphan) (logical-slot-copy-cold-wal-begin ledger kind))
  (let* ((operation (logical-slot-copy-cold-wal-require
                     ledger '(:orphan :prefix :history-create) '(:begin :written :installed)))
         (step (getf operation :step))
         (row (logical-slot-copy-cold-wal-row ledger name)))
    (unless (and (eq kind (case (first step) (:history-create :history) (otherwise (first step))))
                 (ecase (first step)
                   (:orphan (and (eq :begin (getf operation :phase)) (equal name (second step))))
                   (:prefix (and (eq :written (getf operation :phase)) (equal name (second step))))
                   (:history-create
                    (and (eq :installed (getf operation :phase)) (eq row (getf operation :row))))))
      (error "cold WAL unlink differs from scheduled path"))
    (logical-slot-copy-cold-wal-check-rows ledger)
    (logical-slot-copy-cold-wal-witness ledger row)
    (setf (getf operation :victim) row (getf operation :phase) :unlinking)))

(defun logical-slot-copy-cold-wal-unlinked (ledger kind name)
  (let* ((operation (logical-slot-copy-cold-wal-require
                     ledger '(:orphan :prefix :history-create) '(:unlinking)))
         (step (getf operation :step)) (row (getf operation :victim))
         (before (second row)) (after (physical-image-file-facts (fourth row))))
    (unless (and (equal name (first row))
                 (eq kind (case (first step) (:history-create :history) (otherwise (first step))))
                 (= (1- (fourth before)) (fourth after))
                 (logical-slot-copy-cold-facts-match-p before after '(3 7)))
      (error "cold WAL unlink changed an unwitnessed inode"))
    (setf (logical-slot-copy-cold-wal-ledger-rows ledger)
          (delete row (logical-slot-copy-cold-wal-ledger-rows ledger) :test #'eq))
    (dolist (alias (logical-slot-copy-cold-wal-ledger-rows ledger))
      (when (logical-slot-copy-cold-scratch-same-inode-p before (second alias))
        (setf (second alias) (copy-list after))))
    (logical-slot-copy-cold-wal-check-rows ledger t)
    (if (eq :prefix (first step)) (setf (getf operation :phase) :written)
        (logical-slot-copy-cold-wal-finish ledger))))

(defun logical-slot-copy-cold-wal-before-install (ledger kind name destination)
  (let* ((operation (logical-slot-copy-cold-wal-require ledger '(:prefix :history-create) '(:written)))
         (step (getf operation :step)) (row (getf operation :row)))
    (unless (and (equal name (first row)) (equal destination (second step))
                 (eq kind (if (eq :prefix (first step)) :prefix :history))
                 (null (logical-slot-copy-cold-wal-row ledger destination)))
      (error "cold WAL install differs from scheduled destination"))
    (logical-slot-copy-cold-wal-check-rows ledger)
    (setf (getf operation :phase) :installing)))

(defun logical-slot-copy-cold-wal-installed (ledger kind name destination)
  (let* ((operation (logical-slot-copy-cold-wal-require ledger '(:prefix :history-create) '(:installing)))
         (step (getf operation :step)) (row (getf operation :row))
         (before (second row)) (after (physical-image-file-facts (fourth row)))
         (history-p (eq :history-create (first step))))
    (unless (and (equal name (first row)) (equal destination (second step))
                 (eq kind (if history-p :history :prefix))
                 (= (fourth after) (if history-p 2 1))
                 (logical-slot-copy-cold-facts-match-p before after (if history-p '(3 7) '(7)))
                 (equal after (physical-image-file-facts
                               (logical-slot-copy-cold-wal-ledger-directory ledger) destination)))
      (error "cold WAL installation did not use its owned scratch inode"))
    (setf (second row) after)
    (if history-p
        (push (list destination (copy-list after) (third row) (fourth row))
              (logical-slot-copy-cold-wal-ledger-rows ledger))
        (setf (first row) (copy-seq destination)))
    (setf (getf operation :phase) :installed)
    (logical-slot-copy-cold-wal-check-rows ledger t)
    (unless history-p (logical-slot-copy-cold-wal-finish ledger))))

(defun logical-slot-copy-cold-wal-observe (ledger event kind path fd &optional destination)
  (let ((name (logical-slot-copy-cold-wal-leaf ledger path))
        (target (when destination (logical-slot-copy-cold-wal-leaf ledger destination))))
    (sb-sys:without-interrupts
      (ecase event
        (:created (logical-slot-copy-cold-wal-created ledger kind name fd))
        (:opened-existing (logical-slot-copy-cold-wal-opened ledger kind name fd))
        (:written (logical-slot-copy-cold-wal-written ledger kind name fd))
        (:before-unlink (logical-slot-copy-cold-wal-before-unlink ledger kind name))
        (:unlinked (logical-slot-copy-cold-wal-unlinked ledger kind name))
        (:before-install (logical-slot-copy-cold-wal-before-install ledger kind name target))
        (:installed (logical-slot-copy-cold-wal-installed ledger kind name target))))))
