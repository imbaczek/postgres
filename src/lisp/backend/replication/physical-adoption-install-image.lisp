;;; Build and verify an independent incoming image from the immutable stage.
;;;
;;; Copying creates new files rather than sharing stage objects.  The caller
;;; must keep the stage immutable throughout preparation and installation.
;;; Verification checks the copy before it can become installation authority.

(in-package #:pg)

(defun physical-adoption-install-copy-file (source target row)
  (destructuring-bind (relative kind mode device inode size digest) row
    (declare (ignore kind device inode digest))
    (let ((from (physical-adoption-install-entry-path source relative))
          (to (physical-adoption-install-entry-path target relative)))
      (multiple-value-bind (input actual-size) (open-bounded-regular-file from size)
        (unwind-protect
             (with-open-file (output to :direction :output :if-exists :error
                                        :element-type '(unsigned-byte 8))
               (let ((stat (sb-posix:fstat (sb-sys:fd-stream-fd input))))
                 (unless (and (= actual-size size)
                              (physical-adoption-install-row-identity-p row stat))
                   (error "adoption stage changed before copying")))
               (let ((buffer (make-array 65536 :element-type '(unsigned-byte 8))))
                 (loop with remaining = size
                       while (plusp remaining)
                       for count = (read-sequence buffer input :end (min remaining (length buffer)))
                       do (when (zerop count) (error "short adoption installation stage read"))
                          (write-sequence buffer output :end count)
                          (decf remaining count)))
               (finish-output output)
               (sb-posix:fchmod (sb-sys:fd-stream-fd output) mode)
               (sb-posix:fsync (sb-sys:fd-stream-fd output))
               (physical-adoption-install-test-point :after-copy-file to))
          (close input))))))

(defun physical-adoption-install-clone (source target expected)
  (let* ((source (uiop:ensure-directory-pathname source))
         (target (uiop:ensure-directory-pathname target))
         (source-fact (physical-adoption-install-directory-fact source))
         (target-fact (physical-adoption-install-auxiliary-fact target)))
    (unless (and (= (getf source-fact :device) (getf target-fact :device))
                 (= (getf source-fact :mount) (getf target-fact :mount))
                 (not (or (uiop:subpathp target source) (uiop:subpathp source target)))
                 (equal '(".pg_lisp.lock" "physical-adoption.install") (physical-adoption-install-entry-names target))
                 (equal expected (physical-adoption-install-snapshot source)))
      (error "adoption installation copy requires an unchanged separate stage and empty target"))
    (let ((rows (loop for entry in expected append (copy-list (second entry)))))
      (dolist (row rows)
        (if (eq :directory (second row))
            (sb-posix:mkdir (namestring (physical-adoption-install-entry-path target (first row))) #o700)
            (physical-adoption-install-copy-file source target row)))
      (dolist (row (reverse rows))
        (when (eq :directory (second row))
          (let ((directory (uiop:ensure-directory-pathname
                            (physical-adoption-install-entry-path target (first row)))))
            (sb-posix:chmod (namestring directory) (third row))
            (fsync-directory directory)))))
    (fsync-directory target)
    (let ((copied (physical-adoption-install-snapshot target :exclude *physical-adoption-install-retained-names*)))
      (unless (and (equal source-fact (physical-adoption-install-directory-fact source))
                   (equal target-fact (physical-adoption-install-auxiliary-fact target))
                   (equal expected (physical-adoption-install-snapshot source))
                   (equal (physical-adoption-install-tree-content expected)
                          (physical-adoption-install-tree-content copied)))
        (error "adoption installation copy differs from its unchanged stage"))
      copied)))

(defun physical-adoption-install-image-state (record)
  (let* ((local (copy-list (getf record :local)))
         (bytes (physical-libpq-datum-octets (getf local :wal-control) (1+ +wal-control-maximum-bytes+)))
         (fields (multiple-value-list (wal-decode-control-line (bytes->string bytes)))))
    (setf (getf local :snapshot) (third fields))
    local))

(defun physical-adoption-installed-base (directory record)
  (let ((*pgdata* directory) (stage (getf record :stage)))
    (authentication-check-backup-policy directory)
    (dolist (entry (getf stage :auth-files))
      (unless (equal entry (subseq (physical-adoption-stage-file-state (first entry) :maximum 1048576) 0 3))
        (error "adoption installed authentication differs from its saved policy")))
    (multiple-value-bind (base control) (physical-recovery-verify-base-state)
      (physical-adoption-stage-check-base-facts
       (physical-adoption-install-image-state record) base control (getf stage :manifest-digest))
      (unless (every (lambda (key) (equal (getf base key) (getf stage key)))
                     '(:system-id :cluster-identity :timeline :checkpoint :checkpoint-start
                       :end :next-xid :manifest-digest :source-pin))
        (error "adoption installed manifest differs from its proved stage"))
      (physical-recovery-read-base-overlap base directory)
      base)))

(defun physical-adoption-install-check-image (directory record &key installed auxiliary)
  (let ((names (append (copy-list *physical-adoption-install-root-names*)
                       (cond (installed (copy-list *physical-adoption-install-retained-names*))
                             (auxiliary (list ".pg_lisp.lock" "physical-adoption.install"))))))
    (unless (equal (sort names #'string<) (physical-adoption-install-entry-names directory))
      (error "adoption installed image has unexpected root entries"))
    (physical-adoption-installed-base directory record)))
