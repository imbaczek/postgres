(in-package #:pg)

(declaim (ftype function logical-slot-copy-descriptor-list-count))

(defun call-with-logical-wal-lane-provider (cursors guard function)
  ;; Stitch at most three contiguous live cursors, advancing only the requested
  ;; lane and rejecting a batch that crosses a seam.  Callbacks are trusted
  ;; internal code; source and publication proofs remain the caller's duty.
  ;; A failed read remains failed even if its caller catches the error.
  (logical-slot-copy-descriptor-list-count cursors 3)
  (unless (and cursors (every #'logical-wal-cursor-p cursors)
               (functionp guard) (functionp function))
    (error "logical WAL lanes require live cursors, a guard and a callback"))
  (let ((lanes nil) (remaining nil) (active t) (failed nil) (busy nil) (provider nil)
                    (thread sb-thread:*current-thread*) (mutex *wal-lock*))
    (sb-thread:with-mutex (*wal-lock*)
      (let ((seen (make-hash-table :test #'eq)) (previous-end nil))
        (dolist (cursor cursors)
          (logical-wal-cursor-check-scope cursor)
          (when (gethash cursor seen) (error "logical WAL lanes reuse a cursor"))
          (when (and previous-end (/= previous-end (logical-wal-cursor-position cursor)))
            (error "logical WAL lanes have a gap or overlap"))
          (setf (gethash cursor seen) t previous-end (logical-wal-cursor-end cursor))
          (push (list cursor (logical-wal-cursor-position cursor) previous-end) lanes)))
      (setf lanes (nreverse lanes) remaining (copy-list lanes)))
    (labels ((check ()
               (assert (sb-thread:holding-mutex-p *wal-lock*))
               (unless (and active (not failed) (eq thread sb-thread:*current-thread*)
                            (eq mutex *wal-lock*))
                 (error "logical WAL lane provider ended, failed or changed owner"))
               (dolist (lane lanes)
                 (logical-wal-cursor-check-scope (first lane))
                 (unless (and (= (second lane) (logical-wal-cursor-position (first lane)))
                              (= (third lane) (logical-wal-cursor-end (first lane))))
                   (error "logical WAL lane changed outside its composed provider")))
               (funcall guard))
             (read-record (position consume)
               (unless (eq thread sb-thread:*current-thread*)
                 (error "logical WAL lane reader changed thread"))
               (sb-sys:without-interrupts
                 (when busy
                   (setf failed t)
                   (error "logical WAL lane reader reentered"))
                 (let ((complete nil))
                   (setf busy t)
                   (unwind-protect
                        (multiple-value-prog1
                            (sb-sys:with-local-interrupts
                              (sb-thread:with-mutex (*wal-lock*)
                                (check)
                                (unless (and provider (logical-wal-record-provider-busy provider))
                                  (error "logical WAL lane reader requires its cursor invocation"))
                                (loop while (and remaining (= (second (first remaining))
                                                              (third (first remaining))))
                                      do (when (and (rest remaining)
                                                    (logical-wal-cursor-batch-open (first (first remaining))))
                                           (error "logical WAL batch crosses a source lane seam"))
                                         (pop remaining))
                                (unless (and remaining (= position (second (first remaining))))
                                  (error "logical WAL lane request differs from its next record")))
                              (let* ((lane (first remaining)) (cursor (first lane)))
                                (multiple-value-bind (record raw owner carrier kind)
                                    (logical-wal-cursor-next cursor)
                                  (declare (ignore owner kind))
                                  (unless record (error "logical WAL lane ended before its declared seam"))
                                  (sb-thread:with-mutex (*wal-lock*)
                                    (setf (second lane) (logical-wal-cursor-position cursor))
                                    (check))
                                  (funcall consume raw (wal-record-start record) carrier)))
                              (sb-thread:with-mutex (*wal-lock*) (check)))
                          (setf complete t))
                     (unless complete (setf failed t))
                     (setf busy nil))))))
      (unwind-protect
           (call-with-logical-wal-record-provider
            #'read-record #'check
            (lambda (selected)
              (setf provider selected)
              (multiple-value-prog1 (funcall function selected)
                (sb-thread:with-mutex (*wal-lock*)
                  (logical-wal-record-provider-check selected)))))
        (sb-sys:without-interrupts (setf active nil))))))
