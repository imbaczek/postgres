;; Image bytes also use the journal's recorded time.  The plan freezes each
;; staged file's identity as well as its expected bytes.

;; Encode and check the follow journal's fixed plan and progress.
;; The plan derives all images and moves from the saved handoff.  Its :reuse-wal
;; field is required and must be NIL: a valid base has history only through its
;; base timeline, while the selected child is newer.  When selection is needed,
;; the child's own native history artifact is always published.
(in-package #:pg)

(defconstant +physical-adoption-follow-body-maximum+
  (+ +physical-adoption-handoff-maximum-bytes+ (* 4 1024 1024)))

(defconstant +physical-adoption-follow-maximum-bytes+
  (+ +physical-adoption-follow-body-maximum+ 4096))

(defun physical-adoption-follow-record (value)
  (getf (getf (getf value :handoff) :installation) :attempt))

(defun physical-adoption-follow-handoff-inodes (handoff)
  (append (physical-adoption-install-plan-inodes (getf handoff :installation))
          (list (getf (getf handoff :attempt-file) :inode)
                (getf (getf handoff :spool) :inode)
                (getf (getf handoff :intent-file) :inode))
          (loop for key in '(:inode :lock-inode :fence-inode)
                collect (getf (getf handoff :workspace) key))
          (loop for entry in (getf handoff :spool-entries)
                append (mapcar #'fifth (second entry)))))

(defun physical-adoption-follow-entry-images (value)
  (let* ((record (physical-adoption-follow-record value))
         (binding (physical-adoption-follow-planned-binding record)))
    (physical-adoption-follow-images record binding (getf value :time))))

(defun physical-adoption-follow-check-history-absence (value)
  (let* ((handoff (getf value :handoff))
         (binding (physical-adoption-follow-planned-binding (physical-adoption-follow-record value)))
         (after (getf binding :after))
         (selected (not (equal (getf binding :before) after)))
         (name (when selected (concatenate 'string "pg_wal/" (timeline-history-filename (eighth after)))))
         (rows (second (assoc "pg_wal" (getf (getf handoff :installation) :new) :test #'equal))))
    (when (or (getf value :reuse-wal) (and name (assoc name rows :test #'equal)))
      (error "adoption follow requires the child history to be absent from its frozen base"))))

;; Validate the plan and its staged image identities, then return a copy.
(defun physical-adoption-follow-copy (value)
  (physical-follow-check-plist
   value '(:version :handoff :handoff-file :workspace :staged :saved :journal :time :entries :reuse-wal))
  (unless (and (eql 1 (getf value :version)) (typep (getf value :time) '(signed-byte 64))
               (null (getf value :reuse-wal)))
    (error "invalid adoption follow plan version, time or reuse flag"))
  (let* ((handoff (physical-adoption-handoff-copy (getf value :handoff)))
         (record (getf (getf handoff :installation) :attempt))
         (device (getf (getf record :local) :device))
         (identities (make-hash-table :test #'equal))
         (file (physical-adoption-handoff-file-copy
                (getf value :handoff-file) device +physical-adoption-handoff-maximum-bytes+)))
    (dolist (inode (physical-adoption-follow-handoff-inodes handoff))
      (physical-adoption-install-register-identity device inode device identities))
    (unless (= (getf file :inode) (getf (getf handoff :intent-file) :inode))
      (error "adoption follow lost its handoff intent identity"))
    (let* ((workspace (physical-adoption-install-fact-copy
                       (getf value :workspace) device identities :directory t :guarded t))
           (staged (physical-adoption-install-fact-copy (getf value :staged) device identities))
           (saved (physical-adoption-install-fact-copy (getf value :saved) device identities))
           (journal (physical-adoption-install-fact-copy (getf value :journal) device identities))
           (entries (physical-adoption-install-trees-copy (getf value :entries) device identities))
           (work (pathname (getf workspace :directory)))
           (copy (list :version 1 :handoff handoff :handoff-file file :workspace workspace
                       :staged staged :saved saved :journal journal :time (getf value :time)
                       :entries entries :reuse-wal (getf value :reuse-wal))))
      (dolist (other (list (getf (getf record :local) :directory)
                           (getf (getf record :stage) :directory)
                           (getf (getf (getf handoff :installation) :workspace) :directory)
                           (getf (getf handoff :workspace) :directory)))
        (when (or (uiop:subpathp work (pathname other)) (uiop:subpathp (pathname other) work))
          (error "adoption follow workspace overlaps protected installation data")))
      (physical-adoption-follow-check-history-absence copy)
      (let ((images (physical-adoption-follow-entry-images copy)))
        (unless (equal (mapcar #'first entries) (sort (mapcar #'car images) #'string<))
          (error "adoption follow staged metadata names differ from its fixed plan"))
        (dolist (entry entries)
          (let* ((rows (second entry)) (row (first rows))
                                       (bytes (cdr (assoc (first entry) images :test #'equal))))
            (unless (and (= 1 (length rows)) (eq :file (second row)) (= #o600 (third row))
                         (= (sixth row) (length bytes))
                         (= (seventh row) (physical-store-update-digest #xCBF29CE484222325 bytes)))
              (error "adoption follow staged metadata differs from its derived image")))))
      copy)))

;; Derive the ordered no-replace moves; the journal stores progress as a prefix.
(defun physical-adoption-follow-moves (value)
  (let* ((binding (physical-adoption-follow-planned-binding (physical-adoption-follow-record value)))
         (after (getf binding :after))
         (selected (not (equal (getf binding :before) after)))
         (receive (when selected (physical-store-history-filename (eighth after) (ninth after))))
         (wal (when selected (timeline-history-filename (eighth after)))))
    (append
     (list (list :staged "follow.pending" :root "physical-follow.control")
           (list :root "physical-recovery.control" :saved "recovery.original")
           (list :staged "recovery.initial" :root "physical-recovery.control"))
     (when selected
       (append
        (list (list :staged "history.receive" :spool receive)
              (list :spool "receive.control" :saved "receive.original")
              (list :staged "receive.selected" :spool "receive.control"))
        (list (list :staged "history.wal" :wal wal))
        (list (list :root "physical-recovery.control" :saved "recovery.initial")
              (list :staged "recovery.selected" :root "physical-recovery.control"))))
     (list (list :root "physical-follow.control" :saved "follow.pending")
           (list :staged "follow.active" :root "physical-follow.control")))))

(defun physical-adoption-follow-positions (value step)
  (let* ((handoff (getf value :handoff))
         (control (assoc "physical-recovery.control" (getf (getf handoff :installation) :new) :test #'equal))
         (receive (assoc "receive.control" (getf handoff :spool-entries) :test #'equal))
         (positions
           (append
            (list (list :root "physical-recovery.control" (copy-list (first (second control))))
                  (list :spool "receive.control" (copy-list (first (second receive)))))
            (loop for entry in (getf value :entries)
                  collect (list :staged (first entry) (copy-list (first (second entry)))))))
         (moves (physical-adoption-follow-moves value)))
    (unless (and (typep step '(integer 0 11)) (<= step (length moves)))
      (error "invalid adoption follow move prefix"))
    (dolist (move (subseq moves 0 step))
      (let ((source (find-if (lambda (entry) (and (eq (first entry) (first move))
                                                  (equal (second entry) (second move)))) positions)))
        (unless (and source
                     (not (find-if (lambda (entry) (and (eq (first entry) (third move))
                                                        (equal (second entry) (fourth move)))) positions)))
          (error "derived adoption follow move has no unique source and empty destination"))
        (setf (first source) (third move) (second source) (fourth move))))
    positions))

(defun physical-adoption-follow-image (value step)
  (let* ((plan (physical-adoption-follow-copy value))
         (body (string->bytes (physical-bootstrap-manifest-text plan)))
         (crc (wal-crc32 body))
         (header (string->bytes (format nil "PGADOPTIONFOLLOW1 ~d ~8,'0X~%" (length body) crc)))
         (image (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0)))
    (unless (and (typep step '(integer 0 11)) (<= step (length (physical-adoption-follow-moves plan)))
                 (<= (length body) +physical-adoption-follow-body-maximum+))
      (error "adoption follow image exceeds its bound"))
    (flet ((emit (bytes) (loop for byte across bytes do (vector-push-extend byte image))))
      (emit header) (emit body) (emit #(10))
      (loop for index from 1 to step do (emit (physical-adoption-install-step-image crc index))))
    image))

(defun physical-adoption-follow-decode (bytes)
  (unless (and (typep bytes '(vector (unsigned-byte 8)))
               (<= (length bytes) +physical-adoption-follow-maximum-bytes+))
    (error "invalid or oversized adoption follow journal"))
  (let* ((newline (position 10 bytes))
         (parts (and newline (uiop:split-string (bytes->string (subseq bytes 0 newline)) :separator " "))))
    (unless (and (= 3 (length parts)) (equal "PGADOPTIONFOLLOW1" (first parts))
                 (<= 1 (length (second parts)) 9) (every #'digit-char-p (second parts))
                 (= 8 (length (third parts))))
      (error "invalid adoption follow journal header"))
    (let* ((size (parse-integer (second parts))) (crc (parse-integer (third parts) :radix 16))
                                                 (start (1+ newline)) (end (+ start size)))
      (unless (and (<= 1 size +physical-adoption-follow-body-maximum+)
                   (< end (length bytes)) (= 10 (aref bytes end))
                   (= crc (wal-crc32 (subseq bytes start end)))
                   (equal (bytes->string (subseq bytes 0 start))
                          (format nil "PGADOPTIONFOLLOW1 ~d ~8,'0X~%" size crc)))
        (error "adoption follow journal length or checksum mismatch"))
      (let* ((plan (physical-adoption-follow-copy
                    (recovery-parse-manifest-text (bytes->string (subseq bytes start end)))))
             (position (1+ end)) (step 0) (partial nil)
             (last (length (physical-adoption-follow-moves plan))))
        (loop while (< position (length bytes))
              do (when (= step last) (error "extra progress after completed adoption follow"))
                 (let* ((next (physical-adoption-install-step-image crc (1+ step)))
                        (count (min (length next) (- (length bytes) position))))
                   (unless (equalp (subseq bytes position (+ position count)) (subseq next 0 count))
                     (error "invalid adoption follow progress"))
                   (when (< count (length next)) (setf partial t) (return))
                   (incf position count) (incf step)))
        (list :plan plan :step step :valid-length position :file-size (length bytes)
              :header-length (1+ end) :body-crc crc :partial partial)))))
