(in-package #:pg)

(defstruct (logical-slot-copy-import-control-owner
            (:include logical-slot-copy-import-owner)
            (:constructor %make-logical-slot-copy-import-control-owner)
            (:print-function physical-libpq-print-private-object)))

(defstruct (logical-slot-copy-import-control-state
            (:constructor %make-logical-slot-copy-import-control-state)
            (:print-function physical-libpq-print-private-object))
  (owner nil :read-only t) (context nil :read-only t) (source nil :read-only t)
  (source-check nil :read-only t) (plan nil :read-only t) (certificate nil :read-only t)
  (certificate-bytes nil :read-only t) (certificate-facts nil :read-only t)
  (evidence-bytes nil :read-only t) (evidence-facts nil :read-only t)
  (manifest nil :read-only t) (expected nil :read-only t)
  (root nil :read-only t) (global nil :read-only t)
  (global-facts nil :read-only t) (global-children nil :read-only t)
  (child-observations nil :read-only t)
  (mark-started nil :read-only t)
  seal fd facts bytes phase active failed)

(defvar *logical-slot-copy-import-control-states* nil)

(defun logical-slot-copy-import-control-prefix-p (bytes expected)
  (and (typep bytes '(vector (unsigned-byte 8)))
       (typep expected '(vector (unsigned-byte 8)))
       (<= (length bytes) (length expected))
       (null (mismatch bytes expected :end2 (length bytes)))))

(defmethod physical-adoption-check-owner-role ((owner logical-slot-copy-import-control-owner))
  (call-next-method)
  (unless (and (eq :cold (logical-slot-copy-import-owner-mode owner))
               (= 3 (logical-slot-copy-import-owner-phase owner))
               (sb-thread:holding-mutex-p *physical-follow-generation-lock*))
    (error "control temporary reconciliation requires cold phase 3 generation exclusion"))
  owner)

(defun logical-slot-copy-import-control-image (record)
  (let ((plan (logical-slot-copy-import-control-state-plan record)))
    (list (logical-slot-copy-import-control-state-source record)
          (logical-slot-copy-import-control-state-source-check record)
          (logical-slot-copy-import-control-state-mark-started record)
          (logical-slot-copy-import-control-state-certificate record)
          (logical-slot-copy-import-control-state-certificate-bytes record)
          (logical-slot-copy-import-control-state-certificate-facts record)
          (logical-slot-copy-import-control-state-evidence-bytes record)
          (logical-slot-copy-import-control-state-evidence-facts record)
          (logical-slot-copy-import-control-state-manifest record)
          (logical-slot-copy-import-control-state-expected record)
          (logical-slot-copy-import-control-state-root record)
          (logical-slot-copy-import-control-state-global record)
          (logical-slot-copy-import-control-state-global-facts record)
          (logical-slot-copy-import-control-state-global-children record)
          (logical-slot-copy-import-control-state-child-observations record)
          (logical-slot-copy-import-pending-plan-value plan)
          (logical-slot-copy-import-pending-plan-state plan)
          (logical-slot-copy-import-pending-plan-state-image plan)
          (logical-slot-copy-import-pending-plan-metadata plan)
          (logical-slot-copy-import-pending-plan-prefix plan)
          (logical-slot-copy-import-pending-plan-generation plan)
          (logical-slot-copy-import-pending-plan-control plan)
          (logical-slot-copy-import-pending-plan-child-plan plan)
          (logical-slot-copy-import-pending-plan-observations plan)
          (logical-slot-copy-import-pending-plan-selected-history plan)
          (logical-slot-copy-import-pending-plan-evidence plan)
          (logical-slot-copy-descriptor-encode (logical-slot-copy-import-pending-plan-descriptor plan)))))

(defun logical-slot-copy-import-control-record (record)
  (unless (and (logical-slot-copy-import-control-state-p record)
               (eq record (cdr (assoc (logical-slot-copy-import-control-state-owner record)
                                      *logical-slot-copy-import-control-states* :test #'eq)))
               (logical-slot-copy-import-control-state-active record)
               (not (logical-slot-copy-import-control-state-failed record)))
    (error "control temporary reconciliation scope ended or failed"))
  (let ((context (logical-slot-copy-import-control-state-context record)))
    (logical-slot-copy-check-input (logical-slot-copy-import-control-state-owner record) context)
    (unless (and (eql (logical-slot-copy-import-control-state-root record)
                      (physical-image-context-root-fd context))
                 (eql (logical-slot-copy-import-control-state-global record)
                      (cdr (assoc "global" (physical-image-context-children context) :test #'equal)))
                 (logical-slot-copy-committed-image-equal-p
                  (logical-slot-copy-import-control-state-seal record)
                  (logical-slot-copy-import-control-image record)))
      (error "control temporary reconciliation binding changed")))
  record)

(defun logical-slot-copy-import-control-fences (context)
  (dolist (name '("logical-slot-copy.install" "logical-slot-copy.import.tmp"
                  "logical-slot-copy.evidence.tmp" "logical-slot-copy.in-progress"
                  "logical-slot-copy.base-verified.tmp"))
    (when (slot-state-lstat (slot-state-fd-path (physical-image-context-root-fd context) name))
      (error "control temporary reconciliation has an unresolved installation or copy fence"))))

(defun logical-slot-copy-import-control-check-proof (record &key (source t))
  (let ((complete nil))
    (unwind-protect
         (progn
           (logical-slot-copy-import-control-record record)
           (let ((owner (logical-slot-copy-import-control-state-owner record))
                 (context (logical-slot-copy-import-control-state-context record))
                 (plan (logical-slot-copy-import-control-state-plan record)))
             (logical-slot-copy-import-control-fences context)
             (when source (funcall (logical-slot-copy-import-control-state-source-check record)))
             (logical-slot-copy-import-check-pending-plan owner context plan)
             (multiple-value-bind (value bytes facts) (logical-slot-copy-import-read-artifact context :pending)
               (unless (and (equal value (logical-slot-copy-import-control-state-certificate record))
                            (equalp bytes (logical-slot-copy-import-control-state-certificate-bytes record))
                            (equal facts (logical-slot-copy-import-control-state-certificate-facts record)))
                 (error "control temporary pending certificate changed")))
             (multiple-value-bind (value bytes facts) (logical-slot-copy-import-read-artifact context :evidence)
               (unless (and (equalp bytes (logical-slot-copy-import-control-state-evidence-bytes record))
                            (equal facts (logical-slot-copy-import-control-state-evidence-facts record)))
                 (error "control temporary permanent evidence changed"))
               (logical-slot-copy-import-evidence-check-certificate
                value (logical-slot-copy-import-control-state-certificate record)
                (logical-slot-copy-import-pending-plan-descriptor plan)
                (logical-slot-copy-import-owner-existing-proof owner))
               (when (member (logical-slot-copy-import-control-state-phase record) '(:present :removed))
                 (unless (equal
                          (logical-slot-copy-import-control-state-child-observations record)
                          (logical-slot-copy-check-committed-child
                           context value (logical-slot-copy-import-pending-plan-child-plan plan)
                           (logical-slot-copy-import-pending-plan-prefix plan)
                           (physical-recovery-decode-control (logical-slot-copy-import-pending-plan-control plan))
                           :include-control nil))
                   (error "control temporary staged child binding changed")))))
           (logical-slot-copy-import-control-check-temp record)
           (setf complete t))
      (unless complete
        (setf (logical-slot-copy-import-control-state-failed record) t
              (physical-adoption-owner-active-p (logical-slot-copy-import-control-state-owner record)) nil)))))
