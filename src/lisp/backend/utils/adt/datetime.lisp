(defun sql-date-to-timestamp (date)
  "Promote a date to midnight at the PostgreSQL epoch, including infinities."
  (cond ((= date #x7fffffff) #x7fffffffffffffff)
        ((= date (- #x80000000)) (- #x8000000000000000))
        (t (let ((value (* date +sql-microseconds-per-day+)))
             (unless (<= -211813488000000000 value 9223371331199999999)
               (ereport "22008" "date out of range for timestamp"))
             value))))

(defun sql-timestamp-to-date (timestamp)
  "Convert a UTC or local timestamp to its calendar date."
  (cond ((= timestamp #x7fffffffffffffff) #x7fffffff)
        ((= timestamp (- #x8000000000000000)) (- #x80000000))
        (t (floor timestamp +sql-microseconds-per-day+))))

