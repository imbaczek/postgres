(defun sql-timestamp-output (value with-zone &optional session-zone (style :iso) (order :mdy))
  "Format a PostgreSQL-epoch timestamp in the requested DateStyle."
  (cond ((= value #x7fffffffffffffff) "infinity")
        ((= value (- #x8000000000000000)) "-infinity")
