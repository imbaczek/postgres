               (let ((whole (truncate value)))
                 (incf days whole)
                 (add-scaled (- value whole) +sql-microseconds-per-day+)))
             (add-months (value)
               (let ((whole (truncate value)))
                 (incf months whole)
                 (add-days (* 30d0 (float (- value whole) 1d0)))))
             (add-clock (word)
               (mark :hour) (mark :minute) (mark :second)
               (let* ((negative (and (plusp (length word)) (char= (char word 0) #\-)))
                      (signed (and (plusp (length word)) (find (char word 0) "+-")))
