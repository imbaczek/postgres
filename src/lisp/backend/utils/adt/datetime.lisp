               (multiple-value-bind (year month day) (sql-julian-to-date (+ days +postgres-epoch-julian-day+))
                 (let* ((date (sql-date-output days style order))
                        (bc (<= year 0))
                        (date-part (if bc (subseq date 0 (- (length date) 3)) date))
                        (time-part (sql-time-output clock))
                        (numeric-zone (and with-zone
                                           (subseq (sql-timetz-output (make-sql-timetz 0 (- offset)))
                                                   (length "00:00:00"))))
                        (zone (if (not with-zone) ""
                                  (if (eq style :iso) numeric-zone
                                      (if (and abbreviation (plusp (length abbreviation)))
                                          (concatenate 'string " " abbreviation)
                                          (if (eq style :postgres) (concatenate 'string " " numeric-zone)
                                              numeric-zone)))))
