;;;; datetime.lisp -- calendar operations shared by SQL temporal types.
(in-package #:pg)

(defconstant +postgres-epoch-julian-day+ 2451545)

(defun sql-date-to-julian (year month day)
  "Return the Julian day for astronomical YEAR, MONTH and DAY, as date2j."
  (if (> month 2) (progn (incf month) (incf year 4800))
      (progn (incf month 13) (incf year 4799)))
  (let ((century (truncate year 100)))
    (+ (* year 365) -32167 (truncate year 4) (- century) (truncate century 4)
       (truncate (* 7834 month) 256) day)))

(defun sql-julian-to-date (julian)
  "Return astronomical year, month and day for a valid Julian day."
  (incf julian 32044)
  (let* ((quad (floor julian 146097))
         (extra (+ (* (- julian (* quad 146097)) 4) 3)))
    (incf julian (+ 60 (* quad 3) (floor extra 146097)))
    (setf quad (floor julian 1461))
    (decf julian (* quad 1461))
    (let ((year (floor (* julian 4) 1461)))
      (setf julian (+ (if (zerop year) (mod (+ julian 306) 366) (mod (+ julian 305) 365)) 123))
      (incf year (* quad 4))
      (setf quad (floor (* julian 2141) 65536))
      (values (- year 4800) (1+ (mod (+ quad 10) 12)) (- julian (floor (* 7834 quad) 256))))))

(defun sql-current-local-microseconds (zone unix-microseconds)
  "Return the transaction instant on the local PostgreSQL timeline."
  (let* ((unix (or unix-microseconds
                   (multiple-value-bind (seconds micros) (sb-ext:get-time-of-day)
                     (+ (* seconds 1000000) micros))))
         (instant (- unix 946684800000000)))
    (if zone (sql-timezone-instant-to-local zone instant) instant)))

(defun sql-date-input (text &optional timestamp-p (order :mdy) current-date)
  "Read a PostgreSQL date using the session's numeric field order."
  (let* ((input (string-trim (mapcar #'code-char '(9 10 11 12 13 32)) text))
         (upper (string-upcase input)))
    (cond ((string= upper "INFINITY") (return-from sql-date-input #x7fffffff))
          ((string= upper "-INFINITY") (return-from sql-date-input (- #x80000000)))
          ((string= upper "EPOCH") (return-from sql-date-input -10957))
          ((member upper '("NOW" "TODAY" "TOMORROW" "YESTERDAY") :test #'string=)
           (let ((today (or current-date (floor (sql-current-local-microseconds nil nil) 86400000000))))
             (return-from sql-date-input
               (+ today (cond ((string= upper "TOMORROW") 1)
                              ((string= upper "YESTERDAY") -1) (t 0)))))))
    (let* ((bc (and (>= (length upper) 3) (string= upper " BC" :start1 (- (length upper) 3))))
           (ad (and (>= (length upper) 3) (string= upper " AD" :start1 (- (length upper) 3))))
           (date (if (or bc ad) (string-right-trim '(#\Space) (subseq input 0 (- (length input) 3))) input))
           (fields (remove "" (uiop:split-string date :separator '(#\- #\/ #\. #\Space #\Tab)) :test #'string=))
           (months '(("jan" . 1) ("january" . 1) ("feb" . 2) ("february" . 2)
                     ("mar" . 3) ("march" . 3) ("apr" . 4) ("april" . 4) ("may" . 5)
                     ("jun" . 6) ("june" . 6) ("jul" . 7) ("july" . 7)
                     ("aug" . 8) ("august" . 8) ("sep" . 9) ("sept" . 9) ("september" . 9)
                     ("oct" . 10) ("october" . 10) ("nov" . 11) ("november" . 11)
                     ("dec" . 12) ("december" . 12)))
           (year-text nil) (month nil) (day nil) (compact-p nil))
      (when (and (plusp (length date)) (find (char date 0) "+-"))
        (ereport "22009" "time zone displacement out of range: ~s" text))
      (unless (and (plusp (length date)) (alphanumericp (char date 0)))
        (ereport "22007" "invalid input syntax for type date: ~s" text))
      (when (and (= (length fields) 1) (>= (length (first fields)) 6)
                 (every #'digit-char-p (first fields)))
        (let* ((compact (first fields)) (length (length compact)))
          (setf compact-p t
                fields (list (subseq compact 0 (- length 4)) (subseq compact (- length 4) (- length 2))
                             (subseq compact (- length 2))))))
      (when (and (= (length fields) 2) (>= (length (first fields)) 3)
                 (= (length (second fields)) 3)
                 (every (lambda (part) (every #'digit-char-p part)) fields))
        (let* ((year (parse-integer (first fields)))
               (day-of-year (parse-integer (second fields))))
          (unless (and (plusp year) (<= 1 day-of-year 366))
            (ereport "22008" "date/time field value out of range: ~s" text))
          (when bc (setf year (- 1 year)))
          (let ((julian (+ (sql-date-to-julian year 1 1) (1- day-of-year))))
            (unless (<= (if timestamp-p -23 0) julian 2147483493)
              (ereport "22008" "date out of range: ~s" text))
            (return-from sql-date-input (- julian +postgres-epoch-julian-day+)))))
      (unless (and (= (length fields) 3)
                   (every (lambda (part) (and (plusp (length part))
                                              (or (every #'digit-char-p part)
                                                  (every #'alpha-char-p part)))) fields))
        (ereport "22007" "invalid input syntax for type date: ~s" text))
      (let ((named (remove-if-not (lambda (part) (alpha-char-p (char part 0))) fields)))
        (cond
          ((= (length named) 1)
           (let* ((name (string-downcase (first named)))
                  (number (cdr (find name months :key #'car :test #'equal)))
                  (numeric (remove (first named) fields :test #'eq)))
             (unless number (ereport "22007" "invalid input syntax for type date: ~s" text))
             (setf month number)
             (if (or (>= (length (first numeric)) 3)
                     (and (eq order :ymd) (< (length (second numeric)) 3)))
                 (setf year-text (first numeric) day (parse-integer (second numeric)))
                 (setf day (parse-integer (first numeric)) year-text (second numeric)))))
          ((null named)
           (let* ((first (first fields)) (second (second fields)) (third (third fields))
                                         (effective-order (if (or compact-p (>= (length first) 3)) :ymd order)))
             (ecase effective-order
               (:ymd (setf year-text first month (parse-integer second) day (parse-integer third)))
               (:mdy (setf month (parse-integer first) day (parse-integer second) year-text third))
               (:dmy (setf day (parse-integer first) month (parse-integer second) year-text third)))))
          (t (ereport "22007" "invalid input syntax for type date: ~s" text))))
      (let ((year (parse-integer year-text)))
        (cond (bc (when (zerop year) (ereport "22008" "date/time field value out of range: ~s" text))
                  (setf year (- 1 year)))
              ((< (length year-text) 3) (incf year (if (< year 70) 2000 1900)))
              ((zerop year) (ereport "22008" "date/time field value out of range: ~s" text)))
        (let* ((leap (and (zerop (mod year 4)) (or (not (zerop (mod year 100))) (zerop (mod year 400)))))
               (days (and (<= 1 month 12) (nth (1- month) (list 31 (if leap 29 28) 31 30 31 30 31 31 30 31 30 31)))))
          (unless (and days (<= 1 day days))
            (ereport "22008" "date/time field value out of range: ~s" text)))
        (let ((julian (sql-date-to-julian year month day)))
          (unless (<= (if timestamp-p -23 0) julian 2147483493)
            (ereport "22008" "date out of range: ~s" text))
          (- julian +postgres-epoch-julian-day+))))))

(defun sql-date-output (value &optional (style :iso) (order :mdy))
  "Format a date in the requested PostgreSQL DateStyle."
  (cond ((= value #x7fffffff) "infinity")
        ((= value (- #x80000000)) "-infinity")
        (t (multiple-value-bind (year month day) (sql-julian-to-date (+ value +postgres-epoch-julian-day+))
             (let ((display-year (if (<= year 0) (- 1 year) year)))
               (concatenate 'string
                            (case style
                              (:iso (format nil "~4,'0d-~2,'0d-~2,'0d" display-year month day))
                              (:german (format nil "~2,'0d.~2,'0d.~4,'0d" day month display-year))
                              (:sql (if (eq order :dmy)
                                        (format nil "~2,'0d/~2,'0d/~4,'0d" day month display-year)
                                        (format nil "~2,'0d/~2,'0d/~4,'0d" month day display-year)))
                              (:postgres (if (eq order :dmy)
                                             (format nil "~2,'0d-~2,'0d-~4,'0d" day month display-year)
                                             (format nil "~2,'0d-~2,'0d-~4,'0d" month day display-year))))
                            (if (<= year 0) " BC" "")))))))

(defun sql-date-arithmetic (operator left right left-type right-type)
  "Apply date +/- integer or date - date, preserving infinite dates."
  (let ((left-date (eq left-type :date)) (right-date (eq right-type :date)))
    (when (and left-date right-date)
      (when (or (member left '(#x7fffffff -2147483648))
                (member right '(#x7fffffff -2147483648)))
        (ereport "22008" "cannot subtract infinite dates"))
      (return-from sql-date-arithmetic (- left right)))
    (let* ((date (if left-date left right))
           (days (if left-date right left)))
      (when (member date '(#x7fffffff -2147483648)) (return-from sql-date-arithmetic date))
      (let ((result (if (and left-date (string= operator "-")) (- date days) (+ date days))))
        (unless (<= (- +postgres-epoch-julian-day+) result (- 2147483493 +postgres-epoch-julian-day+))
          (ereport "22008" "date out of range"))
        result))))

(defun sql-time-adjust-typmod (value typmod)
  "Round microseconds to the requested time precision."
  (if (or (< typmod 0) (>= typmod 6)) value
      (let* ((scale (expt 10 (- 6 typmod)))
             (rounded (* (signum value) (floor (+ (/ (abs value) scale) 1/2)) scale)))
        rounded)))

(defun sql-time-input (text typmod &optional current-local-microseconds)
  "Read a colon-separated time into microseconds since midnight."
  (let* ((input (string-trim (mapcar #'code-char '(9 10 11 12 13 32)) text))
         (parts (uiop:split-string input :separator ":")))
    (when (string-equal input "now")
      (return-from sql-time-input
        (sql-time-adjust-typmod
         (mod (or current-local-microseconds (sql-current-local-microseconds nil nil)) 86400000000) typmod)))
    (when (string-equal input "allballs") (return-from sql-time-input 0))
    (unless (and (<= 2 (length parts) 3)
                 (every (lambda (part) (plusp (length part))) parts))
      (ereport "22007" "invalid input syntax for type time: ~s" text))
    (labels ((digits-p (value) (and (plusp (length value))
                                    (every (lambda (c) (and (char<= #\0 c) (char<= c #\9))) value))))
      (let* ((hours (first parts)) (minutes (second parts)) (seconds (or (third parts) "0"))
                                   (split (uiop:split-string seconds :separator ".")))
        (unless (and (digits-p hours) (digits-p minutes) (<= 1 (length split) 2)
                     (digits-p (first split))
                     (or (null (second split)) (zerop (length (second split))) (digits-p (second split))))
          (ereport "22007" "invalid input syntax for type time: ~s" text))
        (let* ((hour (parse-integer hours)) (minute (parse-integer minutes))
                                            (second (parse-integer (first split)))
                                            (fraction (if (and (second split) (plusp (length (second split))))
                                                          (round (* 1000000d0 (sql-float-input (concatenate 'string "0." (second split)) :float8)))
                                                          0)))
          (let ((value (+ (* hour 3600000000) (* minute 60000000) (* second 1000000) fraction)))
            (unless (and (<= 0 hour 24) (<= 0 minute 59) (<= 0 second 60)
                         (<= 0 value 86400000000))
              (ereport "22008" "date/time field value out of range: ~s" text))
            (sql-time-adjust-typmod value typmod)))))))

(defun sql-time-output (value)
  "Format microseconds since midnight in ISO time notation."
  (multiple-value-bind (seconds microseconds) (floor value 1000000)
    (multiple-value-bind (hours rest) (floor seconds 3600)
      (multiple-value-bind (minutes second) (floor rest 60)
        (format nil "~2,'0d:~2,'0d:~2,'0d~a" hours minutes second
                (if (zerop microseconds) ""
                    (concatenate 'string "." (string-right-trim "0" (format nil "~6,'0d" microseconds)))))))))

(defconstant +sql-microseconds-per-day+ 86400000000)

(defstruct (sql-timetz (:constructor make-sql-timetz (microseconds zone-west)))
  (microseconds 0 :type integer :read-only t)
  (zone-west 0 :type integer :read-only t))

(defun sql-timetz-comparison-values (value)
  "Return the UTC-equivalent time and zone tie-breaker used by timetz_cmp."
  (values (+ (sql-timetz-microseconds value) (* (sql-timetz-zone-west value) 1000000))
          (sql-timetz-zone-west value)))

(defun sql-timetz-compare (left right)
  (multiple-value-bind (a az) (sql-timetz-comparison-values left)
    (multiple-value-bind (b bz) (sql-timetz-comparison-values right)
      (cond ((< a b) -1) ((> a b) 1) ((< az bz) -1) ((> az bz) 1) (t 0)))))

(defun sql-timezone-offset-east (zone)
  "Parse a signed numeric zone displacement into seconds east of UTC."
  (unless (and (plusp (length zone)) (find (char zone 0) "+-"))
    (ereport "22007" "invalid time zone displacement: ~s" zone))
  (let* ((sign (if (char= (char zone 0) #\-) -1 1))
         (digits (subseq zone 1))
         (parts (if (and (not (find #\: digits)) (> (length digits) 2))
                    (list (subseq digits 0 (- (length digits) 2)) (subseq digits (- (length digits) 2)))
                    (uiop:split-string digits :separator ":"))))
    (unless (and (<= 1 (length parts) 3)
                 (every (lambda (part) (and (plusp (length part)) (every #'digit-char-p part))) parts))
      (ereport "22007" "invalid time zone displacement: ~s" zone))
    (let ((hours (parse-integer (first parts))) (minutes (if (second parts) (parse-integer (second parts)) 0))
                                                (seconds (if (third parts) (parse-integer (third parts)) 0)))
      (unless (and (<= 0 hours 15) (<= 0 minutes 59) (<= 0 seconds 59))
        (ereport "22009" "time zone displacement out of range: ~s" zone))
      (* sign (+ (* hours 3600) (* minutes 60) seconds)))))

(defun sql-timetz-input (text typmod &optional session-zone unix-now unix-microseconds)
  "Read a time with an explicit displacement or the session's reference-date zone."
  (let* ((input (string-trim (mapcar #'code-char '(9 10 11 12 13 32)) text))
         (reference (or unix-microseconds (and unix-now (* unix-now 1000000))
                        (multiple-value-bind (seconds micros) (sb-ext:get-time-of-day)
                          (+ (* seconds 1000000) micros))))
         (now (floor reference 1000000))
         (current-local (sql-current-local-microseconds session-zone reference))
         (name-separator (position #\Space input :from-end t))
         (zone-name (and name-separator
                         (let ((suffix (subseq input (1+ name-separator))))
                           (and (plusp (length suffix))
                                (every #'alpha-char-p suffix) suffix))))
         (position (position-if (lambda (c) (find c "+-")) input))
         (utc-p (and (or (null zone-name) (string-equal zone-name "Z"))
                     (plusp (length input)) (char-equal (char input (1- (length input))) #\Z)))
         (raw-clock (cond (position (subseq input 0 position))
                          (utc-p (subseq input 0 (1- (length input))))
                          (zone-name (subseq input 0 name-separator)) (t input)))
         (clock (string-trim (mapcar #'code-char '(9 10 11 12 13 32)) raw-clock)))
    (when (and utc-p (string-equal raw-clock "now"))
      (ereport "22007" "invalid input syntax for type time with time zone: ~s" text))
    (when (string-equal clock "allballs")
      (when (or position utc-p zone-name) (ereport "22007" "invalid input syntax for type time with time zone: ~s" text))
      (return-from sql-timetz-input (make-sql-timetz 0 0)))
    (let* ((microseconds (sql-time-input clock -1 current-local))
           (offset (cond (position (sql-timezone-offset-east (subseq input position)))
                         (utc-p 0)
                         (zone-name
                          (let* ((local-now (+ now (if session-zone
                                                       (sql-timezone-offset-at session-zone now) 0)))
                                 (local-time (+ (* 86400 (floor local-now 86400))
                                                (floor microseconds 1000000)))
                                 (offset (sql-decode-timezone-abbreviation
                                          zone-name session-zone local-time)))
                            (or offset (ereport "22007" "invalid input syntax for type time with time zone: ~s" text))))
                         (session-zone
                          (let* ((local-now (+ now (sql-timezone-offset-at session-zone now)))
                                 (local-time (+ (* 86400 (floor local-now 86400))
                                                (floor microseconds 1000000))))
                            (- local-time (sql-timezone-resolve-local session-zone local-time))))
                         (t 0))))
      (make-sql-timetz (sql-time-adjust-typmod microseconds typmod) (- offset)))))

(defun sql-timetz-output (value)
  "Render a time and its stored fixed offset."
  (let* ((east (- (sql-timetz-zone-west value)))
         (absolute (abs east)))
    (multiple-value-bind (hours remainder) (floor absolute 3600)
      (multiple-value-bind (minutes seconds) (floor remainder 60)
        (format nil "~a~a~2,'0d~a" (sql-time-output (sql-timetz-microseconds value))
                (if (minusp east) "-" "+") hours
                (cond ((plusp seconds) (format nil ":~2,'0d:~2,'0d" minutes seconds))
                      ((plusp minutes) (format nil ":~2,'0d" minutes)) (t "")))))))

(defstruct (sql-interval (:constructor make-sql-interval (months days microseconds)))
  (months 0 :type integer :read-only t)
  (days 0 :type integer :read-only t)
  (microseconds 0 :type integer :read-only t))

(defun sql-interval-infinity (sign)
  (if (plusp sign)
      (make-sql-interval #x7fffffff #x7fffffff #x7fffffffffffffff)
      (make-sql-interval -2147483648 -2147483648 -9223372036854775808)))

(defun sql-interval-infinity-sign (value)
  (cond ((and (= (sql-interval-months value) #x7fffffff) (= (sql-interval-days value) #x7fffffff)
              (= (sql-interval-microseconds value) #x7fffffffffffffff)) 1)
        ((and (= (sql-interval-months value) -2147483648) (= (sql-interval-days value) -2147483648)
              (= (sql-interval-microseconds value) -9223372036854775808)) -1)
        (t nil)))

(defun sql-interval-comparison-value (value)
  "Return PostgreSQL's comparison span, retaining calendar fields in VALUE."
  (+ (* (+ (* (sql-interval-months value) 30) (sql-interval-days value))
        +sql-microseconds-per-day+)
     (sql-interval-microseconds value)))

(defun sql-interval-adjust-typmod (interval typmod)
  "Truncate fields and round precision according to the packed PostgreSQL typmod."
  (when (or (minusp typmod) (sql-interval-infinity-sign interval))
    (return-from sql-interval-adjust-typmod interval))
  (let* ((range (ldb (byte 15 16) typmod))
         (precision (ldb (byte 16 0) typmod))
         (months (sql-interval-months interval))
         (days (sql-interval-days interval))
         (micros (sql-interval-microseconds interval)))
    (case range
      (4 (setf months (* 12 (truncate months 12)) days 0 micros 0))
      ((2 6) (setf days 0 micros 0))
      (8 (setf micros 0))
      ((1024 1032) (setf micros (* 3600000000 (truncate micros 3600000000))))
      ((2048 3072 3080) (setf micros (* 60000000 (truncate micros 60000000))))
      ((4096 6144 7168 7176 32767) nil)
      (otherwise (ereport "22023" "unrecognized interval typmod: ~d" typmod)))
    (unless (= precision #xffff)
      (unless (<= 0 precision 6) (ereport "22023" "invalid interval precision"))
      (let* ((scale (expt 10 (- 6 precision)))
             (offset (floor scale 2))
             (adjusted (+ micros (* (if (minusp micros) -1 1) offset))))
        (unless (<= -9223372036854775808 adjusted 9223372036854775807)
          (ereport "22008" "interval out of range"))
        (setf micros (* (truncate adjusted scale) scale))))
    (make-sql-interval months days micros)))

(defun sql-interval-typmod-sql (typmod)
  "Render a packed interval typmod in PostgreSQL DDL syntax."
  (if (minusp typmod) ""
      (let* ((range (ldb (byte 15 16) typmod))
             (precision (ldb (byte 16 0) typmod))
             (name (case range
                     (4 " year") (2 " month") (6 " year to month")
                     (8 " day") (1024 " hour") (2048 " minute") (4096 " second")
                     (1032 " day to hour") (3080 " day to minute")
                     (7176 " day to second") (3072 " hour to minute")
                     (7168 " hour to second") (6144 " minute to second")
                     (32767 "") (otherwise (ereport "22023" "unrecognized interval typmod")))))
        (format nil "~a~a" name (if (= precision #xffff) "" (format nil "(~d)" precision))))))

(defun sql-exact-hex-float-p (text value)
  "Whether the parsed hexadecimal float is exactly representable as VALUE."
  (let* ((negative (char= (char text 0) #\-))
         (start (+ (if negative 1 0) 2))
         (exponent-position (position-if (lambda (character) (find character "pP")) text :start start))
         (end (or exponent-position (length text)))
         (point nil) (fraction-digits 0) (coefficient 0))
    (loop for position from start below end
          for character = (char text position)
          do (if (char= character #\.)
                 (setf point t)
                 (progn (setf coefficient (+ (* coefficient 16) (digit-char-p character 16)))
                        (when point (incf fraction-digits)))))
    (let ((exponent (- (if exponent-position (parse-integer text :start (1+ exponent-position)) 0)
                       (* 4 fraction-digits))))
      (= (rational value) (* (if negative -1 1) coefficient (expt 2 exponent))))))

(defun sql-iso8601-interval-input (text)
  "Decode the ISO 8601 interval formats accepted by DecodeISO8601Interval."
  (let ((position 1) (length (length text)) (years 0) (months 0) (days 0) (micros 0)
                     (datepart t) (havefield nil))
    (labels ((bad () (ereport "22007" "invalid input syntax for type interval: ~s" text))
             (overflow () (ereport "22015" "interval field value out of range"))
             (peek () (and (< position length) (char text position)))
             (number ()
               (let ((start position) (digits 0) (width 0) (hex-p nil))
                 (when (and (eql (peek) #\-)
                            (some (lambda (prefix)
                                    (and (<= (+ position (length prefix)) length)
                                         (string-equal text prefix :start1 position :end1 (+ position (length prefix)))))
                                  '("-inf" "-nan")))
                   (overflow))
                 (when (eql (peek) #\-) (incf position))
                 (when (and (< (+ position 1) length) (char= (char text position) #\0)
                            (char-equal (char text (1+ position)) #\x))
                   (setf hex-p t width 1)
                   (incf position 2))
                 (loop while (and (peek) (digit-char-p (peek) (if hex-p 16 10)))
                       do (incf position) (incf digits) (unless hex-p (incf width)))
                 (when (eql (peek) #\.)
                   (incf position)
                   (loop while (and (peek) (digit-char-p (peek) (if hex-p 16 10)))
                         do (incf position) (incf digits)))
                 (when (zerop digits) (bad))
                 (when (and (peek) (find (peek) (if hex-p "pP" "eE")))
                   (let ((exponent position))
                     (incf position)
                     (when (and (peek) (find (peek) "+-")) (incf position))
                     (let ((start-digits position))
                       (loop while (and (peek) (digit-char-p (peek))) do (incf position))
                       (when (= position start-digits) (setf position exponent)))))
                 (let ((value (handler-case (sql-float-input (subseq text start position) :float8)
                                (pg-error () (bad)))))
                   (when (or (sb-ext:float-nan-p value) (sb-ext:float-infinity-p value)
                             (> (abs value) 1d15)) (overflow))
                   (when (and (not (zerop value)) (< (abs value) least-positive-normalized-double-float)
                              (not (handler-case
                                       (if hex-p
                                           (sql-exact-hex-float-p (subseq text start position) value)
                                           (= (sql-numeric-rational (sql-numeric-input (subseq text start position)))
                                              (rational value)))
                                     (pg-error () nil))))
                     (bad))
                   (values (truncate value) (- value (truncate value)) width))))
             (check ()
               (unless (and (<= -2147483648 years 2147483647)
                            (<= -2147483648 months 2147483647)
                            (<= -2147483648 days 2147483647)
                            (<= -9223372036854775808 micros 9223372036854775807))
                 (overflow)))
             (add-micro (integer fraction scale)
               (incf micros (* integer scale))
               (check)
               (let* ((scaled (* fraction scale))
                      (whole (truncate scaled))
                      (remainder (- scaled whole)))
                 (incf micros (+ whole (cond ((> remainder 0.5d0) 1)
