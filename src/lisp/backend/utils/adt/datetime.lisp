                                  (let ((weekday (nth (mod (+ days +postgres-epoch-julian-day+ 1) 7)
                                                      '("Sun" "Mon" "Tue" "Wed" "Thu" "Fri" "Sat")))
                                        (month-name (nth (1- month)
                                                         '("Jan" "Feb" "Mar" "Apr" "May" "Jun"
                                                           "Jul" "Aug" "Sep" "Oct" "Nov" "Dec")))
