        (ereport "22015" "interval field value out of range"))
      (make-sql-interval months days microseconds))))

(defun sql-interval-output (value)
  "Format separate interval months, days and time using postgres IntervalStyle."
  (let ((sign (sql-interval-infinity-sign value)))
    (when sign (return-from sql-interval-output (if (plusp sign) "infinity" "-infinity"))))
  (multiple-value-bind (years months) (truncate (sql-interval-months value) 12)
    (let ((days (sql-interval-days value)) (micros (sql-interval-microseconds value))
                                           (parts nil) (previous-negative nil))
      (labels ((add-part (amount unit)
                 (unless (zerop amount)
                   (push (format nil "~a~d ~a~a" (if (and previous-negative (plusp amount)) "+" "")
                                 amount unit (if (= amount 1) "" "s")) parts)
                   (setf previous-negative (minusp amount)))))
        (add-part years "year") (add-part months "mon") (add-part days "day")
        (when (or (zerop micros) nil)
          (when (null parts) (push "00:00:00" parts)))
        (unless (zerop micros)
          (multiple-value-bind (seconds fraction) (floor (abs micros) 1000000)
            (multiple-value-bind (hours rest) (floor seconds 3600)
              (multiple-value-bind (minutes second) (floor rest 60)
                (push (format nil "~a~2,'0d:~2,'0d:~2,'0d~a"
                              (cond ((minusp micros) "-") (previous-negative "+") (t ""))
                              hours minutes second
                              (if (zerop fraction) "" (concatenate 'string "." (string-right-trim "0" (format nil "~6,'0d" fraction))))) parts)))))
        (format nil "~{~a~^ ~}" (nreverse parts))))))

(defun sql-postgres-timestamp-input-normalize (text)
  "Rearrange PostgreSQL's weekday/month timestamp output for the date parser."
  (let ((fields (remove "" (uiop:split-string text :separator '(#\Space #\Tab))
                        :test #'string=)))
    (when (and (<= 5 (length fields) 7)
               (member (first fields) '("Sun" "Mon" "Tue" "Wed" "Thu" "Fri" "Sat")
                       :test #'string-equal)
               (find #\: (fourth fields))
               (every #'digit-char-p (fifth fields)))
      (format nil "~a ~a ~a ~a~{ ~a~}"
              (second fields) (third fields) (fifth fields) (fourth fields)
              (nthcdr 5 fields)))))

