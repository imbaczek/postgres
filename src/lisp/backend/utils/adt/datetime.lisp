            (let* ((new-month (1+ month-index))
                   (leap (and (zerop (mod new-year 4))
                              (or (not (zerop (mod new-year 100))) (zerop (mod new-year 400)))))
                   (month-length (nth month-index (list 31 (if leap 29 28) 31 30 31 30 31 31 30 31 30 31)))
                   (julian (sql-date-to-julian new-year new-month (min day month-length))))
              (unless (<= (if local-p -1 0) julian 2147483493) (ereport "22008" "timestamp out of range"))
              (setf days (- julian +postgres-epoch-julian-day+))
              (unless (or local-p (<= -211813488000000000 (+ (* days +sql-microseconds-per-day+) clock) 9223371331199999999))
                (ereport "22008" "timestamp out of range"))))))
      (incf days (* sign (sql-interval-days interval)))
      (unless (or local-p (<= -211813488000000000 (+ (* days +sql-microseconds-per-day+) clock) 9223371331199999999))
        (ereport "22008" "timestamp out of range"))
      (let ((result (+ (* days +sql-microseconds-per-day+)
                       clock (* sign (sql-interval-microseconds interval)))))
        (unless (or local-p (<= -211813488000000000 result 9223371331199999999))
          (ereport "22008" "timestamp out of range"))
        result))))

(defun sql-timestamptz-add-interval (timestamp interval subtract-p zone)
  "Apply calendar fields in ZONE and the time field on the UTC timeline."
  (when subtract-p
    (setf interval (sql-interval-add (make-sql-interval 0 0 0) interval t)))
  (when (or (sql-interval-infinity-sign interval)
            (member timestamp '(#x7fffffffffffffff -9223372036854775808)))
    (return-from sql-timestamptz-add-interval (sql-timestamp-add-interval timestamp interval nil)))
  (labels ((calendar-step (months days)
             (unless (and (zerop months) (zerop days))
               (let* ((local (sql-timezone-instant-to-local zone timestamp))
                      (adjusted (sql-timestamp-add-interval local (make-sql-interval months days 0) nil t))
                      (instant (sql-timezone-local-to-instant zone adjusted)))
                 (unless (<= -211813488000000000 instant 9223371331199999999)
                   (ereport "22008" "timestamp out of range"))
                 (setf timestamp instant)))))
    (calendar-step (sql-interval-months interval) 0)
    (calendar-step 0 (sql-interval-days interval))
    (sql-timestamp-add-interval timestamp (make-sql-interval 0 0 (sql-interval-microseconds interval)) nil)))

(defun sql-interval-scale (span factor divide-p)
  "Multiply or divide an interval by float8, cascading fractional calendar units."
  (sb-int:with-float-traps-masked (:invalid :divide-by-zero :overflow :underflow :inexact)
    (when (and divide-p (zerop factor)) (ereport "22012" "division by zero"))
    (when (sb-ext:float-nan-p factor) (ereport "22008" "interval out of range"))
    (let ((interval-sign (sql-interval-infinity-sign span)))
      (when interval-sign
        (when (or (and divide-p (sb-ext:float-infinity-p factor))
                  (and (not divide-p) (zerop factor)))
          (ereport "22008" "interval out of range"))
        (return-from sql-interval-scale
          (sql-interval-infinity (if (minusp factor) (- interval-sign) interval-sign))))
      (when (and (not divide-p) (sb-ext:float-infinity-p factor))
        (let ((sign (signum (sql-interval-comparison-value span))))
          (when (zerop sign) (ereport "22008" "interval out of range"))
          (return-from sql-interval-scale
            (sql-interval-infinity (* sign (if (minusp factor) -1 1)))))))
    (labels ((calculate (value) (if divide-p (/ (float value 1d0) factor)
                                    (* (float value 1d0) factor)))
             (valid-float-p (value lower upper)
               (and (not (sb-ext:float-nan-p value))
                    (not (sb-ext:float-infinity-p value))
                    (<= lower value) (< value upper)))
             (tsround (value) (/ (float (round (* value 1000000d0)) 1d0) 1000000d0)))
      (let* ((month-value (calculate (sql-interval-months span)))
             (day-value (calculate (sql-interval-days span))))
        (unless (and (valid-float-p month-value -2147483648d0 2147483648d0)
                     (valid-float-p day-value -2147483648d0 2147483648d0))
          (ereport "22008" "interval out of range"))
        (let* ((months (truncate month-value))
               (days (truncate day-value))
               (month-days (tsround (* (- month-value months) 30d0)))
               (seconds (tsround (* (- (+ (- day-value days) month-days) (truncate month-days)) 86400d0))))
          (when (>= (abs seconds) 86400d0)
            (let ((extra (truncate (/ seconds 86400d0))))
              (incf days extra)
              (unless (<= -2147483648 days 2147483647) (ereport "22008" "interval out of range"))
              (decf seconds (* extra 86400d0))))
          (incf days (truncate month-days))
          (unless (<= -2147483648 days 2147483647) (ereport "22008" "interval out of range"))
          (let ((time-value (+ (calculate (sql-interval-microseconds span)) (* seconds 1000000d0))))
            (unless (valid-float-p time-value -9223372036854775808d0 9223372036854775808d0)
              (ereport "22008" "interval out of range"))
            (let ((micros (round time-value)))
              (unless (<= -9223372036854775808 micros 9223372036854775807)
                (ereport "22008" "interval out of range"))
              (let ((result (make-sql-interval months days micros)))
                (when (sql-interval-infinity-sign result) (ereport "22008" "interval out of range"))
                result))))))))

(defun sql-temporal-arithmetic (operator left right left-type right-type &optional zone)
  "Dispatch the supported timestamp, time and interval binary operators."
  (let ((subtract-p (string= operator "-")))
    (cond ((and (eq left-type :interval) (eq right-type :float8))
           (sql-interval-scale left right (string= operator "/")))
          ((and (eq left-type :float8) (eq right-type :interval))
           (sql-interval-scale right left nil))
          ((and (eq left-type :interval) (eq right-type :interval))
           (sql-interval-add left right subtract-p))
          ((and (eq left-type :time) (eq right-type :time))
           (make-sql-interval 0 0 (- left right)))
          ((and (member left-type '(:timestamp :timestamptz))
                (member right-type '(:timestamp :timestamptz)))
           (let ((left-sign (cond ((= left #x7fffffffffffffff) 1) ((= left -9223372036854775808) -1)))
                 (right-sign (cond ((= right #x7fffffffffffffff) 1) ((= right -9223372036854775808) -1))))
             (when (and left-sign right-sign (= left-sign right-sign)) (ereport "22008" "interval out of range"))
             (when (or left-sign right-sign)
               (return-from sql-temporal-arithmetic (sql-interval-infinity (or left-sign (- right-sign))))))
           (let ((difference (- left right)))
             (unless (<= -9223372036854775808 difference 9223372036854775807)
               (ereport "22008" "interval out of range"))
             (multiple-value-bind (days micros) (truncate difference +sql-microseconds-per-day+)
               (make-sql-interval 0 days micros))))
          ((and (eq left-type :time) (eq right-type :interval))
           (when (sql-interval-infinity-sign right) (ereport "22008" "cannot add infinite interval to time"))
           (mod (+ left (* (if subtract-p -1 1) (sql-interval-microseconds right))) +sql-microseconds-per-day+))
          ((and (eq left-type :interval) (eq right-type :time))
           (when (sql-interval-infinity-sign left) (ereport "22008" "cannot add infinite interval to time"))
           (mod (+ right (sql-interval-microseconds left)) +sql-microseconds-per-day+))
          ((eq right-type :interval)
           (if (and (eq left-type :timestamptz) zone)
               (sql-timestamptz-add-interval left right subtract-p zone)
               (sql-timestamp-add-interval (if (eq left-type :date) (sql-date-to-timestamp left) left) right subtract-p)))
          ((eq left-type :interval)
           (if (and (eq right-type :timestamptz) zone)
               (sql-timestamptz-add-interval right left nil zone)
               (sql-timestamp-add-interval (if (eq right-type :date) (sql-date-to-timestamp right) right) left nil)))
          (t (ereport "42883" "unsupported temporal operator")))))
