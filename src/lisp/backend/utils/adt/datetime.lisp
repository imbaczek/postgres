                      (digits 0) (dots 0))
                 (loop for char across (subseq word start)
                       do (cond ((digit-char-p char) (incf digits))
                                ((char= char #\.) (incf dots))
                                (t (bad))))
                 (unless (and (plusp digits) (<= dots 1)) (bad)))
               (handler-case
                   (let ((value (sql-numeric-input word)))
                     (when (sql-numeric-special-p value) (bad))
                     (sql-numeric-rational value))
                 (pg-error () (bad))))
             (mark (unit)
               (when (gethash unit seen) (bad))
               (setf (gethash unit seen) t))
             (add-scaled (value scale)
               (let* ((whole (truncate value))
                      (scaled (* (float (- value whole) 1d0) scale))
                      (fraction-integer (truncate scaled))
                      (remainder (- scaled fraction-integer)))
                 (incf microseconds (+ (* whole scale) fraction-integer
                                       (cond ((> remainder 0.5d0) 1)
                                             ((< remainder -0.5d0) -1) (t 0))))))
