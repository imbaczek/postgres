          (loop for rest on words
                for word = (first rest)
                append (if (and (second rest) (find #\: (second rest))
                                (plusp (length word))
                                (or (digit-char-p (char word 0)) (find (char word 0) "+-"))
                                (not (find #\: word)))
                           (list word "days") (list word))))
    (when (and (= (length words) 1) (not (find #\: (first words))))
      (let* ((range (if (minusp typmod) #x7fff (ldb (byte 15 16) typmod)))
             (unit (cond ((logbitp 12 range) "seconds")
                         ((logbitp 11 range) "minutes")
                         ((logbitp 10 range) "hours")
                         ((logbitp 3 range) "days")
                         ((logbitp 1 range) "months")
                         ((logbitp 2 range) "years")
