;;;; json.lisp -- validation of the preserved SQL JSON text.

(in-package #:pg)

(defun sql-json-input (text &key jsonb-p scalar-cache)
  "Validate one complete JSON value and return TEXT unchanged, as json_in does.
Whitespace, key order, duplicate keys, and escape spelling are preserved. Invalid
syntax signals SQLSTATE 22P02. The explicit state stack bounds control-stack use
for deeply nested input. By default Unicode escapes are checked syntactically;
JSONB-P decodes strings and numbers in callback order into SCALAR-CACHE."
  (let ((position 0)
        (length (length text))
        (stack (list :root-value)))
    (labels ((fail ()
               (ereport "22P02" "invalid input syntax for type json"))
             (peek ()
               (and (< position length) (char text position)))
             (take ()
               (prog1 (peek) (incf position)))
             (space-p (c)
               (and c (find c '(#\Space #\Tab #\Newline #\Return))))
             (skip-space ()
               (loop while (space-p (peek)) do (incf position)))
             (digit-p (c)
               (and c (char<= #\0 c #\9)))
             (hex-unit ()
               (let ((value 0))
                 (dotimes (i 4 value)
                   (let* ((char (take))
                          (digit (and char
                                      (or (and (char<= #\0 char #\9) (- (char-code char) (char-code #\0)))
                                          (and (char<= #\a char #\f) (+ 10 (- (char-code char) (char-code #\a))))
                                          (and (char<= #\A char #\F) (+ 10 (- (char-code char) (char-code #\A))))))))
                     (unless digit (fail))
                     (setf value (+ (* value 16) digit))))))
             (unicode-character ()
               (let ((high (hex-unit)))
                 (if (not jsonb-p)
                     nil
                     (cond
                       ((zerop high) (ereport "22P05" "unsupported Unicode escape sequence"))
                       ((<= #xd800 high #xdbff)
                        (unless (and (eql (take) (code-char 92)) (eql (take) #\u))
                          (ereport "22P02" "invalid Unicode surrogate pair"))
                        (let ((low (hex-unit)))
                          (unless (<= #xdc00 low #xdfff)
                            (ereport "22P02" "invalid Unicode surrogate pair"))
                          (code-char (+ #x10000 (* (- high #xd800) 1024) (- low #xdc00)))))
                       ((<= #xdc00 high #xdfff) (ereport "22P02" "invalid Unicode surrogate pair"))
                       (t (code-char high))))))
             (string-token (&optional (lookahead-p t))
               (let ((start position))
                 (when (and scalar-cache (gethash start scalar-cache))
                   (setf position (car (gethash start scalar-cache)))
                   (when (and jsonb-p lookahead-p) (lex-lookahead))
                   (return-from string-token))
                 (unless (eql (take) #\") (fail))
                 (let ((out (when jsonb-p (make-string-output-stream))))
                   (loop
                     (let ((c (take)))
                       (unless c (fail))
                       (cond
                         ((char= c #\") (return))
                         ((< (char-code c) 32) (fail))
                         ((char= c (code-char 92))
                          (let ((escape (take)))
                            (unless escape (fail))
                            (let ((char
                                    (case escape
                                      (#\u (unicode-character))
                                      (#\b (code-char 8)) (#\f (code-char 12))
                                      (#\n (code-char 10)) (#\r (code-char 13))
                                      (#\t (code-char 9))
                                      ((#\" #\/) escape)
                                      (otherwise (if (char= escape (code-char 92)) escape (fail))))))
                              (when (and out char) (write-char char out)))))
                         (t (when out (write-char c out))))))
                   (when (and jsonb-p scalar-cache)
                     (setf (gethash start scalar-cache)
                           (cons position (get-output-stream-string out))))
                   (when (and jsonb-p lookahead-p) (lex-lookahead)))))
             (number-token (&optional (convert-p t))
               (let ((start position))
                 (when (eql (peek) #\-) (take))
                 (cond ((eql (peek) #\0) (take))
                       ((and (peek) (char<= #\1 (peek) #\9))
                        (loop while (digit-p (peek)) do (take)))
                       (t (fail)))
                 (when (eql (peek) #\.)
                   (take)
                   (unless (digit-p (peek)) (fail))
                   (loop while (digit-p (peek)) do (take)))
                 (when (and (peek) (find (peek) '(#\e #\E)))
                   (take)
                   (when (and (peek) (find (peek) '(#\+ #\-))) (take))
                   (unless (digit-p (peek)) (fail))
                   (loop while (digit-p (peek)) do (take)))
                 ;; json_lex_number consumes trailing alphanumeric garbage.
                 (when (alnum-p (peek)) (fail))
                 (when (and jsonb-p convert-p)
                   (let ((end position))
                     (lex-lookahead)
                     (setf (gethash start scalar-cache)
                           (cons end (sql-numeric-input (subseq text start end))))))))
             (alnum-p (c)
               (and c (or (char<= #\0 c #\9) (char<= #\a c #\z)
                          (char<= #\A c #\Z) (char= c #\_) (>= (char-code c) 128))))
             (lex-lookahead ()
               ;; parse_scalar calls json_lex before executing the scalar callback.
               (let ((saved position))
                 (skip-space)
                 (case (peek)
                   ((nil #\, #\: #\[ #\] #\{ #\}) nil)
                   (#\" (string-token nil))
                   (otherwise
                    (cond ((or (eql (peek) #\-) (digit-p (peek))) (number-token nil))
                          ((alnum-p (peek))
                           (let ((start position))
                             (loop while (alnum-p (peek)) do (take))
                             (unless (member (subseq text start position)
                                             '("true" "false" "null") :test #'string=)
                               (fail))))
                          (t (fail)))))
                 (setf position saved)))
             (literal-token (word)
               (loop for expected across word
                     unless (eql (take) expected) do (fail))
               (when (alnum-p (peek)) (fail))
               (when jsonb-p (lex-lookahead)))
             (value-token ()
               (case (peek)
                 (#\" (string-token))
                 (#\{ (take) (push :object-first stack))
                 (#\[ (take) (push :array-first stack))
                 (#\t (literal-token "true"))
                 (#\f (literal-token "false"))
                 (#\n (literal-token "null"))
                 (otherwise
                  (if (or (eql (peek) #\-) (digit-p (peek)))
                      (number-token)
                      (fail))))))
      (loop while stack
            do (skip-space)
               (case (car stack)
                 (:root-value (setf (car stack) :root-done) (value-token))
                 (:root-done (unless (= position length) (fail)) (pop stack))
                 (:array-first
                  (if (eql (peek) #\]) (progn (take) (when jsonb-p (lex-lookahead)) (pop stack))
                      (progn (setf (car stack) :array-next) (value-token))))
                 (:array-value (setf (car stack) :array-next) (value-token))
                 (:array-next
                  (case (take)
                    (#\, (setf (car stack) :array-value))
                    (#\] (when jsonb-p (lex-lookahead)) (pop stack))
                    (otherwise (fail))))
                 (:object-first
                  (if (eql (peek) #\}) (progn (take) (when jsonb-p (lex-lookahead)) (pop stack))
                      (setf (car stack) :object-key)))
                 (:object-key (string-token) (setf (car stack) :object-colon))
                 (:object-colon
                  (unless (eql (take) #\:) (fail))
                  (setf (car stack) :object-value))
                 (:object-value (setf (car stack) :object-next) (value-token))
                 (:object-next
                  (case (take)
                    (#\, (setf (car stack) :object-key))
                    (#\} (when jsonb-p (lex-lookahead)) (pop stack))
                    (otherwise (fail))))))
      text)))