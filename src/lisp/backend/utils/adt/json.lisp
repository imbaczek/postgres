;;;; json.lisp -- validation of the preserved SQL JSON text.

(in-package #:pg)

(defun sql-json-input (text)
  "Validate one complete JSON value and return TEXT unchanged, as json_in does.
Whitespace, key order, duplicate keys, and escape spelling are preserved. Invalid
syntax signals SQLSTATE 22P02. The explicit state stack bounds control-stack use
for deeply nested input; Unicode escapes are checked syntactically, not decoded."
  (let ((position 0)
        (length (length text))
        (stack (list :root-value)))
    (labels ((fail ()
               (ereport "22P02" "invalid input syntax for type json"))
             (peek ()
               (and (< position length) (char text position)))
             (take ()
               (prog1 (peek) (incf position)))
             (space-p (c)
               (and c (find c '(#\Space #\Tab #\Newline #\Return))))
             (skip-space ()
               (loop while (space-p (peek)) do (incf position)))
             (digit-p (c)
               (and c (char<= #\0 c #\9)))
             (string-token ()
               (unless (eql (take) #\") (fail))
               (loop
                 (let ((c (take)))
                   (unless c (fail))
                   (cond
                     ((char= c #\") (return))
                     ((< (char-code c) 32) (fail))
                     ((char= c (code-char 92))
                      (let ((escape (take)))
                        (unless escape (fail))
                        (cond
                          ((char= escape #\u)
                           (dotimes (i 4)
                             (let ((hex (take)))
                               (unless (and hex (or (char<= #\0 hex #\9)
                                                    (char<= #\a hex #\f)
                                                    (char<= #\A hex #\F)))
                                 (fail)))))
                          ((find escape (list #\" (code-char 92) #\/ #\b #\f #\n #\r #\t)))
                          (t (fail)))))))))
             (number-token ()
               (when (eql (peek) #\-) (take))
               (cond ((eql (peek) #\0) (take))
                     ((and (peek) (char<= #\1 (peek) #\9))
                      (loop while (digit-p (peek)) do (take)))
                     (t (fail)))
               (when (eql (peek) #\.)
                 (take)
                 (unless (digit-p (peek)) (fail))
                 (loop while (digit-p (peek)) do (take)))
               (when (and (peek) (find (peek) '(#\e #\E)))
                 (take)
                 (when (and (peek) (find (peek) '(#\+ #\-))) (take))
                 (unless (digit-p (peek)) (fail))
                 (loop while (digit-p (peek)) do (take))))
             (literal-token (word)
               (loop for expected across word
                     unless (eql (take) expected) do (fail)))
             (value-token ()
               (case (peek)
                 (#\" (string-token))
                 (#\{ (take) (push :object-first stack))
                 (#\[ (take) (push :array-first stack))
                 (#\t (literal-token "true"))
                 (#\f (literal-token "false"))
                 (#\n (literal-token "null"))
                 (otherwise
                  (if (or (eql (peek) #\-) (digit-p (peek)))
                      (number-token)
                      (fail))))))
      (loop while stack
            do (skip-space)
               (case (car stack)
                 (:root-value (setf (car stack) :root-done) (value-token))
                 (:root-done (unless (= position length) (fail)) (pop stack))
                 (:array-first
                  (if (eql (peek) #\]) (progn (take) (pop stack))
                      (progn (setf (car stack) :array-next) (value-token))))
                 (:array-value (setf (car stack) :array-next) (value-token))
                 (:array-next
                  (case (take)
                    (#\, (setf (car stack) :array-value))
                    (#\] (pop stack))
                    (otherwise (fail))))
                 (:object-first
                  (if (eql (peek) #\}) (progn (take) (pop stack))
                      (setf (car stack) :object-key)))
                 (:object-key (string-token) (setf (car stack) :object-colon))
                 (:object-colon
                  (unless (eql (take) #\:) (fail))
                  (setf (car stack) :object-value))
                 (:object-value (setf (car stack) :object-next) (value-token))
                 (:object-next
                  (case (take)
                    (#\, (setf (car stack) :object-key))
                    (#\} (pop stack))
                    (otherwise (fail))))))
      text)))