;;;; PostgreSQL PGLZ stream codec.  See src/common/pg_lzcompress.c.
(in-package #:pg)

(defun pglz-decompress (source raw-size &key (start 0) (end (length source)))
  "Decode raw PGLZ SOURCE octets to the separately supplied RAW-SIZE.
Decode only the half-open range [START, END); reject malformed streams and
trailing bytes within that range with corruption error XX001."
  (check-type source (vector (unsigned-byte 8)))
  (check-type raw-size (integer 0 1073741819))
  (unless (and (integerp start) (integerp end) (<= 0 start end (length source)))
    (error "invalid PGLZ source bounds"))
  ;; No input byte can contribute more than the maximum match length.
  (when (> raw-size (* 273 (- end start)))
    (ereport "XX001" "corrupt PGLZ data"))
  (let ((result (make-array raw-size :element-type '(unsigned-byte 8)))
        (in start)
        (out 0)
        (limit end))
    (labels ((corrupt () (ereport "XX001" "corrupt PGLZ data"))
             (next-byte ()
               (when (>= in limit) (corrupt))
               (prog1 (aref source in) (incf in))))
      (loop while (< out raw-size)
            do (let ((control (next-byte)))
                 (loop for bit below 8
                       while (< out raw-size)
                       do (if (logbitp bit control)
                              (let* ((first (next-byte))
                                     (second (next-byte))
                                     (offset (+ (ash (logand first #xf0) 4) second))
                                     (length (+ 3 (logand first #x0f))))
                                (when (= length 18)
                                  (incf length (next-byte)))
                                (when (or (zerop offset) (> offset out)
                                          (> length (- raw-size out)))
                                  (corrupt))
                                (dotimes (i length)
                                  (declare (ignorable i))
                                  (setf (aref result out) (aref result (- out offset)))
                                  (incf out)))
                              (setf (aref result out) (next-byte)
                                    out (1+ out))))))
      (unless (= in limit) (corrupt))
      result)))

(defun pglz-compress (source)
  "Return raw PGLZ stream octets for SOURCE, without a varlena header.
Return NIL for input shorter than 32 bytes or when this bounded recent-match
heuristic does not produce a stream meeting the default size threshold.
Match choices need not be identical to PostgreSQL's compressor."
  (check-type source (vector (unsigned-byte 8)))
  (let ((size (length source)))
    (when (< size 32) (return-from pglz-compress nil))
    (let ((recent (make-array 65536 :initial-element -1))
          (output (make-array 0 :element-type '(unsigned-byte 8)
                                :adjustable t :fill-pointer 0))
          (pos 0)
          (result-max (floor (* size 75) 100))
          (found-match nil))
      (labels ((hash-at (p)
                 (logand #xffff
                         (logxor (ash (aref source p) 8)
                                 (ash (aref source (1+ p)) 4)
                                 (aref source (+ p 2)))))
               (remember (p)
                 (when (< (+ p 2) size)
                   (setf (aref recent (hash-at p)) p))))
        (loop while (< pos size)
              do (let ((control-pos (fill-pointer output))
                       (control 0))
                   (vector-push-extend 0 output)
                   (loop for bit below 8
                         while (< pos size)
                         do (when (or (>= (length output) result-max)
                                      (and (not found-match) (>= (length output) 1024)))
                              (return-from pglz-compress nil))
                            (let ((match 0) (offset 0))
                              (when (< (+ pos 2) size)
                                (let* ((key (hash-at pos))
                                       (candidate (aref recent key))
                                       (distance (- pos candidate)))
                                  (when (and (>= candidate 0) (<= distance 4095))
                                    (loop while (and (< match 273)
                                                     (< (+ pos match) size)
                                                     (= (aref source (+ candidate match))
                                                        (aref source (+ pos match))))
                                          do (incf match))
                                    (when (>= match 3) (setf offset distance)))))
                              (if (>= match 3)
                                  (progn
                                    (setf found-match t
                                          control (logior control (ash 1 bit)))
                                    (vector-push-extend
                                     (logior (ash (ash offset -8) 4)
                                             (min 15 (- match 3))) output)
                                    (vector-push-extend (logand offset #xff) output)
                                    (when (>= match 18)
                                      (vector-push-extend (- match 18) output))
                                    (dotimes (i match) (remember (+ pos i)))
                                    (incf pos match))
                                  (progn
                                    (vector-push-extend (aref source pos) output)
                                    (remember pos)
                                    (incf pos)))))
                   (setf (aref output control-pos) control)))
        ;; Match the default C strategy's strict, rounded size threshold.
        (when (< (length output) result-max)
          (coerce output '(vector (unsigned-byte 8))))))))
