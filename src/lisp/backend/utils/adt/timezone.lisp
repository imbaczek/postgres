(in-package #:pg)

;; TZif records are immutable after publication; session settings retain names,
;; not zone objects, so rollback and RESET continue to use the normal GUC path.
(defstruct (sql-timezone (:constructor make-sql-timezone (transitions indices offsets abbreviations footer rules footer-names)))
  transitions indices offsets abbreviations footer rules footer-names)

