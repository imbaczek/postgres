(defvar *sql-timezone-cache* (make-hash-table :test #'equal))
(defvar *sql-timezone-cache-lock* (sb-thread:make-mutex :name "SQL timezone cache"))

(defun sql-tzif-unsigned (bytes position width)
  (unless (<= (+ position width) (length bytes)) (error "truncated TZif file"))
  (loop for index from position below (+ position width)
        for result = (aref bytes index) then (+ (ash result 8) (aref bytes index))
        finally (return result)))

(defun sql-tzif-signed (bytes position width)
  (let ((number (sql-tzif-unsigned bytes position width)))
    (if (logbitp (1- (* width 8)) number) (- number (ash 1 (* width 8))) number)))

(defun sql-tzif-header (bytes position)
  (unless (and (<= (+ position 44) (length bytes))
               (equalp (subseq bytes position (+ position 4)) #(84 90 105 102)))
    (error "invalid TZif header"))
  (let ((version (aref bytes (+ position 4)))
        (counts (loop for offset from 20 below 44 by 4
                      collect (sql-tzif-unsigned bytes (+ position offset) 4))))
    (unless (member version '(0 50 51 52)) (error "unsupported TZif version"))
    (destructuring-bind (utc standard leap transitions types chars) counts
      (unless (and (<= 1 types 256) (<= transitions 100000) (<= chars 100000)
                   (zerop leap) (member standard (list 0 types)) (member utc (list 0 types)))
        (error "invalid TZif counts")))
    (values version counts)))

(defun sql-tzif-block-end (position counts width)
  (destructuring-bind (utc standard leap transitions types chars) counts
    (+ position (* transitions (1+ width)) (* types 6) chars
       (* leap (+ width 4)) standard utc)))

(defun sql-parse-tzif-footer (text)
  "Parse the POSIX rule suffix of a TZif file into offsets and annual rules."
  (when (zerop (length text)) (return-from sql-parse-tzif-footer nil))
  (let ((position 0) (length (length text)))
    (labels ((peek () (and (< position length) (char text position)))
             (accept (character)
               (when (eql (peek) character) (incf position) t))
             (need (character)
               (unless (accept character) (error "invalid TZif POSIX rule")))
             (name ()
               (if (accept #\<)
                   (let ((end (position #\> text :start position)))
                     (unless (and end (> end position)) (error "invalid TZif abbreviation"))
                     (setf position (1+ end)))
                   (let ((start position))
                     (loop while (and (peek) (alpha-char-p (peek))) do (incf position))
                     (when (= start position) (error "invalid TZif abbreviation")))))
             (number ()
               (let ((start position))
                 (loop while (and (peek) (digit-char-p (peek))) do (incf position))
                 (when (= start position) (error "invalid TZif number"))
                 (parse-integer text :start start :end position)))
             (clock (limit)
               (let* ((sign (cond ((accept #\-) -1) ((accept #\+) 1) (t 1)))
                      (hours (number)) (minutes 0) (seconds 0))
                 (when (accept #\:) (setf minutes (number))
                       (when (accept #\:) (setf seconds (number))))
                 (unless (and (<= hours limit) (< minutes 60) (< seconds 60))
                   (error "invalid TZif clock"))
                 (* sign (+ (* hours 3600) (* minutes 60) seconds))))
             (rule ()
               (let ((date
                       (cond ((accept #\M)
                              (let ((month (number)))
                                (need #\.)
                                (let ((week (number)))
                                  (need #\.)
                                  (let ((day (number)))
                                    (unless (and (<= 1 month 12) (<= 1 week 5) (<= 0 day 6))
                                      (error "invalid TZif month rule"))
                                    (list :month month week day)))))
                             ((accept #\J)
                              (let ((day (number)))
                                (unless (<= 1 day 365) (error "invalid TZif Julian rule"))
                                (list :julian day)))
                             (t (let ((day (number)))
                                  (unless (<= 0 day 365) (error "invalid TZif day rule"))
                                  (list :day day))))))
                 (append date (list (if (accept #\/) (clock 167) 7200))))))
      (name)
      (let ((standard (- (clock 24))))
        (if (= position length)
            (list standard)
            (progn
              (name)
              (let ((daylight (if (and (peek) (not (eql (peek) #\,))) (- (clock 24)) (+ standard 3600))))
                (need #\,)
                (let ((start (rule)))
                  (need #\,)
                  (let ((end (rule)))
                    (unless (= position length) (error "trailing TZif POSIX rule"))
                    (list standard daylight start end))))))))))

(defun sql-tz-days-from-civil (year month day)
  "Proleptic Gregorian date as days since 1970-01-01."
  (let* ((year (if (<= month 2) (1- year) year))
         (era (floor year 400))
         (yoe (- year (* era 400)))
         (mp (+ month (if (> month 2) -3 9)))
         (doy (+ (floor (+ (* 153 mp) 2) 5) (1- day)))
         (doe (+ (* yoe 365) (floor yoe 4) (- (floor yoe 100)) doy)))
    (- (+ (* era 146097) doe) 719468)))

(defun sql-tz-year-from-seconds (seconds)
  (let* ((days (+ (floor seconds 86400) 719468))
         (era (floor days 146097))
         (doe (- days (* era 146097)))
         (yoe (floor (+ doe (- (floor doe 1460)) (floor doe 36524) (- (floor doe 146096))) 365))
         (year (+ yoe (* era 400)))
         (doy (- doe (+ (* 365 yoe) (floor yoe 4) (- (floor yoe 100)))))
         (month-part (floor (+ (* 5 doy) 2) 153))
         (month (+ month-part (if (< month-part 10) 3 -9))))
    (if (<= month 2) (1+ year) year)))

(defun sql-tz-rule-second (year rule offset-before)
  (let* ((leap (and (zerop (mod year 4)) (or (not (zerop (mod year 100))) (zerop (mod year 400)))))
         (jan (sql-tz-days-from-civil year 1 1))
         (day
           (case (first rule)
             (:julian (+ (1- (second rule)) (if (and leap (>= (second rule) 60)) 1 0)))
             (:day (second rule))
             (:month
              (destructuring-bind (kind month week weekday seconds) rule
                (declare (ignore kind seconds))
                (let* ((first-day (sql-tz-days-from-civil year month 1))
                       (weekday-first (mod (+ first-day 4) 7))
                       (month-length (- (sql-tz-days-from-civil (if (= month 12) (1+ year) year)
                                                                (if (= month 12) 1 (1+ month)) 1)
                                        first-day))
                       (day (+ 1 (mod (- weekday weekday-first) 7) (* 7 (1- week)))))
                  (when (> day month-length) (decf day 7))
                  (- (sql-tz-days-from-civil year month day) jan)))))))
    (+ (* (+ jan day) 86400) (car (last rule)) (- offset-before))))

(defun sql-tz-recurring-transitions (rules year)
  (when (cdr rules)
    (destructuring-bind (standard daylight start end) rules
      (list (list (sql-tz-rule-second year start standard) standard daylight)
            (list (sql-tz-rule-second year end daylight) daylight standard)))))

(defun sql-tz-recurring-offset (rules instant)
  (if (null (cdr rules)) (first rules)
      (let* ((year (sql-tz-year-from-seconds instant))
             (events (loop for candidate from (- year 1) to (+ year 1)
                           append (sql-tz-recurring-transitions rules candidate)))
             (latest (car (sort (remove-if (lambda (event) (> (first event) instant)) events)
                                #'> :key #'first))))
        (if latest (third latest) (first rules)))))

(defun sql-tzif-footer-names (text)
  "Read the standard and daylight abbreviations from a validated POSIX footer."
  (when (zerop (length text)) (return-from sql-tzif-footer-names nil))
  (let ((position 0) (length (length text)))
    (labels ((peek () (and (< position length) (char text position)))
             (name ()
               (if (eql (peek) #\<)
                   (progn
                     (incf position)
                     (let* ((start position) (end (position #\> text :start start)))
                       (unless end (error "invalid TZif abbreviation"))
                       (setf position (1+ end))
                       (subseq text start end)))
                   (let ((start position))
                     (loop while (and (peek) (alpha-char-p (peek))) do (incf position))
                     (when (= start position) (error "invalid TZif abbreviation"))
                     (subseq text start position)))))
      (let ((standard (name)))
        (loop while (and (peek) (or (digit-char-p (peek)) (find (peek) "+-:")))
              do (incf position))
        (if (and (peek) (or (alpha-char-p (peek)) (eql (peek) #\<)))
            (list standard (name))
            (list standard))))))

(defun sql-read-tzif (path)
  (with-open-file (stream path :direction :input :element-type '(unsigned-byte 8))
    (let* ((size (file-length stream))
           (bytes (progn (unless (<= size 1048576) (error "invalid TZif size"))
                         (make-array size :element-type '(unsigned-byte 8)))))
      (unless (= (read-sequence bytes stream) size)
        (error "invalid TZif size"))
      (multiple-value-bind (version counts) (sql-tzif-header bytes 0)
        (let* ((header (if (zerop version) 0 (sql-tzif-block-end 44 counts 4)))
               (width (if (zerop version) 4 8)))
          (unless (zerop version)
            (multiple-value-bind (next-version next-counts) (sql-tzif-header bytes header)
              (unless (= version next-version) (error "inconsistent TZif version"))
              (setf counts next-counts)))
          (destructuring-bind (utc standard leap timecnt typecnt charcnt) counts
            (declare (ignore utc standard leap))
            (let* ((start (+ header 44))
                   (end (sql-tzif-block-end start counts width))
                   (index-start (+ start (* timecnt width)))
                   (type-start (+ index-start timecnt))
                   (abbrev-start (+ type-start (* typecnt 6)))
                   (transitions (make-array timecnt))
                   (indices (make-array timecnt))
                   (offsets (make-array typecnt))
                   (abbreviations (make-array typecnt))
                   (footer ""))
              (unless (<= end size) (error "truncated TZif block"))
              (dotimes (index timecnt)
                (let ((transition (sql-tzif-signed bytes (+ start (* index width)) width))
                      (type (aref bytes (+ index-start index))))
                  (unless (and (< type typecnt)
                               (or (zerop index) (< (aref transitions (1- index)) transition)))
                    (error "invalid TZif transitions"))
                  (setf (aref transitions index) transition (aref indices index) type)))
              (dotimes (index typecnt)
                (let* ((position (+ type-start (* index 6)))
                       (abbrev (aref bytes (+ position 5))))
                  (unless (and (<= (aref bytes (+ position 4)) 1) (< abbrev charcnt)
                               (position 0 bytes :start (+ abbrev-start abbrev)
                                                 :end (+ abbrev-start charcnt)))
                    (error "invalid TZif local time type"))
                  (setf (aref offsets index) (sql-tzif-signed bytes position 4)
                        (aref abbreviations index)
                        (map 'string #'code-char
                             (subseq bytes (+ abbrev-start abbrev)
                                     (position 0 bytes :start (+ abbrev-start abbrev)
                                                       :end (+ abbrev-start charcnt)))))))
              (unless (zerop version)
                (unless (and (< end size) (= (aref bytes end) 10)
                             (= (aref bytes (1- size)) 10))
                  (error "invalid TZif footer"))
                (setf footer (map 'string #'code-char (subseq bytes (1+ end) (1- size)))))
              (make-sql-timezone transitions indices offsets abbreviations footer
                                 (sql-parse-tzif-footer footer) (sql-tzif-footer-names footer)))))))))

(defun sql-timezone-name-valid-p (name)
  (and (stringp name) (plusp (length name)) (< (length name) 256)
       (not (char= (char name 0) #\/))
       (every (lambda (part) (and (plusp (length part)) (not (member part '("." "..") :test #'equal))))
              (uiop:split-string name :separator "/"))
       (every (lambda (char) (or (and (char<= #\a char #\z)) (and (char<= #\A char #\Z))
                                 (and (char<= #\0 char #\9)) (find char "/_+-"))) name)))

(defun sql-timezone-file (name)
  "Find an IANA zone using PostgreSQL's case-insensitive path lookup."
  (let ((direct (merge-pathnames name #p"/usr/share/zoneinfo/")))
    (or (probe-file direct)
        (loop with path = #p"/usr/share/zoneinfo/"
              for remaining on (uiop:split-string name :separator "/")
              for part = (car remaining)
              for entries = (directory (merge-pathnames "*" path) :resolve-symlinks nil)
              for entry = (find part entries :test #'string-equal
                                             :key (lambda (entry)
                                                    (let ((filename (file-namestring entry)))
                                                      (if (plusp (length filename)) filename
                                                          (car (last (pathname-directory entry)))))))
              unless (and entry (or (null (cdr remaining)) (uiop:directory-pathname-p entry)))
                do (return nil)
              do (setf path entry)
              finally (return path)))))

(defun sql-load-timezone (name)
  (unless (sql-timezone-name-valid-p name) (error "invalid time zone name"))
  (or (sb-thread:with-mutex (*sql-timezone-cache-lock*) (gethash name *sql-timezone-cache*))
      (let ((zone (sql-read-tzif (or (sql-timezone-file name) (error "unknown time zone")))))
        (sb-thread:with-mutex (*sql-timezone-cache-lock*)
          (or (gethash name *sql-timezone-cache*)
              (setf (gethash name *sql-timezone-cache*) zone))))))

(defun sql-timezone-offset-at (zone unix-second)
  "Return the UTC offset east of Greenwich at UNIX-SECOND."
  (let* ((times (sql-timezone-transitions zone)) (count (length times))
                                                 (low 0) (high count))
    (when (and (sql-timezone-rules zone)
               (or (zerop count) (> unix-second (aref times (1- count)))))
      (return-from sql-timezone-offset-at
        (sql-tz-recurring-offset (sql-timezone-rules zone) unix-second)))
    (loop while (< low high)
          for middle = (floor (+ low high) 2)
          do (if (<= (aref times middle) unix-second)
                 (setf low (1+ middle)) (setf high middle)))
    (aref (sql-timezone-offsets zone)
          (if (zerop low) 0 (aref (sql-timezone-indices zone) (1- low))))))

(defun sql-timezone-abbreviation-at (zone unix-second)
  "Return the TZif or POSIX abbreviation in effect at UNIX-SECOND."
  (let* ((times (sql-timezone-transitions zone)) (count (length times))
                                                 (rules (sql-timezone-rules zone)) (names (sql-timezone-footer-names zone)))
    (when (and rules names (or (zerop count) (> unix-second (aref times (1- count)))))
      (return-from sql-timezone-abbreviation-at
        (if (null (cdr rules)) (first names)
            (let* ((year (sql-tz-year-from-seconds unix-second))
                   (events (loop for candidate from (1- year) to (1+ year)
                                 for pair = (sql-tz-recurring-transitions rules candidate)
                                 append (list (cons (first (first pair)) (second names))
                                              (cons (first (second pair)) (first names)))))
                   (latest (car (sort (remove-if (lambda (event) (> (car event) unix-second)) events)
                                      #'> :key #'car))))
              (if latest (cdr latest) (first names))))))
    (let ((low 0) (high count))
      (loop while (< low high) for middle = (floor (+ low high) 2)
            do (if (<= (aref times middle) unix-second)
                   (setf low (1+ middle)) (setf high middle)))
      (aref (sql-timezone-abbreviations zone)
            (if (zerop low) 0 (aref (sql-timezone-indices zone) (1- low)))))))

(defun sql-timezone-abbreviation-offset (zone abbreviation local-second)
  "Resolve ABBREVIATION in ZONE using PostgreSQL's transition search order."
  (let* ((names (sql-timezone-abbreviations zone))
         (offsets (sql-timezone-offsets zone))
         (matches (loop for name across names for index from 0
                        when (string-equal name abbreviation) collect index)))
    (unless matches (return-from sql-timezone-abbreviation-offset nil))
    (when (every (lambda (index) (= (aref offsets index) (aref offsets (first matches))))
                 (rest matches))
      (return-from sql-timezone-abbreviation-offset (aref offsets (first matches))))
    (let* ((times (sql-timezone-transitions zone))
           (indices (sql-timezone-indices zone))
           (probe (sql-timezone-resolve-local zone local-second))
           (cutoff (position-if (lambda (time) (> time probe)) times)))
      (setf cutoff (or cutoff (length times)))
      (flet ((offset-at (index)
               (let ((type (aref indices index)))
                 (when (member type matches) (aref offsets type)))))
        (or (loop for index downfrom (1- cutoff) to 0
                  for offset = (offset-at index) when offset return offset)
            (when (member 0 matches) (aref offsets 0))
            (loop for index from cutoff below (length times)
                  for offset = (offset-at index) when offset return offset)
            (aref offsets (first matches)))))))

(defun sql-decode-timezone-abbreviation (name session-zone local-second)
  "Return the offset east for a PostgreSQL timezone abbreviation, or NIL."
  (or (and session-zone
           (sql-timezone-abbreviation-offset session-zone name local-second))
      (let ((entry (assoc name +sql-default-timezone-abbreviations+ :test #'string-equal)))
        (when entry
          (let ((value (second entry)))
            (if (integerp value) value
                (let ((zone (sql-load-timezone value)))
                  (or (sql-timezone-abbreviation-offset zone name local-second)
                      (- local-second (sql-timezone-resolve-local zone local-second))))))))))

(defun sql-timezone-resolve-local (zone local-second)
  "Resolve a local wall-clock second using PostgreSQL's gap and fold policy."
  (let ((candidates nil) (coverage-error nil))
    (loop for offset in (remove-duplicates
                         (append (coerce (sql-timezone-offsets zone) 'list)
                                 (let ((rules (sql-timezone-rules zone)))
                                   (when rules (if (cdr rules) (subseq rules 0 2) rules)))))
          for instant = (- local-second offset)
          do (handler-case
                 (when (= offset (sql-timezone-offset-at zone instant)) (push instant candidates))
               (pg-error (condition) (setf coverage-error condition))))
    (when candidates (return-from sql-timezone-resolve-local (reduce #'max candidates)))
    (let ((times (sql-timezone-transitions zone)) (indices (sql-timezone-indices zone))
                                                  (offsets (sql-timezone-offsets zone)))
      (loop for index below (length times)
            for instant = (aref times index)
            for before = (aref offsets (if (zerop index) 0 (aref indices (1- index))))
            for after = (aref offsets (aref indices index))
            when (and (< before after) (<= (+ instant before) local-second)
                      (< local-second (+ instant after)))
              do (return-from sql-timezone-resolve-local (- local-second before))))
    (let* ((rules (sql-timezone-rules zone))
           (times (sql-timezone-transitions zone))
           (last-transition (and (plusp (length times)) (aref times (1- (length times)))))
           (year (sql-tz-year-from-seconds local-second)))
      (when rules
        (loop for candidate from (1- year) to (1+ year)
              do (dolist (event (sql-tz-recurring-transitions rules candidate))
                   (destructuring-bind (instant before after) event
                     (when (and (or (null last-transition) (> instant last-transition))
                                (< before after) (<= (+ instant before) local-second)
                                (< local-second (+ instant after)))
                       (return-from sql-timezone-resolve-local (- local-second before))))))))
    (when coverage-error (error coverage-error))
    (ereport "22008" "cannot resolve local time in time zone")))

(defun sql-timezone-instant-to-local (zone timestamp)
  "Shift PostgreSQL-epoch microseconds to local wall-clock microseconds."
  (if (member timestamp '(#x7fffffffffffffff -9223372036854775808))
      timestamp
      (+ timestamp (* 1000000 (sql-timezone-offset-at zone (+ 946684800 (floor timestamp 1000000)))))))

(defun sql-timezone-local-to-instant (zone timestamp)
  "Resolve local PostgreSQL-epoch microseconds to an instant."
  (if (member timestamp '(#x7fffffffffffffff -9223372036854775808))
      timestamp
      (multiple-value-bind (seconds fraction) (floor timestamp 1000000)
        (+ (* 1000000 (- (sql-timezone-resolve-local zone (+ seconds 946684800)) 946684800))
           fraction))))
