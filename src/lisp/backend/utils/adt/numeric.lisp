;;;; Exact finite numeric values for expression evaluation and aggregate results.
(in-package #:pg)

(defstruct (sql-decimal (:constructor make-sql-decimal (coefficient scale)))
  ;; Immutable finite value coefficient * 10^-scale; scale also preserves display
  ;; precision. Integers are accepted as scale-zero values by the numeric helpers.
  (coefficient 0 :type integer :read-only t)
  (scale 0 :type (integer 0 *) :read-only t))

(defun sql-numeric-special-p (value)
  (member value '(:numeric-nan :numeric-positive-infinity :numeric-negative-infinity)))

(defun sql-numeric-compare (left right)
  "Compare finite and special numeric values in PostgreSQL's total order."
  (labels ((rank (value)
             (case value (:numeric-negative-infinity 0) (:numeric-positive-infinity 2)
                   (:numeric-nan 3) (otherwise 1))))
    (let ((a (rank left)) (b (rank right)))
      (cond ((< a b) -1) ((> a b) 1) ((/= a 1) 0)
            (t (let ((x (sql-numeric-rational left)) (y (sql-numeric-rational right)))
                 (cond ((< x y) -1) ((> x y) 1) (t 0))))))))

(defun sql-numeric-negate (value)
  (case value
    (:numeric-nan :numeric-nan)
    (:numeric-positive-infinity :numeric-negative-infinity)
    (:numeric-negative-infinity :numeric-positive-infinity)
    (otherwise (if (integerp value) (- value)
                   (make-sql-decimal (- (sql-decimal-coefficient value))
                                     (sql-decimal-scale value))))))

(defun sql-numeric-p (value)
  (or (integerp value) (sql-decimal-p value) (sql-numeric-special-p value)))

(defun sql-numeric-coefficient (value)
  (if (integerp value) value (sql-decimal-coefficient value)))

(defun sql-numeric-scale (value)
  "Return the stored fractional digit count of finite VALUE; integers have scale zero."
  (if (integerp value) 0 (sql-decimal-scale value)))

(defun sql-numeric-min-scale (value)
  "Return the least nonnegative scale that preserves finite VALUE without loss.
Zero and values with no significant fractional digits have minimum scale zero."
  (let ((coefficient (sql-numeric-coefficient value))
        (scale (sql-numeric-scale value)))
    (when (or (zerop coefficient) (zerop scale))
      (return-from sql-numeric-min-scale 0))
    (let ((digits (format nil "~d" (abs coefficient))))
      (loop for index downfrom (1- (length digits))
            while (and (plusp scale) (>= index 0) (char= (char digits index) #\0))
            do (decf scale)))
    scale))

(defun sql-numeric-trim-scale (value)
  "Return VALUE at its minimum scale, removing insignificant fractional zeroes.
Finite values become SQL decimals; NaN and infinities pass through unchanged."
  (when (sql-numeric-special-p value) (return-from sql-numeric-trim-scale value))
  (let* ((scale (sql-numeric-min-scale value))
         (coefficient (truncate (sql-numeric-coefficient value)
                                (expt 10 (- (sql-numeric-scale value) scale)))))
    (make-sql-decimal coefficient scale)))

(defun sql-numeric-rational (value)
  (/ (sql-numeric-coefficient value) (expt 10 (sql-numeric-scale value))))

(defun sql-numeric-output (value)
  (case value
    (:numeric-nan (return-from sql-numeric-output "NaN"))
    (:numeric-positive-infinity (return-from sql-numeric-output "Infinity"))
    (:numeric-negative-infinity (return-from sql-numeric-output "-Infinity")))
  (if (integerp value) (format nil "~d" value)
      (let* ((coefficient (sql-decimal-coefficient value))
             (scale (sql-decimal-scale value))
             (digits (format nil "~v,'0d" (1+ scale) (abs coefficient)))
             (point (- (length digits) scale)))
        (format nil "~a~a~a" (if (minusp coefficient) "-" "")
                (subseq digits 0 point)
                (if (zerop scale) "" (concatenate 'string "." (subseq digits point)))))))

(defun sql-numeric-input (text)
  "Read finite decimal input without invoking the Lisp reader."
  (let* ((input (string-trim (mapcar #'code-char '(9 10 11 12 13 32)) text))
         (length (length input)) (position 0) (sign 1) (coefficient 0)
         (digits 0) (fractional 0) (exponent 0))
    (let ((special (string-downcase input)))
      (cond ((string= special "nan") (return-from sql-numeric-input :numeric-nan))
            ((member special '("infinity" "+infinity" "inf" "+inf") :test #'string=)
             (return-from sql-numeric-input :numeric-positive-infinity))
            ((member special '("-infinity" "-inf") :test #'string=)
             (return-from sql-numeric-input :numeric-negative-infinity))))
    (labels ((peek () (when (< position length) (char input position)))
             (bad () (ereport "22P02" "invalid input syntax for type numeric: ~s" text))
             (digit () (sql-number-digit-p (peek) 10))
             (read-digits (fraction-p)
               (loop while (digit)
                     do (setf coefficient (+ (* coefficient 10) (digit)))
                        (incf position) (incf digits)
                        (when fraction-p (incf fractional))
                        (when (eql (peek) #\_)
                          (incf position) (unless (digit) (bad))))))
      (when (and (peek) (find (peek) "+-"))
        (when (char= (peek) #\-) (setf sign -1)) (incf position))
      (read-digits nil)
      (when (eql (peek) #\.) (incf position) (read-digits t))
      (when (zerop digits) (bad))
      (when (and (peek) (find (peek) "eE"))
        (incf position)
        (let ((exponent-sign 1) (exponent-digits 0))
          (when (and (peek) (find (peek) "+-"))
            (when (char= (peek) #\-) (setf exponent-sign -1)) (incf position))
          (loop while (digit)
                do (setf exponent (+ (* exponent 10) (digit)))
                   (incf position) (incf exponent-digits)
                   (when (> exponent (floor +int4-max+ 2)) (ereport "22003" "numeric value out of range"))
                   (when (eql (peek) #\_) (incf position) (unless (digit) (bad))))
          (when (zerop exponent-digits) (bad))
          (setf exponent (* exponent-sign exponent))))
      (unless (= position length) (bad))
      (let ((scale (- fractional exponent)))
        (when (or (> scale 16383) (and (not (zerop coefficient))
                                       (> (- (length (format nil "~d" coefficient)) scale) 131072)))
          (ereport "22003" "numeric value out of range"))
        (if (minusp scale)
            (make-sql-decimal (if (zerop coefficient) 0 (* sign coefficient (expt 10 (- scale)))) 0)
            (make-sql-decimal (* sign coefficient) scale))))))

(defun sql-numeric-rounded-coefficient (value scale)
  "Round at the requested decimal scale, with ties away from zero."
  (let ((scaled (* (sql-numeric-rational value) (expt 10 scale))))
    (* (signum scaled) (floor (+ (abs scaled) 1/2)))))

(defun sql-numeric-apply-typmod (value typmod)
  "Round and check a finite numeric value using PostgreSQL's packed typmod."
  (when (and (>= typmod 4) (sql-numeric-special-p value))
    (if (eq value :numeric-nan) (return-from sql-numeric-apply-typmod value)
        (ereport "22003" "numeric field overflow")))
  (if (< typmod 4) value
      (let* ((packed (- typmod 4))
             (precision (ldb (byte 16 16) packed))
             (bits (logand packed #x7ff))
             (scale (- (logxor bits #x400) #x400))
             (rounded (sql-numeric-rounded-coefficient value scale)))
        (when (>= (abs rounded) (expt 10 precision))
          (ereport "22003" "numeric field overflow"))
        (if (minusp scale)
            (make-sql-decimal (* rounded (expt 10 (- scale))) 0)
            (make-sql-decimal rounded scale)))))

(defun sql-numeric-leading-digit (value)
  "Return numeric.c's normalized base-10000 weight and first digit."
  (let ((coefficient (abs (sql-numeric-coefficient value)))
        (scale (sql-numeric-scale value)))
    (if (zerop coefficient) (values 0 0)
        (let* ((digits (length (format nil "~d" coefficient)))
               (weight (floor (- digits scale 1) 4))
               (shift (+ scale (* 4 weight))))
          (values weight (if (minusp shift)
                             (* coefficient (expt 10 (- shift)))
                             (floor coefficient (expt 10 shift))))))))

(defun sql-numeric-special-arithmetic (operator left right)
  "Evaluate a binary numeric operation when at least one argument is special."
  (when (or (eq left :numeric-nan) (eq right :numeric-nan))
    (return-from sql-numeric-special-arithmetic :numeric-nan))
  (when (string= operator "-")
    (return-from sql-numeric-special-arithmetic
      (sql-numeric-special-arithmetic "+" left (sql-numeric-negate right))))
  (when (string= operator "+")
    (return-from sql-numeric-special-arithmetic
      (cond ((not (sql-numeric-special-p left)) right)
            ((not (sql-numeric-special-p right)) left)
            ((eq left right) left)
            (t :numeric-nan))))
  (when (and (member operator '("/" "%") :test #'string=)
             (not (sql-numeric-special-p right))
             (zerop (sql-numeric-coefficient right)))
    (ereport "22012" "division by zero"))
  (when (string= operator "%")
    (return-from sql-numeric-special-arithmetic
      (if (sql-numeric-special-p left) :numeric-nan left)))
  (when (string= operator "/")
    (return-from sql-numeric-special-arithmetic
      (cond ((and (sql-numeric-special-p left) (sql-numeric-special-p right)) :numeric-nan)
            ((not (sql-numeric-special-p left)) (make-sql-decimal 0 0))
            (t (if (minusp (sql-numeric-coefficient right)) (sql-numeric-negate left) left)))))
  (when (string= operator "*")
    (let* ((finite (if (sql-numeric-special-p left) right left))
           (infinite (if (sql-numeric-special-p left) left right)))
      (return-from sql-numeric-special-arithmetic
        (cond ((sql-numeric-special-p finite)
               (if (eq finite infinite) :numeric-positive-infinity :numeric-negative-infinity))
              ((zerop (sql-numeric-coefficient finite)) :numeric-nan)
              ((minusp (sql-numeric-coefficient finite)) (sql-numeric-negate infinite))
              (t infinite)))))
  (ereport "XX000" "unknown numeric operator"))

(defun sql-numeric-accumulate (left right)
  "Retain an unbounded exact total; only the aggregate's final result is bounded."
  (when (or (sql-numeric-special-p left) (sql-numeric-special-p right))
    (return-from sql-numeric-accumulate (sql-numeric-special-arithmetic "+" left right)))
  (if (and (integerp left) (integerp right)) (+ left right)
      (let ((scale (max (sql-numeric-scale left) (sql-numeric-scale right))))
        (make-sql-decimal (+ (* (sql-numeric-coefficient left) (expt 10 (- scale (sql-numeric-scale left))))
                             (* (sql-numeric-coefficient right) (expt 10 (- scale (sql-numeric-scale right)))))
                          scale))))

(defun sql-numeric-result (coefficient scale)
  "Apply numeric's finite result bounds and multiplication scale limit."
  (when (> scale 16383)
    (let* ((divisor (expt 10 (- scale 16383)))
           (scaled (/ coefficient divisor)))
      (setf coefficient (* (signum scaled) (floor (+ (abs scaled) 1/2)))
            scale 16383)))
  (when (and (not (zerop coefficient))
             (> (- (length (format nil "~d" (abs coefficient))) scale) 131072))
    (ereport "22003" "value overflows numeric format"))
  (make-sql-decimal coefficient scale))

;; Defined later in backend/access/transam/xact.lisp.
(declaim (ftype (function () t) check-for-interrupts))

(defun sql-numeric-gcd-lcm (left right lcm-p)
  "Compute numeric GCD or LCM at the maximum input display scale."
  (when (or (sql-numeric-special-p left) (sql-numeric-special-p right))
    (return-from sql-numeric-gcd-lcm :numeric-nan))
  (let* ((scale (max (sql-numeric-scale left) (sql-numeric-scale right)))
         (a (* (sql-numeric-coefficient left) (expt 10 (- scale (sql-numeric-scale left)))))
         (b (* (sql-numeric-coefficient right) (expt 10 (- scale (sql-numeric-scale right)))))
         (divisor (let ((x (abs a)) (y (abs b)))
                    (when (< x y) (rotatef x y))
                    (unless (or (= x y) (zerop y))
                      (loop while (not (zerop y))
                            do (check-for-interrupts)
                               (psetf x y y (rem x y))))
                    x))
         (coefficient (if lcm-p
                          (if (zerop divisor) 0 (abs (* (truncate a divisor) b)))
                          divisor)))
    (sql-numeric-result coefficient scale)))

(defun sql-numeric-sqrt (value)
  "Return the square root using numeric.c's result scale and decimal rounding.
The scale preserves the input display scale and supplies significant digits,
subject to the numeric display limit.  Integer arithmetic keeps the rounding
exact.  Negative values signal an error; NaN and positive infinity pass through."
  (when (eq value :numeric-negative-infinity)
    (ereport "2201F" "cannot take square root of a negative number"))
  (when (sql-numeric-special-p value) (return-from sql-numeric-sqrt value))
  (let ((coefficient (sql-numeric-coefficient value)))
    (when (minusp coefficient)
      (ereport "2201F" "cannot take square root of a negative number"))
    (multiple-value-bind (weight digit) (sql-numeric-leading-digit value)
      (declare (ignore digit))
      (let* ((scale (min 1000 (max 0 (sql-numeric-scale value) (- 15 (* 2 weight)))))
             (shift (- (* 2 scale) (sql-numeric-scale value)))
             (numerator (if (minusp shift) coefficient (* coefficient (expt 10 shift))))
             (denominator (if (minusp shift) (expt 10 (- shift)) 1))
             (root (isqrt (floor numerator denominator))))
        (when (>= (* 4 numerator) (* denominator (expt (1+ (* 2 root)) 2)))
          (incf root))
        (sql-numeric-result root scale)))))

(defun sql-numeric-round-rational (number scale)
  "Round a rational to SCALE decimal places, with ties away from zero."
  (let* ((factor (expt 10 scale))
         (scaled (* number factor)))
    (/ (* (signum scaled) (floor (+ (abs scaled) 1/2))) factor)))

(defun sql-numeric-rational-weight (value)
  "Return the normalized base-10000 weight of a positive rational."
  (when (zerop value) (return-from sql-numeric-rational-weight 0))
  (let* ((numerator (numerator value))
         (denominator (denominator value))
         (decimal-weight (- (length (format nil "~d" numerator))
                            (length (format nil "~d" denominator)))))
    (when (< value (expt 10 decimal-weight))
      (decf decimal-weight))
    (floor decimal-weight 4)))

(defun sql-numeric-rational-decimal-weight (value)
  "Return the decimal weight of the first significant digit of VALUE."
  (let* ((value (abs value))
         (weight (- (length (format nil "~d" (numerator value)))
                    (length (format nil "~d" (denominator value))))))
    (if (< value (expt 10 weight)) (1- weight) weight)))

(defun sql-numeric-estimate-ln-weight (value)
  "Estimate the decimal weight of ln(VALUE), following numeric.c."
  (cond ((not (plusp value)) 0)
        ((<= 9/10 value 11/10)
         (if (= value 1) 0 (sql-numeric-rational-decimal-weight (- value 1))))
        (t
         (let* ((weight (sql-numeric-rational-weight value))
                (digits (floor (* value (expt 10 (- 4 (* 4 weight))))))
                (one-digit (zerop (mod digits 10000)))
                (digits (if one-digit (/ digits 10000) digits))
                (dweight (- (* weight 4) (if one-digit 0 4)))
                (estimate (+ (log (coerce digits 'double-float))
                             (* dweight 2.302585092994046d0))))
           (truncate (/ (log (abs estimate)) (log 10d0)))))))

(defun sql-numeric-sqrt-rational (value scale)
  "Round the positive rational square root to SCALE decimal places."
  (let* ((scaled (* value (expt 10 (* 2 scale))))
         (numerator (numerator scaled))
         (denominator (denominator scaled))
         (root (isqrt (floor numerator denominator))))
    (when (>= (* 4 numerator) (* denominator (expt (1+ (* 2 root)) 2)))
      (incf root))
    (/ root (expt 10 scale))))

(defun sql-numeric-ln-rational (value scale)
  "Compute ln at SCALE using numeric.c's square-root reduction and odd-power series.
Intermediate operations are rounded at guard scales before the final rounding."
  (when (zerop value) (ereport "2201E" "cannot take logarithm of zero"))
  (when (minusp value) (ereport "2201E" "cannot take logarithm of a negative number"))
  (let ((x value) (roots 0))
    (loop while (or (<= x 9/10) (>= x 11/10))
          do (setf x (sql-numeric-sqrt-rational
                      x (+ 8 scale (* -2 (sql-numeric-rational-weight x)))))
             (incf roots))
    (let* ((work-scale (+ scale 8 (truncate (* (1+ roots) 0.301029995663981d0))))
           (z (sql-numeric-round-rational (/ (- x 1) (+ x 1)) work-scale))
           (square (sql-numeric-round-rational (* z z) work-scale))
           (power z)
           (sum z)
           (index 1))
      (loop
        (incf index 2)
        (setf power (sql-numeric-round-rational (* power square) work-scale))
        (let ((term (sql-numeric-round-rational (/ power index) work-scale)))
          (when (zerop term) (return))
          (incf sum term)
          (when (< (sql-numeric-rational-weight (abs term))
                   (- (sql-numeric-rational-weight (abs sum))
                      (truncate (* work-scale 2) 4)))
            (return))))
      (sql-numeric-round-rational (* sum (expt 2 (1+ roots))) scale))))

(defun sql-numeric-ln (value)
  "Return the numeric natural logarithm with PostgreSQL's display scale.
Zero and negative inputs raise SQLSTATE 2201E; NaN and positive infinity pass through."
  (case value
    (:numeric-negative-infinity
     (ereport "2201E" "cannot take logarithm of a negative number"))
    ((:numeric-positive-infinity :numeric-nan) (return-from sql-numeric-ln value)))
  (let* ((number (sql-numeric-rational value))
         (weight (sql-numeric-estimate-ln-weight number))
         (scale (min 1000 (max 0 (sql-numeric-scale value) (- 16 weight))))
         (result (sql-numeric-ln-rational number scale)))
    (sql-numeric-result (* result (expt 10 scale)) scale)))

(defun sql-numeric-log (base value)
  "Return ln(VALUE) / ln(BASE), choosing numeric.c's result and guard scales.
Reject zero or negative arguments and base one with SQLSTATE 2201E."
  (when (or (eq base :numeric-nan) (eq value :numeric-nan))
    (return-from sql-numeric-log :numeric-nan))
  (when (or (eq base :numeric-negative-infinity) (eq value :numeric-negative-infinity))
    (ereport "2201E" "cannot take logarithm of a negative number"))
  (when (or (sql-numeric-special-p base) (sql-numeric-special-p value))
    (when (or (and (not (sql-numeric-special-p base)) (minusp (sql-numeric-coefficient base)))
              (and (not (sql-numeric-special-p value)) (minusp (sql-numeric-coefficient value))))
      (ereport "2201E" "cannot take logarithm of a negative number"))
    (when (or (and (not (sql-numeric-special-p base)) (zerop (sql-numeric-coefficient base)))
              (and (not (sql-numeric-special-p value)) (zerop (sql-numeric-coefficient value))))
      (ereport "2201E" "cannot take logarithm of zero"))
    (when (eq base :numeric-positive-infinity)
      (return-from sql-numeric-log (if (eq value :numeric-positive-infinity) :numeric-nan 0)))
    (let ((compare (sql-numeric-compare base 1)))
      (cond ((minusp compare) (return-from sql-numeric-log :numeric-negative-infinity))
            ((plusp compare) (return-from sql-numeric-log :numeric-positive-infinity))
            (t (ereport "2201E" "cannot take logarithm using base one")))))
  (let* ((b (sql-numeric-rational base))
         (v (sql-numeric-rational value)))
    (when (= b 1) (ereport "2201E" "cannot take logarithm using base one"))
    (let* ((bw (sql-numeric-estimate-ln-weight b))
           (vw (sql-numeric-estimate-ln-weight v))
           (weight (- vw bw))
           (scale (min 1000 (max 0 (sql-numeric-scale base) (sql-numeric-scale value)
                                 (- 16 weight))))
           (base-scale (max 0 (+ scale weight (- bw) 8)))
           (value-scale (max 0 (+ scale weight (- vw) 8)))
           (lb (sql-numeric-ln-rational b base-scale))
           (lv (sql-numeric-ln-rational v value-scale))
           (result (sql-numeric-round-rational (/ lv lb) scale)))
      (sql-numeric-result (* result (expt 10 scale)) scale))))

(defun sql-numeric-exp (value &optional requested-scale)
  "Compute numeric exp using numeric.c's scale and intermediate rounding strategy.
Reduce the argument by powers of two, sum a rounded Taylor series, then square
back and round to the result scale.  NaN and positive infinity pass through;
negative infinity returns zero.  Large positive inputs overflow and large
negative inputs return scaled zero."
  (case value
    (:numeric-negative-infinity (return-from sql-numeric-exp 0))
    ((:numeric-positive-infinity :numeric-nan) (return-from sql-numeric-exp value)))
  (let* ((x (sql-numeric-rational value))
         (estimate (cond ((> x 6000) 6000d0)
                         ((< x -6000) -6000d0)
                         (t (sb-int:with-float-traps-masked (:underflow :inexact)
                              (coerce x 'double-float)))))
         (decimal-estimate (* estimate 0.434294481903252d0))
         (scale (or requested-scale
                    (min 1000 (max 0 (sql-numeric-scale value)
                                   (- 16 (truncate (max -2000d0 (min 2000d0 decimal-estimate)))))))))
    (when (>= (abs estimate) 6000d0)
      (if (plusp estimate) (ereport "22003" "value overflows numeric format")
          (return-from sql-numeric-exp (make-sql-decimal 0 scale))))
    (let ((divisions 0) (reduced estimate))
      (loop while (> (abs reduced) 0.01d0)
            do (setf reduced (/ reduced 2d0))
               (incf divisions))
      (let* ((y (/ x (expt 2 divisions)))
             (weight (truncate decimal-estimate))
             (significant (+ 8 (max 0 (+ 1 weight scale
                                         (truncate (* divisions 0.301029995663981d0))))))
             (working-scale (1- significant))
             (sum (+ 1 y))
             (term (sql-numeric-round-rational (* y y) working-scale))
             (index 2))
        (setf term (sql-numeric-round-rational (/ term index) working-scale))
        (loop until (zerop term)
              do (incf sum term)
                 (setf term (sql-numeric-round-rational (* term y) working-scale))
                 (incf index)
                 (setf term (sql-numeric-round-rational (/ term index) working-scale)))
        (dotimes (i divisions)
          (declare (ignorable i))
          (let* ((base-weight (sql-numeric-rational-weight sum))
                 (product-scale (max 0 (- significant (* 8 base-weight)))))
            (setf sum (sql-numeric-round-rational (* sum sum) product-scale))))
        (let* ((rounded (sql-numeric-round-rational sum scale))
               (coefficient (* rounded (expt 10 scale))))
          (sql-numeric-result coefficient scale))))))

(defun sql-numeric-power-estimate (number exponent)
  "Estimate the power's decimal weight from numeric.c's first four base-10000 digits.
This estimate selects result and working scales and detects extreme results."
  (when (zerop number) (return-from sql-numeric-power-estimate 0d0))
  (let* ((weight (sql-numeric-rational-weight (abs number)))
         (normalized (/ (abs number) (expt 10 (* 4 weight))))
         (first-digit (floor normalized))
         (fraction (- normalized first-digit))
         (mantissa (coerce first-digit 'double-float))
         (power (* 4 weight)))
    (loop repeat 3 while (not (zerop fraction))
          do (setf fraction (* fraction 10000))
             (let ((digit (floor fraction)))
               (setf mantissa (+ (* mantissa 10000d0) (coerce digit 'double-float))
                     fraction (- fraction digit)))
             (decf power 4))
    (* exponent (+ (sb-kernel:%log10 mantissa) power))))

(defun sql-numeric-power-integer (base exponent exponent-scale)
  "Compute an int32 numeric power using numeric.c's guarded multiplication scales.
Exponentiation by squaring rounds intermediate products; negative exponents use
the reciprocal.  The result scale also preserves the operands' display scales."
  (let* ((number (sql-numeric-rational base))
         (base-scale (sql-numeric-scale base))
         (estimate (sql-numeric-power-estimate number exponent)))
    (when (> estimate 131072d0) (ereport "22003" "value overflows numeric format"))
    (when (< (+ estimate 1) -1000d0)
      (return-from sql-numeric-power-integer (make-sql-decimal 0 1000)))
    (let* ((scale (min 1000 (max 0 base-scale exponent-scale (- 16 (truncate estimate)))))
           (result
             (cond ((zerop exponent) 1)
                   ((= exponent 1) number)
                   ((= exponent -1) (/ 1 number))
                   ((= exponent 2) (* number number))
                   ((zerop number) 0)
                   (t
                    (let* ((significant (+ 1 scale (truncate estimate)
                                           (truncate (log (coerce (abs exponent) 'double-float))) 8))
                           (mask (abs exponent))
                           (product number)
                           (product-scale base-scale)
                           (answer (if (oddp mask) number 1))
                           (answer-scale (if (oddp mask) base-scale 0)))
                      (loop
                        (setf mask (ash mask -1))
                        (when (zerop mask) (return))
                        (let* ((pw (if (zerop product) 0 (sql-numeric-rational-weight (abs product))))
                               (local (max 0 (min (- significant (* 8 pw)) (* 2 product-scale)))))
                          (setf product (sql-numeric-round-rational (* product product) local)
                                product-scale local))
                        (when (oddp mask)
                          (let* ((pw (if (zerop product) 0 (sql-numeric-rational-weight (abs product))))
                                 (aw (if (zerop answer) 0 (sql-numeric-rational-weight (abs answer))))
                                 (local (max 0 (min (- significant (* 4 (+ pw aw)))
                                                    (+ product-scale answer-scale)))))
                            (setf answer (sql-numeric-round-rational (* product answer) local)
                                  answer-scale local)))
                        (when (or (and (not (zerop product))
                                       (> (sql-numeric-rational-weight (abs product)) 32767))
                                  (and (not (zerop answer))
                                       (> (sql-numeric-rational-weight (abs answer)) 32767)))
                          (if (plusp exponent) (ereport "22003" "value overflows numeric format")
                              (return-from sql-numeric-power-integer (make-sql-decimal 0 scale)))))
                      (if (minusp exponent) (/ 1 answer) answer))))))
      (let ((rounded (sql-numeric-round-rational result scale)))
        (sql-numeric-result (* rounded (expt 10 scale)) scale)))))

(defun sql-numeric-power (base exponent)
  "Compute numeric power following numeric_power and power_var in numeric.c.
Handle NaNs, infinities and domain errors before dispatching int32 exponents to
guarded multiplication.  Other finite powers use exp(exponent * ln(abs(base)))
with estimated result and guard scales, restoring the sign for odd exponents."
  (when (eq base :numeric-nan)
    (return-from sql-numeric-power
      (if (and (not (sql-numeric-special-p exponent))
               (zerop (sql-numeric-coefficient exponent))) 1 :numeric-nan)))
  (when (eq exponent :numeric-nan)
    (return-from sql-numeric-power
      (if (and (not (sql-numeric-special-p base)) (= (sql-numeric-rational base) 1))
          1 :numeric-nan)))
  (let* ((base-special (sql-numeric-special-p base))
         (exp-special (sql-numeric-special-p exponent))
         (b (unless base-special (sql-numeric-rational base)))
         (e (unless exp-special (sql-numeric-rational exponent)))
         (base-sign (if base-special (if (eq base :numeric-negative-infinity) -1 1) (signum b)))
         (exp-sign (if exp-special (if (eq exponent :numeric-negative-infinity) -1 1) (signum e))))
    (when (and (zerop base-sign) (minusp exp-sign))
      (ereport "2201F" "zero raised to a negative power is undefined"))
    (when (and (minusp base-sign) e (not (integerp e)))
      (ereport "2201F" "a negative number raised to a non-integer power yields a complex result"))
    (when (or base-special exp-special)
      (return-from sql-numeric-power
        (cond ((and b (= b 1)) 1)
              ((zerop exp-sign) 1)
              ((zerop base-sign) 0)
              (exp-special
               (cond ((and b (= (abs b) 1)) 1)
                     ((eq (> (if b (abs b) 2) 1) (plusp exp-sign)) :numeric-positive-infinity)
                     (t 0)))
              ((minusp exp-sign) 0)
              ((and (minusp base-sign) (oddp e)) :numeric-negative-infinity)
              (t :numeric-positive-infinity))))
    (when (and (integerp e) (<= -2147483648 e 2147483647))
      (return-from sql-numeric-power
        (sql-numeric-power-integer base e (sql-numeric-scale exponent))))
    (when (zerop b) (return-from sql-numeric-power (make-sql-decimal 0 16)))
    (let* ((negative (and (minusp b) (oddp e)))
           (absolute (abs b))
           (ln-weight (sql-numeric-estimate-ln-weight absolute))
           (estimate-scale (max 0 (- 8 ln-weight)))
           (estimate-ln (sql-numeric-ln-rational absolute estimate-scale))
           (estimate-product (sql-numeric-round-rational (* estimate-ln e) estimate-scale)))
      (when (> (abs estimate-product) 6020)
        (if (plusp estimate-product) (ereport "22003" "value overflows numeric format")
            (return-from sql-numeric-power (make-sql-decimal 0 1000))))
      (let* ((estimated-weight (* (coerce estimate-product 'double-float) 0.434294481903252d0))
             (scale (min 1000 (max 0 (sql-numeric-scale base) (sql-numeric-scale exponent)
                                   (- 16 (truncate estimated-weight)))))
             (significant (max 0 (+ scale (truncate estimated-weight))))
             (work-scale (max 0 (+ significant (- ln-weight) 8)))
             (ln-base (sql-numeric-ln-rational absolute work-scale))
             (product (sql-numeric-round-rational (* ln-base e) work-scale))
             (argument (make-sql-decimal (* product (expt 10 work-scale)) work-scale))
             (result (sql-numeric-exp argument scale)))
        (if negative (sql-numeric-negate result) result)))))

(defun sql-numeric-round-or-trunc (value scale round-p)
  "Round or truncate a numeric at SCALE, retaining PostgreSQL display scale.
Negative scales operate before the decimal point and produce display scale zero.
Rounding ties go away from zero.  Clamp the scale as numeric.c does, with one
extra integer digit allowed for rounding; special values pass through."
  (when (sql-numeric-special-p value)
    (return-from sql-numeric-round-or-trunc value))
  (let* ((scale (max (if round-p -131073 -131072) (min scale 16383)))
         (coefficient (sql-numeric-coefficient value))
         (integer-digits (- (length (format nil "~d" (abs coefficient)))
                            (sql-numeric-scale value))))
    ;; A scale beyond all significant digits cannot round up.
    (when (and (minusp scale) (> (- scale) integer-digits))
      (return-from sql-numeric-round-or-trunc (sql-numeric-result 0 0))))
  (let* ((scale (max (if round-p -131073 -131072) (min scale 16383)))
         (scaled (* (sql-numeric-rational value) (expt 10 scale)))
         (coefficient (if round-p
                          (* (signum scaled) (floor (+ (abs scaled) 1/2)))
                          (truncate scaled))))
    (if (minusp scale)
        (sql-numeric-result (* coefficient (expt 10 (- scale))) 0)
        (sql-numeric-result coefficient scale))))

(defun sql-numeric-basic-function (name value &optional (scale 0))
  "Apply a basic numeric function to VALUE, using SCALE for round and trunc.
Special values pass through except for abs of negative infinity and sign of
infinity.  Numeric sign preserves NaN, unlike the floating-point version."
  (cond ((member name '("abs" "numeric_abs") :test #'string=)
         (if (eq value :numeric-negative-infinity) :numeric-positive-infinity
             (if (or (sql-numeric-special-p value)
                     (not (minusp (sql-numeric-coefficient value))))
                 value (sql-numeric-negate value))))
        ((string= name "sign")
         (case value
           (:numeric-nan :numeric-nan)
           (:numeric-positive-infinity 1)
           (:numeric-negative-infinity -1)
           (otherwise (signum (sql-numeric-coefficient value)))))
        ((member name '("round" "trunc") :test #'string=)
         (sql-numeric-round-or-trunc value scale (string= name "round")))
        ((sql-numeric-special-p value) value)
        ((member name '("ceil" "ceiling") :test #'string=)
         (sql-numeric-result (ceiling (sql-numeric-rational value)) 0))
        ((string= name "floor")
         (sql-numeric-result (floor (sql-numeric-rational value)) 0))
        (t (ereport "XX000" "unknown numeric function ~a" name))))

(defun sql-numeric-division (left right)
  ;; Follow numeric.c select_div_scale using normalized base-10000 leading digits,
  ;; input display scales and the display cap; round ties away from zero.
  (when (or (sql-numeric-special-p left) (sql-numeric-special-p right))
    (return-from sql-numeric-division (sql-numeric-special-arithmetic "/" left right)))
  (when (zerop (sql-numeric-coefficient right))
    (ereport "22012" "division by zero"))
  (multiple-value-bind (weight1 digit1) (sql-numeric-leading-digit left)
    (multiple-value-bind (weight2 digit2) (sql-numeric-leading-digit right)
      (let* ((qweight (- weight1 weight2 (if (<= digit1 digit2) 1 0)))
             (scale (min 1000 (max 0 (- 16 (* 4 qweight))
                                   (sql-numeric-scale left) (sql-numeric-scale right))))
             (quotient (/ (sql-numeric-rational left) (sql-numeric-rational right)))
             (scaled (* quotient (expt 10 scale))))
        (sql-numeric-result (* (signum scaled) (floor (+ (abs scaled) 1/2))) scale)))))

(defun sql-numeric-div-trunc (left right)
  "Divide numeric operands as numeric_div_trunc: truncate finite quotients toward zero.
Special operands follow numeric division; a zero divisor signals SQLSTATE 22012
unless NaN takes precedence."
  (when (or (sql-numeric-special-p left) (sql-numeric-special-p right))
    (return-from sql-numeric-div-trunc (sql-numeric-special-arithmetic "/" left right)))
  (when (zerop (sql-numeric-coefficient right))
    (ereport "22012" "division by zero"))
  (sql-numeric-result (truncate (/ (sql-numeric-rational left) (sql-numeric-rational right))) 0))

(defun sql-numeric-arithmetic (operator left right)
  (unless (and (sql-numeric-p left) (sql-numeric-p right))
    (ereport "42883" "numeric operator requires numeric operands"))
  (when (or (sql-numeric-special-p left) (sql-numeric-special-p right))
    (return-from sql-numeric-arithmetic (sql-numeric-special-arithmetic operator left right)))
  (when (string= operator "/") (return-from sql-numeric-arithmetic (sql-numeric-division left right)))
  (let* ((scale (if (string= operator "*")
                    (+ (sql-numeric-scale left) (sql-numeric-scale right))
                    (max (sql-numeric-scale left) (sql-numeric-scale right))))
         (a (sql-numeric-rational left)) (b (sql-numeric-rational right))
         (result (cond ((string= operator "+") (+ a b))
                       ((string= operator "-") (- a b))
                       ((string= operator "*") (* a b))
                       ((string= operator "%")
                        (when (zerop b) (ereport "22012" "division by zero"))
                        (rem a b))
                       (t (ereport "XX000" "unknown numeric operator")))))
    (let ((decimal (sql-numeric-result (* result (expt 10 scale)) scale)))
      (if (and (integerp left) (integerp right)) (sql-decimal-coefficient decimal) decimal))))
