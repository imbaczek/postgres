;;;; Source-preserving JSON field and array extraction, as in jsonfuncs.c.
(in-package #:pg)

(defun json-extraction-decode-string (text start end)
  "Decode a validated JSON string, preserving jsonfuncs.c Unicode diagnostics."
  (let ((pending nil) (position (1+ start)))
    (labels ((surrogate-error (high-p)
               (ereport "22P02" "invalid input syntax for type json"
                        :detail (if high-p
                                    "Unicode high surrogate must not follow a high surrogate."
                                    "Unicode low surrogate must follow a high surrogate."))))
      (loop while (< position (1- end))
            for c = (char text position)
            do (incf position)
               (if (char= c (code-char 92))
                   (let ((escape (char text position)))
                     (incf position)
                     (if (char= escape #\u)
                         (let ((unit (parse-integer text :start position :end (+ position 4)
                                                         :radix 16)))
                           (incf position 4)
                           (cond ((<= #xd800 unit #xdbff)
                                  (when pending (surrogate-error t))
                                  (setf pending t))
                                 ((<= #xdc00 unit #xdfff)
                                  (unless pending (surrogate-error nil))
                                  (setf pending nil))
                                 (t (when pending (surrogate-error nil))
                                    (when (zerop unit)
                                      (ereport "22P05" "unsupported Unicode escape sequence"
                                               :detail "\\u0000 cannot be converted to text.")))))
                         (when pending (surrogate-error nil))))
                   (when pending (surrogate-error nil))))
      (when pending (surrogate-error nil))))
  (sql-jsonb-value (sql-jsonb-input (subseq text start end))))

(defun sql-json-source-kind (text)
  "Identify the top-level kind of validated JSON TEXT without decoding strings."
  (let ((first (find-if-not (lambda (c) (find c '(#\Space #\Tab #\Newline #\Return))) text)))
    (case first
      (#\{ "object") (#\[ "array") (#\" "string")
      ((#\t #\f) "boolean") (#\n "null")
      (otherwise "number"))))

(defun sql-jsonb-kind (jsonb)
  "Identify the top-level kind of a normalized JSONB value."
  (let ((value (sql-jsonb-value jsonb)))
    (cond ((eq value :json-null) "null")
          ((member value '(:json-true :json-false)) "boolean")
          ((stringp value) "string")
          ((sql-numeric-p value) "number")
          ((and (consp value) (eq (car value) :object)) "object")
          ((vectorp value) "array")
          (t (error "invalid JSONB value")))))

(defun sql-json-source-array-length (text)
  "Count top-level elements of validated JSON TEXT.
Track nesting and string escapes without decoding strings, as json_array_length
does not need their values.  Reject a top-level object or scalar."
  (let ((kind (sql-json-source-kind text)))
    (unless (string= kind "array")
      (ereport "22023" "cannot get array length of a ~a"
               (if (string= kind "object") "non-array" "scalar")))
    (let ((depth 0) (in-string nil) (escaped nil) (count 0) (element-p nil))
      (loop for c across text
            do (cond
                 (in-string
                  (cond (escaped (setf escaped nil))
                        ((char= c #\\) (setf escaped t))
                        ((char= c #\") (setf in-string nil))))
                 ((char= c #\")
                  (when (= depth 1) (setf element-p t))
                  (setf in-string t))
                 ((find c '(#\[ #\{))
                  (when (= depth 1) (setf element-p t))
                  (incf depth))
                 ((find c '(#\] #\})) (decf depth))
                 ((and (= depth 1) (char= c #\,)) (incf count))
                 ((and (= depth 1) (not (find c '(#\Space #\Tab #\Newline #\Return))))
                  (setf element-p t))))
      (if element-p (1+ count) 0))))

(defun sql-jsonb-array-length (jsonb)
  "Return the number of top-level array elements in JSONB.
Reject a top-level object or scalar, including JSON null."
  (let ((kind (sql-jsonb-kind jsonb)))
    (unless (string= kind "array")
      (ereport "22023" "cannot get array length of a ~a"
               (if (string= kind "object") "non-array" "scalar")))
    (length (sql-jsonb-value jsonb))))

(defun sql-json-extract (text key text-p)
  "Extract a field or array element from JSON TEXT.
JSON results and non-string text results retain the selected source spelling;
TEXT-P decodes strings and maps JSON null to SQL NULL. KEY is a string or an
integer index, which may count backward from the end. Missing values return NULL."
  (sql-json-input text)
  (let ((length (length text)))
    (labels ((space-p (c) (and c (find c '(#\Space #\Tab #\Newline #\Return))))
             (skip-space (position)
               (loop while (and (< position length) (space-p (char text position)))
                     do (incf position)
                     finally (return position)))
             (string-end (start)
               (let ((position (1+ start)))
                 (loop
                   for c = (char text position)
                   do (incf position)
                      (cond ((char= c #\") (return position))
                            ((char= c (code-char 92)) (incf position))))))
             (value-end (start)
               (let ((first (char text start)))
                 (cond
                   ((char= first #\") (string-end start))
                   ((find first "{[")
                    (let ((position (1+ start)) (depth 1))
                      (loop while (plusp depth)
                            for c = (char text position)
                            do (cond ((char= c #\")
                                      (setf position (string-end position)))
                                     ((find c "{[") (incf depth) (incf position))
                                     ((find c "}]") (decf depth) (incf position))
                                     (t (incf position))))
                      position))
                   (t (loop for position from start below length
                            for c = (char text position)
                            when (or (space-p c) (find c ",]}"))
                              do (return position)
                            finally (return length)))))))
      ;; jsonfuncs.c requests decoded escapes throughout the complete document,
      ;; including strings outside the selected value.
      (loop for position from 0 below length
            when (char= (char text position) #\")
              do (let ((end (string-end position)))
                   (json-extraction-decode-string text position end)
                   (setf position (1- end))))
      (let ((root (skip-space 0)) (selected nil))
        (cond
          ((and (stringp key) (< root length) (char= (char text root) #\{))
           (let ((position (skip-space (1+ root))))
             (loop until (char= (char text position) #\})
                   do (let* ((key-end (string-end position))
                             (name (json-extraction-decode-string text position key-end))
                             (value-start (skip-space (1+ (skip-space key-end))))
                             (end (value-end value-start)))
                        (when (string= key name)
                          (setf selected (cons value-start end)))
                        (setf position (skip-space end))
                        (when (char= (char text position) #\,)
                          (setf position (skip-space (1+ position))))))))
          ((and (integerp key) (< root length) (char= (char text root) #\[))
           (flet ((scan-array (wanted)
                    (let ((position (skip-space (1+ root))) (count 0) (result nil))
                      (loop until (char= (char text position) #\])
                            do (let ((end (value-end position)))
                                 (when (eql count wanted)
                                   (setf result (cons position end)))
                                 (incf count)
                                 (setf position (skip-space end))
                                 (when (char= (char text position) #\,)
                                   (setf position (skip-space (1+ position))))))
                      (values count result))))
             (multiple-value-bind (count result) (scan-array (unless (minusp key) key))
               (setf selected
                     (if (minusp key)
                         (let ((index (+ count key)))
                           (when (<= 0 index (1- count))
                             (nth-value 1 (scan-array index))))
                         result))))))
        (if (null selected)
            +null+
            (let* ((start (car selected))
                   (end (cdr selected))
                   (raw (subseq text start end)))
              (cond ((not text-p) raw)
                    ((string= raw "null") +null+)
                    ((char= (char text start) #\") (json-extraction-decode-string text start end))
                    (t raw))))))))

(defun sql-json-path-index (text)
  "Parse a decimal JSON path index using strtoint's whitespace and int4 rules."
  (let ((length (length text)) (position 0) (sign 1) (value 0) (digits 0))
    (loop while (and (< position length)
                     (find (char text position) (mapcar #'code-char '(32 9 10 13 12 11))))
          do (incf position))
    (when (and (< position length) (find (char text position) "+-"))
      (when (char= (char text position) #\-) (setf sign -1))
      (incf position))
    (loop while (and (< position length) (char<= #\0 (char text position) #\9))
          do (setf value (+ (* value 10) (- (char-code (char text position)) (char-code #\0))))
             (incf position) (incf digits)
             (when (> value 2147483648) (return-from sql-json-path-index nil)))
    (let ((result (* sign value)))
      (when (and (plusp digits) (= position length)
                 (<= -2147483648 result 2147483647))
        result))))

(defun sql-json-path-source-extract (text path text-p)
  "Scan a JSON document with jsonfuncs.c's shared path state and source spans."
  ;; This validates syntax and every string escape even when no path matches.
  (sql-json-extract text "" nil)
  (let* ((length (length text))
         (npath (length path))
         (indexes (map 'vector (lambda (part) (sql-json-path-index part)) path))
         (container-ends (make-hash-table :test #'eql))
         (work nil)
         (result +null+))
    (labels ((space-p (c) (find c '(#\Space #\Tab #\Newline #\Return)))
             (skip-space (position)
               (loop while (and (< position length) (space-p (char text position)))
                     do (incf position) finally (return position)))
             (string-end (start)
               (let ((position (1+ start)))
                 (loop for c = (char text position)
                       do (incf position)
                          (cond ((char= c #\") (return position))
                                ((char= c (code-char 92)) (incf position))))))
             (value-end (start)
               (let ((first (char text start)))
                 (cond ((char= first #\") (string-end start))
                       ((find first "{[") (gethash start container-ends))
                       (t (loop for position from start below length
                                for c = (char text position)
                                when (or (space-p c) (find c ",]}")) do (return position)
                                  finally (return length))))))
             (each-array (start callback)
               (let ((position (skip-space (1+ start))) (index 0))
                 (loop until (char= (char text position) #\])
                       do (let ((end (value-end position)))
                            (funcall callback position end index)
                            (incf index)
                            (setf position (skip-space end))
                            (when (char= (char text position) #\,)
                              (setf position (skip-space (1+ position))))))
                 index))
             (visit (start depth matched)
               (let ((end (value-end start)) (first (char text start)) (children nil))
                 (when (and matched (= depth npath))
                   (let* ((scalar (not (find first "{[")))
                          (raw (subseq text (if (and (zerop npath) scalar) 0 start) end)))
                     (setf result
                           (cond ((not text-p) raw)
                                 ((and (char= first #\n) (string= text "null" :start1 start :end1 end)) +null+)
                                 ((char= first #\") (json-extraction-decode-string text start end))
                                 (t raw)))))
                 (when (< depth npath)
                   (cond
                     ((char= first #\{)
                      (let ((position (skip-space (1+ start))))
                        (loop until (char= (char text position) #\})
                              do (let* ((key-end (string-end position))
                                        (child (skip-space (1+ (skip-space key-end))))
                                        (child-end (value-end child))
                                        (key-match (and matched
                                                        (string= (aref path depth)
                                                                 (json-extraction-decode-string
                                                                  text position key-end)))))
                                   (when (or key-match
                                             (and (< (1+ depth) npath)
                                                  (find (char text child) "{[")))
                                     (push (list child (1+ depth) key-match) children))
                                   (setf position (skip-space child-end))
                                   (when (char= (char text position) #\,)
                                     (setf position (skip-space (1+ position))))))))
                     ((char= first #\[)
                      (let ((index (aref indexes depth)))
                        ;; C mutates the shared negative index even in an array
                        ;; outside the currently matching path.
                        (when (and index (< -2147483648 index 0))
                          (let ((count (each-array start (lambda (&rest args) (declare (ignore args))))))
                            (when (<= (- index) count)
                              (incf index count)
                              (setf (aref indexes depth) index))))
                        (each-array start
                                    (lambda (child child-end child-index)
                                      (declare (ignore child-end))
                                      (let ((child-match (and matched index (= child-index index))))
                                        (when (or child-match
                                                  (and (< (1+ depth) npath)
                                                       (find (char text child) "{[")))
                                          (push (list child (1+ depth) child-match) children)))))))))
                 (dolist (child children) (push child work)))))
      ;; Cache only container boundaries, avoiding repeated scans of nested
      ;; subtrees without retaining a copy of every scalar or string.
      (let ((stack nil) (position 0))
        (loop while (< position length)
              for c = (char text position)
              do (cond ((char= c #\") (setf position (string-end position)))
                       ((find c "{[") (push position stack) (incf position))
                       ((find c "}]") (setf (gethash (pop stack) container-ends)
                                            (1+ position))
                                      (incf position))
                       (t (incf position)))))
      (push (list (skip-space 0) 0 t) work)
      (loop while work
            do (destructuring-bind (start depth matched) (pop work)
                 (visit start depth matched)))
      result)))

(defun sql-json-path-extract (value path jsonb-p text-p)
  "Extract PATH from JSON or JSONB, following jsonfuncs.c path semantics."
  (when (some (lambda (item) (eq item +null+)) path)
    (return-from sql-json-path-extract +null+))
  (unless jsonb-p
    (return-from sql-json-path-extract (sql-json-path-source-extract value path text-p)))
  (when (zerop (length path))
    (return-from sql-json-path-extract
      (let ((root (sql-jsonb-value value)))
        (cond ((not text-p) value)
              ((eq root :json-null) +null+)
              ((stringp root) root)
              (t (sql-jsonb-output value))))))
  (loop for part across path
        for i from 0
        for last-p = (= i (1- (length path)))
        do (let* ((node (sql-jsonb-value value))
                  (array-p (and (vectorp node) (not (stringp node))))
                  (object-p (and (consp node) (eq (car node) :object)))
                  (index (and array-p (sql-json-path-index part))))
             (setf value
                   (if (or object-p (and array-p index))
                       (sql-jsonb-extract value (if array-p index part) (and text-p last-p))
                       +null+))
             (when (eq value +null+) (return +null+)))
        finally (return value)))
