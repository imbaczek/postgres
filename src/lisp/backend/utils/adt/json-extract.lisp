;;;; Source-preserving JSON field and array extraction, as in jsonfuncs.c.
(in-package #:pg)

(defun json-extraction-decode-string (text start end)
  "Decode a validated JSON string, preserving jsonfuncs.c Unicode diagnostics."
  (let ((pending nil) (position (1+ start)))
    (labels ((surrogate-error (high-p)
               (ereport "22P02" "invalid input syntax for type json"
                        :detail (if high-p
                                    "Unicode high surrogate must not follow a high surrogate."
                                    "Unicode low surrogate must follow a high surrogate."))))
      (loop while (< position (1- end))
            for c = (char text position)
            do (incf position)
               (if (char= c (code-char 92))
                   (let ((escape (char text position)))
                     (incf position)
                     (if (char= escape #\u)
                         (let ((unit (parse-integer text :start position :end (+ position 4)
                                                         :radix 16)))
                           (incf position 4)
                           (cond ((<= #xd800 unit #xdbff)
                                  (when pending (surrogate-error t))
                                  (setf pending t))
                                 ((<= #xdc00 unit #xdfff)
                                  (unless pending (surrogate-error nil))
                                  (setf pending nil))
                                 (t (when pending (surrogate-error nil))
                                    (when (zerop unit)
                                      (ereport "22P05" "unsupported Unicode escape sequence"
                                               :detail "\\u0000 cannot be converted to text.")))))
                         (when pending (surrogate-error nil))))
                   (when pending (surrogate-error nil))))
      (when pending (surrogate-error nil))))
  (sql-jsonb-value (sql-jsonb-input (subseq text start end))))

(defun sql-json-extract (text key text-p)
  "Extract a field or array element from JSON TEXT.
JSON results and non-string text results retain the selected source spelling;
TEXT-P decodes strings and maps JSON null to SQL NULL. KEY is a string or an
integer index, which may count backward from the end. Missing values return NULL."
  (sql-json-input text)
  (let ((length (length text)))
    (labels ((space-p (c) (and c (find c '(#\Space #\Tab #\Newline #\Return))))
             (skip-space (position)
               (loop while (and (< position length) (space-p (char text position)))
                     do (incf position)
                     finally (return position)))
             (string-end (start)
               (let ((position (1+ start)))
                 (loop
                   for c = (char text position)
                   do (incf position)
                      (cond ((char= c #\") (return position))
                            ((char= c (code-char 92)) (incf position))))))
             (value-end (start)
               (let ((first (char text start)))
                 (cond
                   ((char= first #\") (string-end start))
                   ((find first "{[")
                    (let ((position (1+ start)) (depth 1))
                      (loop while (plusp depth)
                            for c = (char text position)
                            do (cond ((char= c #\")
                                      (setf position (string-end position)))
                                     ((find c "{[") (incf depth) (incf position))
                                     ((find c "}]") (decf depth) (incf position))
                                     (t (incf position))))
                      position))
                   (t (loop for position from start below length
                            for c = (char text position)
                            when (or (space-p c) (find c ",]}"))
                              do (return position)
                            finally (return length)))))))
      ;; jsonfuncs.c requests decoded escapes throughout the complete document,
      ;; including strings outside the selected value.
      (loop for position from 0 below length
            when (char= (char text position) #\")
              do (let ((end (string-end position)))
                   (json-extraction-decode-string text position end)
                   (setf position (1- end))))
      (let ((root (skip-space 0)) (selected nil))
        (cond
          ((and (stringp key) (< root length) (char= (char text root) #\{))
           (let ((position (skip-space (1+ root))))
             (loop until (char= (char text position) #\})
                   do (let* ((key-end (string-end position))
                             (name (json-extraction-decode-string text position key-end))
                             (value-start (skip-space (1+ (skip-space key-end))))
                             (end (value-end value-start)))
                        (when (string= key name)
                          (setf selected (cons value-start end)))
                        (setf position (skip-space end))
                        (when (char= (char text position) #\,)
                          (setf position (skip-space (1+ position))))))))
          ((and (integerp key) (< root length) (char= (char text root) #\[))
           (flet ((scan-array (wanted)
                    (let ((position (skip-space (1+ root))) (count 0) (result nil))
                      (loop until (char= (char text position) #\])
                            do (let ((end (value-end position)))
                                 (when (eql count wanted)
                                   (setf result (cons position end)))
                                 (incf count)
                                 (setf position (skip-space end))
                                 (when (char= (char text position) #\,)
                                   (setf position (skip-space (1+ position))))))
                      (values count result))))
             (multiple-value-bind (count result) (scan-array (unless (minusp key) key))
               (setf selected
                     (if (minusp key)
                         (let ((index (+ count key)))
                           (when (<= 0 index (1- count))
                             (nth-value 1 (scan-array index))))
                         result))))))
        (if (null selected)
            +null+
            (let* ((start (car selected))
                   (end (cdr selected))
                   (raw (subseq text start end)))
              (cond ((not text-p) raw)
                    ((string= raw "null") +null+)
                    ((char= (char text start) #\") (json-extraction-decode-string text start end))
                    (t raw))))))))
