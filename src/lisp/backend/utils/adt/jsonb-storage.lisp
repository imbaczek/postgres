;;;; PostgreSQL JSONB container storage; see jsonb.h and jsonb_util.c.
(in-package #:pg)

(defun sql-jsonb-to-octets (jsonb)
  "Encode JSONB as a little-endian PostgreSQL JsonbContainer payload."
  (let ((buffer (make-array 0 :element-type '(unsigned-byte 8)
                              :adjustable t :fill-pointer 0)))
    (labels ((reserve (n)
               (let ((start (length buffer)))
                 (dotimes (i n) (vector-push-extend 0 buffer))
                 start))
             (append-bytes (bytes)
               (loop for byte across bytes do (vector-push-extend byte buffer)))
             (pad ()
               (loop until (zerop (mod (length buffer) 4))
                     do (vector-push-extend 0 buffer)))
             (container-p (value)
               (or (and (consp value) (eq (car value) :object))
                   (and (vectorp value) (not (stringp value)))))
             (emit-value (value)
               (let ((start (length buffer)) (type 0))
                 (cond
                   ((stringp value) (append-bytes (string->bytes value)))
                   ((eq value :json-null) (setf type #x40000000))
                   ((eq value :json-true) (setf type #x30000000))
                   ((eq value :json-false) (setf type #x20000000))
                   ((or (integerp value) (sql-decimal-p value))
                    (setf type #x10000000)
                    (pad)
                    (append-bytes (sql-numeric-to-packed-octets value)))
                   ((container-p value)
                    (setf type #x50000000)
                    (emit-container value nil))
                   (t (error "Invalid JSONB value")))
                 (let ((size (- (length buffer) start)))
                   (when (> size #x0fffffff)
                     (ereport "54000" "JSONB element exceeds maximum size"))
                   (logior type size))))
             (emit-container (value scalar-p)
               (let* ((start (length buffer))
                      (object-p (and (consp value) (eq (car value) :object)))
                      (pairs (and object-p (cdr value)))
                      (elements (cond (scalar-p (list value))
                                      (object-p (append (mapcar #'car pairs)
                                                        (mapcar #'cdr pairs)))
                                      (t (coerce value 'list))))
                      (count (if scalar-p 1 (if object-p (length pairs) (length value)))))
                 (when (> count #x0fffffff)
                   (ereport "54000" "JSONB container exceeds maximum size"))
                 (pad)
                 (let* ((header-offset (reserve 4))
                        (entries-offset (reserve (* 4 (length elements))))
                        (total 0))
                   (page-set-u32 buffer header-offset
                                 (logior count (if object-p #x20000000 #x40000000)
                                         (if scalar-p #x10000000 0)))
                   (loop for item in elements for i from 0
                         for entry = (emit-value item)
                         do (incf total (logand entry #x0fffffff))
                            (when (> total #x0fffffff)
                              (ereport "54000" "JSONB container exceeds maximum size"))
                            (when (zerop (mod i 32))
                              (setf entry (logior (logand entry #x70000000)
                                                  #x80000000 total)))
                            (page-set-u32 buffer (+ entries-offset (* i 4)) entry))
                   (when (> (- (length buffer) start) #x0fffffff)
                     (ereport "54000" "JSONB container exceeds maximum size"))))))
      (let ((value (sql-jsonb-value jsonb)))
        (emit-container value (not (container-p value))))
      (coerce buffer '(vector (unsigned-byte 8))))))

(defun sql-jsonb-from-octets (bytes)
  "Decode a little-endian PostgreSQL JsonbContainer payload."
  (check-type bytes (vector (unsigned-byte 8)))
  (labels ((bad () (ereport "XX001" "invalid JSONB container"))
           (decode-value (type start end depth)
             (when (> depth 512) (bad))
             (case type
               (#x00000000
                (when (position 0 bytes :start start :end end) (bad))
                (handler-case (bytes->string bytes :start start :end end)
                  (error () (bad))))
               (#x10000000
                (let ((aligned (align-up start 4)))
                  (unless (<= (+ aligned 6) end) (bad))
                  (sql-numeric-from-packed-octets (subseq bytes aligned end))))
               (#x20000000 (unless (= start end) (bad)) :json-false)
               (#x30000000 (unless (= start end) (bad)) :json-true)
               (#x40000000 (unless (= start end) (bad)) :json-null)
               (#x50000000 (decode-container (align-up start 4) end depth nil))
               (otherwise (bad))))
           (decode-container (start end depth root-p)
             (when (or (> depth 512) (> (+ start 4) end)) (bad))
             (let* ((header (page-u32 bytes start))
                    (flags (logand header #xf0000000))
                    (count (logand header #x0fffffff))
                    (object-p (= flags #x20000000))
                    (array-p (= flags #x40000000))
                    (scalar-p (= flags #x50000000))
                    (n (if object-p (* 2 count) count))
                    (data-start (+ start 4 (* n 4))))
               (unless (and (or object-p array-p (and root-p scalar-p (= count 1)))
                            (<= data-start end))
                 (bad))
               (let ((children (make-array n))
                     (previous 0)
                     (data-size (- end data-start)))
                 (dotimes (i n)
                   (let* ((entry (page-u32 bytes (+ start 4 (* i 4))))
                          (field (logand entry #x0fffffff))
                          (next (if (logbitp 31 entry) field (+ previous field))))
                     (unless (<= previous next data-size) (bad))
                     (setf (aref children i)
                           (decode-value (logand entry #x70000000)
                                         (+ data-start previous) (+ data-start next)
                                         (1+ depth))
                           previous next)))
                 (unless (= previous data-size) (bad))
                 (cond
                   (scalar-p
                    (when (or (and (consp (aref children 0))
                                   (eq (car (aref children 0)) :object))
                              (and (vectorp (aref children 0))
                                   (not (stringp (aref children 0)))))
                      (bad))
                    (aref children 0))
                   (object-p
                    (let ((pairs nil) (previous-key nil))
                      (dotimes (i count)
                        (let ((key (aref children i)))
                          (unless (and (stringp key)
                                       (or (null previous-key)
                                           (sql-jsonb-key-less-p previous-key key)))
                            (bad))
                          (push (cons key (aref children (+ i count))) pairs)
                          (setf previous-key key)))
                      (cons :object (nreverse pairs))))
                   (t children))))))
    (make-sql-jsonb (decode-container 0 (length bytes) 0 t))))
