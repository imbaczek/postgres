(asdf:defsystem "pg-physical-tests"
  :description "Native physical WAL intake and recovery contracts"
  :depends-on ("pg" "rove" "cl-spec/check-it")
  :serial t
  :components ((:file "t/physical-tests")
               (:file "t/physical-store-tests")
               (:file "t/physical-pid-tests")
               (:file "t/physical-config-tests")
               (:file "t/coalesce-tests")
               (:file "t/physical-source-tests")
               (:file "t/physical-bootstrap-tests")
               (:file "t/physical-recovery-tests")
               (:file "t/physical-control-tests")
               (:file "t/physical-history-tests")
               (:file "t/timeline-tests")
               (:file "t/physical-restartpoint-tests")
               (:file "t/physical-stream-tests")
               (:file "t/physical-follow-exit-tests")
               (:file "t/physical-shutdown-tests"))
  :perform (asdf:test-op (operation component)
                         (declare (ignore operation component))
                         (unless (uiop:symbol-call :rove :run :pg-physical-tests)
                           (error "Physical recovery contracts failed"))))
