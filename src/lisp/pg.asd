(asdf:defsystem "pg/sql-types"
  :description "Shared SQL type identities, assignment rules, and SQLSTATE errors"
  :serial t
  :components ((:file "packages")
               (:file "backend/utils/elog")
               (:file "backend/utils/adt/sql-types")))

(asdf:defsystem "pg"
  :version "0.1"
  :description "Minimal PostgreSQL-compatible server in Common Lisp"
  :license "PostgreSQL"
  :depends-on ("pg/sql-types")
  :serial t
  :components
  ((:module "include"
    :serial t
    :components ((:file "pg-limits")
                 (:file "pg-protocol")))
   (:module "port"
    :serial t
    :components ((:module "sbcl"
                  :serial t
                  :components ((:file "sockets")
                               (:file "files.hot")
                               (:file "files")
                               (:file "physical-image")
                               (:file "replication-slot-state")
                               (:file "arm-crc32-support")
                               (:file "ieee-crc32" :if-feature :x86-64)
                               (:file "crc32c" :if-feature :x86-64)
                               (:file "arm-crc32" :if-feature :arm64)))))
   (:module "backend"
    :serial t
    :components
    ((:file "utils/recovery")
     (:file "utils/lwlock")
     (:module "libpq"
      :serial t
      :components ((:file "pqcomm.hot")
                   (:file "pqcomm")
                   (:file "pqformat")
                   (:file "scram")
                   (:file "scram-wire")
                   (:file "hba")))
     (:module "storage"
      :serial t
      :components ((:file "bufpage")
                   (:file "smgr")
                   (:file "wal-core.hot")
                   (:file "wal-crc32.hot" :if-feature :x86-64)
                   (:file "wal-crc32c.hot" :if-feature :x86-64)
                   (:file "wal-crc32-arm.hot" :if-feature :arm64)
                   (:file "wal-record" :depends-on ("wal-core.hot"))
                   (:file "wal-page-image" :depends-on ("bufpage" "wal-record"))
                   (:file "wal" :pathname "wal-core" :depends-on ("wal-page-image"))
                   (:file "wal-batch-grammar" :depends-on ("wal"))
                   (:file "wal-scan" :depends-on ("wal"))
                   (:file "wal-page-publication" :depends-on ("wal"))
                   (:file "wal-transaction-publication" :depends-on ("wal-page-publication"))
                   (:file "wal-catalog-publication" :depends-on ("wal-page-publication"))
                   (:file "wal-archive" :depends-on ("wal"))
                   (:file "wal-slot-persistence" :depends-on ("wal"))
                   (:file "wal-slot-retention" :depends-on ("wal"))
                   (:file "wal-pressure")
                   (:file "wal-resource-parameters")
                   (:file "wal-eor")
                   (:file "wal-checkpoint")
                   (:file "wal-control" :depends-on ("wal" "wal-checkpoint"))
                   (:file "wal-full-page-writes")
                   (:file "wal-logical-status")
                   (:file "wal-logical-policy")
                   (:file "bufmgr")))
     (:file "utils/adt/pglz")
     (:file "utils/adt/json")
     (:file "utils/adt/numeric")
     (:file "utils/adt/numeric-storage")
     (:file "utils/adt/jsonb")
     (:file "utils/adt/jsonb-storage")
     (:file "utils/adt/json-extract")
     (:file "utils/adt/float")
     (:file "utils/adt/timezone")
     (:file "utils/adt/datetime")
     (:module "access"
      :serial t
      :components
      ((:module "transam"
        :serial t
        :components ((:file "clog")
                     (:file "snapshot")
                     (:file "xact")
                     (:file "xid-reservation")
                     (:file "running-xacts")))
       (:module "heap"
        :serial t
        :components ((:file "visibilitymap")
                     (:file "heapam")))
       (:module "btree"
        :serial t
        :components ((:file "btree")))
       (:module "vacuum"
        :serial t
        :components ((:file "vacuumlazy")))))
     (:module "postmaster"
      :serial t
      :components ((:file "backend-lifetime") (:file "postmaster") (:file "bgworker") (:file "walwriter")))
     (:file "replication/walsender-status")
     (:file "replication/syncrep")
     (:module "catalog"
      :serial t
      :components ((:file "catalog")
                   (:file "namespace")))
     (:module "replication"
      :serial t
      :components ((:file "logical" :pathname "logical-stream")
                   (:file "logical-fragments")
                   (:file "schema-contracts")
                   (:file "client-core")
                   (:file "physical")
                   (:file "physical-store.hot")
                   (:file "physical-store")
                   (:file "physical-source")
                   (:file "../postmaster/pidfile")))
     (:module "commands"
      :serial t
      :components ((:file "vacuum")
                   (:file "analyze")))
     (:module "sql-runtime"
      :pathname "utils/adt"
      :components ((:file "varbit")
                   (:file "sql-casts" :depends-on ("varbit"))
                   (:file "sql-text" :depends-on ("sql-casts"))))
     (:module "parser"
      :depends-on ("sql-runtime")
      :serial t
      :components ((:file "scan-core")
                   (:file "gram")
                   (:file "cte")
                   (:file "subselect")
                   (:file "window")
                   (:file "analyze")))
     (:module "executor"
      :serial t
      :components ((:file "exec_arena")
                   (:file "exec_spill")
                   (:file "../replication/logical-spool")
                   (:file "exec_scan")
                   (:file "exec_plan")
                   (:file "exec_window")
                   (:file "exec_iterator")
                   (:file "exec_cursor_window")
                   (:file "exec_cursor")
                   (:file "exec_cte")
                   (:file "exec_owner")
                   (:file "exec_subplan")
                   (:file "exec_analyze")
                   (:file "exec_insert")
                   (:file "exec_delete")
                   (:file "exec_subplan_dml")
                   (:file "exec_joined_dml")
                   (:file "exec_on_conflict")
                   (:file "exec_constraints")
                   (:file "exec_vacuum")
                   (:file "exec_simple")))
     ;; Recovery uses executor temporary storage and supplies the startup
     ;; and physical replay entry points below.
     (:file "storage/wal-recovery")
     (:module "tcop"
      :pathname "tcop"
      :depends-on ("storage/wal-recovery")
      :serial t
      :components ((:file "dest")
                   (:file "control")))
     (:module "startup-policy"
      :pathname "tcop"
      :depends-on ("tcop")
      :serial t
      :components ((:file "../replication/walsender-shutdown")
                   (:file "../utils/startup-config")
                   (:file "../libpq/auth-policy")
                   (:file "../utils/session-config")
                   (:file "../access/transam/timeline")
                   (:file "../access/transam/timeline.hot")))
     (:module "physical-recovery-runtime"
      :pathname "replication"
      :depends-on ("startup-policy")
      :serial t
      :components ((:file "logical-slot-state")
                   (:file "logical-slot-imported-state")
                   (:file "physical-fpw")
                   (:file "physical-logical-status")
                   (:file "metadata-literal.hot")
                   (:file "metadata-literal-envelope"
                    :depends-on ("metadata-literal.hot"))
                   (:file "physical-bootstrap.hot")
                   (:file "physical-bootstrap"
                    :depends-on ("metadata-literal-envelope"
                                 "physical-bootstrap.hot"))
                   (:file "physical-recovery"
                    :depends-on ("metadata-literal-envelope"))
                   (:file "physical-store-history")
                   (:file "physical-replay-facts"
                    :depends-on ("physical-recovery"
                                 "physical-fpw"
                                 "physical-logical-status"))
                   (:file "physical-recovery-policy")
                   (:file "../storage/wal-namespace")
                   (:file "../storage/wal-lineage")
                   (:file "logical-wal-record-provider")
                   (:file "logical-wal-cursor")
                   (:file "logical-wal-lane-provider")
                   (:file "../storage/wal-timeline")
                   (:file "physical-history"
                    :depends-on ("physical-replay-facts" "physical-store-history"))
                   (:file "physical-replay"
                    :depends-on ("physical-replay-facts"
                                 "physical-history"))
                   (:file "physical-replay-history"
                    :depends-on ("physical-replay-facts"
                                 "physical-replay"))
                   (:file "physical-row-replay"
                    :depends-on ("physical-replay-facts"
                                 "physical-replay"
                                 "physical-replay-history"))))
     (:module "physical-retention-runtime"
      :pathname "replication"
      :depends-on ("physical-recovery-runtime")
      :serial t
      :components ((:file "physical-prefix")
                   (:file "physical-follow-pin")
