(in-package #:pg)

(declaim (inline %fdinfo-token= %fdinfo-fields %fdinfo-unsigned-p %fdinfo-inode=))

(defun %fdinfo-token= (text start end literal)
  (declare (type simple-string text literal) (type fixnum start end)
           (optimize (speed 3) (safety 1) (debug 1)))
  (and (= (- end start) (length literal))
       (loop for index fixnum from start below end
             for offset fixnum from 0
             always (char= (char text index) (char literal offset)))))

(defun %fdinfo-fields (text start end spans maximum)
  (declare (type simple-string text) (type fixnum start end)
           (type (simple-array (unsigned-byte 32) (18)) spans)
           (type (integer 0 9) maximum)
           (optimize (speed 3) (safety 1) (debug 1)))
  (let ((cursor start) (count 0))
    (declare (type fixnum cursor count))
    (loop
      (loop while (and (< cursor end)
                       (or (char= (char text cursor) #\Space) (char= (char text cursor) #\Tab)))
            do (incf cursor))
      (when (= cursor end) (return count))
      (when (= count maximum) (return -1))
      (setf (aref spans (* 2 count)) cursor)
      (loop while (and (< cursor end)
                       (not (or (char= (char text cursor) #\Space) (char= (char text cursor) #\Tab))))
            do (incf cursor))
      (setf (aref spans (1+ (* 2 count))) cursor)
      (incf count))))

(defun %fdinfo-unsigned-p (text start end radix positive)
  (declare (type simple-string text) (type fixnum start end)
           (type (member 10 16) radix)
           (optimize (speed 3) (safety 1) (debug 1)))
  (and (<= 1 (- end start) 20)
       (loop for index fixnum from start below end always (digit-char-p (char text index) radix))
       (or (not positive)
           (loop for index fixnum from start below end thereis (char/= (char text index) #\0)))))

(defun %fdinfo-inode= (text start end inode)
  (declare (type simple-string text) (type fixnum start end)
           (type (unsigned-byte 64) inode)
           (optimize (speed 3) (safety 1) (debug 1)))
  (unless (<= 1 (- end start) 20) (return-from %fdinfo-inode= nil))
  (let ((low 0) (high 0) (positive nil))
    (declare (type (unsigned-byte 32) low high) (type boolean positive))
    (loop for index fixnum from start below end
          for digit = (digit-char-p (char text index) 10)
          do (unless digit (return-from %fdinfo-inode= nil))
             (when (char/= (char text index) #\0) (setf positive t))
             (let* ((wide (+ (* low 10) digit))
                    (next-high (+ (* high 10) (ash wide -32))))
               (when (> next-high #xffffffff) (return-from %fdinfo-inode= nil))
               (setf low (logand wide #xffffffff) high next-high)))
    (and positive
         (= low (ldb (byte 32 0) inode))
         (= high (ldb (byte 32 32) inode)))))

(defun %fdinfo-flock-p (text inode spans)
  (declare (type simple-string text) (type (unsigned-byte 64) inode)
           (type (simple-array (unsigned-byte 32) (18)) spans)
           (optimize (speed 3) (safety 1) (debug 1)))
  (let ((size (length text)) (cursor 0) (locks 0) (identities 0)
                             (lock-start 0) (lock-end 0) (identity-start 0) (identity-end 0))
    (declare (type fixnum size cursor locks identities lock-start lock-end identity-start identity-end))
    (when (> size 4096) (return-from %fdinfo-flock-p nil))
    (loop while (< cursor size)
          do (let ((end (or (position #\Newline text :start cursor) size)))
               (declare (type fixnum end))
               (when (and (<= 5 (- end cursor)) (%fdinfo-token= text cursor (+ cursor 5) "lock:"))
                 (incf locks) (setf lock-start cursor lock-end end))
               (when (and (<= 4 (- end cursor)) (%fdinfo-token= text cursor (+ cursor 4) "ino:"))
                 (incf identities) (setf identity-start cursor identity-end end))
               (setf cursor (1+ end))))
    (unless (and (= 1 locks identities)
                 (= 2 (%fdinfo-fields text identity-start identity-end spans 2))
                 (%fdinfo-token= text (aref spans 0) (aref spans 1) "ino:")
                 (%fdinfo-inode= text (aref spans 2) (aref spans 3) inode)
                 (= 9 (%fdinfo-fields text lock-start lock-end spans 9)))
      (return-from %fdinfo-flock-p nil))
    (unless (and (%fdinfo-token= text (aref spans 0) (aref spans 1) "lock:")
                 (< 1 (- (aref spans 3) (aref spans 2)))
                 (char= #\: (char text (1- (aref spans 3))))
                 (%fdinfo-unsigned-p text (aref spans 2) (1- (aref spans 3)) 10 t)
                 (%fdinfo-token= text (aref spans 4) (aref spans 5) "FLOCK")
                 (%fdinfo-token= text (aref spans 6) (aref spans 7) "ADVISORY")
                 (%fdinfo-token= text (aref spans 8) (aref spans 9) "WRITE")
                 (%fdinfo-unsigned-p text (aref spans 10) (aref spans 11) 10 t)
                 (%fdinfo-token= text (aref spans 14) (aref spans 15) "0")
                 (%fdinfo-token= text (aref spans 16) (aref spans 17) "EOF"))
      (return-from %fdinfo-flock-p nil))
    (let* ((start (aref spans 12)) (end (aref spans 13))
                                   (first (position #\: text :start start :end end))
                                   (second (and first (position #\: text :start (1+ first) :end end))))
      (and first second (not (position #\: text :start (1+ second) :end end))
           (%fdinfo-unsigned-p text start first 16 nil)
           (%fdinfo-unsigned-p text (1+ first) second 16 nil)
           (%fdinfo-inode= text (1+ second) end inode)))))
