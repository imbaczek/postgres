;;;; Fast, independently selectable regressions migrated from t/unit-tests/.
(asdf:defsystem "pg-unit-tests"
  :description "Unit regressions and generated contracts"
  :depends-on ("pg" "rove" "cl-spec/check-it")
  :serial t
  :components ((:file "t/rove/support")
               (:file "t/rove/hot-path-tests")
               (:file "t/rove/primitives-tests")
               (:file "t/rove/storage-tests")
               (:file "t/rove/pglz-tests")
               (:file "t/rove/numeric-storage-tests")
               (:file "t/rove/jsonb-storage-tests")
               (:file "t/rove/json-operator-tests")
               (:file "t/rove/sql-tests")
               (:file "t/rove/catalog-tests")
               (:file "t/rove/protocol-tests")
               (:file "t/rove/logical-tests")
               (:file "t/rove/vacuum-tests")
               (:file "t/rove/join-tests")
               (:file "t/rove/spill-tests")
               (:file "t/rove/cleanup-domain-tests")
               (:file "t/rove/concurrency-tests")
               (:file "t/rove/relation-resource-tests")
               (:file "t/rove/resource-parameters-tests")
               (:file "t/rove/checkpoint-commit-ts-tests")
               (:file "t/rove/checkpoint-commit-ts-policy-tests")
               (:file "t/rove/checkpoint-full-page-writes-tests")
               (:file "t/rove/checkpoint-logical-status-tests")
               (:file "t/rove/logical-status-wal-tests")
               (:file "t/rove/full-page-writes-state-tests")
               (:file "t/rove/full-page-writes-writer-tests")
               (:file "t/rove/source-fpw-fact-tests")
               (:file "t/rove/source-logical-fact-tests")
               (:file "t/rove/source-fpw-control-tests")
               (:file "t/rove/source-logical-control-tests")
               (:file "t/rove/promotion-fpw-intent-tests")
               (:file "t/rove/promotion-fpw-plan-tests")
               (:file "t/rove/child-fpw-grammar-tests")
               (:file "t/rove/scan-stage-tests")
               (:file "t/rove/eor-stage-tests")
               (:file "t/rove/standby-backup-tests")
               (:file "t/rove/snapshot-tests")
               (:file "t/rove/transaction-tests")
               (:file "t/rove/wal-tests")
               (:file "t/rove/crc32-tests")
               (:file "t/rove/record-crc32-tests")
               (:file "t/rove/native-crc32-tests" :if-feature :x86-64)
               (:file "t/rove/native-crc32c-tests" :if-feature :x86-64)
               (:file "t/rove/native-arm-crc32-tests" :if-feature :arm64)
               (:file "t/rove/crc32-portability-tests")
               (:file "t/rove/fnv64-tests")
               (:file "t/rove/wal-writer-tests")
               (:file "t/rove/clog-policy-epoch-tests")
               (:file "t/rove/logical-policy-tests")
               (:file "t/rove/wal-writer-output-tests")
               (:file "t/rove/wal-writer-policy-tests")
               (:file "t/rove/wal-pressure-tests")
               (:file "t/rove/wal-writer-lifecycle-tests")
               (:file "t/rove/backend-lifecycle-tests")
               (:file "t/rove/property-tests")
               (:file "t/rove/subquery-tests")
               (:file "t/rove/window-tests")
               (:file "t/rove/cte-tests")
               (:file "t/rove/having-tests")
               (:file "t/rove/lateral-tests")
               (:file "t/rove/recursive-cte-tests")
               (:file "t/rove/returning-tests")
               (:file "t/rove/insert-select-tests")
               (:file "t/rove/on-conflict-tests")
               (:file "t/rove/joined-dml-tests")
               (:file "t/rove/basic-aggregate-tests")
               (:file "t/rove/default-check-tests")
               (:file "t/rove/syncrep-tests"))
  :perform (asdf:test-op (operation component)
                         (declare (ignore operation component))
                         (unless (uiop:symbol-call :rove :run :pg-unit-tests)
                           (error "Unit regressions or generated contracts failed"))))
