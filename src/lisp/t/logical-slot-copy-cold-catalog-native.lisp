(in-package #:pg)

(defvar *logical-cold-catalog-optional-thread* nil)

(defvar *logical-cold-catalog-optional-result* nil)

(declaim (ftype function logical-import-commit-test-omit-fact))

(defun logical-cold-catalog-prepare-optional ()
  (setf *logical-cold-catalog-optional-result* nil
        *logical-cold-catalog-optional-thread*
        (sb-thread:make-thread
         (lambda ()
           (handler-case
               (progn
                 (physical-follow-call-with-controller-blocked
                  (lambda ()
                    (sb-thread:with-mutex (*physical-shutdown-lock*)
                      (sb-thread:with-mutex (*physical-follow-command-lock*)
                        (sb-thread:with-mutex (*reload-run-lock*)
                          (with-live-operation-quiescence
                            (with-physical-follow-controller-publication (obsolete)
                              (logical-import-commit-test-omit-fact))))))))
                 (setf *logical-cold-catalog-optional-result* :passed))
             (error (condition)
               (setf *logical-cold-catalog-optional-result* (list :error (princ-to-string condition)))))))))

(defun logical-cold-catalog-dropped-node ()
  (let ((tables (loop for database being the hash-values of (catalog-databases *catalog*)
                      for table = (gethash "dropped_since_base" (database-tables database))
                      when table collect table)))
    (assert (= 1 (length tables)))
    (let ((node (pg-class-relfilenode (first tables))))
      (format t "~&COLD-CATALOG-BASE-NODE ~d~%" node)
      (finish-output)
      node)))

(defun logical-cold-catalog-test-write (path bytes)
  (with-open-file (out path :direction :output :if-exists :overwrite
                            :if-does-not-exist :error :element-type '(unsigned-byte 8))
    (write-sequence bytes out)
    (force-output out)))

(defun logical-cold-catalog-test-run (mode)
  (let* ((directory *pgdata*)
         (read-function (symbol-function 'sb-posix:read))
         (write-function (symbol-function 'sb-posix:write))
         (open-function (symbol-function 'physical-image-openat))
         (close-function (symbol-function 'sb-posix:close))
         (sync-function (symbol-function 'sb-posix:fsync))
         (rename-function (symbol-function 'port-renameat))
         (unlink-function (symbol-function 'logical-slot-copy-unlinkat))
         (store-close (symbol-function 'physical-store-close))
         (root-scope (symbol-function 'call-with-physical-directory-root))
         (saved nil) (extra nil) (fired nil) (sticky nil) (failure nil) (result nil)
         (reused nil) (close-target nil) (closes 0)
         (fenced (or (and (symbolp mode) (search "LATE-" (symbol-name mode)))
                     (member mode '(:create :write :temp-sync :old-sync :file-sync :directory-sync
                                    :rename :rename-after :unlink :unlink-after :close :close-interrupt
                                    :store-close :root-close :caught-write :caught-create :caught-sync
                                    :caught-rename :throw-after)))))
    (with-open-file (witness (merge-pathnames "catalog-foreign-witness" (uiop:temporary-directory))
                             :direction :io :if-exists :supersede :if-does-not-exist :create
                             :element-type '(unsigned-byte 8))
      (write-sequence #(9 8 7) witness)
      (force-output witness)
      (let* ((outside (sb-sys:fd-stream-fd witness))
             (count (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t))))
        (labels ((attempt () (cdar *logical-slot-copy-catalog-attempts*))
                 (path (name) (merge-pathnames name directory))
                 (rejects (function &optional text)
                   (handler-case (progn (funcall function) nil)
                     (error (condition)
                       (or (null text) (search text (princ-to-string condition))))))
                 (change (name &optional same)
                   (let* ((target (path name))
                          (bytes (read-bounded-regular-file target (* 32 1024 1024))))
                     (unless (assoc target saved :test #'equal) (push (cons target (copy-seq bytes)) saved))
                     (unless same (setf (aref bytes 0) (logxor 1 (aref bytes 0))))
                     (logical-cold-catalog-test-write target bytes)))
                 (extent ()
                   (let ((names (directory (path "pg_physical_retained/extent-*.wal"))))
                     (assert (= 1 (length names))) (enough-namestring (first names) directory)))
                 (restartpoint ()
                   (let ((names (directory (path "pg_physical_restartpoints/*.rp"))))
                     (assert (= 1 (length names))) (enough-namestring (first names) directory)))
                 (fault (message) (setf fired t) (error message))
                 (hook (point context)
                   (declare (ignore context))
                   (when (and (consp mode) (eq :kill (first mode)) (eq point (second mode)))
                     (format t "~&COLD-CATALOG-KILL ~s~%" point) (finish-output)
                     (sb-posix:kill (sb-posix:getpid) sb-posix:sigkill))
                   (when (and (eq point :before-cold-catalog-close)
                              (member mode '(:close :close-interrupt)))
                     (setf close-target (or (logical-slot-copy-catalog-attempt-temp-fd (attempt))
                                            (logical-slot-copy-catalog-attempt-old-fd (attempt)))))
                   (unless fired
                     (when (eq point :after-cold-catalog-open)
                       (case mode
                         (:source (setf fired t) (change (extent)))
                         (:restartpoint (setf fired t) (change (restartpoint) t))
                         (:pending (setf fired t) (change "logical-slot-copy.import" t))
                         (:evidence (setf fired t) (change "logical-slot-copy.evidence" t))
                         (:parent (setf fired t) (change "global/pg_wal_control" t))
                         (:target (setf fired t) (change "global/pg_catalog.dat" t))
                         (:extra
                          (setf fired t extra (path "global/foreign-catalog-leaf"))
                          (with-open-file (out extra :direction :output :if-exists :error) (write-line "foreign" out)))
                         (:binding
                          (setf fired t)
                          (let ((bytes (getf (logical-slot-copy-catalog-attempt-binding (attempt)) :catalog)))
                            (setf (aref bytes 0) (logxor 1 (aref bytes 0)))))
                         (:fd-field
                          (setf fired t (logical-slot-copy-catalog-attempt-old-fd (attempt)) outside)
                          (error "injected catalog FD field mutation"))
                         (:seal-field
                          (setf fired t
                                (second (logical-slot-copy-catalog-attempt-operation-seal (attempt))) outside)
                          (error "injected catalog seal mutation"))
                         (:copied-forged
                          (setf fired t)
                          (let* ((real (attempt)) (fake (copy-structure real)))
                            (dolist (function
                                     (list (lambda () (logical-slot-copy-catalog-create fake))
                                           (lambda () (logical-slot-copy-catalog-write fake))
                                           (lambda () (logical-slot-copy-catalog-check fake))
                                           (lambda () (logical-slot-copy-catalog-check-source fake nil))
                                           (lambda () (logical-slot-copy-catalog-open-one fake nil))
                                           (lambda () (logical-slot-copy-catalog-close-one fake nil))))
                              (assert (rejects function "scope")))
                            (logical-slot-copy-catalog-check real)))
                         (:caught-registry
                          (setf fired t)
                          (let ((real (attempt)))
                            (let ((*logical-slot-copy-catalog-attempts* nil))
                              (assert (rejects (lambda () (logical-slot-copy-catalog-check real)) "scope")))
                            (setf sticky (rejects (lambda () (logical-slot-copy-catalog-check real))))))
                         (:caught-source
                          (setf fired t)
                          (let ((name (extent)))
                            (change name)
                            (assert (rejects (logical-slot-copy-catalog-attempt-source-check (attempt))))
                            (logical-cold-catalog-test-write (path name) (cdr (assoc (path name) saved :test #'equal)))
                            (setf (logical-slot-copy-catalog-attempt-failed (attempt)) nil
                                  (physical-adoption-owner-active-p
                                   (logical-slot-copy-catalog-attempt-owner (attempt))) t)
                            (setf sticky (rejects (logical-slot-copy-catalog-attempt-source-check (attempt))))))))
                     (when (and (eq point :before-cold-catalog-create) (eq mode :throw-before))
                       (setf fired t) (throw 'catalog-cut :cut))
                     (when (and (eq point :after-cold-catalog-rename) (eq mode :throw-after))
                       (setf fired t) (throw 'catalog-cut :cut))
                     (when (and (eq point :before-cold-catalog-create) (eq mode :caught-create))
                       (setf fired t)
                       (assert (rejects (lambda () (logical-slot-copy-catalog-create (attempt)))))
                       (setf sticky (rejects (lambda () (logical-slot-copy-catalog-create (attempt))))))
                     (when (and (eq point :after-cold-catalog-create) (eq mode :caught-write))
                       (setf fired t)
                       (assert (rejects (lambda () (logical-slot-copy-catalog-write (attempt)))))
                       (setf sticky (rejects (lambda () (logical-slot-copy-catalog-write (attempt))))))
                     (when (and (eq point :after-cold-catalog-write) (eq mode :caught-sync))
                       (setf fired t)
                       (assert (rejects (lambda ()
                                          (logical-slot-copy-catalog-sync
                                           (attempt) (logical-slot-copy-catalog-attempt-temp-fd (attempt)) :test))))
                       (setf sticky (rejects (lambda () (logical-slot-copy-catalog-check (attempt))))))
                     (when (and (eq point :before-cold-catalog-rename) (eq mode :caught-rename))
                       (setf fired t)
                       (assert (rejects (lambda () (logical-slot-copy-catalog-rename (attempt)))))
                       (setf sticky (rejects (lambda () (logical-slot-copy-catalog-rename (attempt)))))))
                   (when (and (eq point :after-cold-catalog-execute)
                              (member mode '(:late-source :late-restartpoint :late-target :late-extra)))
                     (setf fired t)
                     (case mode
                       (:late-source (change (extent)))
                       (:late-restartpoint (change (restartpoint) t))
                       (:late-target (change "global/pg_catalog.dat" t))
                       (:late-extra
                        (setf extra (path "global/foreign-catalog-leaf"))
                        (with-open-file (out extra :direction :output :if-exists :error) (write-line "foreign" out))))))
                 (invoke ()
                   (case mode
                     (:forged
                      (let ((global (sb-posix:open (namestring (uiop:temporary-directory))
                                                   (logior sb-posix:o-rdonly sb-posix:o-directory))))
                        (unwind-protect
                             (let ((fake (%make-logical-slot-copy-catalog-attempt
                                          :global global :temp-fd outside :binding (list :catalog #(1 2 3)))))
                               (dolist (function (list (lambda () (logical-slot-copy-catalog-create fake))
                                                       (lambda () (logical-slot-copy-catalog-write fake))
                                                       (lambda () (logical-slot-copy-catalog-open-one fake nil))
                                                       (lambda () (logical-slot-copy-catalog-close-one fake t))))
                                 (assert (rejects function "scope")))
                               (assert (not (probe-file (merge-pathnames "pg_catalog.tmp" (uiop:temporary-directory))))))
                          (funcall close-function global)))
                      (setf fired t) :forged)
                     (:dirty-catalog (let ((*catalog* :dirty)) (logical-slot-copy-import-restore-parent-catalog)))
                     (:dirty-store (let ((*physical-receive-store* :dirty)) (logical-slot-copy-import-restore-parent-catalog)))
                     (:dirty-ready (let ((*wal-ready* t)) (logical-slot-copy-import-restore-parent-catalog)))
                     (otherwise (logical-slot-copy-import-restore-parent-catalog)))))
          (unwind-protect
               (progn
                 (setf (symbol-function 'physical-image-openat)
                       (lambda (parent name flags permissions)
                         (when (and (not (logtest sb-posix:o-creat flags)) (equal name "pg_catalog.dat")
                                    (eq mode :open) (not fired))
                           (fault "injected catalog open"))
                         (when (and (logtest sb-posix:o-creat flags) (equal name "pg_catalog.tmp")
                                    (or (eq mode :create) (eq mode :caught-create))
                                    (or (eq mode :caught-create) (not fired)))
                           (fault "injected catalog create"))
                         (funcall open-function parent name flags permissions))
                       (symbol-function 'sb-posix:read)
                       (lambda (fd buffer size)
                         (when (and (eq mode :read) (not fired) (attempt)
                                    (eql fd (logical-slot-copy-catalog-attempt-old-fd (attempt))))
                           (fault "injected catalog read"))
                         (funcall read-function fd buffer size))
                       (symbol-function 'sb-posix:write)
                       (lambda (fd buffer size)
                         (when (and (member mode '(:write :caught-write)) (attempt)
                                    (eql fd (logical-slot-copy-catalog-attempt-temp-fd (attempt))))
                           (fault "injected catalog write"))
                         (funcall write-function fd buffer size))
                       (symbol-function 'logical-slot-copy-unlinkat)
                       (lambda (fd name flags)
                         (if (and (member mode '(:unlink :unlink-after)) (equal name "pg_catalog.tmp"))
                             (progn
                               (when (eq mode :unlink-after) (funcall unlink-function fd name flags))
                               (fault "injected catalog unlink"))
                             (funcall unlink-function fd name flags)))
                       (symbol-function 'port-renameat)
                       (lambda (from-fd from to-fd to)
                         (if (and (member mode '(:rename :rename-after :caught-rename))
                                  (equal from "pg_catalog.tmp") (equal to "pg_catalog.dat"))
                             (progn
                               (when (eq mode :rename-after) (funcall rename-function from-fd from to-fd to))
                               (fault "injected catalog rename"))
                             (funcall rename-function from-fd from to-fd to)))
                       (symbol-function 'sb-posix:fsync)
                       (lambda (fd)
                         (when (and (attempt)
                                    (let ((a (attempt)))
                                      (or (and (member mode '(:temp-sync :caught-sync))
                                               (eq :ready (logical-slot-copy-catalog-attempt-phase a))
                                               (eql fd (logical-slot-copy-catalog-attempt-temp-fd a)))
                                          (and (eq mode :old-sync)
                                               (eq :ready (logical-slot-copy-catalog-attempt-phase a))
                                               (eql fd (logical-slot-copy-catalog-attempt-old-fd a)))
                                          (and (eq mode :file-sync)
                                               (eq :installed (logical-slot-copy-catalog-attempt-phase a))
                                               (eql fd (logical-slot-copy-catalog-attempt-temp-fd a)))
                                          (and (eq mode :directory-sync)
                                               (eql fd (logical-slot-copy-catalog-attempt-global a))))))
                           (fault "injected catalog sync"))
                         (funcall sync-function fd))
                       (symbol-function 'sb-posix:close)
                       (lambda (fd)
                         (let ((value (funcall close-function fd)))
                           (when (and (eql fd close-target) (not fired))
                             (setf fired t) (incf closes)
                             (sb-posix:dup2 outside fd)
                             (setf reused fd)
                             (if (eq mode :close-interrupt)
                                 (sb-thread:interrupt-thread sb-thread:*current-thread*
                                                             (lambda () (throw 'catalog-cut :cut)))
                                 (error "injected catalog close")))
                           value))
                       (symbol-function 'physical-store-close)
                       (lambda (store)
                         (prog1 (funcall store-close store)
                           (when (and (eq mode :store-close) (not fired))
                             (fault "injected catalog store close"))))
                       (symbol-function 'call-with-physical-directory-root)
                       (lambda (owner function)
                         (funcall root-scope owner
                                  (lambda (borrowed root)
                                    (multiple-value-prog1 (funcall function borrowed root)
                                      (when (and (eq mode :root-close) (not fired))
                                        (fault "injected catalog root exit")))))))
                 (let ((*logical-slot-copy-verification-test-hook* #'hook))
                   (handler-case (setf result (catch 'catalog-cut (invoke)))
                     (error (condition) (setf failure (princ-to-string condition))))))
            (sb-sys:without-interrupts
              (setf (symbol-function 'physical-image-openat) open-function
                    (symbol-function 'sb-posix:read) read-function
                    (symbol-function 'sb-posix:write) write-function
                    (symbol-function 'sb-posix:fsync) sync-function
                    (symbol-function 'port-renameat) rename-function
                    (symbol-function 'logical-slot-copy-unlinkat) unlink-function
                    (symbol-function 'sb-posix:close) close-function
                    (symbol-function 'physical-store-close) store-close
                    (symbol-function 'call-with-physical-directory-root) root-scope))
            (dolist (entry saved) (logical-cold-catalog-test-write (car entry) (cdr entry)))
            (when extra (delete-file extra)))
          (when reused
            (assert (sb-posix:s-isreg (sb-posix:stat-mode (sb-posix:fstat reused))))
            (funcall close-function reused))
          (if (member mode '(:healthy :forged :copied-forged))
              (progn (assert (null failure)) (assert (member result '(:restored :synced :forged))))
              (progn
                (assert (or failure (eq result :cut)))
                (when (or (member mode '(:read :open :create :write :temp-sync :old-sync :file-sync
                                         :directory-sync :rename :rename-after :unlink :unlink-after
                                         :close :close-interrupt :store-close :root-close
                                         :source :restartpoint :pending :evidence :parent :target :extra
                                         :binding :fd-field :seal-field :caught-source :caught-write
                                         :caught-create :caught-sync :caught-rename :throw-before :throw-after
                                         :late-source :late-restartpoint :late-target :late-extra)))
                  (assert fired))))
          (when (member mode '(:caught-source :caught-create :caught-write :caught-sync :caught-rename :caught-registry))
            (assert sticky))
          (when (eq mode :copied-forged) (assert fired))
          (when (member mode '(:close :close-interrupt)) (assert (= closes 1)))
          (assert (eql (not (null fenced)) (not (null *physical-recovery-failed-p*))))
          (when fenced (assert (rejects #'logical-slot-copy-import-restore-parent-catalog)))
          (assert (= count (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t))))
          (assert (sb-posix:s-isreg (sb-posix:stat-mode (sb-posix:fstat outside))))
          (file-position witness 0)
          (let ((bytes (make-array 3 :element-type '(unsigned-byte 8))))
            (assert (= 3 (read-sequence bytes witness))) (assert (equalp bytes #(9 8 7))))
          (assert (and (null *physical-recovery-state*) (null *physical-receive-store*)
                       (null *catalog*) (null *clog-stream*) (null *wal-output-stream*)
                       (not *wal-ready*) (zerop (hash-table-count *relation-streams*))
                       (zerop (hash-table-count *wal-replication-slots*))))
          (format t "~&COLD-CATALOG-RESTORE-PASS ~s~%" mode)
          (finish-output))))))
