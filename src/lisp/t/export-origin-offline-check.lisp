(require :asdf)
(asdf:load-asd (merge-pathnames "../pg.asd" *load-truename*))
(asdf:load-system "pg")

(in-package #:pg)

(destructuring-bind (directory system timeline base manifest endpoint digest)
    (uiop:command-line-arguments)
  (let* ((*pgdata* (uiop:ensure-directory-pathname (truename directory)))
         (*catalog-identity-needs-persist-p* nil)
         (*catalog* (load-catalog))
         (*physical-recovery-state* nil)
         (*physical-export-origins* (make-hash-table :test #'equal))
         (*physical-export-origin-reservations* (make-hash-table :test #'eq))
         (*physical-source-senders* (make-hash-table :test #'equal))
         (identity (mapcar #'parse-integer (list system timeline base manifest)))
         (expected-end (parse-integer endpoint))
         (expected-digest (parse-integer digest)))
    (when (probe-file (merge-pathnames "postmaster.pid" *pgdata*))
      (error "offline origin check requires a stopped primary"))
    (multiple-value-bind (lock size)
        (open-bounded-regular-file (merge-pathnames ".pg_lisp.lock" *pgdata*) 0)
      (declare (ignore size))
      (unwind-protect
           (progn
             (unless (zerop (physical-store-flock (sb-sys:fd-stream-fd lock) 6))
               (error "offline origin check could not own PGDATA"))
             (multiple-value-bind (checkpoint durable snapshot insertion checkpoint-timeline namespace metadata)
                 (wal-read-control-fields)
               (unless (and (= checkpoint durable expected-end)
                            (= +db-shutdowned+ (getf metadata :db-state))
                            (= (catalog-system-identifier) (getf metadata :system-id)))
                 (error "offline origin check requires the exact clean checkpoint"))
               (let ((*wal-checkpoint-lsn* checkpoint) (*wal-durable-lsn* durable)
                                                       (*wal-checkpoint-snapshot* snapshot) (*wal-insert-timeline* insertion)
                                                       (*wal-checkpoint-timeline* checkpoint-timeline) (*wal-segment-namespace* namespace))
                 (physical-export-origin-load)
                 (let* ((entry (gethash identity *physical-export-origins*))
                        (origin (and entry (physical-export-origin-entry-origin entry))))
                   (unless (and origin
                                (= expected-end (physical-export-origin-proven-lsn origin))
                                (= expected-digest (physical-export-origin-prefix-digest origin)))
                     (error "offline origin commitment differs from the independent oracle")))))
             (format t "~&export-origin: cold history load without WAL reconstruction PASS~%"))
        (close lock)))))
