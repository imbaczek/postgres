(in-package #:pg-physical-tests)

(deftest statement-snapshot-scopes-publish-nested-registration-owners
    (let ((pg::*statement-snapshot-registrations* nil)
          (pg::*active-snapshots* 0)
          (pg::*active-snapshot-set* (make-hash-table :test #'eq))
          (pg::*active-xids* nil)
          (pg::*physical-recovery-state* nil)
          (pg::*next-xid* 50)
          (outer-registration nil)
          (inner-registration nil))
      (declare (special pg::*statement-snapshot-registrations*))
      (pg::with-statement-snapshot
          (outer (lambda (registration)
                   (setf outer-registration registration)
                   (pg::make-snapshot 1 :register registration)))
        (ok (equal (list outer-registration) pg::*statement-snapshot-registrations*))
        (ok (eq outer (pg::snapshot-registration-snapshot outer-registration)))
        (pg::with-statement-snapshot
            (inner (lambda (registration)
                     (setf inner-registration registration)
                     (pg::make-snapshot 2 :register registration)))
          (ok (equal (list inner-registration outer-registration)
                     pg::*statement-snapshot-registrations*))
          (ok (eq inner (pg::snapshot-registration-snapshot inner-registration)))
          (ok (= 2 pg::*active-snapshots*)))
        (ok (equal (list outer-registration) pg::*statement-snapshot-registrations*))
        (ok (not (pg::snapshot-registration-active-p inner-registration)))
        (ok (pg::snapshot-registration-active-p outer-registration))
        (ok (= 1 pg::*active-snapshots*)))
      (ok (null pg::*statement-snapshot-registrations*))
      (ok (not (pg::snapshot-registration-active-p outer-registration)))
      (ok (zerop pg::*active-snapshots*))
      (ok (zerop (hash-table-count pg::*active-snapshot-set*)))))

(deftest statement-snapshot-scope-restores-owner-list-after-acquisition-unwinds
    (let* ((sentinel (pg::make-snapshot-registration))
           (pg::*statement-snapshot-registrations* (list sentinel))
           (registration nil)
           (pg::*active-snapshots* 0)
           (pg::*active-snapshot-set* (make-hash-table :test #'eq))
           (pg::*active-xids* nil)
           (pg::*physical-recovery-state* nil)
           (pg::*next-xid* 50))
      (declare (special pg::*statement-snapshot-registrations*))
      (ok (eq :injected
              (catch 'snapshot-acquisition-fault
                (pg::with-statement-snapshot
                    (snapshot (lambda (owner)
                                (setf registration owner)
                                (pg::make-snapshot 1 :register owner)
                                (ok (= 1 pg::*active-snapshots*))
                                (ok (equal (list owner sentinel)
                                           pg::*statement-snapshot-registrations*))
                                (throw 'snapshot-acquisition-fault :injected)))
                  :unreachable))))
      (ok (equal (list sentinel) pg::*statement-snapshot-registrations*))
      (ok registration)
      (ok (zerop pg::*active-snapshots*))
      (ok (zerop (hash-table-count pg::*active-snapshot-set*)))
      (ok (not (pg::snapshot-registration-active-p registration)))))
