(in-package #:pg)

(defun logical-publication-input-test-run (phase)
  (assert (member phase '(:parent :child)))
  (labels ((rejects (function message)
             (assert (handler-case (progn (funcall function) nil)
                       (error (condition) (search message (princ-to-string condition)))))))
    (rejects (lambda () (logical-slot-copy-read-preserved-inputs nil nil nil nil :unknown))
             "unknown preserved import control phase")
    (call-with-logical-slot-copy-install-exclusion
     (lambda ()
       (call-with-logical-slot-copy-owned-input
        (lambda (&rest arguments)
          (apply #'%make-logical-slot-copy-committed-owner
                 :mode :cold :state nil :store nil arguments))
        (lambda (owner context proof)
          (let ((certificate (logical-slot-copy-import-read-artifact context :pending)))
            (assert (eq :pending (getf certificate :phase)))
            (multiple-value-bind (actual evidence descriptor manifest control plan status observations)
                (logical-slot-copy-read-preserved-inputs owner context proof certificate phase)
              (declare (ignore evidence descriptor manifest control plan status))
              (assert (equal certificate actual))
              (assert (find "global/pg_wal_control" observations :key #'first :test #'equal))
              (logical-slot-copy-input-check-observations owner context observations)
              (rejects (lambda ()
                         (logical-slot-copy-read-preserved-inputs
                          owner context proof certificate (if (eq phase :parent) :child :parent)))
                       (if (eq phase :parent) "exact child control" "exact parent control"))
              (rejects (lambda ()
                         (logical-slot-copy-read-preserved-inputs owner context proof certificate :unknown))
                       "unknown preserved import control phase")
              (if (eq phase :child)
                  (assert (equal certificate (logical-slot-copy-read-committed-inputs owner context proof certificate)))
                  (rejects (lambda () (logical-slot-copy-read-committed-inputs owner context proof certificate))
                           "exact child control"))
              (assert (equal certificate
                             (logical-slot-copy-read-preserved-inputs owner context proof certificate phase)))
              (logical-slot-copy-input-check-observations owner context observations))))))))
  (assert (and (null *physical-recovery-state*) (null *physical-receive-store*)
               (null *catalog*) (not *wal-ready*)
               (zerop (hash-table-count *wal-replication-slots*))))
  (format t "~&PUBLICATION-INPUT-PHASE-PASS ~s~%" phase)
  (finish-output))
