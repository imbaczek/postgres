(in-package #:pg)

(defun logical-source-proof-test-binding-rejection (expected)
  (let ((before (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t)))
        (message (handler-case (progn (logical-slot-copy-read-source-proof) nil)
                   (error (condition) (princ-to-string condition)))))
    (assert (and message (search expected message)) ()
            "Expected source binding rejection ~s, got ~s" expected message)
    (assert (zerop (hash-table-count *physical-retained-root-references*)))
    (assert (= before (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t))))
    (assert (and (null *catalog*) (null *physical-recovery-state*)
                 (null *physical-receive-store*) (null *clog-stream*)
                 (null *wal-output-stream*) (not *wal-ready*)))
    message))

(defun logical-source-proof-test-binding-mutant (mode)
  (let* ((facts (logical-slot-copy-read-source-proof))
         (certificate (getf facts :certificate))
         (reference (getf certificate :retained-reference))
         (directory (physical-recovery-retained-directory))
         (identity (physical-promotion-retained-identity (getf certificate :system-id) reference))
         (history (logical-slot-copy-source-proof-parent-history facts))
         (index (physical-retained-inventory-read-index
                 directory (getf reference :root-id) identity history)))
    (if (eq mode :prefix)
        (let* ((path (merge-pathnames "logical-slot-copy.source-proof" *pgdata*))
               (parts (logical-slot-copy-source-proof-decode
                       (read-bounded-regular-file path (logical-slot-copy-source-proof-maximum-bytes))))
               (prefix (copy-seq (getf parts :prefix))))
          (assert (plusp (length prefix)))
          (setf (aref prefix 0) (logxor 1 (aref prefix 0))
                (getf parts :prefix) prefix)
          (let ((image (logical-slot-copy-source-proof-encode parts)))
            (logical-slot-copy-source-proof-decode image)
            (values path image "invalid restartpoint WAL prefix proof")))
        (multiple-value-bind (kind id image)
            (ecase mode
              (:inventory
               (setf (getf index :history-text)
                     (concatenate 'string (getf index :history-text) " "))
               (let ((image (physical-retained-inventory-image index)))
                 (physical-retained-inventory-decode image)
                 (values :inventory (getf reference :root-id) image)))
              (:extent
               (let* ((entry (first (getf index :entries)))
                      (id (first entry)))
                 (assert entry)
                 (multiple-value-bind (metadata bytes)
                     (physical-retained-extent-decode
                      (physical-retained-object-read directory :extent id +physical-retained-image-limit+))
                   (setf (getf metadata :manifest-digest) (logxor 1 (getf metadata :manifest-digest)))
                   (let ((image (physical-retained-extent-encode metadata bytes)))
                     (physical-retained-extent-decode image)
                     (values :extent id image))))))
          (assert (/= id (logical-slot-copy-import-digest image)))
          (values (physical-retained-object-path directory kind id) image
                  "permanent source archive object differs from its content ID")))))

(defun logical-source-proof-test-binding (mode)
  (let ((before (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t))))
    (multiple-value-bind (path image expected) (logical-source-proof-test-binding-mutant mode)
      (let* ((original (slot-state-lstat path))
             (hidden (uiop:ensure-directory-pathname
                      (sb-posix:mkdtemp
                       (namestring (merge-pathnames "source-proof-binding-XXXXXX"
                                                    (uiop:temporary-directory))))))
             (backup (merge-pathnames "original" hidden))
             (moved nil))
        (unwind-protect
             (progn
               (sb-posix:rename (namestring path) (namestring backup))
               (setf moved t)
               (with-open-file (out path :direction :output :if-exists :error
                                         :element-type '(unsigned-byte 8))
                 (write-sequence image out)
                 (fsync-stream out))
               (sb-posix:chmod (namestring path) #o600)
               (fsync-directory (uiop:pathname-directory-pathname path))
               (logical-source-proof-test-binding-rejection expected)
               (assert (equalp image (read-bounded-regular-file path (length image)))))
          (when moved
            (when (slot-state-lstat path) (delete-file path))
            (sb-posix:rename (namestring backup) (namestring path))
            (fsync-directory (uiop:pathname-directory-pathname path)))
          (uiop:delete-directory-tree hidden :validate t :if-does-not-exist :ignore))
        (let ((restored (slot-state-lstat path)))
          (assert (= (sb-posix:stat-dev original) (sb-posix:stat-dev restored)))
          (assert (= (sb-posix:stat-ino original) (sb-posix:stat-ino restored))))
        (assert (getf (logical-slot-copy-read-source-proof) :fact))
        (assert (logical-source-proof-test-rejected-p #'logical-slot-copy-check-promotion))))
    (assert (zerop (hash-table-count *physical-retained-root-references*)))
    (assert (= before (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t))))
    (format t "~&SOURCE-PROOF-READER-BINDING-PASS mode=~s restored=t retry=t~%" mode)
    (finish-output)))

(defun logical-source-proof-test-foreign-root ()
  (let* ((bytes (read-bounded-regular-file
                 (merge-pathnames "logical-slot-copy.source-proof" *pgdata*)
                 (logical-slot-copy-source-proof-maximum-bytes)))
         (facts (logical-slot-copy-check-source-proof bytes))
         (certificate (getf facts :certificate))
         (root (slot-state-lstat *pgdata*)))
    (assert (not (and (= (getf certificate :device) (sb-posix:stat-dev root))
                      (= (getf certificate :inode) (sb-posix:stat-ino root)))))
    (logical-source-proof-test-binding-rejection
     "permanent source proof belongs to a different PGDATA root")
    (assert (logical-source-proof-test-rejected-p #'logical-slot-copy-check-promotion))
    (format t "~&SOURCE-PROOF-FOREIGN-ROOT-PASS envelope-valid=t binding-rejected=t~%")
    (finish-output)))
