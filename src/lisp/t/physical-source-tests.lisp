;;;; Source pin tests isolate retention decisions; placeholder segments are not replay fixtures.
(in-package #:pg-physical-tests)

(defun call-with-physical-source-fixture (function)
  (with-physical-store-directory (root)
    (let* ((pg::*pgdata* root)
           (pg::*catalog* (pg::make-catalog))
           (pg::*physical-source-pins* (make-hash-table :test #'equal))
           (pg::*wal-snapshot-retention-pins* (make-hash-table :test #'eq))
           (pg::*wal-replication-slots* (make-hash-table :test #'equal))
           (pg::*wal-xid-first-lsn* (make-hash-table :test #'eql))
           (pg::*wal-output-stream* nil) (pg::*wal-output-segment* nil)
           (pg::*wal-poisoned* nil)
           (pg::*startup-installed-configuration*
             (physical-slot-test-configuration
              (pg::make-wal-slot-retention-policy :mode :bytes :limit 1073741824) 0))
           (pg::*pm-requested-mode* pg::+no-shutdown+)
           (pg::*wal-checkpoint-lsn* (* 2 pg::+wal-segment-size+))
           (pg::*wal-durable-lsn* (+ (* 3 pg::+wal-segment-size+) 64)))
      (pg::wal-ensure-directory-durable (pg::wal-directory))
      (loop for segment below 4
            do (with-open-file (stream (pg::wal-segment-path segment)
                                       :direction :output :element-type '(unsigned-byte 8))
                 (write-byte 0 stream)))
      (let ((start (- pg::*wal-checkpoint-lsn* (pg::wal-checkpoint-record-size))))
        (multiple-value-bind (record pg::*wal-checkpoint-snapshot*)
            (physical-test-checkpoint-record start)
          (with-open-file (stream (pg::wal-segment-path 1) :direction :io :if-exists :overwrite
                                                           :element-type '(unsigned-byte 8))
            (file-position stream (mod start pg::+wal-segment-size+))
            (write-sequence record stream)
            (pg::fsync-stream stream))
          (funcall function))))))

(deftest primary-archive-proof-tracks-the-writer-rotation-end
    (call-with-physical-source-fixture
     (lambda ()
       (let* ((pg::*wal-output-stream* nil)
              (pg::*wal-output-segment* nil)
              (pg::*wal-new-segments* nil)
              (settings (pg::startup-configuration-settings pg::*startup-installed-configuration*))
              (first (sample-physical-record))
              (later (concatenate '(vector (unsigned-byte 8)) first (sample-physical-record (length first))))
              (path (pg::wal-segment-path 0))
              (proof (merge-pathnames (pg::wal-archive-segment-proof-name (file-namestring path))
                                      (pg::wal-directory))))
         (setf (getf (gethash "archive_mode" settings) :value) "on")
         (dolist (bytes (list first later))
           (pg::wal-atomic-write-bytes path bytes)
           (let ((pg::*wal-end-lsn* (length bytes)))
             (unwind-protect
                  (pg::wal-open-output 1)
               (when pg::*wal-output-stream* (close pg::*wal-output-stream*))
               (setf pg::*wal-output-stream* nil pg::*wal-output-segment* nil)))
           (ok (= (length bytes)
                  (pg::wal-verify-archive-segment-proof
                   (pg::read-bounded-regular-file proof pg::+wal-archive-segment-proof-size+)
                   (pg::catalog-system-identifier) 1 0 :legacy bytes))))
         (delete-file proof)
         (sb-posix:mkdir (namestring proof) #o700)
         (let ((pg::*wal-end-lsn* (length later))
               (warned nil))
           (unwind-protect
                (handler-bind ((warning (lambda (condition)
                                          (setf warned t)
                                          (muffle-warning condition))))
                  (ok (streamp (pg::wal-open-output 1)))
                  (ok warned))
             (when pg::*wal-output-stream* (close pg::*wal-output-stream*))))))))

(deftest primary-archive-publishes-and-recycles-rotation-proof
    (call-with-physical-source-fixture
     (lambda ()
       (let* ((pg::*wal-ready* t)
              (pg::*wal-archive-primary-scan* (pg::make-wal-archive-scan))
              (pg::*wal-control-metadata* (list :db-state pg::+db-in-production+))
              (pg::*wal-insert-timeline* 1)
              (pg::*wal-segment-namespace* :legacy)
              (settings (pg::startup-configuration-settings pg::*startup-installed-configuration*))
              (segment (pg::wal-segment-path 0))
              (name (file-namestring segment))
              (proof-name (pg::wal-archive-segment-proof-name name))
              (proof (merge-pathnames proof-name (pg::wal-directory)))
              (destination (merge-pathnames proof-name pg::*pgdata*))
              (bytes (sample-physical-record)))
         (setf (getf (gethash "archive_mode" settings) :value) "on"
               (getf (gethash "archive_command" settings) :value) "cp -- \"%p\" \"%f\"")
         (pg::wal-atomic-write-bytes segment bytes)
         (pg::wal-record-primary-archive-rotation 0 (length bytes))
         (ok (pg::wal-archiver-step))
         (ok (equal (first (pg::wal-archive-scan-items pg::*wal-archive-primary-scan*))
                    (cons :proof 0)))
         (ok (not (probe-file destination)))
         (sb-thread:with-mutex (pg::*wal-lock*)
           (ok (not (pg::wal-archive-recycle-segment 0))))
         (handler-bind ((warning #'muffle-warning))
           (ok (pg::wal-archiver-step-primary
                "case \"%f\" in *.proof) exit 1;; esac; cp -- \"%p\" \"%f\"")))
         (ok (probe-file (merge-pathnames "0000000000000001.wal" pg::*pgdata*)))
         (ok (not (probe-file destination)))
         (let ((receipt (merge-pathnames (concatenate 'string "archive_status/" proof-name ".done")
                                         (pg::wal-directory))))
           (sb-posix:mkdir (namestring receipt) #o700)
           (handler-bind ((warning #'muffle-warning))
             (ok (pg::wal-archiver-step)))
           (ok (probe-file (merge-pathnames "0000000000000002.wal" pg::*pgdata*)))
           (sb-posix:rmdir (namestring receipt)))
         (ok (pg::wal-archiver-step-primary
              "case \"%f\" in *.proof) cp -- \"%p\" \"%f\";; *) exit 1;; esac"))
         (ok (= (length bytes)
                (pg::wal-verify-archive-segment-proof
                 (pg::read-bounded-regular-file destination pg::+wal-archive-segment-proof-size+)
                 (pg::catalog-system-identifier) 1 0 :legacy bytes)))
         (pg::wal-atomic-write-bytes
          segment (pg::wal-encode-record pg::+wal-record-maintenance+ 0 0 (empty-octets)))
         (ok (pg::wal-archive-attempt 0 "cp -- \"%p\" \"%f\""))
         (sb-thread:with-mutex (pg::*wal-lock*)
           (ok (not (pg::wal-archive-recycle-segment 0))))
         (pg::wal-atomic-write-bytes segment bytes)
         (ok (pg::wal-archive-attempt 0 "cp -- \"%p\" \"%f\""))
         (let* ((status (merge-pathnames "archive_status/" (pg::wal-directory)))
                (segment-done (merge-pathnames (concatenate 'string name ".done") status))
                (proof-done (merge-pathnames (concatenate 'string proof-name ".done") status))
                (other-done (merge-pathnames "0000000000000001.wal.done" status)))
           (ok (probe-file segment-done))
           (ok (probe-file proof-done))
           (ok (probe-file other-done))
           (sb-thread:with-mutex (pg::*wal-lock*)
             (ok (pg::wal-archive-recycle-segment 0)))
           (ok (not (probe-file segment-done)))
           (ok (not (probe-file proof-done)))
           (ok (probe-file other-done))
           ;; Recreate the marker residue left when recycling stops after unlink.
           (let ((partial-done (merge-pathnames "0000000000000000.wal.partial.done" status))
                 (future-ready (merge-pathnames "0000000000000010.wal.ready" status)))
             (dolist (marker (list segment-done proof-done partial-done future-ready))
               (pg::wal-atomic-write-bytes marker bytes))
             (pg::wal-archive-clean-retired-status)
             (ok (not (probe-file segment-done)))
             (ok (not (probe-file proof-done)))
             (ok (probe-file other-done))
             (ok (probe-file partial-done))
             (ok (probe-file future-ready)))
           ;; A stop after the data unlink can leave an already archived proof.
           (pg::wal-atomic-write-bytes proof bytes)
           (pg::wal-atomic-write-bytes proof-done bytes)
           (pg::wal-archive-clean-retired-status)
           (ok (probe-file proof))
           (let ((wal-fd (pg::wal-archive-open-wal-directory)))
             (unwind-protect
                  (let ((status-fd (pg::wal-archive-open-status-directory wal-fd)))
                    (unwind-protect
                         (pg::wal-archive-publish-done
                          status-fd proof-name (pg::physical-image-file-facts wal-fd proof-name))
                      (sb-posix:close status-fd)))
               (sb-posix:close wal-fd)))
           (pg::wal-archive-clean-retired-status)
           (ok (not (probe-file proof-done))))
         (ok (not (probe-file segment)))
         (ok (not (probe-file proof)))))))

(deftest primary-archive-drains-a-backlog-and-refreshes-its-scan
    (call-with-physical-source-fixture
     (lambda ()
       (let* ((count 96)
              (pg::*wal-ready* t)
              (pg::*wal-control-metadata* (list :db-state pg::+db-in-production+))
              (pg::*wal-insert-timeline* 1)
              (pg::*wal-segment-namespace* :legacy)
              (pg::*wal-durable-lsn* (* count pg::+wal-segment-size+))
              (pg::*wal-archive-primary-scan* (pg::make-wal-archive-scan))
              (settings (pg::startup-configuration-settings pg::*startup-installed-configuration*))
              (log (merge-pathnames "archive.log" pg::*pgdata*))
              (template "echo \"%f\" >> archive.log"))
         (setf (getf (gethash "archive_mode" settings) :value) "on")
         (loop for segment from 4 below count
               do (with-open-file (stream (pg::wal-segment-path segment)
                                          :direction :output :element-type '(unsigned-byte 8))
                    (write-byte 0 stream)))
         (ok (pg::wal-archiver-step-primary template))
         (let ((remaining (pg::wal-archive-scan-items pg::*wal-archive-primary-scan*)))
           (ok (pg::wal-archiver-step-primary template))
           (ok (eq (cddr remaining)
                   (pg::wal-archive-scan-items pg::*wal-archive-primary-scan*))))
         (with-open-file (stream (pg::wal-segment-path count) :direction :output
                                                              :element-type '(unsigned-byte 8))
           (write-byte 0 stream))
         (incf pg::*wal-durable-lsn* pg::+wal-segment-size+)
         (ok (loop repeat (1- count)
                   always (pg::wal-archiver-step-primary template)))
         (ok (not (pg::wal-archiver-step-primary template)))
         (with-open-file (stream log)
           (ok (equal (loop for line = (read-line stream nil)
                            while line collect line)
                      (loop for segment from 0 to count
                            collect (pg::wal-segment-filename segment 1 :legacy)))))))))

(deftest archive-restore-requires-matching-segment-proof
    (with-physical-store-directory (root)
      (let* ((name (pg::wal-segment-filename 0 2 :timeline))
             (proof-name (pg::wal-archive-segment-proof-name name))
             (archive (merge-pathnames "archive/" root))
             (segment-path (merge-pathnames name archive))
             (proof-path (merge-pathnames proof-name archive))
             (bytes (sample-physical-record))
             (end (length bytes))
             (template (format nil "cp -- '~a'\"%f\" \"%p\"" (namestring archive))))
        (pg::wal-ensure-directory-durable archive)
        (pg::wal-atomic-write-bytes segment-path bytes)
        (flet ((restore (leaf &optional (command template) partial)
                 (let ((stage (merge-pathnames leaf root)))
                   (sb-posix:mkdir (namestring stage) #o700)
                   (let ((fd (pg::physical-backup-open-directory stage)))
                     (unwind-protect
                          (pg::wal-restore-proved-segment command fd 17 2 0 :timeline :partial partial)
                       (sb-posix:close fd))))))
          (ok (null (restore "missing/")))
          (pg::wal-atomic-write-bytes proof-path
                                      (pg::wal-encode-archive-segment-proof 17 2 0 :timeline end bytes))
          (multiple-value-bind (restored restored-end) (restore "valid/")
            (ok (equalp restored bytes))
            (ok (eql restored-end end)))
          (let ((partial-name (concatenate 'string name ".partial")))
            (pg::wal-atomic-write-bytes (merge-pathnames partial-name archive) bytes)
            (ok (null (restore "partial-missing/" template t)))
            (pg::wal-atomic-write-bytes
             (merge-pathnames (pg::wal-archive-segment-proof-name partial-name) archive)
             (pg::wal-encode-archive-segment-proof 17 2 0 :timeline end bytes))
            (multiple-value-bind (restored restored-end) (restore "partial-valid/" template t)
              (ok (equalp restored bytes))
              (ok (eql restored-end end))))
          (pg::wal-atomic-write-bytes proof-path
                                      (pg::wal-encode-archive-segment-proof 18 2 0 :timeline end bytes))
          (ok (signals (restore "wrong-cluster/") 'error))
          (ok (signals (restore "unsafe-output/" "ln -s /dev/null \"%p\"") 'error))
          (ok (signals (restore "nonprivate-output/" "chmod 755 \"$(dirname \"%p\")\"") 'error))
          (ok (signals (restore "failed-shell/" "exit 127") 'error))))))

(deftest archive-proof-follows-wal-namespace-migration
    (call-with-physical-source-fixture
     (lambda ()
       (let* ((pg::*wal-insert-timeline* 1)
              (pg::*wal-segment-namespace* :legacy)
              (old (pg::wal-segment-path 0 1 :legacy))
              (new (pg::wal-segment-path 0 1 :timeline))
              (old-proof (pg::wal-namespace-proof-path old))
              (new-proof (pg::wal-namespace-proof-path new))
              (bytes (sample-physical-record))
              (end (length bytes))
              (id (pg::catalog-system-identifier)))
         (dolist (segment '(1 2 3))
           (delete-file (pg::wal-segment-path segment 1 :legacy)))
         (pg::wal-atomic-write-bytes old bytes)
         (pg::wal-atomic-write-bytes new-proof bytes)
         (sb-thread:with-mutex (pg::*wal-lock*)
           (ok (signals (pg::wal-namespace-stage-qualified-proof old new) 'error)))
         (delete-file new-proof)
         (pg::wal-record-primary-archive-rotation 0 end)
         (sb-posix:link (namestring old) (namestring new))
         (sb-thread:with-mutex (pg::*wal-lock*)
           (pg::wal-namespace-stage-qualified-proof old new))
         (ok (= end (pg::wal-verify-archive-segment-proof
                     (pg::read-bounded-regular-file new-proof pg::+wal-archive-segment-proof-size+)
                     id 1 0 :timeline bytes)))
         (pg::wal-reconcile-namespace-at-startup)
         (ok (and (probe-file old) (probe-file old-proof)))
         (ok (not (or (probe-file new) (probe-file new-proof))))
         (sb-posix:link (namestring old) (namestring new))
         (sb-thread:with-mutex (pg::*wal-lock*)
           (pg::wal-namespace-stage-qualified-proof old new))
         (let ((pg::*wal-segment-namespace* :timeline))
           (pg::wal-reconcile-namespace-at-startup))
         (ok (and (probe-file new) (probe-file new-proof)))
         (ok (not (or (probe-file old) (probe-file old-proof))))))))

(deftest primary-archive-ready-follows-control-and-fences-recycling
    (call-with-physical-source-fixture
     (lambda ()
       (let* ((directory (merge-pathnames "archive_status/" (pg::wal-directory)))
              (settings (pg::startup-configuration-settings pg::*startup-installed-configuration*))
              (ready (loop for segment below 4
                           collect (merge-pathnames
                                    (concatenate 'string
                                                 (file-namestring (pg::wal-segment-path segment))
                                                 ".ready")
                                    directory))))
         (setf (getf (gethash "archive_mode" settings) :value) "on")
         (pg::with-wal-critical
           (let ((pg::*wal-durable-lsn* (* 2 pg::+wal-segment-size+))
                 (pg::*wal-output-stream* t)
                 (pg::*wal-output-segment* 1))
             (pg::wal-archive-reconcile-ready-under-lock)
             (ok (probe-file (first ready)))
             (ok (null (some #'probe-file (rest ready)))))
           (let ((pg::*wal-durable-lsn* 0))
             (ok (not (pg::wal-archive-ready-segment-p 1))))
           (delete-file (first ready))
           (let ((pg::*wal-shutdown-defer-recycling* t))
             (pg::wal-remove-checkpointed-segments-under-wal-lock pg::*wal-checkpoint-lsn*))
           (ok (probe-file (first ready)))
           (pg::wal-archive-reconcile-ready-under-lock)
           (ok (every #'probe-file (subseq ready 0 3)))
           (ok (not (probe-file (fourth ready))))
           (with-open-file (stream (make-pathname :type "done" :defaults (first ready))
                                   :direction :output :if-does-not-exist :create)
             (write-line "unverified" stream))
           (pg::wal-remove-checkpointed-segments-under-wal-lock pg::*wal-checkpoint-lsn*)
           (ok (equal '(0 1 2 3) (pg::wal-discover-segments))))))))

(deftest primary-archive-command-requires-success-and-the-same-wal-file
    (call-with-physical-source-fixture
     (lambda ()
       (let* ((directory (merge-pathnames "archive_status/" (pg::wal-directory)))
              (settings (pg::startup-configuration-settings pg::*startup-installed-configuration*))
              (name (file-namestring (pg::wal-segment-path 0)))
              (done (merge-pathnames (concatenate 'string name ".done") directory))
              (changed (merge-pathnames
                        (concatenate 'string (file-namestring (pg::wal-segment-path 1)) ".done")
                        directory)))
         (setf (getf (gethash "archive_mode" settings) :value) "on")
         (pg::with-wal-critical (pg::wal-archive-reconcile-ready-under-lock))
         (ok (not (pg::wal-archive-attempt 0 "exit 42")))
         (ok (not (probe-file done)))
         (let ((sentinel (merge-pathnames "archive-sentinel" pg::*pgdata*)))
           (with-open-file (stream sentinel :direction :output)
             (write-line "kept" stream))
           (sb-posix:link
            (namestring sentinel)
            (namestring (merge-pathnames (concatenate 'string name ".done.tmp") directory)))
           (ok (pg::wal-archive-attempt 0 "cp -- \"%p\" \"copy-%f\""))
           (ok (string= "kept" (uiop:read-file-line sentinel))))
         (with-open-file (stream (merge-pathnames (concatenate 'string "copy-" name) pg::*pgdata*)
                                 :element-type '(unsigned-byte 8))
           (ok (eql 0 (read-byte stream)))
           (ok (eql :eof (read-byte stream nil :eof))))
         (ok (uiop:string-prefix-p (format nil "WAL-ARCHIVE ~a " name)
                                   (uiop:read-file-line done)))
         (ok (signals (pg::wal-archive-attempt
                       1 "mv -- \"pg_wal/%f\" moved-wal && cp -- moved-wal \"pg_wal/%f\"")
                      'error))
         (ok (not (probe-file changed)))))))

(deftest primary-archive-recycling-stops-at-the-first-unproved-segment
    (call-with-physical-source-fixture
     (lambda ()
       (let* ((settings (pg::startup-configuration-settings pg::*startup-installed-configuration*))
              (checkpoint (* 3 pg::+wal-segment-size+)))
         (setf (getf (gethash "archive_mode" settings) :value) "on")
         (pg::with-wal-critical (pg::wal-archive-reconcile-ready-under-lock))
         (ok (pg::wal-archive-attempt 1 "true"))
         (pg::with-wal-critical
           (pg::wal-remove-checkpointed-segments-under-wal-lock checkpoint))
         (ok (equal '(0 1 2 3) (pg::wal-discover-segments)))
         (ok (pg::wal-archive-attempt 0 "true"))
         (let* ((name (file-namestring (pg::wal-segment-path 0)))
                (marker (merge-pathnames (concatenate 'string "archive_status/" name ".done")
                                         (pg::wal-directory))))
           (sb-posix:chmod (namestring marker) #o666)
           (pg::with-wal-critical
             (pg::wal-remove-checkpointed-segments-under-wal-lock checkpoint))
           (ok (equal '(0 1 2 3) (pg::wal-discover-segments)))
           (sb-posix:chmod (namestring marker) #o600))
         (let ((path (pg::wal-segment-path 1)))
           (with-open-file (stream path :direction :io :if-exists :overwrite
                                        :element-type '(unsigned-byte 8))
             (write-byte 42 stream)
             (pg::fsync-stream stream)))
         (pg::with-wal-critical
           (pg::wal-remove-checkpointed-segments-under-wal-lock checkpoint))
         (ok (equal '(1 2 3) (pg::wal-discover-segments)))
         (ok (pg::wal-archive-attempt 1 "true"))
         (pg::with-wal-critical
           (pg::wal-remove-checkpointed-segments-under-wal-lock checkpoint))
         (ok (equal '(2 3) (pg::wal-discover-segments)))))))

(deftest primary-archiver-retries-and-skips-completed-segments
