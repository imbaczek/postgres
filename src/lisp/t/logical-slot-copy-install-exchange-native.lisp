(in-package #:pg)

(defvar *logical-install-exchange-test-result* nil)
(defvar *logical-install-exchange-test-thread* nil)

(defun logical-install-exchange-test-restore (root image)
  (let* ((value (logical-slot-copy-install-decode image))
         (pending (getf value :certificate))
         (active (logical-slot-copy-install-active-image (logical-slot-copy-import-decode pending)))
         (current (read-bounded-regular-file (slot-state-fd-path root "logical-slot-copy.import")
                                             +logical-slot-copy-import-maximum-bytes+ :stabilize nil)))
    (when (equalp current active)
      (let ((container (physical-image-openat root "logical-slot-copy.install"
                                              (logior sb-posix:o-rdonly sb-posix:o-directory
                                                      sb-posix:o-nofollow +postmaster-o-cloexec+) 0)))
        (assert (not (minusp container)))
        (unwind-protect
             (progn (assert (zerop (slot-state-renameat2 root "logical-slot-copy.import" container "active" 2)))
                    (sb-posix:fsync root) (sb-posix:fsync container))
          (sb-posix:close container))))
    (logical-install-rows-test-restore root image)))

(defun logical-install-exchange-test-run (mode)
  (let* ((cold (not *wal-ready*)) (before (logical-install-stage-test-fd-count))
                                  (root nil) (image nil) (saved nil) (receipt-saved nil) (auxiliary nil)
                                  (fired nil) (caught nil) (exchange-count 0) (sync-count 0) (target-synced nil)
                                  (events nil) (physical-cleanup nil) (syncs (make-hash-table :test #'eq)) (delivered nil) (owned-closes 0)
                                  (original-rename (symbol-function 'physical-adoption-renameat2))
                                  (original-sync (symbol-function 'sb-posix:fsync))
                                  (original-close (symbol-function 'sb-posix:close))
                                  (original-source (symbol-function 'logical-slot-copy-check-committed-source))
                                  (expected (cond ((member mode '(:without-receipt :bare-prefix)) "registered row receipt")
                                                  ((member mode '(:graft-pending :graft-active)) "recorded inode")
                                                  ((member mode '(:receipt-seal :receipt-cycle)) "row receipt changed")
                                                  ((eq mode :late-row) "row durability observations changed")
                                                  ((member mode '(:ctor-error :ctor-throw :caught)) "scope ended")
                                                  ((eq mode :throw) :nonlocal)
                                                  ((eq mode :source-cut) "exchange source cut")
                                                  ((eq mode :metadata-cut) "beyond rename ctime")
                                                  ((eq mode :close-cut) "exchange close cut")
                                                  ((eq mode :close-interrupt) "exchange close interrupt")
                                                  ((and (consp mode) (eq :cut (first mode))) "exchange event cut")
                                                  ((and (consp mode) (eq :fsync (first mode))) "exchange fsync cut"))))
    (labels ((capture (publisher)
               (unless root
                 (setf root (logical-install-journal-test-root publisher)
                       image (copy-seq (logical-slot-copy-install-publisher-image publisher)))))
             (point (event writer)
               (capture writer) (push event events) (setf saved writer)
               (assert (null *logical-slot-copy-install-inspection*))
               (when (eq event :after-exchange-final-proof)
                 (dolist (role '(:pending-file :active-file :root :container))
                   (assert (member role (gethash writer syncs)))))
               (logical-install-handoff-test-denied
                (lambda () (logical-slot-copy-install-check-exchange-writer
                            (copy-logical-slot-copy-install-exchange-writer writer))) "registered publisher")
               (when (and (consp mode) (member (first mode) '(:cut :kill)) (eq event (second mode)))
                 (setf fired t)
                 (if (eq :kill (first mode))
                     (progn (format t "~&LOGICAL-INSTALL-EXCHANGE-KILL ~s~%" event) (finish-output)
                            (sb-posix:kill (sb-posix:getpid) sb-posix:sigkill) (error "exchange kill returned"))
                     (error "exchange event cut")))
               (when (and (eq event :after-exchange) (member mode '(:caught :throw)))
                 (setf fired t)
                 (if (eq mode :throw) (throw 'exchange-exit :escaped) (error "exchange caught cut")))
               (when (and (eq event :before-exchange) (eq mode :source-cut))
                 (setf (symbol-function 'logical-slot-copy-check-committed-source)
                       (lambda (&rest args) (declare (ignore args)) (setf fired t) (error "exchange source cut")))))
             (journal-point (event publisher)
               (capture publisher)
               (when (logical-slot-copy-install-exchange-writer-p publisher) (point event publisher)))
             (pipeline (owner context input)
               (logical-slot-copy-install-publish-journal owner context input)
               (when (member mode '(:ctor-error :ctor-throw))
                 (setf fired t)
                 (catch 'constructor-exit
                   (handler-case
                       (call-with-logical-slot-copy-install-publisher
                        owner context input (lambda (writer) (declare (ignore writer)) (error "constructor callback ran"))
                        :constructor (lambda (&rest args) (declare (ignore args))
                                       (if (eq mode :ctor-throw) (throw 'constructor-exit :escaped)
                                           (error "constructor cut"))))
                     (error (condition) (assert (search "constructor cut" (princ-to-string condition))))))
                 (logical-slot-copy-install-check-input owner context input))
               (when (eq mode :bare-prefix)
                 (logical-install-rows-test-parents
                  root (getf (logical-slot-copy-install-decode image) :stage-id)
                  (lambda (slots container)
                    (dolist (row (getf (logical-slot-copy-install-decode image) :entries))
                      (assert (zerop (slot-state-renameat2 container (first row) slots (first row) 1))))))
                 (setf fired t)
                 (logical-slot-copy-install-exchange-certificate owner context input (%make-logical-slot-copy-install-row-receipt)))
               (multiple-value-bind (count receipt) (logical-slot-copy-install-rows owner context input)
                 (assert (= 2 count)) (setf receipt-saved (list owner context input receipt))
                 (logical-install-handoff-test-denied
                  (lambda () (logical-slot-copy-install-check-row-receipt
                              owner context input (copy-logical-slot-copy-install-row-receipt receipt))) "registered row receipt")
                 (let ((answer nil))
                   (sb-thread:join-thread
                    (sb-thread:make-thread
                     (lambda () (setf answer (handler-case
                                                 (progn (logical-slot-copy-install-check-row-receipt owner context input receipt) nil)
                                               (error () t))))))
                   (assert answer))
                 (when (member mode '(:graft-pending :graft-active))
                   (let* ((work (physical-image-openat root "logical-slot-copy.work"
                                                       (logior sb-posix:o-rdonly sb-posix:o-directory sb-posix:o-nofollow +postmaster-o-cloexec+) 0))
                          (container (physical-image-openat root "logical-slot-copy.install"
                                                            (logior sb-posix:o-rdonly sb-posix:o-directory sb-posix:o-nofollow +postmaster-o-cloexec+) 0))
                          (parent (if (eq mode :graft-pending) root container))
                          (name (if (eq mode :graft-pending) "logical-slot-copy.import" "active"))
                          (bytes (read-bounded-regular-file (slot-state-fd-path parent name)
                                                            +logical-slot-copy-import-maximum-bytes+ :stabilize nil)))
                     (assert (and (not (minusp work)) (not (minusp container))))
                     (push (lambda ()
                             (sb-posix:unlink (namestring (slot-state-fd-path parent name)))
                             (assert (zerop (slot-state-renameat2 work "graft-saved" parent name 1)))
                             (sb-posix:fsync parent) (sb-posix:fsync work)
                             (sb-posix:close container) (sb-posix:close work)) auxiliary)
                     (assert (zerop (slot-state-renameat2 parent name work "graft-saved" 1)))
                     (with-open-file (out (slot-state-fd-path parent name) :direction :output :if-exists :error
                                                                           :element-type '(unsigned-byte 8))
                       (write-sequence bytes out) (fsync-stream out))
                     (sb-posix:chmod (namestring (slot-state-fd-path parent name)) #o600)
                     (setf fired t)))
                 (case mode
                   (:without-receipt (setf fired t) (setf receipt (%make-logical-slot-copy-install-row-receipt)))
                   (:receipt-seal
                    (let* ((bytes (logical-slot-copy-install-row-receipt-image receipt)) (old (aref bytes 0)))
                      (push (lambda () (setf (aref bytes 0) old)) auxiliary)
                      (setf (aref bytes 0) (logxor old 1) fired t)))
                   (:receipt-cycle
                    (let* ((facts (logical-slot-copy-install-row-receipt-facts receipt)) (tail (cdr facts)))
                      (push (lambda () (setf (cdr facts) tail)) auxiliary)
                      (setf (cdr facts) facts fired t)))
                   (:late-row
                    (let ((path (namestring (slot-state-fd-path root "pg_replslot/alpha/state"))))
                      (sb-posix:chmod path #o400) (sb-posix:chmod path #o600) (setf fired t))))
                 (if (eq mode :caught)
                     (progn
                       (handler-case (logical-slot-copy-install-exchange-certificate owner context input receipt)
                         (error (condition) (assert (search "exchange caught cut" (princ-to-string condition)))))
                       (logical-slot-copy-install-check-input owner context input))
                     (logical-slot-copy-install-exchange-certificate owner context input receipt)))))
      (unwind-protect
           (let ((*logical-slot-copy-install-publication-test-hook* #'journal-point)
                 (*logical-slot-copy-install-exchange-test-hook* #'point))
             (when (eq mode :physical) (setf physical-cleanup (logical-install-input-test-physical :physical)))
             (setf (symbol-function 'physical-adoption-renameat2)
                   (lambda (from name to target flags)
                     (prog1 (funcall original-rename from name to target flags)
                       (when (= flags +logical-slot-copy-install-exchange+)
                         (incf exchange-count)
                         (when (eq mode :metadata-cut)
                           (setf fired t)
                           (sb-posix:utime (namestring (slot-state-fd-path root "logical-slot-copy.import")) 1 1))))))
             (setf (symbol-function 'sb-posix:fsync)
                   (lambda (fd)
                     (let* ((writer (first *logical-slot-copy-install-publishers*))
                            (writer (when (logical-slot-copy-install-exchange-writer-p writer) writer))
                            (target (and writer (= fd (logical-slot-copy-install-node-fd
                                                       (logical-slot-copy-install-publisher-root writer)))))
                            (container (when writer (logical-slot-copy-install-publisher-container writer))))
                       (when (and container (= fd (logical-slot-copy-install-node-fd container)))
                         (assert (eq writer target-synced)))
                       (when (and writer (consp mode) (eq :fsync (first mode)))
                         (incf sync-count)
                         (when (= sync-count (second mode)) (setf fired t) (error "exchange fsync cut")))
                       (prog1 (funcall original-sync fd)
                         (when writer
                           (let* ((facts (physical-image-file-facts fd))
                                  (id (subseq (logical-slot-copy-install-file-identity facts) 0 2))
                                  (value (logical-slot-copy-install-decode (logical-slot-copy-install-publisher-image writer))))
                             (dolist (key '(:pending-file :active-file))
                               (when (equal id (subseq (getf value key) 0 2))
                                 (pushnew key (gethash writer syncs)))))
                           (when target (setf target-synced writer) (pushnew :root (gethash writer syncs)))
                           (when (and container (= fd (logical-slot-copy-install-node-fd container)))
                             (pushnew :container (gethash writer syncs))))))))
             (when (member mode '(:close-cut :close-interrupt))
               (setf (symbol-function 'sb-posix:close)
                     (lambda (fd)
                       (let* ((writer (first *logical-slot-copy-install-publishers*))
                              (owned (and (logical-slot-copy-install-exchange-writer-p writer)
                                          (find fd (logical-slot-copy-install-publisher-nodes writer)
                                                :key #'logical-slot-copy-install-node-fd))))
                         (when owned
                           (incf owned-closes)
                           (unless fired
                             (setf fired t)
                             (when (eq mode :close-interrupt)
                               (sb-thread:interrupt-thread sb-thread:*current-thread*
                                                           (lambda () (setf delivered t)
                                                             (assert (= 4 owned-closes))
                                                             (error "exchange close interrupt"))))))
                         (prog1 (funcall original-close fd)
                           (when (and owned (eq mode :close-cut)) (error "exchange close cut")))))))
             (handler-case
                 (let ((result (catch 'exchange-exit
                                 (cond
                                   ((eq mode :absent) (assert cold) (assert (null (logical-slot-copy-install-resume-active))))
                                   ((eq mode :orphan)
                                    (assert cold)
                                    (call-with-logical-slot-copy-install-handoff
                                     (lambda (operation handoff) (declare (ignore operation handoff))))
                                    (assert (null (logical-slot-copy-install-resume-active))))
                                   ((member mode '(:resume-pending :resume-active))
                                    (assert cold)
                                    (if (eq mode :resume-pending) (logical-slot-copy-install-fresh-rows)
                                        (logical-slot-copy-install-fresh-active))
                                    (setf exchange-count 0)
                                    (assert (eq :active (logical-slot-copy-install-resume-active)))
                                    (assert (= exchange-count (if (eq mode :resume-active) 0 1)))
                                    (when (eq mode :resume-active)
                                      (assert (eq :active (logical-slot-copy-install-resume-active)))
                                      (assert (zerop exchange-count))))
                                   ((eq mode :active-denied)
                                    (assert cold) (logical-slot-copy-install-fresh-active)
                                    (setf exchange-count 0)
                                    (call-with-logical-slot-copy-install-cold-input
                                     (lambda (owner context input)
                                       (logical-slot-copy-install-publish-journal owner context input)
                                       (multiple-value-bind (count receipt) (logical-slot-copy-install-rows owner context input :phase :active)
                                         (assert (= 2 count))
                                         (call-with-logical-slot-copy-install-publisher
                                          owner context input
                                          (lambda (writer)
                                            (logical-slot-copy-install-exchange-bind writer)
                                            (logical-install-handoff-test-denied
                                             (lambda () (logical-slot-copy-install-exchange-rename writer)) "requires pending phase")
                                            (assert (eq :available (logical-slot-copy-install-input-state-row-receipt-state
                                                                    (logical-slot-copy-install-input-record owner context input)))))
                                          :constructor (lambda (&rest args)
                                                         (apply #'%make-logical-slot-copy-install-exchange-writer
                                                                :receipt receipt :expected-phase :active args)))
                                         (assert (eq :active (logical-slot-copy-install-exchange-certificate owner context input receipt))))))
                                    (assert (zerop exchange-count)))
                                   ((eq mode :recover) (assert cold) (assert (eq :active (logical-slot-copy-install-resume-active))))
                                   ((member mode '(:fresh :physical)) (assert (eq :active (logical-slot-copy-install-fresh-active))))
                                   (t (assert (eq :active (call-with-logical-slot-copy-install-fresh-input #'pipeline))))))))
                   (when (eq result :escaped) (assert (eq mode :throw)) (setf caught t)))
               (error (condition)
                 (assert (and (stringp expected) (search expected (princ-to-string condition)))
                         () "unexpected exchange test failure ~s: ~a" mode condition)
                 (setf caught t)))
             (when (member mode '(:without-receipt :bare-prefix :receipt-seal :receipt-cycle :late-row
                                  :graft-pending :graft-active :ctor-error :ctor-throw :source-cut))
               (assert (zerop exchange-count)))
             (when (member mode '(:fresh :physical)) (assert (= 1 exchange-count)))
             (when expected (assert fired) (assert caught))
             (when (eq mode :close-interrupt) (assert delivered))
             (assert (eq caught (not (null *physical-recovery-failed-p*))))
             (when (and cold (not expected) (not (member mode '(:absent :orphan))))
               (dolist (function (list #'logical-slot-copy-preflight-startup #'logical-slot-copy-check-promotion))
                 (logical-install-handoff-test-denied function "child-owner import")))
             (when saved
               (logical-install-handoff-test-denied
                (lambda () (logical-slot-copy-install-check-exchange-writer saved)) "registered publisher"))
             (when receipt-saved
               (assert (handler-case (progn (apply #'logical-slot-copy-install-check-row-receipt receipt-saved) nil) (error () t)))))
        (setf (symbol-function 'physical-adoption-renameat2) original-rename
              (symbol-function 'sb-posix:fsync) original-sync
              (symbol-function 'sb-posix:close) original-close
              (symbol-function 'logical-slot-copy-check-committed-source) original-source)
        (dolist (action auxiliary) (funcall action))
        (when root (unwind-protect (logical-install-exchange-test-restore root image) (sb-posix:close root)))
        (when physical-cleanup (funcall physical-cleanup)))
      (assert (eq (not (null expected)) caught))
      (when cold (assert (logical-install-handoff-test-unopened-p))
            (assert (= before (logical-install-stage-test-fd-count))))))
  (format t "~&LOGICAL-INSTALL-EXCHANGE-PASS ~s~%" mode) (finish-output))

(defun logical-install-exchange-test-start (mode)
  (setf *logical-install-exchange-test-result* :running
        *logical-install-exchange-test-thread*
        (sb-thread:make-thread
         (lambda ()
           (handler-case (progn (logical-install-exchange-test-run mode) (setf *logical-install-exchange-test-result* :passed))
             (error (condition) (setf *logical-install-exchange-test-result* (list :error (princ-to-string condition))))))
         :name "owned active certificate exchange")))
