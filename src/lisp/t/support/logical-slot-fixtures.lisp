(in-package #:pg)

(defun dispose-page-publication-test-owner (owner)
  (when owner
    (flet ((dispose ()
             (assert (eq owner *wal-pending-page-publication*))
             (loop while *wal-pending-page-publication*
                   for current = *wal-pending-page-publication*
                   do (wal-close-primary-page-spool (wal-page-publication-spool current))
                      (let ((stores nil))
                        (maphash (lambda (key reference)
                                   (when (wal-dirty-reference-p reference)
                                     (pushnew (wal-dirty-reference-store reference) stores))
                                   (wal-dirty-release-reference reference)
                                   (remhash key (wal-page-publication-pages current))
                                   (remhash key (wal-page-publication-contributors current)))
                                 (wal-page-publication-pages current))
                        (dolist (store stores)
                          (let ((*wal-dirty-store* store)) (wal-dirty-close-empty-store))))
                      (setf *wal-pending-page-publication* (wal-page-publication-next current)
                            (wal-page-publication-next current) nil
                            (wal-page-publication-state current) :released))
             (setf *wal-pending-page-publication-tail* nil)))
      (if (sb-thread:holding-mutex-p *wal-lock*)
          (dispose)
          (sb-thread:with-mutex (*wal-lock*) (dispose)))))
  (values))

(defun clear-wal-test-page-cache ()
  (sb-thread:with-mutex (*wal-lock*) (wal-clear-page-cache)))

(defun wal-test-read-dirty-reference (key reference)
  (sb-thread:with-mutex (*wal-lock*) (wal-dirty-read-reference key reference)))

(defun call-with-page-publication-test (function &key (resident-limit 0))
  (let* ((*pgdata* (merge-pathnames
                    (format nil "pg-page-owner-~d-~d/" (sb-posix:getpid) (random 1000000))
                    (uiop:temporary-directory)))
         (*clog-stream* nil) (*clog-pending-commits* (make-hash-table :test #'eql))
         (*query-temp-directory* *pgdata*) (*query-temp-file-limit-bytes* 0)
         (*logical-capture-memory-bytes* 0)
         (*relation-streams* (make-hash-table :test #'equal))
         (*wal-dirty-store* nil) (*wal-dirty-resident-limit-pages* resident-limit)
         (*wal-page-cache* (make-hash-table :test #'equal))
         (*wal-page-cache-xids* (make-hash-table :test #'equal))
         (*wal-page-batch* nil) (*wal-page-batch-xids* nil) (*wal-page-batch-split* nil)
         (*wal-pending-btree-split* nil) (*wal-pending-page-publication* nil)
         (*wal-pending-page-publication-tail* nil)
         (*wal-storage-incarnation* (gensym "TEST-PAGE-STORE-"))
         (*wal-logical-policy* nil) (*logical-capture-force* nil)
         (*wal-logical-info* nil) (*wal-logical-info-disable-pending* nil)
         (*wal-logical-info-activations* (make-hash-table :test #'eq))
         (*wal-temp-cleanup-domain* nil)
         (*wal-insert-timeline* 1) (*wal-ready* t) (*wal-poisoned* nil)
         (*physical-recovery-failed-p* nil)
         (*wal-end-lsn* 200) (*wal-durable-lsn* 100)
         (*backend* (make-backend :xid 44)))
    (ensure-directories-exist (merge-pathnames "base/" *pgdata*))
    (unwind-protect
         (funcall function)
      (dispose-page-publication-test-owner *wal-pending-page-publication*)
      (sb-thread:with-mutex (*wal-lock*) (wal-clear-page-cache))
      (smgr-close-all)
      (when *clog-stream* (close *clog-stream*))
      (uiop:delete-directory-tree *pgdata* :validate t :if-does-not-exist :ignore))))

(defun call-with-queued-clog-test (function)
  (call-with-page-publication-test
   (lambda ()
     (let ((*clog-stream* nil) (*clog-pending-commits* (make-hash-table :test #'eql))
                               (*wal-output-stream* nil) (*wal-output-segment* nil) (*wal-new-segments* nil)
                               (*wal-end-lsn* 0) (*wal-durable-lsn* 0) (*wal-checkpoint-lsn* 0)
                               (*wal-control-metadata* nil) (*wal-replication-slots* (make-hash-table :test #'equal))
                               (*wal-xid-first-lsn* (make-hash-table :test #'eql))
                               (*active-xids* nil) (*next-xid* 100) (*xid-batch-end* 100))
       (ensure-directories-exist (wal-directory))
       (unwind-protect
            (progn (clog-init) (funcall function))
         (when *wal-output-stream* (close *wal-output-stream*))
         (when *clog-stream* (close *clog-stream*)))))))
(defun call-with-primary-writer-authority-test (function &key (isolate t))
  (let* ((*wal-lock* (if isolate (sb-thread:make-mutex :name "writer authority test WAL")
                         *wal-lock*))
         (*wal-temp-cleanup-domain* (unless isolate *wal-temp-cleanup-domain*))
         (*primary-wal-writer-lock* (sb-thread:make-mutex :name "writer authority test state"))
         (*primary-wal-writer-generation* 7)
         (*wal-storage-incarnation* (if isolate (gensym "WRITER-TEST-STORE-")
                                        *wal-storage-incarnation*))
         (*wal-insert-timeline* (if isolate 3 *wal-insert-timeline*))
         (*wal-logical-policy* (unless isolate *wal-logical-policy*))
         (*wal-logical-info* (unless isolate *wal-logical-info*))
         (*wal-logical-info-disable-pending* (unless isolate *wal-logical-info-disable-pending*))
         (*wal-logical-info-activations* (if isolate (make-hash-table :test #'eq)
                                             *wal-logical-info-activations*))
         (*logical-capture-force* (unless isolate *logical-capture-force*))
         (*postmaster-data-lock* (list :owned-directory))
         (*physical-recovery-state* nil)
         (*wal-ready* t)
         (*wal-poisoned* nil)
         (*wal-end-lsn* (if isolate 0 *wal-end-lsn*))
         (*wal-durable-lsn* (if isolate 0 *wal-durable-lsn*))
         (*wal-pending-page-publication* (unless isolate *wal-pending-page-publication*))
         (*clog-pending-commits* (if isolate (make-hash-table :test #'eql)
                                     *clog-pending-commits*))
         (*wal-control-metadata* (make-wal-control-metadata 1 +db-in-production+))
         (*wal-pending-page-publication-tail* nil)
         (*primary-wal-writer*
           (%make-primary-wal-writer
            7 (make-wal-writer-epoch *wal-storage-incarnation* *wal-insert-timeline*
                                     *postmaster-data-lock*)
            *standard-output* *error-output*))
         (owned (symbol-function 'postmaster-pid-owned-p)))
    (setf (primary-wal-writer-thread *primary-wal-writer*) sb-thread:*current-thread*
          (primary-wal-writer-state *primary-wal-writer*) :running)
    (unwind-protect
         (progn
           (setf (symbol-function 'postmaster-pid-owned-p) (lambda () t))
           (funcall function *primary-wal-writer*))
      (setf (symbol-function 'postmaster-pid-owned-p) owned))))
(defun call-with-writer-clog-reset-test (function)
  (call-with-queued-clog-test
   (lambda ()
     (call-with-primary-writer-authority-test
      (lambda (writer)
        (let ((log-reset (symbol-function 'wal-log-clog-reset-under-lock)))
          (unwind-protect
               (progn
                 (setf (symbol-function 'wal-log-clog-reset-under-lock) #'values)
                 (funcall function writer))
            (setf (symbol-function 'wal-log-clog-reset-under-lock) log-reset))))
      :isolate nil))))
(defun call-with-logical-policy-test (function)
  (let ((*wal-logical-policy* nil) (*logical-capture-force* nil)
                                   (*wal-level* :replica) (*wal-logical-policy-test-hook* nil)
                                   (*logical-capture-live-slots* 0)
                                   (*logical-capture-arming* (make-hash-table :test #'eq))
                                   (*logical-capture-xid-modes* (make-hash-table :test #'eql)))
    (call-with-writer-clog-reset-test
     (lambda (writer)
       (let ((*backend* nil))
         (sb-thread:with-mutex (*wal-lock*)
           (wal-logical-info-publish-under-lock nil :rebase t))
         (funcall function writer))))))
(defun call-with-logical-slot-creation-test (function)
  (call-with-logical-policy-test
   (lambda (writer)
     (declare (ignore writer))
     (let ((*catalog* nil)
           (*catalog-identity-needs-persist-p* nil)
           (*catalog-oldest-relfrozenxid* nil)
           (*catalog-durable-generation* 0)
           (*catalog-logical-event-publication-p* nil)
           (*wal-control-metadata* nil)
           (*wal-replication-slots* (make-hash-table :test #'equal))
           (*wal-snapshot-retention-pins* (make-hash-table :test #'eq))
           (*wal-logical-catalog-event-interests* (make-hash-table :test #'eq))
           (*active-snapshots* 0)
           (*active-snapshot-set* (make-hash-table :test #'eq))
           (*backend* (make-backend)))
       (ensure-directories-exist (catalog-path))
       (catalog-init)
       (wal-ensure-directory-durable (wal-replication-slot-directory))
       (unwind-protect
            (funcall function)
         (end-backend-session))))))

(defun call-with-logical-slot-real-startup-test (function)
  (call-with-queued-clog-test
   (lambda ()
     (let ((*wal-ready* nil) (*wal-dirty-resident-limit-pages* 512)
                             (*query-temp-file-limit-bytes* nil) (*logical-capture-memory-bytes* (* 1024 1024))
                             (*wal-fpw-state* nil) (*wal-control-metadata* nil)
                             (*wal-insert-timeline* 1) (*wal-checkpoint-timeline* 1)
                             (*wal-segment-namespace* :legacy) (*wal-prev-timeline* 1)
                             (*wal-checkpoint-snapshot* nil) (*wal-xid-reserved-through* nil)
                             (*catalog* nil) (*catalog-identity-needs-persist-p* nil)
                             (*catalog-oldest-relfrozenxid* nil) (*catalog-durable-generation* 0)
                             (*catalog-logical-event-publication-p* nil)
                             (*wal-level* :logical) (*backend* nil)
                             (*startup-installed-configuration* nil) (*physical-follow-desired* nil)
                             (*active-xids* nil) (*next-xid* 3) (*xid-batch-end* 3)
                             (*active-snapshots* 0) (*active-snapshot-set* (make-hash-table :test #'eq))
                             (*recovery-reader-xids* (make-hash-table :test #'eql))
                             (*backend-registry* (make-hash-table :test #'eql)) (*n-backends* 0)
                             (*shutdown-abandoned-backends* nil)
                             (*xid-wrap-pending* nil) (*xid-wrap-failure* nil) (*xid-wrap-completed-through* nil)
                             (*postmaster-data-lock* nil) (*postmaster-pid-stream* nil)
                             (*postmaster-pid-directory* nil) (*postmaster-pid-inode* nil)
                             (*postmaster-start-time* nil) (*postmaster-start-timestamp* nil)
                             (*postmaster-pid-host* nil) (*postmaster-pid-port* nil)
                             (*physical-recovery-state* nil) (*physical-recovery-failed-p* nil)
                             (*physical-receive-store* nil) (*physical-follow-runtime* nil)
                             (*physical-restartpoint-worker* nil) (*primary-wal-writer* nil)
                             (*logical-capture-live-slots* 0) (*logical-capture-arming* (make-hash-table :test #'eq))
                             (*logical-capture-xid-modes* (make-hash-table :test #'eql))
                             (*pm-requested-mode* +no-shutdown+) (*accept-stop-requested* nil)
                             (*shutdown-finalizing-p* nil) (*shutdown-finished* nil)
                             (saved-exit-hooks sb-ext:*exit-hooks*))
       (unwind-protect
            (progn
              (let ((settings (startup-default-settings (namestring *pgdata*))))
                (setf (getf (gethash "wal_level" settings) :value) "logical"
                      *startup-installed-configuration*
                      (startup-prepare-installation settings (make-hash-table :test #'equal)
                                                    (make-hash-table :test #'equal) nil)))
              (sb-posix:chmod (namestring *pgdata*) #o700)
              (postmaster-own-data-directory "127.0.0.1" 5439)
              (when *clog-stream* (close *clog-stream*) (setf *clog-stream* nil))
              (initialize-primary-storage)
              (setf *wal-control-metadata*
                    (make-wal-control-metadata (catalog-system-identifier) +db-in-crash-recovery+))
              (wal-save-control-fields *wal-checkpoint-lsn* *wal-durable-lsn*)
              (let ((*backend* (make-backend)))
                (register-backend *backend*)
                (unwind-protect (funcall function)
                  (unwind-protect (end-backend-session) (unregister-backend *backend*)))))
         (postmaster-remove-pid-file)
         (when *postmaster-data-lock* (close *postmaster-data-lock*))
         (setf sb-ext:*exit-hooks* saved-exit-hooks))))))

(defun call-with-logical-slot-owned-startup-test (function)
  (call-with-live-operation-startup-quiescence
   (lambda (gate-owner)
     (call-with-postmaster-ownership
      (lambda (ownership) (funcall function gate-owner ownership))))))
