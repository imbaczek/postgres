(in-package #:pg)

(defun logical-source-proof-test-publication-syscall (mode)
  (declare (notinline sb-posix:close))
  (let* ((symbols '(physical-image-openat sb-posix:write sb-posix:fsync
                    physical-adoption-renameat2 sb-posix:close))
         (saved (mapcar (lambda (symbol) (cons symbol (symbol-function symbol))) symbols))
         (open-function (cdr (assoc 'physical-image-openat saved)))
         (write-function (cdr (assoc 'sb-posix:write saved)))
         (sync-function (cdr (assoc 'sb-posix:fsync saved)))
         (rename-function (cdr (assoc 'physical-adoption-renameat2 saved)))
         (close-function (cdr (assoc 'sb-posix:close saved)))
         (marker (make-condition 'simple-error :format-control "source proof syscall fault"))
         (body-marker (make-condition 'simple-error :format-control "source proof body fault"))
         (root (string-right-trim "/" (namestring *pgdata*)))
         (witness-directory
           (uiop:ensure-directory-pathname
            (sb-posix:mkdtemp
             (namestring (merge-pathnames "source-proof-witness-XXXXXX" (uiop:temporary-directory))))))
         (armed nil) (calls 0) (failure nil) (reused nil) (outer-root nil))
    (unwind-protect
         (with-open-file (witness (merge-pathnames "witness" witness-directory)
                                  :direction :io :if-exists :error :if-does-not-exist :create
                                  :element-type '(unsigned-byte 8))
           (write-sequence #(7 8 9) witness)
           (finish-output witness)
           (let ((outside (sb-sys:fd-stream-fd witness))
                 (before (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t))))
             (labels
                 ((target (fd) (ignore-errors (sb-posix:readlink (format nil "/proc/self/fd/~d" fd))))
                  (temporary-p (fd)
                    (let ((path (target fd))) (and path (search "logical-slot-copy.source-proof.tmp" path))))
                  (canonical-p (fd)
                    (let ((path (target fd)))
                      (and path (search "logical-slot-copy.source-proof" path)
                           (not (search "logical-slot-copy.source-proof.tmp" path)))))
                  (fault () (incf calls) (setf armed nil) (error marker))
                  (replace-fd (fd)
                    (incf calls)
                    (setf armed nil)
                    (funcall close-function fd)
                    (sb-posix:dup2 outside fd)
                    (setf reused fd))
                  (hook (point)
                    (when (eq point
                              (ecase mode
                                (:open :after-source-proof-seal)
                                ((:write :reuse-before-write) :after-source-proof-temp-create)
                                ((:temp-sync :reuse-after-write) :after-source-proof-temp-write)
                                ((:temp-close :body-close) :after-source-proof-temp-sync)
                                ((:rename :rename-exists) :before-source-proof-install)
                                (:installed-sync :after-source-proof-install)
                                (:directory-sync :after-source-proof-file-sync)
                                (:canonical-close :after-source-proof-root-sync)
                                ((:reader-proof-close :reader-archive-close :outer-root-close)
                                 :after-source-proof-publication-close)))
                      (setf armed t)
                      (when (eq mode :outer-root-close)
                        (setf outer-root
                              (physical-image-context-root-fd
                               (logical-slot-copy-source-proof-preparation-context
                                (first (first *logical-slot-copy-source-proof-preparations*))))))
                      (when (member mode '(:reuse-before-write :reuse-after-write))
                        (let ((fd (loop for name in (directory-entry-names "/proc/self/fd/" :follow-symlinks t)
                                        for number = (ignore-errors (parse-integer name))
                                        when (and number (temporary-p number)) return number)))
                          (assert fd)
                          (replace-fd fd)))
                      (when (eq mode :body-close) (error body-marker)))))
               (unwind-protect
                    (progn
                      (setf
                       (symbol-function 'physical-image-openat)
                       (lambda (parent name flags permissions)
                         (when (and armed (eq mode :open) (equal name "logical-slot-copy.source-proof.tmp")
                                    (logtest flags sb-posix:o-creat)) (fault))
                         (funcall open-function parent name flags permissions))
                       (symbol-function 'sb-posix:write)
                       (lambda (fd buffer size)
                         (when (and armed (eq mode :write) (temporary-p fd)) (fault))
                         (funcall write-function fd buffer size))
                       (symbol-function 'sb-posix:fsync)
                       (lambda (fd)
                         (when (and armed
                                    (case mode
                                      (:temp-sync (temporary-p fd))
                                      (:installed-sync (canonical-p fd))
                                      (:directory-sync (equal root (target fd)))))
                           (fault))
                         (funcall sync-function fd))
                       (symbol-function 'physical-adoption-renameat2)
                       (lambda (from-directory from to-directory to flags)
                         (when (and armed (member mode '(:rename :rename-exists))
                                    (equal from "logical-slot-copy.source-proof.tmp")
                                    (equal to "logical-slot-copy.source-proof"))
                           (assert (= flags +physical-adoption-rename-noreplace+))
                           (if (eq mode :rename)
                               (fault)
                               (progn
                                 (incf calls) (setf armed nil)
                                 (with-open-file (out (slot-state-fd-path to-directory to)
                                                      :direction :output :if-exists :error
                                                      :element-type '(unsigned-byte 8))
                                   (sb-posix:fchmod (sb-sys:fd-stream-fd out) #o600)
                                   (write-sequence #(70 79 82 69 73 71 78) out)))))
                         (funcall rename-function from-directory from to-directory to flags))
                       (symbol-function 'sb-posix:close)
                       (lambda (fd)
                         (if (and armed
                                  (case mode
                                    ((:temp-close :body-close) (temporary-p fd))
                                    ((:canonical-close :reader-proof-close) (canonical-p fd))
                                    (:reader-archive-close
                                     (let ((path (target fd)))
                                       (and path (uiop:string-suffix-p path "/pg_physical_retained"))))
                                    (:outer-root-close (eql fd outer-root))))
                             (progn (replace-fd fd) (error marker))
                             (funcall close-function fd))))
                      (let ((*logical-slot-copy-source-proof-publication-test-hook* #'hook))
                        (handler-case (logical-slot-copy-publish-source-proof)
                          (error (condition) (setf failure condition)))))
                 (dolist (row saved) (setf (symbol-function (car row)) (cdr row))))
               (assert (= calls 1))
               (assert failure)
               (unless (member mode '(:reuse-before-write :reuse-after-write :rename-exists))
                 (assert (eq failure (if (eq mode :body-close) body-marker marker))))
               (assert *physical-recovery-failed-p*)
               (when reused
                 (assert (equal (physical-image-file-facts outside) (physical-image-file-facts reused)))
                 (assert (= 3 (sb-posix:stat-size (sb-posix:fstat reused))))
                 (funcall close-function reused))
               (assert (= before (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t))))
               (assert (and (null *physical-recovery-state*) (null *physical-receive-store*)
                            (null *catalog*) (null *clog-stream*) (null *wal-output-stream*) (not *wal-ready*)))
               (format t "~&SOURCE-PROOF-SYSCALL-PASS mode=~s calls=~d reused=~s~%"
                       mode calls (not (null reused))))))
      (uiop:delete-directory-tree witness-directory :validate t :if-does-not-exist :ignore))))

(defun logical-source-proof-test-publication-mount (kind)
  (let ((before (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t)))
        (mounted nil) (target nil) (injected nil) (failure nil))
    (labels ((command (program arguments)
               (let ((process (sb-ext:run-program "/usr/bin/sudo"
                                                  (append (list "-n" program) arguments)
                                                  :search nil :wait t :input nil :output nil :error nil)))
                 (unwind-protect
                      (unless (zerop (sb-ext:process-exit-code process))
                        (error "owned publication mount command failed: ~s" program))
                   (sb-ext:process-close process))))
             (hook (point)
               (when (eq point (if (eq kind :temporary)
                                   :after-source-proof-temp-create :after-source-proof-seal))
                 (let* ((attempt (first (first *logical-slot-copy-source-proof-preparations*)))
                        (owner (logical-slot-copy-source-proof-preparation-owner attempt))
                        (directory (physical-adoption-owner-directory owner)))
                   (setf target
                         (namestring
                          (ecase kind
                            (:root directory)
                            (:archive (merge-pathnames "pg_physical_retained/" directory))
                            (:canonical (merge-pathnames "logical-slot-copy.source-proof" directory))
                            (:temporary (merge-pathnames "logical-slot-copy.source-proof.tmp" directory))))))
                 (let ((original (physical-image-file-facts -100 target)))
                   (sb-sys:without-interrupts
                     (command "/bin/mount" (list "--bind" target target))
                     (setf mounted t))
                   (let ((changed (physical-image-file-facts -100 target)))
                     (assert (= (first original) (first changed)))
                     (assert (= (second original) (second changed)))
                     (assert (/= (ninth original) (ninth changed))))
                   (setf injected t)))))
      (unwind-protect
           (let ((*logical-slot-copy-source-proof-publication-test-hook* #'hook))
             (handler-case (logical-slot-copy-publish-source-proof)
               (error (condition) (setf failure condition))))
        (when mounted
          (command "/bin/umount" (list target))
          (setf mounted nil))))
    (assert injected)
    (assert failure)
    (assert *physical-recovery-failed-p*)
    (assert (= before (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t))))
    (assert (and (null *physical-recovery-state*) (null *physical-receive-store*)
                 (null *catalog*) (null *clog-stream*) (null *wal-output-stream*) (not *wal-ready*)
                 (zerop (hash-table-count *physical-retained-root-holds*))
                 (zerop (hash-table-count *physical-retained-root-updates*))))
    (format t "~&SOURCE-PROOF-MOUNT-PASS kind=~s injected=t~%" kind)))
