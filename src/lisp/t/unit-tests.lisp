      (test-heap-free-space-map)
      (test-postgres-special-xid-statuses)
      (test-xid-control-state)
      (test-key-order)
      (test-index-catalog-roundtrip)
      (test-sql-strict-let-evaluation)
      (test-query-plan-ir-and-count-aggregate)
      (test-index-scan-limit-stops-duplicate-candidates)
      (test-query-plan-compiler-backend-hook)
      (test-query-plan-compiler-dispatch-uses-registry-snapshot)
      (test-query-plan-backend-registry-synchronization)
      (test-insert-index-catalog-snapshot-lock)
      (test-select-top-n-collector)
      (test-using-join-output-metadata)
      (test-error-cleanup-and-fatal-rethrow)
      (test-create-table-cleanup-after-fsync-error)
      (test-relation-build-own-xid)
      (test-visibility)
      (test-statement-snapshot-acquisition-interrupt-cleanup)
      (test-make-snapshot-rejects-unowned-registration)
      (test-register-active-snapshot-requires-token)
      (test-snapshot-registration-cannot-be-reused-while-active)
      (test-vacuum-page-publication-is-atomic)
      (test-revalidated-relation-locks-retry-and-release)
      (test-revalidated-relation-locks-release-after-revalidation-error)
      (test-vacuum-index-object-set-invariant)
      (test-vacuum-current-table-index-set-lock-guard)
      (test-vacuum-xid-normalization-invariant)
      (test-vacuum-freeze-cutoff-invariant)
      (test-vacuum-full-publish-failure-boundaries)
      (test-vacuum-page-retry-rebuilds-proposal)
      (test-vacuum-page-read-releases-global-write-lock)
      (test-vacuum-reuses-tid-clears-index-and-vm)
      (test-vacuum-snapshot-horizon)
      (test-btree-duplicate-keys)
      (test-btree-mixed-duplicate-keys)
      (test-btree-vacuum-bounded-split-retries)
      (test-session-setting-rollback)
      (test-transaction-snapshot-lifecycle)
      (test-transaction-isolation-controls)
