;;;; unit-tests.lisp -- Load topic-specific tests and run the Lisp unit suite.
;;;; Run via t/run-unit-tests.sh, which loads the "pg" system first.

(in-package #:pg)

(let ((test-directory (merge-pathnames #p"unit-tests/" *load-truename*)))
  (dolist (module '("support.lisp"
                    "primitives-tests.lisp"
                    "concurrency-tests.lisp"
                    "join-tests.lisp"
                    "spill-tests.lisp"
                    "backend-lifecycle-tests.lisp"
                    "wal-tests.lisp"
                    "protocol-tests.lisp"
                    "storage-tests.lisp"
                    "transaction-tests.lisp"
                    "catalog-tests.lisp"
                    "sql-tests.lisp"
                    "snapshot-tests.lisp"
                    "vacuum-tests.lisp"))
    (load (merge-pathnames module test-directory))))

(defun run-unit-tests ()
  (setf *test-failures* 0
        *test-checks* 0)
  (let ((dir (merge-pathnames
              (format nil "pg-unit-~a-~a-~a/"
                      (sb-posix:getpid) (get-universal-time) (random 1000000))
              #p"/tmp/opencode/")))
    (ensure-directories-exist dir)
    (let ((*pgdata* dir)
          (*backend* (make-backend)))
      (clog-init)
      (test-swank-arguments)
      (check (test-wait-until (lambda () t) 0.01)
             "test wait helper accepts an explicit timeout")
      (test-exported-snapshot-schema-lock-coordination)
      (test-schema-lock-nesting-and-read-upgrade-rejection)
      (test-schema-lock-acquisition-interruption)
      (test-atomic-relation-reader-registration)
      (test-single-relation-lock-macros-share-set-guards)
      (test-select-index-reader-blocks-drop-after-registration)
      (test-streamed-join-stop-and-outer-matches)
      (test-lazy-join-skips-inner-for-empty-outer)
      (test-lazy-join-interpreter-stops-inner-scan)
      (test-streamed-join-on-matches-survive-where-and-stop)
      (test-query-temp-startup-removes-abandoned-namespaces)
      (test-query-temp-fd-scope-closes-after-error)
      (test-query-temp-fd-scope-closes-after-acquisition-interrupt)
      (test-query-temp-fd-scope-closes-before-cleanup-interrupt)
      (test-query-temp-fd-scope-macro-expansion-protects-cleanup)
      (test-query-temp-retained-namespace-observability)
      (test-query-temp-retained-scan-refuses-symlink-swap)
      (test-query-temp-retained-scan-reports-file-type-race)
      (test-query-temp-file-limit-is-enforced)
      (test-query-spill-macros-use-default-memory-limit)
      (test-query-spill-resource-macros-clean-up-after-error)
      (test-query-temp-file-limit-option-parsing)
      (test-query-temp-file-macro-cleans-up-after-error)
      (test-query-temp-open-registration-failure-cleans-up)
      (test-query-temp-delete-failure-retains-cleanup-registration)
      (test-full-join-spool-spills-typed-bytea-and-match-state)
      (test-query-row-spool-spills-bytea-without-expanded-list)
      (test-query-plan-external-sort-spills-stably)
      (test-select-row-qualification-before-projection)
      (test-protocol-packet-limits)
      (test-protocol-decoding-enters-live-operation)
      (test-malformed-protocol-frames-drain-to-fatal-error)
      (test-terminate-frame-drains-active-backend)
      (test-page-roundtrip)
      (test-atomic-output)
      (test-backend-wait-state)
      (test-heap-tuple-edit)
      (test-with-registered-table)
      (test-with-registered-relation-access-set)
      (test-live-operation-gate)
      (test-live-operation-quiescence-ownership)
      (test-nested-control-repl-reload)
      (test-legacy-live-operation-gate-call-shapes)
      (test-live-operation-entry-interrupt-cleanup)
      (test-transaction-ending-statement-classifier)
      (test-simple-query-terminal-statement-drain)
      (test-cancel-query-waiting-for-live-operation-admission)
      (test-late-cancel-is-cleared-at-query-end)
      (test-query-token-cleans-up-after-publication-error)
      (test-unregister-backend-clears-query-state)
      (test-idle-backend-teardown-enters-captured-cleanup)
      (test-shutdown-cleanup-respects-reload-admission)
      (test-pre-admitted-idle-backend-can-drain-after-starting-transaction)
      (test-active-transaction-suffix-waits-for-reload)
      (test-disconnect-cleanup-drains-active-transaction)
      (test-idle-commit-waits-for-reload)
      (test-idle-active-transaction-does-not-block-reload)
      (test-wal-catalog-codec-and-page-checksums)
      (test-wal-record-codec)
      (test-wal-snapshot-boundary-retains-active-xid-pages)
      (test-wal-snapshot-release-race-before-pin-publication)
      (test-wal-chunked-catalog-record)
      (test-wal-catalog-terminal-validation-precedes-page-redo)
      (test-wal-segment-rotation)
      (test-wal-checkpoint-retains-active-xid-segments)
      (test-wal-replication-slot-durable-retention)
      (test-with-exported-snapshot-scope)
      (test-exported-snapshot-wraparound-admission)
      (test-exported-snapshot-wraparound-race)
      (test-wal-replication-slot-fsync-failure-keeps-pin)
      (test-wal-drop-missing-slot-does-not-poison-wal)
      (test-wal-drop-fsync-retry-keeps-pin)
      (test-wal-replication-slot-load-rejects-missing-wal)
      (test-wal-checkpoint-skips-obsolete-prefix)
      (test-wal-missing-interior-segment)
      (test-live-page-items-stop)
