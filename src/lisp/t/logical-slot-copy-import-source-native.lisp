(in-package #:pg)

(defun logical-import-source-test-reader-keys ()
  (sb-thread:with-mutex (*physical-retained-inventory-publish-lock*)
    (loop for key being the hash-keys of *physical-retained-root-references*
          when (and (symbolp key) (search "ARCHIVE-READER" (symbol-name key) :start2 0))
            collect key)))

(defun logical-import-source-test-write (path bytes)
  (with-open-file (out path :direction :output :if-exists :overwrite
                            :element-type '(unsigned-byte 8))
    (write-sequence bytes out)
    (fsync-stream out)))

(defun logical-import-source-test-body (mode)
  (let ((original-open (symbol-function 'physical-promotion-open-pending-store))
        (original-close (symbol-function 'physical-store-close))
        (opens 0) (closes 0) (scans 0) (lease nil) (escaped nil) (escaped-owner nil)
        (called nil) (rejected nil) (sticky nil) (fault-fired nil)
        (path (merge-pathnames "physical-recovery.control" *pgdata*))
        (saved nil))
    (unwind-protect
         (progn
           (setf (symbol-function 'physical-promotion-open-pending-store)
                 (lambda (&rest arguments)
                   (incf opens)
                   (apply original-open arguments))
                 (symbol-function 'physical-store-close)
                 (lambda (store)
                   (assert (null (logical-import-source-test-reader-keys)))
                   (incf closes)
                   (funcall original-close store)
                   (when (eq mode :close) (error "source store close cut"))))
           (when (member mode '(:control :extent :parent-rewrite))
             (when (eq mode :extent)
               (setf path (first (directory (merge-pathnames "pg_physical_retained/extent-*.wal" *pgdata*)))))
             (when (eq mode :parent-rewrite)
               (setf path (merge-pathnames "global/pg_wal_control" *pgdata*)))
             (assert path)
             (setf saved (read-bounded-regular-file path (* 32 1024 1024))))
           (let ((*logical-slot-copy-verification-test-hook*
                   (lambda (point context)
                     (declare (ignore context))
                     (when (eq point :after-import-source-scan)
                       (let ((keys (logical-import-source-test-reader-keys)))
                         (assert (= 1 (length keys)))
                         (if lease (assert (eq lease (first keys))) (setf lease (first keys))))
                       (incf scans)))))
             (handler-case
                 (catch 'source-cut
                   (call-with-logical-slot-copy-import-input
                    (lambda (owner context)
                      (setf escaped-owner owner)
                      (let ((result
                              (multiple-value-list
                               (call-with-logical-slot-copy-import-source
                                owner context
                                (lambda (source check)
                                  (setf called t escaped check)
                                  (assert (and (= 1 opens) (zerop closes)
                                               (> (getf source :fork) (getf source :base-end))
                                               (getf source :logical-fact) (getf source :eligible-interest)))
                                  (assert (eq lease (first (logical-import-source-test-reader-keys))))
                                  (case mode
                                    (:case (setf (aref (caar (getf source :slots)) 0) #\A))
                                    (:number (setf (getf source :fork) (float (getf source :fork) 1d0)))
                                    ((:cycle :caught)
                                     (let ((tail (last source)))
                                       (setf (cdr tail) source)
                                       (when (eq mode :caught)
                                         (assert (handler-case (progn (funcall check) nil)
                                                   (error () t)))
                                         (setf (cdr tail) nil)
                                         (setf sticky (handler-case (progn (funcall check) nil)
                                                        (error () t))))))
                                    ((:control :extent :parent-rewrite)
                                     (let ((bytes (copy-seq saved)))
                                       (unless (eq mode :parent-rewrite)
                                         (setf (aref bytes 0) (logxor 1 (aref bytes 0))))
                                       (logical-import-source-test-write path bytes)
                                       (setf fault-fired t)))
                                    (:throw (throw 'source-cut :cut)))
                                  (when (eq mode :healthy)
                                    (assert (funcall check))
                                    (assert (and (= 1 opens) (zerop closes)
                                                 (eq lease (first (logical-import-source-test-reader-keys))))))
                                  (values :first :second nil))))))
                        (when (eq mode :healthy)
                          (assert (equal result '(:first :second nil)))
                          (assert (physical-adoption-owner-active-p owner))
                          (assert (and (= 1 opens closes) (null (logical-import-source-test-reader-keys))))
                          (assert (handler-case (progn (funcall escaped) nil)
                                    (error (condition)
                                      (search "leased import source proof ended or failed"
                                              (princ-to-string condition))))))))))
               (error (condition) (setf rejected (princ-to-string condition)))))
           (assert called)
           (if (member mode '(:healthy :throw)) (assert (not rejected)) (assert rejected))
           (when (member mode '(:case :number :cycle))
             (assert (search "leased import source binding was modified" rejected)))
           (when (eq mode :caught)
             (assert (and sticky (search "leased import source proof ended or failed" rejected))))
           (when (eq mode :close) (assert (search "source store close cut" rejected)))
           (when (member mode '(:control :extent :parent-rewrite)) (assert fault-fired))
           (when rejected (format t "~&LOGICAL-IMPORT-SOURCE-REJECTION ~s ~a~%" mode rejected))
           (when (eq mode :healthy) (assert (= 3 scans)))
           (when (eq mode :throw) (assert (= 1 scans)))
           (assert (and (= 1 opens closes) (null (logical-import-source-test-reader-keys))
                        (not (physical-adoption-owner-active-p escaped-owner))))
           (assert (handler-case (progn (funcall escaped) nil) (error () t)))
           (assert (and (not *physical-recovery-state*) (not *physical-receive-store*)
                        (not *wal-ready*) (not *catalog*) (not *wal-output-stream*) (not *clog-stream*)
                        (zerop *n-backends*) (zerop (hash-table-count *relation-streams*))
                        (zerop (hash-table-count *wal-replication-slots*))))
           (format t "~&LOGICAL-IMPORT-SOURCE-SCOPE-PASS ~s~%" mode)
           (finish-output))
      (sb-sys:without-interrupts
        (setf (symbol-function 'physical-promotion-open-pending-store) original-open
              (symbol-function 'physical-store-close) original-close))
      (when saved (logical-import-source-test-write path saved)))))

(defun logical-import-source-test-optional ()
  (let ((original (symbol-function 'logical-slot-copy-prepare-import-source)) (calls 0))
    (unwind-protect
         (progn
           (setf (symbol-function 'logical-slot-copy-prepare-import-source)
                 (lambda (owner context)
                   (incf calls)
                   (call-with-logical-slot-copy-import-source
                    owner context
                    (lambda (source check)
                      (assert (and (getf source :logical-fact) (getf source :eligible-interest)
                                   (null (getf (physical-recovery-read-control *pgdata*) :logical-fact))))
                      (assert (funcall check))
                      source))))
           (logical-import-native-optional-control-fact)
           (assert (plusp calls))
           (format t "~&LOGICAL-IMPORT-SOURCE-SCOPE-PASS :OPTIONAL~%")
           (finish-output))
      (setf (symbol-function 'logical-slot-copy-prepare-import-source) original))))

(defun logical-import-source-test-terminal (mode)
  (let* ((original (symbol-function 'logical-slot-copy-read-import-source))
         (path (first (directory (merge-pathnames "pg_physical_retained/extent-*.wal" *pgdata*))))
         (saved (read-bounded-regular-file path (* 32 1024 1024)))
         (store nil) (owner nil) (lease nil) (escaped nil)
         (armed nil) (fired nil) (called nil) (postcalls 0) (failure nil) (result nil)
         (tuple-preserved nil))
    (unwind-protect
         (progn
           (setf (symbol-function 'logical-slot-copy-read-import-source)
                 (lambda (&rest args)
                   (setf store (third args))
                   (multiple-value-prog1 (apply original args)
                     (when (and (eq mode :late-extent) armed (not fired)
                                (getf (nthcdr 11 args) :emit-test-point t))
                       (let ((tuple (copy-tree (physical-store-control-tuple store)))
                             (bytes (copy-seq saved)))
                         (setf (aref bytes 0) (logxor 1 (aref bytes 0)))
                         (logical-import-source-test-write path bytes)
                         (assert (equal tuple (physical-store-control-tuple store)))
                         (setf fired t tuple-preserved t))))))
           (handler-case
               (call-with-logical-slot-copy-import-input
                (lambda (input context)
                  (setf owner input)
                  (setf result
                        (multiple-value-list
                         (apply #'call-with-logical-slot-copy-import-source
                                input context
                                (lambda (source check)
                                  (assert (getf source :logical-fact))
                                  (setf called t escaped check armed t
                                        lease (first (logical-import-source-test-reader-keys)))
                                  (assert lease)
                                  (values :one :two nil))
                                (unless (eq mode :late-extent)
                                  (list :final-check
                                        (lambda ()
                                          (incf postcalls)
                                          (assert (and (not (physical-store-closed-p store))
                                                       (eq lease (first (logical-import-source-test-reader-keys)))))
                                          (assert (handler-case (progn (funcall escaped) nil)
                                                    (error (condition)
                                                      (search "proof ended or failed" (princ-to-string condition)))))
                                          (when (eq mode :post-error) (error "terminal metadata cut"))))))))))
             (error (condition) (setf failure (princ-to-string condition))))
           (assert called)
           (format t "~&SOURCE-TERMINAL-EVIDENCE ~s fired=~s tuple-preserved=~s failure=~s~%"
                   mode fired tuple-preserved failure)
           (finish-output)
           (case mode
             (:late-extent
              (assert (and fired failure
                           (search "retained WAL object differs from its immutable reference" failure))))
             (:post-error (assert (and (= 1 postcalls) failure (search "terminal metadata cut" failure))))
             (:post-check (assert (and (= 1 postcalls) (null failure)
                                       (equal result '(:one :two nil))))))
           (assert (and (physical-store-closed-p store)
                        (not (physical-adoption-owner-active-p owner))
                        (null (logical-import-source-test-reader-keys))))
           (format t "~&LOGICAL-IMPORT-SOURCE-SCOPE-PASS ~s~%" mode)
           (finish-output))
      (setf (symbol-function 'logical-slot-copy-read-import-source) original)
      (logical-import-source-test-write path saved))))

(defun logical-import-source-test-run (mode)
  (sb-thread:with-mutex (*physical-follow-command-lock*)
    (sb-thread:with-mutex (*reload-run-lock*)
      (with-live-operation-quiescence
        (sb-thread:with-mutex (*physical-restartpoint-start-lock*)
          (sb-thread:with-mutex (*timeline-history-lock*)
            (cond ((eq mode :optional) (logical-import-source-test-optional))
                  ((member mode '(:late-extent :post-check :post-error))
                   (logical-import-source-test-terminal mode))
                  (t (logical-import-source-test-body mode)))))))))
