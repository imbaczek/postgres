(in-package #:pg)

(defun logical-source-proof-test-write-rotation ()
  (sb-thread:with-mutex (*write-lock*)
    (sb-thread:with-mutex (*catalog-mutex*)
      (wal-commit-maintenance)
      (let* ((bytes (catalog-image-bytes))
             (start (sb-thread:with-mutex (*wal-lock*) *wal-end-lsn*))
             (batch-size (+ 72 (length bytes)))
             (boundary (* (1+ (floor start +wal-segment-size+)) +wal-segment-size+))
             (first-end (- boundary 16))
             (end (+ boundary batch-size))
             (padding (- first-end start batch-size)))
        (assert (not (minusp padding)))
        (let ((padded (make-array (+ (length bytes) padding)
                                  :element-type '(unsigned-byte 8) :initial-element 32))
              (seen nil))
          (replace padded bytes)
          (assert (equal (physical-history-read-catalog bytes)
                         (physical-history-read-catalog padded)))
          (assert (= first-end (wal-commit-catalog padded #'write-catalog-image)))
          (assert (= end (wal-commit-catalog bytes #'write-catalog-image)))
          (assert (equalp bytes (read-bounded-regular-file (catalog-path) (length bytes))))
          (assert (= end (wal-scan
                          (lambda (record)
                            (push (list (wal-record-type record) (wal-record-start record)
                                        (wal-record-end record)) seen))
                          start :end-lsn end)))
          (assert (equal (nreverse seen)
                         (list (list +wal-record-batch-start+ start (+ start 32))
                               (list +wal-record-catalog+ (+ start 32) first-end)
                               (list +wal-record-batch-start+ boundary (+ boundary 32))
                               (list +wal-record-catalog+ (+ boundary 32) end))))
          (format t "~&SOURCE-PROOF-SOURCE-CATALOG-PASS start=~d terminal=~d catalog-bytes=~d gap=16~%"
                  start end (length bytes))
          (finish-output)
          end)))))

(defun logical-source-proof-test-rotation (expected-fork expected-size)
  (logical-source-proof-test-run)
  (let* ((facts (logical-slot-copy-read-source-proof))
         (certificate (getf facts :certificate))
         (fork (getf certificate :fork))
         (cursor (getf certificate :base-end))
         (gaps nil)
         (result (logical-slot-copy-source-proof-scan-archive
                  facts (physical-recovery-retained-directory) #'physical-retained-object-read)))
    (assert (= expected-fork fork))
    (assert (= expected-size (getf (getf facts :receipt) :catalog-size)))
    (assert (= (mod fork +wal-segment-size+) (+ 72 expected-size)))
    (assert (= (length (getf facts :prefix)) (mod fork +wal-segment-size+)))
    (assert (equal '("alpha" "beta") (mapcar #'first (getf certificate :slots))))
    (assert (every (lambda (row) (eq :eligible (fifth row))) (getf certificate :slots)))
    (logical-slot-copy-source-proof-map-archive
     facts (physical-recovery-retained-directory) #'physical-retained-object-read
     (%make-physical-store)
     (lambda (record raw)
       (declare (ignore raw))
       (when (> (wal-record-start record) cursor)
         (push (list cursor (wal-record-start record)
                     (- (wal-record-end record) (wal-record-start record))) gaps))
       (setf cursor (wal-record-end record)))
     cursor)
    (assert (= fork cursor (getf result :terminal)))
    (assert (equal gaps (list (list (- +wal-segment-size+ 16) +wal-segment-size+ 32))))
    (assert (equal (getf facts :fact) (getf result :applied-logical-fact)))
    (format t "~&SOURCE-PROOF-ROTATION-PASS F=~d gap=16 next-record=32~%" fork)
    (finish-output)))
