(in-package #:pg-physical-tests)

(rove:deftest suffix-stage-scan-clears-a-future-checkpoint-before-child-initialization
    (with-restartpoint-fixture (root store)
      (declare (ignore root))
      (selected-replay-test-prepare store)
      (pg::physical-store-input store 152 (sample-physical-record 152))
      (let* ((bytes (selected-replay-test-child-checkpoint 184))
             (end (+ 184 (length bytes)))
             (state pg::*physical-recovery-state*))
        (pg::physical-store-input store 184 bytes)
        (pg::physical-store-flush store)
        (setf (getf state :source-checkpoint) (list :timeline 2 :end end))
        (let ((before (copy-tree state)))
          (multiple-value-bind (resource fpw)
              (pg::physical-recovery-scan-resource-fact
               store 32 end nil state :checkpoint-seed nil :next-xid-seed 50 :fpw-seed nil)
            (ok (null resource))
            (ok (null fpw)))
          (ok (equal state before))
          (ok (= 96 pg::*last-replay-lsn*))
          (ok (= 1 (pg::physical-recovery-replay-timeline)))))))

(rove:deftest suffix-stage-scan-rejects-child-work-hidden-by-a-future-checkpoint
    (with-restartpoint-fixture (root store)
      (declare (ignore root))
      (selected-replay-test-prepare store)
      (let* ((bytes (pg::wal-encode-record pg::+wal-record-xid-reservation+ 0 152
                                           (pg::wal-encode-xid-reservation 1999)))
             (end (+ 152 (length bytes)))
             (state pg::*physical-recovery-state*))
        (pg::physical-store-input store 152 bytes)
        (pg::physical-store-flush store)
        (setf (getf state :source-checkpoint) (list :timeline 2 :end (+ end 1000)))
        (let ((before (copy-tree state)))
          (ok (signals (pg::physical-recovery-scan-resource-fact
                        store 32 end nil state :checkpoint-seed nil :next-xid-seed 50) 'error))
          (ok (equal state before))
          (ok (= 96 pg::*last-replay-lsn*))))))

(rove:deftest suffix-stage-scan-rejects-regressing-child-floor-and-unproven-child-start
    (dolist (case '(:floor :child-start))
      (with-restartpoint-fixture (root store)
        (declare (ignore root))
        (selected-replay-test-prepare store)
        (pg::physical-store-input store 152 (sample-physical-record 152))
        (let* ((bytes (selected-replay-test-child-checkpoint 184 500))
               (end (+ 184 (length bytes)))
               (state pg::*physical-recovery-state*))
          (pg::physical-store-input store 184 bytes)
          (pg::physical-store-flush store)
          (let ((before (copy-tree state)))
            (ok (signals
                 (if (eq case :floor)
                     (pg::physical-recovery-scan-resource-fact
                      store 32 end nil state :checkpoint-seed nil :next-xid-seed 1000)
                     (pg::physical-recovery-scan-resource-fact store 152 end nil state))
                 'error))
            (ok (equal state before)))))))

(rove:deftest suffix-stage-scan-resumes-a-proven-child-restartpoint-before-its-first-checkpoint
    (with-restartpoint-fixture (root store)
      (declare (ignore root))
      (pg::clog-init)
      (unwind-protect
           (progn
             (selected-replay-test-prepare store)
             (pg::physical-replay-from 96)
             (pg::physical-store-compact store 152 #'pg::physical-restartpoint-publish)
             (multiple-value-bind (metadata catalog prefix)
                 (pg::physical-restartpoint-read pg::*physical-recovery-state*)
               (declare (ignore catalog prefix))
               (ok (= 152 (getf metadata :lsn)))
               (ok (= 2 (getf metadata :replay-timeline)))
               (ok (get-properties metadata '(:source-checkpoint)))
               (ok (null (getf metadata :source-checkpoint)))
               (pg::physical-store-input store 152 (sample-physical-record 152))
               (let* ((bytes (selected-replay-test-child-checkpoint 184))
                      (end (+ 184 (length bytes)))
                      (state pg::*physical-recovery-state*))
                 (pg::physical-store-input store 184 bytes)
                 (pg::physical-store-flush store)
                 (setf (getf state :source-checkpoint) (list :timeline 2 :end (+ end 1000)))
                 (let ((before (copy-tree state)))
                   (multiple-value-bind (checkpoint next) (pg::physical-restartpoint-scan-seeds metadata state)
                     (ok (null (pg::physical-recovery-scan-resource-fact
                                store 152 end nil state :checkpoint-seed checkpoint :next-xid-seed next))))
                   (ok (equal before state))
                   (ok (= 152 pg::*last-replay-lsn*))))))
        (close pg::*clog-stream*)
        (setf pg::*clog-stream* nil))))
