(in-package #:pg-physical-tests)

(declaim (special pg::*enable-hot-standby*))

(cl-spec:defproperty hot-standby-boolean-aliases-have-canonical-values
    ((index (range integer 0 18)) (uppercase boolean))
  (:about pg::startup-normalize-setting)
  (:trials (:normal 200))
  (let* ((aliases '("true" "tru" "tr" "t" "yes" "ye" "y" "on" "1" "false" "fals" "fal" "fa" "f" "no" "n" "off" "of" "0"))
         (word (nth index aliases)))
    (eql (< index 9)
         (pg::startup-normalize-setting "hot_standby" (if uppercase (string-upcase word) word)))))

(deftest hot-standby-boolean-values-match-guc-parsing
    (let ((data (cl-spec:result-data
                 (cl-spec:run-property 'hot-standby-boolean-aliases-have-canonical-values :seed 42))))
      (ok (eq :passed (getf data :status)) (format nil "~s" data))
      (ok (= 200 (getf data :trials))))
  (dolist (word '("" "o" "ofx" "true " " off" " true " "11" "00" "nil"))
    (ok (intake-fails-p (lambda () (pg::startup-normalize-setting "hot_standby" word))))))

(deftest hot-standby-disabled-rejects-every-startup-class-before-authentication
    (dolist (mode '(nil "true" "database"))
      (call-with-backend-admission-fixture
       (lambda ()
         (let* ((pg::*enable-hot-standby* nil)
                (pg::*physical-recovery-state* (list :standby t))
                (pg::*backend* (admission-test-register 1))
                (stream (make-broadcast-stream))
                (pg::*max-connections* 0) (pg::*max-wal-senders* 0)
                (body (concatenate '(vector (unsigned-byte 8))
                                   #(0 3 0 0)
                                   (pg::string->bytes
                                    (format nil "user~cpostgres~cdatabase~cpostgres~c~a~c"
                                            (code-char 0) (code-char 0) (code-char 0) (code-char 0)
                                            (if mode (format nil "replication~c~a~c" (code-char 0) mode (code-char 0)) "")
                                            (code-char 0)))))
                (writes 0)
                (old-auth (symbol-function 'pg::send-auth-ok))
                (condition nil))
           (unwind-protect
                (progn
                  (setf (symbol-function 'pg::send-auth-ok)
                        (lambda (output) (declare (ignore output)) (incf writes)))
                  (setf condition (handler-case (pg::process-startup stream body)
                                    (pg::pg-error (error) error))))
             (setf (symbol-function 'pg::send-auth-ok) old-auth))
           (ok (typep condition 'pg::pg-error))
           (when (typep condition 'pg::pg-error)
             (ok (equal "57P03" (pg::pg-error-sqlstate condition)))
             (ok (equal "FATAL" (pg::pg-error-severity condition)))
             (ok (equal "Hot standby mode is disabled." (pg::pg-error-detail condition))))
           (ok (zerop writes))
           (ok (zerop (hash-table-count pg::*backend-admission-classes*))))))))

(deftest hot-standby-postmaster-setting-keeps-installed-value-on-reload
    (with-physical-store-directory (root)
      (let* ((pg::*pgdata* root)
             (configuration (merge-pathnames "postgresql.conf" root))
             (pg::*startup-server-settings* nil)
             (pg::*startup-native-inputs* nil) (pg::*startup-command-overrides* nil)
             (pg::*enable-hot-standby* t)
             (pg::*wal-keep-size-mb* 0)
             (pg::*physical-restartpoint-timeout* 300)
             (pg::*physical-restartpoint-wal-bytes* 1073741824)
             (pg::*max-slot-wal-keep-bytes* 1073741824)
             (pg::*wal-slot-retention-policy* nil)
             (pg::*max-replication-slots* 10)
             (pg::*max-connections* 100) (pg::*max-wal-senders* 10))
        (write-startup-config configuration (format nil "hot_standby=off~%"))
        (multiple-value-bind (native overrides) (pg::startup-cli-inputs (list "-D" (namestring root)))
          (pg::startup-install-settings (pg::startup-load-settings native overrides) native overrides))
        (ok (null pg::*enable-hot-standby*))
        (ok (equal "off" (pg::startup-setting-show-value "hot_standby")))
        (ok (equal "off" (pg::startup-configuration-output (list "-D" (namestring root) "-C" "hot_standby"))))
        (write-startup-config configuration (format nil "hot_standby=on~%"))
        (pg::startup-reload-settings)
        (ok (null pg::*enable-hot-standby*))
        (let* ((entry (gethash "hot_standby" pg::*startup-server-settings*))
               (row (pg::startup-settings-row "hot_standby" entry)))
          (ok (equal "off" (aref row 1)))
          (ok (eq pg::+null+ (aref row 2)))
          (ok (equal "postmaster" (aref row 3)))
          (ok (equal "bool" (aref row 4)))
          (ok (getf entry :pending-restart)))
        (ok (intake-fails-p (lambda () (pg::startup-check-session-setting "hot_standby"))))
        (write-startup-config configuration (format nil "hot_standby=o~%"))
        (ok (intake-fails-p (lambda () (pg::startup-reload-settings))))
        (ok (null pg::*enable-hot-standby*)))))
