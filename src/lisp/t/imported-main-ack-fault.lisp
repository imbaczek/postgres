(in-package #:pg)

(defvar *imported-main-ack-fault-job* nil)

(defun imported-main-ack-fault-snapshot ()
  (sb-thread:with-mutex (*wal-lock*)
    (let* ((alpha (gethash "alpha" *wal-replication-slots*))
           (beta (gethash "beta" *wal-replication-slots*))
           (group (gethash *wal-replication-slots* *logical-slot-continuation-protection-registries*))
           (selected (imported-main-ack-selected)))
      (assert (and alpha beta group))
      (assert (logical-slot-continuation-protection-call group :check))
      (list :alpha alpha :beta beta :group group
            :fork (gethash group *wal-snapshot-retention-pins*)
            :alpha-bytes (read-bounded-regular-file (wal-replication-slot-path "alpha") +slot-state-maximum-bytes+)
            :alpha-facts (physical-image-file-facts -100 (namestring (wal-replication-slot-path "alpha")))
            :beta-bytes (read-bounded-regular-file (wal-replication-slot-path "beta") +slot-state-maximum-bytes+)
            :beta-facts (physical-image-file-facts -100 (namestring (wal-replication-slot-path "beta")))
            :confirmed (wal-replication-slot-confirmed-flush-lsn alpha)
            :selector selected :generation (getf selected :generation)))))

(defun imported-main-ack-fault-start (target directory cut)
  (unless (member cut '(:prepared-durable :published)) (error "unsupported actual-main ACK cut"))
  (setf directory (pathname directory))
  (let ((before (imported-main-ack-fault-snapshot)))
    (assert (> target (getf before :confirmed)))
    (sb-thread:with-mutex (*imported-main-ack-lock*)
      (when (eq :running (getf *imported-main-ack-fault-job* :state))
        (error "previous fault worker is still running"))
      (setf *imported-main-ack-fault-job*
            (list :state :running :before before :target target :cut cut)))
    (let ((thread
            (sb-thread:make-thread
             (lambda ()
               (let ((failure nil) (barriers 0) (faults 0)
                                   (*logical-slot-continuation-writer-test-hook* nil))
                 (setf *logical-slot-continuation-writer-test-hook*
                       (lambda (point writer)
                         (declare (ignore writer))
                         (when (eq point :before-intent)
                           (incf barriers)
                           (imported-main-ack-barrier directory point))
                         (when (eq point cut)
                           (incf faults)
                           (error "imported ACK injected post-intent fault"))))
                 (handler-case
                     (with-live-operation
                       (call-with-logical-replication-slot
                        "alpha"
                        (lambda (slot)
                          (assert (eq slot (getf before :alpha)))
                          (logical-slot-continuation-native-acknowledge
                           "alpha" target *wal-logical-slot-owner*))))
                   (error (condition) (setf failure condition)))
                 (sb-thread:with-mutex (*imported-main-ack-lock*)
                   (setf (getf *imported-main-ack-fault-job* :failure) failure
                         (getf *imported-main-ack-fault-job* :barriers) barriers
                         (getf *imported-main-ack-fault-job* :faults) faults
                         (getf *imported-main-ack-fault-job* :state) :done))
                 (with-open-file (stream (merge-pathnames "done" directory)
                                         :direction :output :if-exists :error)
                   (write-line "done" stream))))
             :name "imported main ACK fault")))
      (sb-thread:with-mutex (*imported-main-ack-lock*)
        (setf (getf *imported-main-ack-fault-job* :thread) thread))))
  :ack-fault-started)

(defun imported-main-ack-fault-join ()
  (let ((thread (sb-thread:with-mutex (*imported-main-ack-lock*)
                  (getf *imported-main-ack-fault-job* :thread))))
    (when thread (sb-thread:join-thread thread)))
  :ack-fault-worker-reaped)

(defun imported-main-ack-fault-check ()
  (imported-main-ack-fault-join)
  (let* ((job *imported-main-ack-fault-job*)
         (before (getf job :before)) (target (getf job :target))
         (published (eq :published (getf job :cut)))
         (group (getf before :group))
         (alpha (getf before :alpha)) (beta (getf before :beta)))
    (assert (and (eq :done (getf job :state))
                 (= 1 (getf job :barriers) (getf job :faults))
                 (getf job :failure)
                 (search "imported ACK injected post-intent fault"
                         (princ-to-string (getf job :failure)))))
    (sb-thread:with-mutex (*wal-lock*)
      (assert (eq group (gethash *wal-replication-slots* *logical-slot-continuation-protection-registries*)))
      (assert (eq alpha (gethash "alpha" *wal-replication-slots*)))
      (assert (eq beta (gethash "beta" *wal-replication-slots*)))
      (assert (= (getf before :fork) (gethash group *wal-snapshot-retention-pins*)))
      (assert (logical-slot-continuation-protection-call group :uncertain))
      (assert (and (wal-replication-slot-state-uncertain-p alpha)
                   (wal-replication-slot-state-uncertain-p beta)))
      (assert (and (null (wal-replication-slot-active-owner alpha))
                   (null (wal-replication-slot-active-owner beta))))
      (assert (equalp (getf before :beta-bytes) (logical-slot-state-encode beta)))
      (assert (equalp (getf before :beta-bytes)
                      (read-bounded-regular-file (wal-replication-slot-path "beta") +slot-state-maximum-bytes+)))
      (assert (equal (getf before :beta-facts)
                     (physical-image-file-facts -100 (namestring (wal-replication-slot-path "beta")))))
      (assert (logical-slot-continuation-gc-fenced-p *pgdata*))
      (let* ((bytes (read-bounded-regular-file
                     (merge-pathnames "pg_logical_continuation/selector" *pgdata*)
                     (logical-slot-continuation-prepared-maximum-bytes)))
             (disk (read-bounded-regular-file (wal-replication-slot-path "alpha") +slot-state-maximum-bytes+)))
        (if published
            (let ((selected (logical-slot-continuation-decode bytes)))
              (assert (= (1+ (getf before :generation)) (getf selected :generation)))
              (assert (equalp (getf before :beta-bytes)
                              (second (find "beta" (getf selected :slots) :key #'first :test #'equal))))
              (assert (= target (wal-replication-slot-confirmed-flush-lsn alpha)
                         (wal-replication-slot-restart-lsn alpha)))
              (assert (equalp disk (logical-slot-state-encode alpha)))
              (assert (equalp disk (second (find "alpha" (getf selected :slots) :key #'first :test #'equal)))))
            (let ((prepared (logical-slot-continuation-prepared-decode bytes)))
              (assert (and (eq :native-ack (getf prepared :kind))
                           (equal "alpha" (getf prepared :name))
                           (equalp (getf before :selector) (getf prepared :old))))
              (assert (equal (list target *wal-insert-timeline* :prefix-end) (getf prepared :ack)))
              (let* ((new (getf prepared :new))
                     (candidate (logical-slot-continuation-prepared-slot
                                 (second (find "alpha" (getf new :slots) :key #'first :test #'equal)) "alpha")))
                (assert (= target (wal-replication-slot-confirmed-flush-lsn candidate)
                           (wal-replication-slot-restart-lsn candidate)))
                (assert (= *wal-insert-timeline* (wal-replication-slot-confirmed-timeline candidate)
                           (wal-replication-slot-restart-timeline candidate)))
                (assert (equalp (getf before :beta-bytes)
                                (second (find "beta" (getf new :slots) :key #'first :test #'equal)))))
              (assert (= (getf before :generation) (getf (getf prepared :old) :generation)))
              (assert (= (1+ (getf before :generation)) (getf (getf prepared :new) :generation)))
              (assert (= (getf before :confirmed) (wal-replication-slot-confirmed-flush-lsn alpha)))
              (assert (and (equalp disk (getf before :alpha-bytes))
                           (equalp disk (logical-slot-state-encode alpha))))
              (assert (equal (getf before :alpha-facts)
                             (physical-image-file-facts -100 (namestring (wal-replication-slot-path "alpha")))))))))
    (let ((called 0) (proofs 0)
                     (*logical-slot-continuation-native-proof-test-hook* nil))
      (setf *logical-slot-continuation-native-proof-test-hook*
            (lambda (&rest ignored) (declare (ignore ignored)) (incf proofs)))
      (dolist (name '("alpha" "beta"))
        (assert (handler-case
                    (progn
                      (call-with-logical-replication-slot
                       name (lambda (slot) (declare (ignore slot)) (incf called)))
                      nil)
                  (pg-error (condition) (string= "55000" (pg-error-sqlstate condition))))))
      (assert (zerop called))
      (assert (zerop proofs)))
    (format nil "ACK-FAULT-FENCED cut=~a generation=~d confirmed=~d fork=~d"
            (getf job :cut)
            (+ (getf before :generation) (if published 1 0))
            (if published target (getf before :confirmed))
            (getf before :fork))))

(defun imported-main-ack-fault-check-refusal (condition slot)
  (assert (physical-slot-cold-cleanup-refusal-check-under-lock condition slot *backend*))
  (flet ((rejects-replacement ()
           (assert
            (handler-case
                (progn
                  (physical-slot-cold-cleanup-refusal-check-under-lock condition slot *backend*)
                  nil)
              (error (failure)
                (search "cold cleanup refusal lost its uncertain group"
                        (princ-to-string failure)))))))
    (let ((*logical-slot-continuation-protection-registries* (make-hash-table :test #'eq)))
      (rejects-replacement))
    (let ((*logical-slot-continuation-protections* (make-hash-table :test #'equal)))
      (rejects-replacement)))
  (assert (physical-slot-cold-cleanup-refusal-check-under-lock condition slot *backend*))
  t)

(defun imported-main-ack-fault-check-terminal (backend)
  (assert (not *physical-slot-cold-cleanup-exit-ready*))
  (assert *primary-wal-writer-shutdown-p*)
  (sb-thread:with-mutex (*wal-lock*)
    (assert (not (gethash (backend-pid backend) *backend-registry*)))
    (let ((slot (gethash "ack_barrier" *wal-replication-slots*)))
      (assert slot)
      (assert (eq backend (wal-replication-slot-temporary-owner slot)))
      (assert (physical-slot-retained-for-cold-cleanup-p slot))
      (assert (physical-slot-check-name-under-lock "ack_barrier"))
      (assert (probe-file (wal-replication-slot-path "ack_barrier")))))
  (imported-main-ack-fault-check))

(defun imported-main-ack-fault-instrument-refusal (observer-pid)
  (unless *imported-main-ack-sql-functions* (error "ACK SQL instrumentation is required"))
  (let* ((symbol 'physical-slot-refuse-cold-cleanup-under-lock)
         (original (symbol-function symbol)))
    (push (cons symbol original) *imported-main-ack-sql-functions*)
    (setf (symbol-function symbol)
          (lambda (slot check-group)
            (handler-bind
                ((physical-slot-cold-cleanup-refusal
                   (lambda (condition)
                     (when (string= (wal-replication-slot-name slot) "ack_barrier")
                       (imported-main-ack-fault-check-refusal condition slot)
                       (imported-main-ack-sql-marker '("ack_barrier") "refusal-validated")))))
              (funcall original slot check-group)))))
  (let* ((symbol 'request-cold-slot-reconciliation-exit)
         (original (symbol-function symbol)))
    (push (cons symbol original) *imported-main-ack-sql-functions*)
    (setf (symbol-function symbol)
          (lambda (backend)
            (unwind-protect
                 (when (eq backend *physical-slot-cold-cleanup-owner*)
                   (let ((report
                           (handler-case
                               (imported-main-ack-fault-check-terminal backend)
                             (error (condition)
                               (format nil "ACK-FAULT-TERMINAL-CHECK-ERROR ~a" condition)))))
                     (with-open-file (stream (merge-pathnames "terminal" *imported-main-ack-sql-directory*)
                                             :direction :output :if-exists :error)
                       (write-line report stream))))
              (funcall original backend))
            (when (and backend (= observer-pid (backend-pid backend)))
              (assert *physical-slot-cold-cleanup-owner*)
              (assert (not *physical-slot-cold-cleanup-exit-ready*))
              (imported-main-ack-sql-marker '("ack_barrier") "observer-reaped")))))
  (let* ((symbol 'send-error-response)
         (original (symbol-function symbol)))
    (push (cons symbol original) *imported-main-ack-sql-functions*)
    (setf (symbol-function symbol)
          (lambda (stream condition)
            (when (and *backend* (eq *backend* *physical-slot-cold-cleanup-owner*))
              (let ((backend *backend*))
                (sb-thread:join-thread
                 (sb-thread:make-thread (lambda () (terminate-backend backend))
                                        :name "ACK fault termination delivery"))
                (assert (backend-termination-pending backend))
                (check-for-interrupts)
                (imported-main-ack-sql-marker '("ack_barrier") "termination-deferred")
                (imported-main-ack-barrier
                 (merge-pathnames "response/" *imported-main-ack-sql-directory*) :before-error)))
            (funcall original stream condition))))
  :ack-refusal-instrumented)

(defun imported-main-ack-fault-temporary (pid name)
  (sb-thread:with-mutex (*wal-lock*)
    (let ((slot (gethash name *wal-replication-slots*))
          (backend (gethash pid *backend-registry*)))
      (when slot
        (assert (and backend (wal-physical-slot-p slot) (wal-replication-slot-temporary-p slot)
                     (eq backend (wal-replication-slot-temporary-owner slot))
                     (or (null (wal-replication-slot-active-owner slot))
                         (eq backend (wal-replication-slot-active-owner slot)))
                     (or (null (wal-replication-slot-active-owner-backend slot))
                         (eq backend (wal-replication-slot-active-owner-backend slot))))))
      (format nil "ACK-FAULT-TEMP ~a" (if slot :present :absent)))))
