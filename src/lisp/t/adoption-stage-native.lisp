(require :asdf)
(asdf:load-asd (merge-pathnames "../pg.asd" *load-truename*))
(asdf:load-system "pg")

(in-package #:pg)

(defun adoption-install-native-check (state stage proved expected-root)
  (let* ((owner (getf state :owner))
         (root (physical-adoption-owner-directory owner))
         (workspace (uiop:ensure-directory-pathname (uiop:getenv "PG_ADOPTION_INSTALL_WORKSPACE")))
         (root-inode (physical-adoption-owner-inode owner))
         (lock-inode (physical-adoption-owner-lock-inode owner))
         (installed (physical-adoption-install-start owner workspace))
         (plan (getf installed :plan)))
    (assert (= (physical-adoption-install-last-step plan) (getf installed :step)))
    (assert (eq :installed (getf (physical-adoption-attempt-read owner) :phase)))
    (assert (= root-inode (sb-posix:stat-ino (sb-posix:lstat (namestring root)))))
    (assert (= lock-inode (sb-posix:stat-ino (sb-posix:lstat (namestring (merge-pathnames ".pg_lisp.lock" root))))))
    (assert (equal (getf plan :old)
                   (physical-adoption-install-snapshot (merge-pathnames "quarantine/" workspace)
                                                       :exclude *physical-adoption-install-retained-names*)))
    (assert (equal (getf plan :stage-tree) (physical-adoption-install-snapshot (getf stage :directory))))
    (assert (physical-adoption-install-check-image root proved :installed t))
    (assert (equal installed (physical-adoption-install-resume owner)))
    (let ((*pgdata* root))
      (assert (handler-case (progn (physical-adoption-check-startup) nil) (error () t))))
    (multiple-value-bind (profile frozen) (physical-follow-source-profile (getf proved :source))
      (declare (ignore profile))
      (let ((client (physical-libpq-connect-frozen (physical-libpq-helper-path) frozen))
            (anchor (physical-follow-anchor-copy
                     (physical-adoption-attempt-with-history
                      (getf proved :anchor) *physical-follow-anchor-keys* (getf proved :source-history)))))
        (unwind-protect
             (let ((remote (pg-client-native-prove-retained
                            client (getf (getf proved :stage) :source-pin) anchor
                            (physical-adoption-attempt-origin-request (getf proved :origin-proof)))))
               (assert (= expected-root (getf remote :root-id)))
               (assert (= (getf (getf proved :origin-proof) :end-digest) (getf remote :end-digest)))
               (assert (equal (getf proved :source-history) (getf remote :history-text))))
          (physical-client-close client))))
    (format t "~&adoption-install: E/Mnew installed, originals quarantined, stable ownership and source pin retained PASS~%")
    installed))

(defun adoption-stage-native-prove (stage state proof port expected-root)
  (let* ((profile (make-physical-libpq-profile
                   (format nil "host=127.0.0.1 port=~d user=postgres dbname=postgres connect_timeout=3" port)
                   :mode :physical))
         (client (physical-libpq-connect (physical-libpq-helper-path) profile))
         (name nil)
         (coordinates nil)
         (anchor nil)
         (cancel-test (equal "1" (uiop:getenv "PG_ADOPTION_CANCEL_TEST"))))
    (unwind-protect
         (let* ((record (physical-adoption-attempt-create state stage client profile))
                (identity (getf proof :identity))
                (request (list :system-id (first identity) :base-timeline (second identity)
                               :base (third identity) :manifest-digest (fourth identity)
                               :end (getf proof :end))))
           (assert (physical-adoption-attempt-validate-context (getf state :owner) record))
           (assert (not (probe-file (physical-adoption-attempt-path
                                     (physical-adoption-owner-directory (getf state :owner))))))
           (when (equal "1" (uiop:getenv "PG_ADOPTION_INSTALL_TEST"))
             (let ((proved (physical-adoption-attempt-start-proof state stage client profile)))
               (physical-client-close client)
               (setf client nil)
               (return-from adoption-stage-native-prove
                 (adoption-install-native-check state stage proved expected-root))))
           (when (equal "1" (uiop:getenv "PG_ADOPTION_PROOF_TEST"))
             (let* ((owner (getf state :owner))
                    (proved (physical-adoption-attempt-start-proof state stage client profile)))
               (assert (eq :proved (getf proved :phase)))
               (assert (= expected-root (getf (getf proved :proof) :root-id)))
               (assert (= (getf proof :end-digest) (getf (getf proved :proof) :end-digest)))
               (physical-client-close client)
               (setf client nil)
               (assert (equal proved (physical-adoption-attempt-resume-proof owner)))
               (assert (eq :retired (physical-adoption-attempt-cancel owner)))
               (format t "~&adoption-proof: durable intent, independent proof, frozen reconnect and exact proved retry PASS~%")
               (return-from adoption-stage-native-prove proved)))
           (when cancel-test (physical-adoption-attempt-publish (getf state :owner) record))
           (setf name (getf (getf record :stage) :source-pin)
                 coordinates (getf record :request)
                 anchor (pg-client-native-prepare client name coordinates))
           (assert (equal (getf record :source-history) (getf anchor :history-text)))
           (let ((remote (pg-client-native-prove-retained client name anchor request)))
             (assert (equal (getf record :source-history) (getf remote :history-text)))
             (assert (= (getf proof :end-digest) (getf remote :end-digest)))
             (assert (= expected-root (getf remote :root-id)))
             (format t "~&adoption-context: fresh stage, frozen accepted route and retained proof agree PASS~%"))
           (when cancel-test
             (physical-client-close client)
             (setf client nil)
             (assert (eq :retired (physical-adoption-attempt-cancel (getf state :owner))))
             (setf coordinates nil)
             (assert (not (probe-file (physical-adoption-attempt-path
                                       (physical-adoption-owner-directory (getf state :owner))))))
             (multiple-value-bind (original frozen) (physical-follow-source-profile (getf record :source))
               (declare (ignore original))
               (let ((late (physical-libpq-connect-frozen (physical-libpq-helper-path) frozen)))
                 (unwind-protect
                      (assert (handler-case (progn (pg-client-native-prepare late name (getf record :request)) nil)
                                (pg-client-error () t)))
                   (physical-client-close late))))
             (format t "~&adoption-cancel: frozen reconnect, durable retirement and delayed PREPARE refusal PASS~%")))
      (unwind-protect
           (when (and coordinates (not cancel-test))
             (if anchor
                 (pg-client-native-release client name (physical-follow-anchor-digest anchor))
                 (pg-client-native-abort client name coordinates)))
        (physical-client-close client)))))

(destructuring-bind (directory target port system timeline base manifest endpoint digest root)
    (uiop:command-line-arguments)
  (let ((identity (mapcar #'parse-integer (list system timeline base manifest))))
    (call-with-physical-adoption-owner
     directory
     (lambda (owner)
       (let* ((state (physical-adoption-inspect-primary owner))
              (proof (physical-adoption-prove-primary-origin state identity))
              (stage (physical-adoption-stage-base
                      state proof target (format nil "adopted_base_~d" (sb-posix:getpid)))))
         (assert (= (parse-integer endpoint) (getf proof :end)))
         (assert (= (parse-integer digest) (getf proof :end-digest)))
         (assert (= (getf state :next-xid) (getf (getf stage :base-state) :next-xid)))
         (adoption-stage-native-prove stage state proof (parse-integer port) (parse-integer root)))))))
