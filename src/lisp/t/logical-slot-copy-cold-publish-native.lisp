(in-package #:pg)

(defun logical-cold-publish-test-binding ()
  (let ((before (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t))))
    (call-with-logical-slot-copy-install-exclusion
     (lambda ()
       (call-with-logical-slot-copy-owned-input
        (lambda (&rest arguments)
          (apply #'%make-logical-slot-copy-cold-control-owner :mode :cold :state nil :store nil arguments))
        (lambda (owner context proof)
          (let ((binding (logical-slot-copy-cold-control-read-binding owner context proof)))
            (assert (eq :parent (getf binding :control-phase)))
            (assert (eq :absent (getf binding :temporary-kind)))
            (assert (not (equalp (getf binding :catalog) (getf binding :old-catalog))))
            (assert (getf binding :inputs))
            (assert (not (assoc "global/pg_wal_control" (getf binding :inputs) :test #'equal)))
            (assert (and (null *physical-recovery-state*) (null *physical-receive-store*)
                         (null *catalog*) (null *clog-stream*) (null *wal-output-stream*)))
            (format t "~&COLD-PUBLISH-BINDING-PASS ~d~%" (length (getf binding :inputs))))))))
    (assert (= before (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t))))
    (finish-output)))

(defun logical-cold-publish-test-run ()
  (let ((before (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t)))
        (result (logical-slot-copy-import-publish-cold-control)))
    (assert (member result '(:published :synced)))
    (call-with-logical-slot-copy-install-exclusion
     (lambda ()
       (call-with-logical-slot-copy-committed-source-kind
        #'%make-logical-slot-copy-catalog-owner
        (lambda (owner context store certificate plan fact history proof)
          (declare (ignore owner store certificate fact history))
          (multiple-value-bind (metadata catalog prefix generation)
              (physical-restartpoint-read (logical-slot-copy-committed-proof-state proof))
            (declare (ignore metadata generation))
            (assert (equalp catalog (logical-slot-copy-read-file
                                     context "global/pg_catalog.dat" (length catalog))))
            (dolist (entry (physical-promotion-checkpoint-files plan prefix))
              (format t "~&COLD-PUBLISH-CHILD-FILE pg_wal/~a~%"
                      (wal-segment-filename (first entry) (getf plan :child) :timeline)))
            (format t "~&COLD-PUBLISH-CHILD-FILE pg_wal/~a~%"
                    (timeline-history-filename (getf plan :child))))))))
    (assert (= before (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t))))
    (assert (and (null *physical-recovery-state*) (null *physical-receive-store*)
                 (null *catalog*) (null *clog-stream*) (null *wal-output-stream*)
                 (not *wal-ready*) (not *physical-recovery-failed-p*)
                 (zerop (hash-table-count *relation-streams*))
                 (zerop (hash-table-count *wal-replication-slots*))))
    (format t "~&COLD-PUBLISH-CONTROL-PASS ~s~%" result)
    (finish-output)))

(defun logical-cold-publish-test-late-source ()
  (let* ((directory *pgdata*)
         (paths (directory (merge-pathnames "pg_physical_retained/extent-*.wal" directory)))
         (before (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t)))
         (fired nil) (failure nil) (saved nil))
    (assert (= 1 (length paths)))
    (labels ((write-bytes (bytes)
               (with-open-file (out (first paths) :direction :io :if-exists :overwrite
                                                  :element-type '(unsigned-byte 8))
                 (write-sequence bytes out) (finish-output out)))
             (hook (point context)
               (declare (ignore context))
               (when (eq point :after-cold-control-close)
                 (assert (not fired))
                 (setf saved (read-bounded-regular-file (first paths) (* 32 1024 1024)))
                 (assert (plusp (length saved)))
                 (let ((changed (copy-seq saved)))
                   (setf (aref changed 0) (logxor 1 (aref changed 0)))
                   (write-bytes changed))
                 (setf fired t))))
      (unwind-protect
           (let ((*logical-slot-copy-verification-test-hook* #'hook))
             (handler-case (logical-slot-copy-import-publish-cold-control)
               (error (condition) (setf failure condition))))
        (when saved (write-bytes saved))))
    (assert fired)
    (assert failure)
    (assert *physical-recovery-failed-p*)
    (assert (= before (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t))))
    (assert (and (null *physical-recovery-state*) (null *physical-receive-store*)
                 (null *catalog*) (null *clog-stream*) (null *wal-output-stream*) (not *wal-ready*)))
    (format t "~&COLD-PUBLISH-LATE-SOURCE-PASS ~a~%" failure)
    (finish-output)))

(defun logical-cold-publish-test-cut (point exit)
  (let* ((before (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t)))
         (marker (make-condition 'simple-error :format-control "cold publication test cut"))
         (fired nil)
         (outcome
           (catch 'cold-publication-cut
             (handler-case
                 (let ((*logical-slot-copy-verification-test-hook*
                         (lambda (actual context)
                           (declare (ignore context))
                           (when (eq point actual)
                             (setf fired t)
                             (ecase exit
                               (:error (error marker))
                               (:throw (throw 'cold-publication-cut :cut)))))))
                   (logical-slot-copy-import-publish-cold-control)
                   :unexpected-success)
               (error (condition) condition)))))
    (assert fired)
    (assert (eq outcome (if (eq exit :error) marker :cut)))
    (assert *physical-recovery-failed-p*)
    (assert (= before (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t))))
    (assert (and (null *physical-recovery-state*) (null *physical-receive-store*)
                 (null *catalog*) (null *clog-stream*) (null *wal-output-stream*) (not *wal-ready*)))
    (format t "~&COLD-PUBLISH-CUT-PASS ~s ~s~%" point exit)
    (finish-output)))

(defun logical-cold-publish-test-authority (mode)
  (let ((before (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t)))
        (fired nil) (failure nil))
    (labels ((rejects (function)
               (handler-case (progn (funcall function) nil) (error () t)))
             (hook (point context)
               (declare (ignore context))
               (when (and (eq point :before-cold-control-create) (not fired))
                 (setf fired t)
                 (let* ((real (cdar *logical-slot-copy-cold-control-attempts*))
                        (operations (logical-slot-copy-cold-control-attempt-operations real)))
                   (ecase mode
                     (:copied
                      (let ((copy (copy-structure real)))
                        (assert (rejects (lambda () (logical-slot-copy-cold-control-record copy))))
                        (assert (rejects (lambda () (funcall operations :execute copy))))
                        (assert (rejects (lambda () (funcall operations :file copy :rename))))
                        (logical-slot-copy-cold-control-revoke copy))
                      (logical-slot-copy-cold-control-record real))
                     (:sticky
                      (assert (rejects (lambda () (funcall operations :file real :rename))))
                      (setf (physical-adoption-owner-active-p
                             (logical-slot-copy-cold-control-attempt-owner real)) t)
                      (assert (rejects (lambda () (logical-slot-copy-cold-control-record real))))))))))
      (let ((*logical-slot-copy-verification-test-hook* #'hook))
        (handler-case (logical-slot-copy-import-publish-cold-control)
          (error (condition) (setf failure condition)))))
    (assert fired)
    (assert (eql (eq mode :sticky) (not (null failure))))
    (assert (eql (eq mode :sticky) (not (null *physical-recovery-failed-p*))))
    (assert (= before (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t))))
    (format t "~&COLD-PUBLISH-AUTHORITY-PASS ~s~%" mode)
    (finish-output)))

(defun logical-cold-publish-test-syscall (mode)
  (declare (notinline sb-posix:close))
  (let ((open-function (symbol-function 'physical-image-openat))
        (write-function (symbol-function 'sb-posix:write))
        (sync-function (symbol-function 'sb-posix:fsync))
        (rename-function (symbol-function 'port-renameat))
        (close-function (symbol-function 'sb-posix:close))
        (marker (make-condition 'simple-error :format-control "cold publication syscall fault"))
        (armed nil) (calls 0) (failure nil) (reused nil))
    (with-open-file (witness (merge-pathnames "cold-control-fd-witness" (uiop:temporary-directory))
                             :direction :io :if-exists :supersede :if-does-not-exist :create
                             :element-type '(unsigned-byte 8))
      (write-sequence #(7 8 9) witness) (finish-output witness)
      (let ((outside (sb-sys:fd-stream-fd witness))
            (before (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t))))
        (labels ((fault () (incf calls) (setf armed nil) (error marker))
                 (name (fd) (ignore-errors (sb-posix:readlink (format nil "/proc/self/fd/~d" fd))))
                 (hook (point context)
                   (declare (ignore context))
                   (when (eq point (ecase mode
                                     (:open :before-cold-control-create)
                                     (:write :after-cold-control-create)
                                     (:old-sync :after-cold-control-write)
                                     (:temp-sync :after-cold-control-old-sync)
                                     (:installed-sync :after-cold-control-rename)
                                     (:directory-sync :after-cold-control-file-sync)
                                     (:data-sync :before-cold-control-data-sync)
                                     (:rename :before-cold-control-rename)
                                     (:close :after-cold-control-directory-sync)))
                     (setf armed t))))
          (unwind-protect
               (progn
                 (setf (symbol-function 'physical-image-openat)
                       (lambda (parent leaf flags permissions)
                         (when (and armed (eq mode :open) (equal leaf "pg_wal_control.tmp")
                                    (logtest flags sb-posix:o-creat)) (fault))
                         (funcall open-function parent leaf flags permissions))
                       (symbol-function 'sb-posix:write)
                       (lambda (fd buffer size)
                         (when (and armed (eq mode :write)) (fault))
                         (funcall write-function fd buffer size))
                       (symbol-function 'sb-posix:fsync)
                       (lambda (fd)
                         (when (and armed (member mode '(:old-sync :temp-sync :installed-sync
                                                         :directory-sync :data-sync)))
                           (fault))
                         (funcall sync-function fd))
                       (symbol-function 'port-renameat)
                       (lambda (from-directory from to-directory to)
                         (when (and armed (eq mode :rename) (equal from "pg_wal_control.tmp")
                                    (equal to "pg_wal_control")) (fault))
                         (funcall rename-function from-directory from to-directory to))
                       (symbol-function 'sb-posix:close)
                       (lambda (fd)
                         (if (and armed (eq mode :close)
                                  (let ((target (name fd)))
                                    (and target (search "pg_wal_control (deleted)" target))))
                             (progn
                               (funcall close-function fd)
                               (sb-posix:dup2 outside fd)
                               (setf reused fd)
                               (fault))
                             (funcall close-function fd))))
                 (let ((*logical-slot-copy-verification-test-hook* #'hook))
                   (handler-case (logical-slot-copy-import-publish-cold-control)
                     (error (condition) (setf failure condition)))))
            (setf (symbol-function 'physical-image-openat) open-function
                  (symbol-function 'sb-posix:write) write-function
                  (symbol-function 'sb-posix:fsync) sync-function
                  (symbol-function 'port-renameat) rename-function
                  (symbol-function 'sb-posix:close) close-function))
          (assert (= calls 1))
          (assert (eq failure marker))
          (assert *physical-recovery-failed-p*)
          (when reused
            (assert (equal (physical-image-file-facts outside) (physical-image-file-facts reused)))
            (funcall close-function reused))
          (assert (= before (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t))))
          (assert (and (null *physical-recovery-state*) (null *physical-receive-store*)
                       (null *catalog*) (null *clog-stream*) (null *wal-output-stream*) (not *wal-ready*)))
          (format t "~&COLD-PUBLISH-SYSCALL-PASS ~s~%" mode)
          (finish-output))))))
