(in-package #:pg)

(defstruct slot-publication-test-state
  root moved name kind original hook fired mutated
  device inode staging-device staging-inode namespace-restored staging-cleaned)

(defvar *slot-publication-test-state* nil)

(defun slot-publication-test-fire (state)
  (assert (sb-thread:holding-mutex-p *wal-lock*))
  (let* ((root (slot-publication-test-state-root state))
         (name (slot-publication-test-state-name state))
         (kind (slot-publication-test-state-kind state))
         (victim (if (eq kind :after-child) (slot-state-directory root name) root))
         (stat (slot-state-lstat victim)))
    (setf (slot-publication-test-state-fired state) t
          (slot-publication-test-state-device state) (sb-posix:stat-dev stat)
          (slot-publication-test-state-inode state) (sb-posix:stat-ino stat))
    (when (eq kind :before-root)
      (let ((staging (slot-state-lstat (slot-state-directory root name t))))
        (setf (slot-publication-test-state-staging-device state) (sb-posix:stat-dev staging)
              (slot-publication-test-state-staging-inode state) (sb-posix:stat-ino staging))))
    (sb-sys:without-interrupts
      (sb-posix:rename (string-right-trim "/" (namestring victim))
                       (string-right-trim "/" (namestring (slot-publication-test-state-moved state))))
      (setf (slot-publication-test-state-mutated state) t))
    (unless (eq kind :after-child) (ensure-directories-exist root))
    (error "injected slot publication namespace fault")))

(defun slot-publication-test-setup (name kind)
  (unless (and (wal-valid-replication-slot-name-p name)
               (member kind '(:before-root :after-root :after-child)))
    (error "invalid slot publication test request"))
  (when *slot-publication-test-state* (error "slot publication test is already installed"))
  (let* ((root (wal-replication-slot-directory))
         (moved (merge-pathnames "slot-publication-held/" *pgdata*))
         (original *logical-test-failpoint-hook*)
         (state (make-slot-publication-test-state
                 :root root :moved moved :name name :kind kind :original original)))
    (sb-thread:with-mutex (*wal-lock*)
      (when (or (gethash name *wal-replication-slots*) (slot-state-lstat moved)
                (slot-state-lstat (slot-state-directory root name))
                (slot-state-lstat (slot-state-directory root name t)))
        (error "slot publication test does not own empty names"))
      (setf (slot-publication-test-state-hook state)
            (lambda (point &rest details)
              (when (and (not (slot-publication-test-state-fired state))
                         (eq point (if (eq kind :before-root)
                                       :slot-file-before-rename :slot-file-after-rename))
                         (equal (first details) (slot-state-path root name)))
                (slot-publication-test-fire state))
              (when original (apply original point details)))
            *slot-publication-test-state* state
            *logical-test-failpoint-hook* (slot-publication-test-state-hook state))))
  :installed)

(defun slot-publication-test-verify ()
  (sb-thread:with-mutex (*wal-lock*)
    (let* ((state *slot-publication-test-state*)
           (slot (gethash (slot-publication-test-state-name state) *wal-replication-slots*)))
      (assert (and state (slot-publication-test-state-fired state) (slot-publication-test-state-mutated state)))
      (assert (null (slot-state-lstat
                     (slot-state-directory (wal-replication-slot-directory)
                                           (slot-publication-test-state-name state)))))
      (if (eq (slot-publication-test-state-kind state) :before-root)
          (assert (null slot))
          (assert (and slot (wal-logical-slot-p slot)
                       (wal-replication-slot-creation-failed-p slot)
                       (typep (wal-slot-reserved-p slot) '(integer 0 *))
                       (null (wal-replication-slot-active-owner slot)))))
      (assert (zerop (hash-table-count *logical-capture-arming*)))
      (assert (zerop (hash-table-count *exported-logical-snapshots*)))
      :verified)))

(defun slot-publication-test-check-restart-fence (name expected)
  (sb-thread:with-mutex (*wal-lock*)
    (let ((slot (gethash name *wal-replication-slots*)))
      (assert (and slot (wal-logical-slot-p slot)
                   (typep (wal-slot-reserved-p slot) '(integer 0 *))
                   (eq expected (wal-replication-slot-creation-failed-p slot))
                   (null (wal-replication-slot-drop-claim slot))
                   (null (wal-replication-slot-active-owner slot))))
      (unless expected (wal-require-usable-replication-slot slot))
      :verified)))

(defun slot-publication-test-state-hex (name)
  (sb-thread:with-mutex (*wal-lock*)
    (slot-state-read
     (wal-replication-slot-directory) name
     (lambda (bytes expected)
       (declare (ignore expected))
       (with-output-to-string (output)
         (loop for byte across bytes do (format output "~2,'0X" byte)))))))

(defun slot-publication-test-clean-owned-staging (state)
  (call-with-slot-state-root
   (slot-publication-test-state-root state)
   (lambda (root-fd)
     (let ((entry (concatenate 'string (slot-publication-test-state-name state) ".tmp")))
       (if (slot-state-lstat (slot-state-fd-path root-fd entry))
           (let ((item (slot-state-inventory-entry root-fd entry t)))
             (assert (and (= (fourth item) (slot-publication-test-state-staging-device state))
                          (= (fifth item) (slot-publication-test-state-staging-inode state))))
             (slot-state-remove-staging root-fd item))
           (fsync-directory (physical-image-fd-path root-fd)))))))

(defun slot-publication-test-restore ()
  (when *slot-publication-test-state*
    (sb-thread:with-mutex (*wal-lock*)
      (let* ((state *slot-publication-test-state*)
             (root (slot-publication-test-state-root state))
             (kind (slot-publication-test-state-kind state))
             (target (if (eq kind :after-child)
                         (slot-state-directory root (slot-publication-test-state-name state)) root)))
        (assert (or (eq *logical-test-failpoint-hook* (slot-publication-test-state-hook state))
                    (eq *logical-test-failpoint-hook* (slot-publication-test-state-original state))))
        (setf *logical-test-failpoint-hook* (slot-publication-test-state-original state))
        (when (slot-publication-test-state-mutated state)
          (let ((moved (slot-state-lstat (slot-publication-test-state-moved state))))
            (assert (and moved (= (sb-posix:stat-dev moved) (slot-publication-test-state-device state))
                         (= (sb-posix:stat-ino moved) (slot-publication-test-state-inode state)))))
          (if (eq kind :after-child)
              (assert (null (slot-state-lstat target)))
              (when (slot-state-lstat root)
                (slot-state-check-private-owner (slot-state-lstat root))
                (assert (null (directory-entry-names root)))
                (sb-posix:rmdir (string-right-trim "/" (namestring root)))))
          (sb-sys:without-interrupts
            (sb-posix:rename (string-right-trim "/" (namestring (slot-publication-test-state-moved state)))
                             (string-right-trim "/" (namestring target)))
            (setf (slot-publication-test-state-mutated state) nil (slot-publication-test-state-namespace-restored state) t)))
        (when (slot-publication-test-state-namespace-restored state)
          (let ((restored (slot-state-lstat target)))
            (assert (and restored (= (sb-posix:stat-dev restored) (slot-publication-test-state-device state))
                         (= (sb-posix:stat-ino restored) (slot-publication-test-state-inode state)))))
          (fsync-directory target)
          (fsync-directory root)
          (fsync-directory *pgdata*)
          (when (and (eq kind :before-root) (not (slot-publication-test-state-staging-cleaned state)))
            (slot-publication-test-clean-owned-staging state)
            (setf (slot-publication-test-state-staging-cleaned state) t)))
        (setf *slot-publication-test-state* nil))))
  :restored)
