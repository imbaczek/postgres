(in-package #:pg-physical-tests)

(defun replay-source-fpw-change (mode)
  (ecase mode
    (:full (pg::physical-replay-from pg::*last-replay-lsn*))
    (:rows (pg::physical-row-replay-prefix 0))))

(rove:deftest source-fpw-changes-publish-off-on-off-in-both-replay-paths
    (dolist (mode '(:full :rows))
      (with-restartpoint-fixture (root store)
        (let ((pg::*physical-replay-restarting-p* t)
              (pg::*wal-fpw-state* (list :unrelated-writer-policy))
              (disable nil))
          (setf pg::*catalog* (pg::load-catalog))
          (pg::clog-init)
          (unwind-protect
               (dolist (enabled '(nil t nil))
                 (let* ((begin (pg::physical-store-flushed-lsn store))
                        (start (+ begin pg::+wal-header-size+))
                        (writer pg::*wal-fpw-state*)
                        (incarnation pg::*wal-storage-incarnation*))
                   (append-readiness-fpw-change store enabled)
                   (let ((end (pg::physical-store-flushed-lsn store)))
                     (ok (= end (replay-source-fpw-change mode)))
                     (let* ((fact (getf pg::*physical-recovery-state* :source-fpw-fact))
                            (disk (getf (pg::physical-recovery-read-control root) :fpw-fact)))
                       (unless enabled (setf disable start))
                       (ok (pg::physical-fpw-fact-at-p fact end 1))
                       (ok (eql enabled (getf fact :enabled)))
                       (ok (eq :change (getf fact :witness-kind)))
                       (ok (= start (getf fact :witness-start)))
                       (ok (= disable (getf fact :last-disable-start)))
                       (ok (equal fact disk))
                       (ok (equal fact (getf pg::*physical-recovery-state* :required-fpw-fact)))
                       (ok (eq writer pg::*wal-fpw-state*))
                       (ok (eq incarnation pg::*wal-storage-incarnation*))
                       (ok (= 50 pg::*next-xid*))))))
            (close pg::*clog-stream*)
            (setf pg::*clog-stream* nil))))))

(rove:deftest source-fpw-change-restartpoint-restores-known-off-and-replays-a-later-on
    (dolist (mode '(:full :rows))
      (with-restartpoint-fixture (root store)
        (let ((pg::*physical-replay-restarting-p* t)
              (pg::*wal-fpw-state* (list :unrelated-writer-policy)))
          (setf pg::*catalog* (pg::load-catalog))
          (pg::clog-init)
          (unwind-protect
               (progn
                 (append-readiness-fpw-change store nil)
                 (let* ((end (pg::physical-store-flushed-lsn store))
                        (writer pg::*wal-fpw-state*)
                        (incarnation pg::*wal-storage-incarnation*))
                   (ok (= end (replay-source-fpw-change mode)))
                   (let ((expected (copy-list (getf pg::*physical-recovery-state* :source-fpw-fact))))
                     (pg::physical-store-compact store end #'pg::physical-restartpoint-publish)
                     (ok (< (getf expected :witness-start) (pg::physical-store-floor-lsn store)))
                     (dotimes (retry 2)
                       (declare (ignorable retry))
                       (setf (getf pg::*physical-recovery-state* :source-fpw-fact) nil
                             pg::*last-replay-lsn* 32 pg::*wal-checkpoint-lsn* 32 pg::*next-xid* 50)
                       (ok (= end (pg::physical-restartpoint-prepare-storage store)))
                       (let ((restored (getf pg::*physical-recovery-state* :source-fpw-fact)))
                         (ok (equal expected restored))
                         (ok (not (eq expected restored)))
                         (ok (not (getf restored :enabled)))
                         (ok (equal restored (getf (pg::physical-recovery-read-control root) :fpw-fact)))))
                     (append-readiness-fpw-change store t)
                     (ok (= (pg::physical-store-flushed-lsn store) (replay-source-fpw-change mode)))
                     (let ((fact (getf pg::*physical-recovery-state* :source-fpw-fact)))
                       (ok (eq t (getf fact :enabled)))
                       (ok (= (getf expected :last-disable-start) (getf fact :last-disable-start)))
                       (ok (eq writer pg::*wal-fpw-state*))
                       (ok (eq incarnation pg::*wal-storage-incarnation*))))))
            (close pg::*clog-stream*)
            (setf pg::*clog-stream* nil))))))

(rove:deftest source-fpw-invalid-batch-never-publishes-a-source-policy
    (dolist (mode '(:full :rows))
      (dolist (framing '(:outside :pages))
        (with-restartpoint-fixture (root store)
          (declare (ignore root))
          (let ((pg::*physical-replay-restarting-p* t)
                (pg::*wal-fpw-state* (list :unrelated-writer-policy)))
            (setf pg::*catalog* (pg::load-catalog))
            (pg::clog-init)
            (unwind-protect
                 (let ((cursor (pg::physical-store-flushed-lsn store))
                       (before (copy-tree pg::*physical-recovery-state*))
                       (writer pg::*wal-fpw-state*)
                       (incarnation pg::*wal-storage-incarnation*))
                   (when (eq framing :pages)
                     (let ((raw (sample-physical-record cursor)))
                       (pg::physical-store-input store cursor raw)
                       (incf cursor (length raw)))
                     (let ((raw (pg::wal-encode-record pg::+wal-record-pages+ 0 cursor
                                                       (pg::wal-encode-page-images nil 0))))
                       (pg::physical-store-input store cursor raw)
                       (incf cursor (length raw))))
                   (pg::physical-store-input
                    store cursor (pg::wal-encode-record pg::+wal-record-full-page-writes-change+ 0 cursor
                                                        (pg::wal-encode-full-page-writes-change nil)))
                   (pg::physical-store-flush store)
                   (ok (handler-case (progn (replay-source-fpw-change mode) nil)
                         (error (condition)
                           (search "metadata terminal" (princ-to-string condition)))))
                   (ok (= 96 pg::*last-replay-lsn*))
                   (ok (equal before pg::*physical-recovery-state*))
                   (ok (eq writer pg::*wal-fpw-state*))
                   (ok (eq incarnation pg::*wal-storage-incarnation*)))
              (close pg::*clog-stream*)
              (setf pg::*clog-stream* nil)))))))

(rove:deftest source-fpw-child-marker-restores-before-initialization-and-finishes-its-checkpoint
    (dolist (mode '(:full :rows))
      (dolist (enabled '(nil t))
        (with-restartpoint-fixture (root store)
          (declare (ignore root))
          (let ((pg::*physical-replay-restarting-p* t)
                (pg::*wal-fpw-state* (list :unrelated-writer-policy)))
            (setf pg::*catalog* (pg::load-catalog))
            (pg::clog-init)
            (unwind-protect
                 (progn
                   (selected-replay-test-prepare store)
                   (ok (= 152 (pg::physical-replay-from 96)))
                   (append-readiness-fpw-change store enabled)
                   (let* ((end (pg::physical-store-flushed-lsn store))
                          (writer pg::*wal-fpw-state*)
                          (incarnation pg::*wal-storage-incarnation*))
                     (ok (= end (replay-source-fpw-change mode)))
                     (pg::physical-store-compact store end #'pg::physical-restartpoint-publish)
                     (setf (getf pg::*physical-recovery-state* :source-fpw-fact) nil
                           (getf pg::*physical-recovery-state* :replay-timeline) 1
                           pg::*last-replay-lsn* 32 pg::*wal-checkpoint-lsn* 32 pg::*next-xid* 50)
                     (ok (= end (pg::physical-restartpoint-prepare-storage store)))
                     (ok (= 2 (pg::physical-recovery-replay-timeline)))
                     (ok (null (getf pg::*physical-recovery-state* :source-checkpoint)))
                     (let ((fact (getf pg::*physical-recovery-state* :source-fpw-fact)))
                       (ok (eq :change (getf fact :witness-kind)))
                       (ok (eql enabled (getf fact :enabled))))
                     (ok (pg::physical-promotion-awaiting-child-initialization-p))
                     (append-readiness-fpw-checkpoint store enabled)
                     (ok (= (pg::physical-store-flushed-lsn store) (pg::physical-replay-from end)))
                     (ok (not (pg::physical-promotion-awaiting-child-initialization-p)))
                     (ok (= 2 (getf (getf pg::*physical-recovery-state* :source-checkpoint) :timeline)))
                     (ok (eql enabled (getf (getf pg::*physical-recovery-state* :source-checkpoint)
                                            :full-page-writes)))
                     (ok (eq writer pg::*wal-fpw-state*))
                     (ok (eq incarnation pg::*wal-storage-incarnation*))))
              (close pg::*clog-stream*)
              (setf pg::*clog-stream* nil)))))))
