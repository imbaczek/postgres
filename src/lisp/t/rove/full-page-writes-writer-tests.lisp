(in-package #:pg)
(declaim (special *wal-fpw-state* *wal-fpw-test-hook*))

(defun call-with-unit-fpw-writer (function)
  (let* ((*wal-lock* (sb-thread:make-mutex :name "FPW writer test"))
         (*clog-lock* (sb-thread:make-mutex :name "FPW writer CLOG"))
         (*clog-pending-commits* (make-hash-table :test #'eql))
         (*wal-pending-page-publication* nil) (*wal-pending-page-publication-tail* nil)
         (*wal-temp-cleanup-domain* nil)
         (*wal-storage-incarnation* (gensym "FPW-WRITER-"))
         (*wal-ready* t) (*wal-poisoned* nil) (*wal-end-lsn* 0) (*wal-durable-lsn* 0)
         (*wal-insert-timeline* 3) (*physical-recovery-state* nil)
         (*wal-fpw-state* nil) (*wal-fpw-test-hook* nil)
         (events nil) (shutdown nil)
         (names '(wal-append-batch-start wal-append-record wal-flush
                  wal-settle-page-publications-under-lock wal-fail-stop request-fast-shutdown))
         (originals (mapcar (lambda (name) (cons name (symbol-function name))) names)))
    (labels ((policy ()
               (if (wal-fpw-state-p *wal-fpw-state*)
                   (list :known (wal-fpw-state-enabled *wal-fpw-state*)) :unknown)))
      (unwind-protect
           (progn
             (setf (symbol-function 'wal-settle-page-publications-under-lock)
                   (lambda () (push (list :settle) events))
                   (symbol-function 'wal-append-batch-start)
                   (lambda ()
                     (push (list :batch) events)
                     (prog1 *wal-end-lsn* (incf *wal-end-lsn* 32)))
                   (symbol-function 'wal-append-record)
                   (lambda (type xid payload)
                     (assert (sb-thread:holding-mutex-p *wal-lock*))
                     (assert (and (= type 17) (zerop xid)))
                     (push (list :marker (policy) (wal-decode-full-page-writes-change payload)) events)
                     (incf *wal-end-lsn* (+ 32 (length payload))))
                   (symbol-function 'wal-flush)
                   (lambda ()
                     (push (list :flush (policy)) events)
                     (setf *wal-durable-lsn* *wal-end-lsn*))
                   (symbol-function 'request-fast-shutdown)
                   (lambda () (setf shutdown t))
                   (symbol-function 'wal-fail-stop)
                   (lambda (condition)
                     (assert (not (sb-thread:holding-mutex-p *wal-lock*)))
                     (setf shutdown t)
                     (error condition)))
             (funcall function (lambda () (reverse events)) (lambda () shutdown)))
        (dolist (entry originals) (setf (symbol-function (car entry)) (cdr entry)))))))

(rove:deftest full-page-writes-writer-orders-on-and-off-and-skips-noops
    (call-with-unit-fpw-writer
     (lambda (events shutdown)
       (let ((first (handler-case (wal-report-full-page-writes t) (error () nil))))
         (rove:ok (eql 80 first))
         (rove:ok (wal-fpw-state-p *wal-fpw-state*))
         (when (wal-fpw-state-p *wal-fpw-state*)
           (let ((on *wal-fpw-state*) (count (length (funcall events))))
             (rove:ok (equal '(:known t) (second (find :marker (funcall events) :key #'first))))
             (rove:ok (= 80 (wal-report-full-page-writes t)))
             (rove:ok (= count (length (funcall events))))
             (rove:ok (= 160 (wal-report-full-page-writes nil)))
             (let* ((off *wal-fpw-state*)
                    (markers (remove :marker (funcall events) :key #'first :test-not #'eq))
                    (flushes (remove :flush (funcall events) :key #'first :test-not #'eq)))
               (rove:ok (equal '(:known t) (second (second markers))))
               (rove:ok (null (third (second markers))))
               (rove:ok (equal '(:known t) (second (second flushes))))
               (rove:ok (null (wal-fpw-state-enabled off)))
               (rove:ok (= 112 (wal-fpw-state-last-disable-start off)))
               (rove:ok (eq t (wal-fpw-state-enabled on)))
               (rove:ok (= 160 (wal-report-full-page-writes nil)))
               (rove:ok (= 240 (wal-report-full-page-writes t)))
               (rove:ok (null (wal-fpw-state-enabled off)))
               (rove:ok (= 112 (wal-fpw-state-last-disable-start *wal-fpw-state*)))
               (sb-thread:with-mutex (*wal-lock*)
                 (rove:ok (equal '(:full-page-writes t) (wal-current-full-page-writes-fields))))
               (rove:ok (not (funcall shutdown))))))))))

(rove:deftest full-page-writes-writer-refuses-before-publication
    (call-with-unit-fpw-writer
     (lambda (events shutdown)
       (let ((first (handler-case (wal-report-full-page-writes t) (error () nil))))
         (rove:ok (eql 80 first))
         (when first
           (let ((before (funcall events)))
             (dolist (bad '(0 :off "off"))
               (rove:ok (unit-commit-ts-error-p (lambda () (wal-report-full-page-writes bad)))))
             (rove:ok (unit-commit-ts-error-p
                       (lambda () (wal-report-full-page-writes nil (gensym "STALE-")))))
             (let ((*wal-ready* nil))
               (rove:ok (unit-commit-ts-error-p (lambda () (wal-report-full-page-writes nil)))))
             (let ((*physical-recovery-state* '(:phase 2)))
               (rove:ok (unit-commit-ts-error-p (lambda () (wal-report-full-page-writes nil)))))
             (let ((*wal-fpw-state* :unrecovered))
               (rove:ok (unit-commit-ts-error-p (lambda () (wal-report-full-page-writes nil)))))
             (rove:ok (equal before (funcall events)))
             (rove:ok (not *wal-poisoned*))
             (rove:ok (not (funcall shutdown)))))))))

(rove:deftest full-page-writes-writer-fences-errors-and-nonlocal-exits
    (dolist (enabled '(nil t))
      (dolist (point '(:before-record :after-record :after-flush :after-state))
        (dolist (exit '(nil t))
          (call-with-unit-fpw-writer
           (lambda (events shutdown)
             (declare (ignore events))
             (let ((first (handler-case (wal-report-full-page-writes (not enabled)) (error () nil))))
               (rove:ok (eql 80 first))
               (when first
                 (let ((*wal-fpw-test-hook*
                         (lambda (stage state)
                           (declare (ignore state))
                           (when (eq stage point)
                             (if exit (throw 'unit-fpw-exit :escaped)
                                 (error "injected FPW publication failure"))))))
                   (rove:ok (unit-commit-ts-error-p
                             (lambda () (catch 'unit-fpw-exit (wal-report-full-page-writes enabled))))))
                 (rove:ok *wal-poisoned*)
                 (rove:ok (funcall shutdown))))))))))
