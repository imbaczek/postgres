;;;; primitives-tests.lisp -- migrated unit regressions; run with pg-unit-tests.
(in-package #:pg)

(rove:deftest test-page-roundtrip
    (let ((p (page-init (make-page))))
      (rove:ok (= (page-lp-count p) 0) "empty page has no line pointers")
      (rove:ok (= (page-free-space p) (- +blcksz+ +size-of-page-header+))
               "empty page free space")
      (let ((item (make-array 8 :element-type '(unsigned-byte 8)
                                :initial-element 7)))
        (rove:ok (= (page-add-item p item) 1) "first item gets LP 1")
        (multiple-value-bind (off flags len) (page-get-lp p 1)
          (rove:ok (= flags +lp-normal+) "LP is normal")
          (rove:ok (= len 8) "LP length")
          (rove:ok (equalp (subseq p off (+ off 8)) item) "LP payload"))
        (rove:ok (= (page-add-item p item) 2) "second item gets LP 2")
        (rove:ok (= (page-lp-count p) 2) "two line pointers")
        (page-mark-dead p 1)
        (rove:ok (= (page-lp-count p) 2) "dead slot keeps the LP")
        (rove:ok (= (page-add-item p item :allow-reuse t) 3)
                 "dead slot is not reused before index cleanup")
        (page-mark-unused p 1)
        (rove:ok (= (page-add-item p item :allow-reuse t) 1)
                 "unused slot is reused when ALLOW-REUSE"))))

(rove:deftest test-backend-wait-state
    (let ((backend (make-backend))
          (backend-evaluations 0)
          (value-evaluations 0))
      (multiple-value-bind (first second)
          (with-backend-wait-state
              ((progn (incf backend-evaluations) backend)
               backend-waiting-xid
               (progn (incf value-evaluations) 8123))
            (rove:ok (= (backend-waiting-xid backend) 8123)
                     "wait-state macro publishes the wait value during its body")
            (values :first :second))
        (rove:ok (and (eq first :first) (eq second :second))
                 "wait-state macro preserves body values"))
      (rove:ok (and (= backend-evaluations 1) (= value-evaluations 1))
               "wait-state macro evaluates its arguments once")
      (rove:ok (null (backend-waiting-xid backend))
               "wait-state macro clears the field after normal return")
      (rove:ok (handler-case
                   (progn
                     (with-backend-wait-state (backend backend-waiting-xid 8124)
                       (error "test unwind"))
                     nil)
                 (error () t))
               "wait-state macro preserves errors")
      (rove:ok (null (backend-waiting-xid backend))
               "wait-state macro clears the field after an error")
      (let ((body-ran nil))
        (with-backend-wait-state (nil backend-waiting-xid 8125)
          (setf body-ran t))
        (rove:ok body-ran "wait-state macro supports a missing backend"))))

(rove:deftest test-heap-tuple-edit
    (let* ((relfilenode 987640)
           (block 4)
           (offnum 1)
           (current-page (page-init (make-page)))
           (tuple (make-array +size-of-heap-tuple-header+
                              :element-type '(unsigned-byte 8)
                              :initial-element 0))
           (read-count 0)
           (write-count 0)
           (dirty-count 0)
           (visibility-clears 0)
           (argument-evaluations 0))
      (page-add-item current-page tuple)
      (flet ((buf-read (rel block-number)
               (declare (ignore rel block-number))
               (incf read-count)
               current-page)
             (buf-write (rel block-number page)
               (declare (ignore rel block-number page))
               (incf write-count))
             (mark-dirty (rel)
               (declare (ignore rel))
               (incf dirty-count))
             (visibilitymap-clear (rel block-number)
               (declare (ignore rel block-number))
               (incf visibility-clears)))
        (let ((result
                (with-heap-tuple-edit
                    (page offset
                          (progn (incf argument-evaluations) relfilenode)
                          (progn (incf argument-evaluations) block)
                          (progn (incf argument-evaluations) offnum))
                  (page-set-u32 page (+ offset +heap-tuple-xmax-off+) 4567)
                  :edited)))
          (rove:ok (eq result :edited) "heap tuple edit preserves body values"))
        (rove:ok (= argument-evaluations 3)
                 "heap tuple edit evaluates relation, block, and offset once")
        (rove:ok (= (page-u32 current-page
                              (+ (nth-value 0 (page-get-lp current-page offnum))
                                 +heap-tuple-xmax-off+))
                    4567)
                 "heap tuple edit applies the tuple-header mutation")
        (rove:ok (= visibility-clears 1) "heap tuple edit clears visibility once")
        (rove:ok (and (= read-count 1) (= write-count 1) (= dirty-count 1))
                 "heap tuple edit reads, writes, and dirties once")
        (setf current-page (page-init (make-page)))
        (page-add-item current-page
                       (make-array 5 :element-type '(unsigned-byte 8)
                                     :initial-element 0))
        (rove:ok (handler-case
                     (progn
                       (with-heap-tuple-edit (page offset relfilenode block offnum)
                         (values page offset))
                       nil)
                   (error () t))
                 "heap tuple edit rejects a truncated tuple header")
        (rove:ok (and (= write-count 1) (= dirty-count 1))
                 "heap tuple edit does not publish a truncated tuple"))))

(rove:deftest test-with-registered-table
    (let* ((table (make-pg-class :oid 987641 :name "macro_table"
                                 :relfilenode 987642 :columns #() :indexes nil))
           (table-evaluations 0)
           (xid-evaluations 0)
           (events '())
           (body-ran nil))
      ;; Separate getter mocks isolate ID acquisition and count evaluations.
      (flet ((get-current-xid ()
               (incf xid-evaluations)
               987643)
             (get-current-reader-xid ()
               (incf xid-evaluations)
               987643)
             (register-relation-readers (relfilenodes xid)
               (declare (ignore xid))
               (rove:ok (equal relfilenodes '(987642))
                        "registered-table captures its reader relation set")
               (push :reader events))
             (register-relation-writer (relfilenode xid)
               (declare (ignore relfilenode xid))
               (push :writer events))
             (ensure-current-table (current-table)
               (rove:ok (eq current-table table)
                        "registered-table revalidates the same table")
               (rove:ok (sb-thread:holding-mutex-p *write-lock*)
                        "registered-table revalidates under the write lock")
               (push :revalidated events)))
        (with-registered-table
            ((progn (incf table-evaluations) table) relfilenode xid :write)
          (setf body-ran t)
          (rove:ok (= relfilenode 987642) "registered-table binds its relfilenode")
          (rove:ok (= xid 987643) "registered-table binds its transaction ID"))
        (rove:ok (equal (reverse events) '(:writer :revalidated))
                 "registered-table registers a writer before revalidation")
        (setf events '())
        (with-registered-table (table relfilenode xid :read)
          (rove:ok (and (= relfilenode 987642) (= xid 987643))
                   "registered-table binds its read relation and transaction ID"))
        (rove:ok (equal (reverse events) '(:reader :revalidated))
                 "registered-table selects the reader registration for :READ"))
      (rove:ok body-ran "registered-table executes its body")
      (rove:ok (and (= table-evaluations 1) (= xid-evaluations 2))
               "registered-table evaluates the table and XID once per use")))

(rove:deftest test-with-registered-relation-access-set
    (let ((relation-evaluations 0)
          (xid-evaluations 0)
          (writer-registrations 0)
          (events '())
          (body-ran nil))
      ;; Separate getter mocks isolate ID acquisition and count evaluations.
      (flet ((get-current-xid ()
               (incf xid-evaluations)
               987649)
             (get-current-reader-xid ()
               (incf xid-evaluations)
               987649)
             (register-relation-readers (relfilenodes xid)
               (rove:ok (equal (sort (copy-list relfilenodes) #'<)
                               '(987647 987648))
                        "relation access captures each reader once")
               (rove:ok (= xid 987649)
                        "relation access registers its captured transaction ID")
               (rove:ok (not (sb-thread:holding-mutex-p *write-lock*))
                        "relation readers register before catalog revalidation")
               (push :registered events))
             (register-relation-writer (relfilenode xid)
               (declare (ignore relfilenode xid))
               (incf writer-registrations)))
        (with-registered-relation-access
            (relfilenodes xid :read)
            (progn
              (incf relation-evaluations)
              '(987647 987648 987647))
            (progn
              (rove:ok (equal (sort (copy-list relfilenodes) #'<)
                              '(987647 987648))
                       "relation access deduplicates its captured set")
              (rove:ok (sb-thread:holding-mutex-p *write-lock*)
                       "relation access validates under the write lock")
              (push :validated events))
          (setf body-ran t)
          (rove:ok (not (sb-thread:holding-mutex-p *write-lock*))
                   "relation access releases the write lock before its body")
          (rove:ok (= xid 987649)
                   "relation access exposes its captured transaction ID"))
        (rove:ok (equal (reverse events) '(:registered :validated))
                 "relation access registers before revalidating")
        (rove:ok (and body-ran (= relation-evaluations 1) (= xid-evaluations 1))
                 "relation access evaluates its set and XID once")
        (rove:ok (handler-case
                     (progn
                       (with-registered-relation-access
                           (relfilenodes xid :write) '(987647 987648) nil)
                       nil)
                   (error () t))
                 "write relation access rejects a multi-relation set")
        (rove:ok (zerop writer-registrations)
                 "invalid write relation access registers no writer"))))
