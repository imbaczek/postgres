(in-package #:pg)

(defun unit-record-crc32-copy-reference (bytes)
  (let ((copy (copy-seq bytes)))
    (wal-set-u32 copy 28 0)
    (unit-crc32-generic-reference copy 0 (length copy))))

(cl-spec:defgenerator unit-record-crc32-arguments ()
  (let* ((size (+ 32 (random 8193)))
         (bytes (make-array size :element-type '(unsigned-byte 8))))
    (dotimes (index size) (setf (aref bytes index) (random 256)))
    (list (case (random 3)
            (0 (coerce (coerce bytes 'list) 'vector))
            (1 (make-array size :element-type '(unsigned-byte 8)
                                :initial-contents bytes :adjustable t :fill-pointer size))
            (t bytes)))))

(cl-spec:defspec-function wal-record-crc32 (:args (bytes (type vector)))
  (:args-generator unit-record-crc32-arguments)
  (:pre (and (>= (length bytes) +wal-header-size+)
             (every (lambda (value) (typep value '(unsigned-byte 8))) bytes)))
  (:returns (type (unsigned-byte 32)))
  (:post (= result (unit-record-crc32-copy-reference bytes))))

(setf (gethash '%wal-crc32-octets *unit-hot-probes*)
      (let ((bytes (make-array 300 :element-type '(unsigned-byte 8) :initial-element 173)))
        (append (list (list bytes 0 0 *wal-crc32-table*)
                      (list bytes 0 (length bytes) *wal-crc32-table*))
                (loop for seed in '(0 #xffffffff #x80000001)
                      append (loop for range in '((0 0) (0 1) (3 259))
                                   collect (list bytes (first range) (second range)
                                                 *wal-crc32-table* seed))))))

(rove:deftest record-crc32-matches-a-zeroed-copy-and-preserves-the-source
    (dolist (size '(32 33 63 64 65 127 128 129 159 160 161 255 256 257 511 512 513 8191 8192 8193))
      (let ((bytes (make-array size :element-type '(unsigned-byte 8))))
        (dotimes (index size) (setf (aref bytes index) (mod (+ 17 (* 73 index)) 256)))
        (dolist (stored '(0 #xffffffff #x12345678))
          (wal-set-u32 bytes 28 stored)
          (let ((before (copy-seq bytes)))
            (rove:ok (= (unit-record-crc32-copy-reference bytes) (wal-record-crc32 bytes)))
            #+x86-64
            (let ((*native-crc32c-sse42-available-p* nil)
                  (*native-crc32c-pclmul-available-p* nil))
              (rove:ok (= (unit-record-crc32-copy-reference bytes) (wal-record-crc32 bytes))))
            (rove:ok (equalp bytes before)))))))

(rove:deftest record-crc32-preserves-generic-and-noncanonical-table-behavior
    (flet ((outcome (function bytes)
             (handler-case (list :value (funcall function bytes))
               (error (condition) (list :error (type-of condition))))))
      (let* ((bytes (make-array 512 :element-type '(unsigned-byte 8) :initial-element 173))
             (generic (coerce (coerce bytes 'list) 'vector))
             (adjustable (make-array 512 :element-type '(unsigned-byte 8)
                                         :initial-contents bytes :adjustable t :fill-pointer 512))
             (displaced (make-array 500 :element-type '(unsigned-byte 8)
                                        :displaced-to bytes :displaced-index-offset 3)))
        (dolist (table (list *wal-crc32-table*
                             (make-array 256 :initial-contents (coerce *wal-crc32-table* 'list))
                             (make-array 1 :initial-element 0)))
          (let ((*wal-crc32-table* table))
            (dolist (input (list bytes generic adjustable displaced
                                 (make-array 0 :element-type '(unsigned-byte 8)) "bad" nil))
              (rove:ok (equal (outcome #'unit-record-crc32-copy-reference input)
                              (outcome #'wal-record-crc32 input))))))
        (let ((*wal-crc32-table* (copy-seq *wal-crc32-table*)))
          (dotimes (slot 256)
            (setf (aref bytes 0) (logxor #xff slot)
                  (aref *wal-crc32-table* slot) (logxor 1 (aref *wal-crc32-table* slot)))
            (rove:ok (= (unit-record-crc32-copy-reference bytes) (wal-record-crc32 bytes)))
            (setf (aref *wal-crc32-table* slot) (logxor 1 (aref *wal-crc32-table* slot))))))))

(rove:deftest record-crc32-keeps-versioned-decoder-corruption-checks-and-payload-ownership
    (dolist (version '(2 3 4 5 6 7 8))
      (let* ((payload (make-array 512 :element-type '(unsigned-byte 8) :initial-element 173))
             (bytes (wal-encode-record +wal-record-pages+ 3 0 payload)))
        (wal-set-u16 bytes 4 version)
        (wal-set-u32 bytes 28 (unit-record-crc32-copy-reference bytes))
        (let* ((before (copy-seq bytes))
               (record (wal-decode-record bytes 0)))
          (rove:ok (= version (wal-record-version record)))
          (rove:ok (equalp payload (wal-record-payload record)))
          (rove:ok (equalp bytes before))
          (setf (aref (wal-record-payload record) 0) 7)
          (rove:ok (= 173 (aref bytes +wal-header-size+)))
          (setf (aref bytes (+ +wal-header-size+ 1)) 9)
          (rove:ok (= 173 (aref (wal-record-payload record) 1)))
          (replace bytes before))
        (let ((corrupt (copy-seq bytes)))
          (setf (aref corrupt (+ +wal-header-size+ 7))
                (logxor 1 (aref corrupt (+ +wal-header-size+ 7))))
          (let ((before (copy-seq corrupt)))
            (rove:ok (handler-case (progn (wal-decode-record corrupt 0) nil)
                       (error (condition) (search "WAL checksum mismatch" (princ-to-string condition)))))
            (rove:ok (equalp corrupt before)))))))

(rove:deftest record-crc32-rejects-ieee-checksum
    (let* ((payload (make-array 128 :element-type '(unsigned-byte 8) :initial-element 173))
           (record (wal-encode-record +wal-record-pages+ 3 0 payload))
           (crc #xffffffff))
      (wal-set-u32 record 28 0)
      (loop for byte across record
            do (setf crc (logxor crc byte))
               (dotimes (bit 8)
                 (setf crc (logxor (ash crc -1)
                                   (if (oddp crc) #xedb88320 0)))))
      (wal-set-u32 record 28 (logxor crc #xffffffff))
      (rove:ok (handler-case (progn (wal-decode-record record 0) nil)
                 (error (condition)
                   (search "WAL checksum mismatch" (princ-to-string condition)))))))

(rove:deftest record-crc32-generated-copy-equivalence-contract
    (let ((data (cl-spec:result-data
                 (cl-spec:check-function 'wal-record-crc32 :trials 100 :seed 3402))))
      (rove:ok (eq :passed (getf data :status)) (format nil "~s" data))))

(rove:deftest record-crc32-typed-checksums-do-not-allocate
    (let ((changed (copy-seq *wal-crc32-table*)))
      (setf (aref changed 0) (logxor 1 (aref changed 0)))
      (dolist (table (list *wal-crc32-table* changed))
        (let ((*wal-crc32-table* table))
          (dolist (size '(32 159 160 8192 8193))
            (let* ((bytes (make-array size :element-type '(unsigned-byte 8) :initial-element 173))
                   (arguments (list bytes)))
              (rove:ok (zerop (unit-hot-call-allocated-bytes #'wal-record-crc32 arguments)))
              #+x86-64
              (let ((*native-crc32c-sse42-available-p* nil)
                    (*native-crc32c-pclmul-available-p* nil))
                (rove:ok (zerop (unit-hot-call-allocated-bytes #'wal-record-crc32 arguments))))))))))
