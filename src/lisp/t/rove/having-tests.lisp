;;;; having-tests.lisp -- grouped filters, singleton groups and subplan ownership.
(in-package #:pg)

(rove:deftest having-grouped-and-hidden-aggregates
    (dolist (case
                '(("SELECT d.x FROM (SELECT 1 AS x UNION ALL SELECT 1 UNION ALL SELECT 2) d GROUP BY d.x HAVING count(*)=1" ((2)))
                  ("SELECT d.x,count(*) FROM (SELECT 1 AS x UNION ALL SELECT 1 UNION ALL SELECT 2) d GROUP BY d.x HAVING d.x=1" ((1 2)))
                  ("SELECT 9 FROM (SELECT 1 AS x UNION ALL SELECT 2) d HAVING sum(d.x)=3" ((9)))
                  ("SELECT sum(d.x) FROM (SELECT 1 AS x UNION ALL SELECT 2) d HAVING count(*)=2" ((3)))
                  ("SELECT d.x FROM (SELECT 1 AS x UNION ALL SELECT 1 UNION ALL SELECT 2) d GROUP BY d.x HAVING count(*)=2 OR sum(d.x)=2 ORDER BY d.x" ((1) (2)))
                  ("SELECT d.x,row_number() OVER(ORDER BY d.x) FROM (SELECT 1 AS x UNION ALL SELECT 1 UNION ALL SELECT 2) d GROUP BY d.x HAVING count(*)=1" ((2 1)))
                  ("SELECT DISTINCT 1 FROM (SELECT 1 AS x UNION ALL SELECT 2) d GROUP BY d.x HAVING d.x>1 ORDER BY 1 LIMIT 1" ((1)))))
      (rove:ok (equalp (second case) (subquery-test-rows (first case))) (first case))))

(rove:deftest having-implicit-singleton-and-empty-input
    (let* ((*catalog* (make-catalog))
           (*backend* (make-backend :database "postgres"))
           (database (make-database :name "postgres" :oid 1)))
      (setf (gethash "postgres" (catalog-databases *catalog*)) database)
      (setf (gethash "having_unused_seq" (database-sequences database))
            (make-pg-sequence :name "having_unused_seq" :oid 9903 :last-value 37))
      (dolist (case
                  '(("SELECT 1 HAVING true" ((1)))
                    ("SELECT 1 HAVING false" nil)
                    ("SELECT 1 HAVING false AND 1/0>0" nil)
                    ("SELECT 1 HAVING NOT true AND 1/0>0" nil)
                    ("SELECT 1 HAVING ((true OR nextval('having_unused_seq')>0) IS FALSE) AND 1/0>0" nil)
                    ("SELECT 1 HAVING (true OR nextval('having_unused_seq')>0) IN(false) AND 1/0>0" nil)
                    ("SELECT 1 HAVING (true OR nextval('having_unused_seq')>0) IN(false,false) AND 1/0>0" nil)
                    ("SELECT 1 HAVING ((nextval('having_unused_seq')>0 OR true) IS FALSE) AND 1/0>0" nil)
                    ("SELECT count(*) HAVING ((nextval('having_unused_seq')>0 OR true) IS FALSE) AND 1/0>0" nil)
                    ("SELECT 1 HAVING NULL AND nextval('having_unused_seq')>0" nil)
                    ("SELECT 1 HAVING CASE WHEN true THEN false ELSE nextval('having_unused_seq')>0 END AND 1/0>0" nil)
                    ("SELECT 1 HAVING COALESCE(false,nextval('having_unused_seq')>0) AND 1/0>0" nil)
                    ("SELECT 1 HAVING (true IS FALSE) AND 1/0>0" nil)
                    ("SELECT 1 HAVING (1 IS NULL) AND 1/0>0" nil)
                    ("SELECT 1 HAVING (false OR false) AND 1/0>0" nil)
                    ("SELECT 1 HAVING COALESCE(false,true) AND 1/0>0" nil)
                    ("SELECT 1 HAVING CASE WHEN true THEN false ELSE true END AND 1/0>0" nil)
                    ("SELECT 1 HAVING length('')=1 AND 1/0>0" nil)
                    ("SELECT 1 HAVING lower('')='x' AND 1/0>0" nil)
                    ("SELECT 1 HAVING substr('abc',1,1)='b' AND 1/0>0" nil)
                    ("SELECT 1 HAVING (true OR 1/0>0)" ((1)))
                    ("SELECT 1 HAVING nextval('having_unused_seq')>0 OR true" ((1)))
                    ("SELECT count(*) HAVING nextval('having_unused_seq')>0 OR true" ((1)))
                    ("SELECT count(*) FROM (SELECT 0 AS x) d WHERE 1/d.x=0 HAVING NOT true" nil)
                    ("SELECT 1 HAVING NULL" nil)
                    ("SELECT 1 WHERE false HAVING true" ((1)))
                    ("SELECT 1 FROM (SELECT 1 AS x WHERE false) d HAVING true" ((1)))
                    ("SELECT 1 FROM (SELECT 1 AS x UNION ALL SELECT 2) d HAVING true" ((1)))
                    ("SELECT 1 FROM (SELECT 1 AS x) d WHERE 1/d.x=0 HAVING true" ((1)))
                    ("SELECT 1 FROM (SELECT 0 AS x) d WHERE 1/d.x=1 HAVING true" ((1)))
                    ("SELECT count(*) FROM (SELECT 1 AS x WHERE false) d HAVING count(*)=0" ((0)))
                    ("SELECT count(*) FROM (SELECT 1 AS x WHERE false) d HAVING count(*)>0" nil)
                    ("SELECT sum(d.x) FROM (SELECT 0 AS x) d HAVING false" nil)
                    ("SELECT 1 FROM (SELECT 0 AS x) d HAVING sum(1/d.x)>0 AND false" nil)
                    ("SELECT count(*) FROM (SELECT 0 AS x) d WHERE 1/d.x=0 HAVING false" nil)
                    ("SELECT count(*) FROM (SELECT 0 AS x) d WHERE 1/d.x=0 HAVING count(*)>0 AND NULL" nil)
                    ("SELECT EXISTS(SELECT 1 WHERE false HAVING true),EXISTS(SELECT 1 HAVING false)" ((t nil)))))
        (rove:ok (equalp (second case) (subquery-test-rows (first case))) (first case)))))

(rove:deftest having-subqueries-and-cte-cursors
    (dolist (case
                '(("SELECT d.x FROM (SELECT 1 AS x UNION ALL SELECT 1 UNION ALL SELECT 2) d GROUP BY d.x HAVING EXISTS(SELECT 1 WHERE d.x=2)" ((2)))
                  ("SELECT d.x FROM (SELECT 1 AS x UNION ALL SELECT 2) d GROUP BY d.x HAVING (SELECT d.x)>1" ((2)))
                  ("SELECT 9 FROM (SELECT 1 AS x UNION ALL SELECT 2) d HAVING (SELECT sum(d.x))=3" ((9)))
                  ("SELECT d.x,(SELECT 1 HAVING d.x>1) FROM (SELECT 1 AS x UNION ALL SELECT 2) d ORDER BY d.x" ((1 :null) (2 1)))
                  ("SELECT d.x,(SELECT count(*) HAVING d.x>1) FROM (SELECT 9 AS y,1 AS x UNION ALL SELECT 9,2) d GROUP BY d.x ORDER BY d.x" ((1 :null) (2 1)))
                  ("WITH q AS MATERIALIZED(SELECT d.x,count(*) AS n FROM (SELECT 1 AS x UNION ALL SELECT 1 UNION ALL SELECT 2) d GROUP BY d.x HAVING count(*)>1) SELECT * FROM q" ((1 2)))
                  ("WITH q AS MATERIALIZED(SELECT 1 AS x WHERE false HAVING true) SELECT * FROM q" ((1)))
                  ("WITH q AS NOT MATERIALIZED(SELECT 1 AS x HAVING false) SELECT EXISTS(SELECT * FROM q)" ((nil)))
                  ("WITH q AS (SELECT 1 AS x HAVING 1/0>0) SELECT 2" ((2)))
                  ("WITH q AS MATERIALIZED(SELECT 1 AS x HAVING 1/0>0) SELECT 2" ((2)))
                  ("WITH q AS NOT MATERIALIZED(SELECT 1 AS x HAVING 1/0>0) SELECT 2" ((2)))
                  ("SELECT (WITH q AS MATERIALIZED(SELECT 1 AS v HAVING d.x>1) SELECT count(*) FROM q) FROM (SELECT 1 AS x UNION ALL SELECT 2) d ORDER BY d.x" ((0) (1)))))
      (rove:ok (equalp (subquery-test-expected (second case)) (subquery-test-rows (first case)))
               (first case))))

(rove:deftest having-validation-boundaries
    (dolist (case
                '(("SELECT d.x FROM (SELECT 1 AS x) d HAVING count(*)>0" "42803")
                  ("SELECT 1 FROM (SELECT 1 AS x) d HAVING d.x>0" "42803")
                  ("SELECT 1 FROM (SELECT 1 AS x) d HAVING (SELECT d.x)>0" "42803")
                  ("SELECT 1 AS x HAVING x>0" "42703")
                  ("SELECT 1 HAVING 1" "42804")
                  ("WITH q AS (SELECT 1 AS x HAVING 1/0>0) SELECT * FROM q" "22012")
                  ("SELECT 1 HAVING 1/0>0 AND false" "22012")
                  ("SELECT 1 WHERE false HAVING 1/0>0" "22012")
                  ("SELECT count(*) WHERE false HAVING 1/0>0" "22012")
                  ("SELECT 1 HAVING NULL AND 1/0>0" "22012")
                  ("SELECT 1 HAVING false OR 1/0>0" "22012")
                  ("SELECT 1 FROM (SELECT 1 AS x) d GROUP BY d.x HAVING d.x IN(1,1/0) AND false" "22012")
                  ("SELECT 1 HAVING current_database()='no_such_database' AND 1/0>0" "22012")
                  ("SELECT 1 HAVING row_number() OVER()>0" "42P20")
                  ("SELECT 1 HAVING pg_get_publication_tables('x') IS NULL" "0A000")
                  ("SELECT 1 HAVING sum(sum(1))>0" "42803")))
      (rove:ok (handler-case
                   (progn (plan-select-query (first (parse-statements (first case)))) nil)
                 (pg-error (condition) (string= (second case) (pg-error-sqlstate condition))))
               (first case))))
