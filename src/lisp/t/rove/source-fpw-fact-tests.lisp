(in-package #:pg)

(defun unit-source-fpw-fact (&key (enabled nil) (start 32))
  (list :enabled enabled :witness-kind :change :witness-start start :witness-end (+ start 48)
        :witness-timeline 1 :coverage-start start :coverage-timeline 1
        :through (+ start 48) :through-timeline 1
        :last-disable-start (unless enabled start) :last-disable-timeline (unless enabled 1)))

(defun unit-source-fpw-checkpoint (policy start)
  (let* ((record (unit-fpw-checkpoint-record policy start))
         (snapshot (wal-checkpoint-record-snapshot record)))
    (setf (getf snapshot :timeline) 1 (getf snapshot :prev-timeline) 1
          (wal-record-payload record) (wal-encode-checkpoint-snapshot snapshot))
    record))

(cl-spec:defgenerator unit-source-fpw-arguments ()
  (list (unit-source-fpw-fact :enabled (zerop (random 2)) :start (+ 32 (random 1000000)))))

(cl-spec:defspec-function physical-fpw-encode-fact
    (:args (fact (type list)))
  (:args-generator unit-source-fpw-arguments)
  (:pre (physical-fpw-fact-valid-p fact))
  (:returns (type (simple-array (unsigned-byte 8) (72))))
  (:post (equal fact (physical-fpw-decode-fact result))))

(cl-spec:defproperty source-fpw-fact-codec-roundtrip
    ((enabled (member nil t)) (start (range integer 32 1000000)))
  (:about physical-fpw-encode-fact physical-fpw-decode-fact)
  (:trials (:normal 100))
  (let ((fact (unit-source-fpw-fact :enabled enabled :start start)))
    (equal fact (physical-fpw-decode-fact (physical-fpw-encode-fact fact)))))

(rove:deftest source-fpw-fact-strict-shape-and-copy
    (let* ((fact (unit-source-fpw-fact)) (copy (physical-fpw-copy-fact fact)))
      (rove:ok (physical-fpw-fact-valid-p fact))
      (rove:ok (equal fact copy)) (rove:ok (not (eq fact copy)))
      (setf (getf copy :enabled) t)
      (rove:ok (null (getf fact :enabled)))
      (rove:ok (null (physical-fpw-copy-fact nil)))
      (rove:ok (not (physical-fpw-fact-valid-p nil)))
      (dolist (bad (list (append fact '(:extra 0)) (append fact '(:enabled nil))
                         (cddr fact) (cons :through (cons 80 fact)) (cons :enabled t)
                         (let ((cycle (copy-list fact))) (setf (cdr (last cycle)) cycle) cycle)))
        (rove:ok (not (physical-fpw-fact-valid-p bad)))
        (rove:ok (unit-commit-ts-error-p (lambda () (physical-fpw-copy-fact bad)))))
      (dolist (pair '((:enabled 0) (:witness-kind :other) (:witness-start -1)
                      (:witness-end 79) (:witness-timeline 0) (:coverage-start 33)
                      (:coverage-timeline 2) (:through 79) (:through-timeline 0)
                      (:through 18446744073709551616)
                      (:last-disable-start nil) (:last-disable-timeline nil)))
        (let ((bad (copy-list fact)))
          (setf (getf bad (first pair)) (second pair))
          (rove:ok (not (physical-fpw-fact-valid-p bad)))))))

(rove:deftest source-fpw-state-adapter-keeps-owner-local
    (dolist (enabled '(nil t))
      (let* ((owner (gensym "FPW-LOCAL-"))
             (other (gensym "FPW-RESTORE-"))
             (state (wal-fpw-state-next nil (unit-fpw-change-record enabled :start 32) 1 owner))
             (fact (physical-fpw-fact-from-state state 80 1))
             (restored (physical-fpw-state-from-fact fact other)))
        (rove:ok (equal (unit-source-fpw-fact :enabled enabled) fact))
        (rove:ok (= 1 (wal-fpw-state-coverage-timeline state)))
        (rove:ok (not (member owner fact)))
        (rove:ok (not (member other fact)))
        (rove:ok (eq other (wal-fpw-state-incarnation restored)))
        (rove:ok (eq owner (wal-fpw-state-incarnation state)))
        (rove:ok (equal fact (physical-fpw-fact-from-state restored 80 1)))
        (rove:ok (unit-commit-ts-error-p (lambda () (physical-fpw-fact-from-state state 79 1))))
        (rove:ok (unit-commit-ts-error-p (lambda () (physical-fpw-state-from-fact fact nil)))))))

(rove:deftest source-fpw-fact-proves-selected-position-owners
    (let* ((history (timeline-parse-history 3 (format nil "1 0/A0 ancestor~%")))
           (fact (unit-source-fpw-fact :enabled t)))
      (setf (getf fact :through) 160)
      (rove:ok (equal fact (physical-fpw-check-fact fact history 160 1)))
      (rove:ok (unit-commit-ts-error-p (lambda () (physical-fpw-check-fact fact history 160 3))))
      (dolist (pair '((:witness-timeline 2) (:coverage-timeline 2) (:through-timeline 2)))
        (let ((bad (copy-list fact)))
          (setf (getf bad (first pair)) (second pair))
          (rove:ok (unit-commit-ts-error-p (lambda () (physical-fpw-check-fact bad history 160 1))))))
      (let ((crossed (unit-source-fpw-fact :enabled t :start 136)))
        (rove:ok (unit-commit-ts-error-p (lambda () (physical-fpw-check-fact crossed history 184 1)))))
      (let ((at-fork (unit-source-fpw-fact :start 112)))
        (rove:ok (equal at-fork (physical-fpw-check-fact at-fork history 160 1)))
        (setf (getf at-fork :last-disable-timeline) 2)
        (rove:ok (unit-commit-ts-error-p (lambda () (physical-fpw-check-fact at-fork history 160 1)))))
      (rove:ok (unit-commit-ts-error-p (lambda () (physical-fpw-check-fact fact nil 160 1))))))

(rove:deftest source-fpw-fold-keeps-disable-history-and-exact-through
    (let* ((history (timeline-parse-history 1 ""))
           (off-record (unit-fpw-change-record nil :start 32))
           (on-record (unit-fpw-change-record t :start 112))
           (off (physical-fpw-fact-next nil off-record 1 history))
           (on (physical-fpw-fact-next off on-record 1 history))
           (checkpoint (unit-source-fpw-checkpoint t 192))
           (saved (copy-tree (wal-checkpoint-record-snapshot checkpoint)))
           (after (physical-fpw-fact-next on checkpoint 1 history)))
      (let ((*gensym-counter* 12345))
        (physical-fpw-fact-next off on-record 1 history)
        (rove:ok (= 12345 *gensym-counter*)))
      (rove:ok (null (getf off :enabled)))
      (rove:ok (eq t (getf on :enabled)))
      (rove:ok (= 32 (getf on :last-disable-start)))
      (rove:ok (= 160 (getf on :through)))
      (rove:ok (eq :checkpoint (getf after :witness-kind)))
      (rove:ok (= 32 (getf after :coverage-start) (getf after :last-disable-start)))
      (rove:ok (= 1 (getf after :coverage-timeline)))
      (rove:ok (= (wal-record-end checkpoint) (getf after :through)))
      (rove:ok (equal saved (wal-checkpoint-record-snapshot checkpoint)))
      (rove:ok (unit-commit-ts-error-p (lambda () (physical-fpw-fact-next on off-record 1 history))))
      (let ((nonterminal (make-wal-record :version 8 :type 6 :start 400 :end 432 :xid 0
                                          :payload (make-array 0 :element-type '(unsigned-byte 8)))))
        (rove:ok (unit-commit-ts-error-p
                  (lambda () (physical-fpw-fact-next after nonterminal 1 history)))))))

(rove:deftest source-fpw-fact-binary-codec-independent
    (let* ((fact (unit-source-fpw-fact))
           (expected (make-array 72 :element-type '(unsigned-byte 8) :initial-element 0)))
      (replace expected #(80 71 70 80 87 70 67 49))
      (loop for offset in '(8 16 24 32 36 40 48 56 60 64)
            for value in '(4 32 80 1 1 32 80 1 1 32)
            do (setf (aref expected offset) value))
      (rove:ok (equalp expected (physical-fpw-encode-fact fact)))
      (rove:ok (equal fact (physical-fpw-decode-fact expected)))
      (dolist (offset '(0 8 12 16 24 32 36 48 56 60 64))
        (let ((bad (copy-seq expected)))
          (setf (aref bad offset) (cond ((= offset 8) 8) ((member offset '(48 56)) 0) (t 255)))
          (rove:ok (unit-commit-ts-error-p (lambda () (physical-fpw-decode-fact bad))))))
      (dotimes (bit 32)
        (let ((bad (copy-seq expected)))
          (wal-set-u32 bad 8 (logxor 4 (ash 1 bit)))
          (rove:ok (unit-commit-ts-error-p (lambda () (physical-fpw-decode-fact bad))))))
      (loop for index from 12 below 16
            do (let ((bad (copy-seq expected)))
                 (setf (aref bad index) 1)
                 (rove:ok (unit-commit-ts-error-p (lambda () (physical-fpw-decode-fact bad))))))
      (let ((on (copy-seq expected)))
        (setf (aref on 8) 1)
        (fill on 0 :start 60 :end 72)
        (rove:ok (equal (unit-source-fpw-fact :enabled t) (physical-fpw-decode-fact on)))
        (loop for index from 60 below 72
              do (let ((bad (copy-seq on)))
                   (setf (aref bad index) 1)
                   (rove:ok (unit-commit-ts-error-p (lambda () (physical-fpw-decode-fact bad)))))))
      (dolist (enabled '(nil t))
        (dolist (disabled '(nil t))
          (dolist (payload '(88 96 136 144))
            (let* ((checkpoint (unit-source-fpw-fact :enabled enabled :start 128))
                   (end (+ 128 32 payload)))
              (setf (getf checkpoint :witness-kind) :checkpoint
                    (getf checkpoint :witness-end) end (getf checkpoint :through) end
                    (getf checkpoint :coverage-start) (if disabled 32 128)
                    (getf checkpoint :last-disable-start) (when disabled 32)
                    (getf checkpoint :last-disable-timeline) (when disabled 1))
              (let ((bytes (physical-fpw-encode-fact checkpoint)))
                (rove:ok (= (+ 2 (if enabled 1 0) (if disabled 4 0)) (aref bytes 8)))
                (rove:ok (equal checkpoint (physical-fpw-decode-fact bytes))))))))
      (dolist (length '(0 71 73))
        (rove:ok (unit-commit-ts-error-p
                  (lambda () (physical-fpw-decode-fact
                              (make-array length :element-type '(unsigned-byte 8) :initial-element 0))))))
      (setf (getf fact :through) 18446744073709551615)
      (loop for index from 48 below 56 do (setf (aref expected index) 255))
      (rove:ok (equalp expected (physical-fpw-encode-fact fact)))
      (rove:ok (equal fact (physical-fpw-decode-fact expected)))))

(rove:deftest source-fpw-fact-generated-contracts
    (dolist (data (list (cl-spec:result-data
                         (cl-spec:check-function 'physical-fpw-encode-fact :trials 100 :seed 261))
                        (cl-spec:result-data
                         (cl-spec:run-property 'source-fpw-fact-codec-roundtrip :seed 262))))
      (rove:ok (eq :passed (getf data :status)) (format nil "~s" data))))

(rove:deftest source-fpw-fold-advances-through-nonpolicy-and-selected-eor
    (let* ((history (timeline-parse-history 3 (format nil "1 0/90 ancestor~%")))
           (*wal-fpw-state* :unchanged)
           (off (physical-fpw-fact-next nil (unit-fpw-change-record nil :start 32) 1 history))
           (maintenance (make-wal-record :version 8 :type 9 :start 112 :end 144 :xid 0
                                         :payload (make-array 0 :element-type '(unsigned-byte 8))))
           (middle (physical-fpw-fact-next off maintenance 1 history))
           (eor (make-wal-record :version 8 :type 13 :start 144 :end 200 :xid 0
                                 :payload (wal-encode-end-of-recovery-payload 0 3 1 1)))
           (child (physical-fpw-fact-next middle eor 3 history))
           (on (physical-fpw-fact-next child (unit-fpw-change-record t :start 232) 3 history)))
      (rove:ok (= 144 (getf middle :through)))
      (rove:ok (= 32 (getf middle :witness-start) (getf middle :last-disable-start)))
      (rove:ok (= 1 (getf middle :through-timeline)))
      (rove:ok (= 200 (getf child :through)))
      (rove:ok (= 3 (getf child :through-timeline)))
      (rove:ok (= 1 (getf child :witness-timeline) (getf child :coverage-timeline)))
      (rove:ok (eq t (getf on :enabled)))
      (rove:ok (= 3 (getf on :witness-timeline)))
      (rove:ok (= 1 (getf on :coverage-timeline) (getf on :last-disable-timeline)))
      (rove:ok (= 32 (getf on :last-disable-start)))
      (rove:ok (eq :unchanged *wal-fpw-state*))
      (setf (wal-record-payload eor) (wal-encode-end-of-recovery-payload 0 3 2 1))
      (rove:ok (unit-commit-ts-error-p (lambda () (physical-fpw-fact-next middle eor 3 history))))
      (setf (wal-record-payload eor) (wal-encode-end-of-recovery-payload 0 2 1 1))
      (rove:ok (unit-commit-ts-error-p (lambda () (physical-fpw-fact-next middle eor 3 history))))))
