           (scan '(:seq-scan 0 42))
           (targets (list (list :expr (list :col 1 :type :int4 :typmod -1))))
           (node (list :project targets scan))
           (demand (simple-select-toast-demand node relations))
           (pointer (make-heap-external-varlena :raw-size 5004 :external-info 5000
                                                :value-id 42 :relation-id 7 :id-width 4))
           (tuple (make-htup :values (vector 3 pointer))))
      (rove:ok (equal (cdr demand) '(1)))
      (let ((*select-toast-demand* demand))
        ;; No TOAST relation exists: this succeeds only if the unused pointer is skipped.
        (materialize-select-tuple table tuple nil :demand *select-toast-demand*)
        (rove:ok (equalp (htup-values tuple) (vector 3 +null+))))
      ;; An unrelated caller must fetch even while an outer scan has a demand hint.
      (rove:ok (handler-case
                   (let ((*select-toast-demand* demand))
                     (materialize-select-tuple table (make-htup :values (vector 3 pointer)) nil)
                     nil)
                 (pg-error () t)))
      (let* ((index (make-pg-index :oid 99 :table-oid 42))
             (path (make-select-scan-path :kind :index-scan :index index))
             (index-relations (list (list :table table :path path)))
             (qual '(:binop "=" (:col 1) (:const 3)))
             (index-scan (list :index-scan 0 42 99 qual #() nil))
             (index-node (list :project targets (list :filter qual index-scan))))
        (rove:ok (equal '(1) (cdr (simple-select-toast-demand index-node index-relations))))
        ;; The index qualification can require a slot absent from the filter and targets.
        (setf (fifth index-scan) '(:binop "=" (:col 2) (:const "x")))
        (let ((needed (cdr (simple-select-toast-demand index-node index-relations))))
          (rove:ok (and (member 1 needed) (member 2 needed))))
        (setf (fifth index-scan) '(:subplan opaque))
        (rove:ok (null (simple-select-toast-demand index-node index-relations)))
        (setf (fifth index-scan) qual
              (seventh index-scan) '(:outer-ref 1 (:col 1)))
        (rove:ok (null (simple-select-toast-demand index-node index-relations))))
      (let ((ordered (simple-select-toast-demand
                      (list :sort (list (cons '(:col 2) nil)) node) relations)))
        (rove:ok (and ordered (member 1 (cdr ordered)) (member 2 (cdr ordered)))))
      (rove:ok (equal '(1) (cdr (simple-select-toast-demand
                                 (list :top-n (list (cons '(:sort-output 1) nil)) 1 node)
                                 relations))))
      (rove:ok (null (simple-select-toast-demand
                      (list :sort (list (cons '(:sort-output 2) nil)) node) relations)))
      (rove:ok (null (simple-select-toast-demand
                      (list :sort (list (cons '(:subplan opaque) nil)) node) relations)))
      (rove:ok (null (simple-select-toast-demand (list :window nil node) relations)))
      (let ((filtered (simple-select-toast-demand
                       (list :project
                             (list (list :expr '(:binop "+" (:col 1) (:const 1))))
                             (list :filter '(:is-null (:col 2) nil) scan))
                       relations)))
        (rove:ok (and filtered (member 1 (cdr filtered)) (member 2 (cdr filtered)))))
      (rove:ok (equal '(1)
                      (cdr (simple-select-toast-demand
                            (list :project (list (list :expr '(:func "abs" ((:col 1)))))
                                  (list :filter '(:binop "=" (:col 1) (:const 3)) scan))
                            relations))))
      (rove:ok (null (simple-select-toast-demand
                      (list :project targets (list :filter '(:subplan opaque) scan)) relations)))
      (rove:ok (null (simple-select-toast-demand
                      (list :project (list (list :expr '(:func "f" ((:subplan opaque))))) scan)
                      relations)))
      (let ((selected (make-htup :values (vector 3 pointer))))
        (rove:ok (handler-case
                     (let ((*select-toast-demand* (cons table '(2))))
                       (materialize-select-tuple table selected nil :demand *select-toast-demand*) nil)
                   (pg-error () t))))))

