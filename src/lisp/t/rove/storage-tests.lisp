         (array (make-sql-array :element-type-id :bytea :elements items
                                :dimensions '(9) :lower-bounds '(1))))
    (setf (aref items 0) (make-array 0 :element-type '(unsigned-byte 8))
          (aref items 8) (make-array 0 :element-type '(unsigned-byte 8)))
    (let ((encoded (sql-varlena-array-encode array :bytea)))
      (rove:ok (= 32 (page-u32 encoded 4)))
      (rove:ok (= 1 (aref encoded 20)))
      (rove:ok (= 1 (aref encoded 21)))
      (rove:ok (= 9 (length (sql-array-elements (sql-varlena-array-decode encoded :bytea)))))))
  (let ((bad (make-array 20 :element-type '(unsigned-byte 8) :initial-element 0)))
    (page-set-u32 bad 0 1) (page-set-u32 bad 8 17)
    (page-set-u32 bad 12 100000000) (page-set-u32 bad 16 1)
    (let ((before (sb-ext:get-bytes-consed)))
      (rove:ok (handler-case (progn (sql-varlena-array-decode bad :bytea) nil)
                 (pg-error (condition) (string= (pg-error-sqlstate condition) "XX001"))))
      (rove:ok (< (- (sb-ext:get-bytes-consed) before) (* 16 1024 1024)))))
  (let* ((count (1+ +max-varlena-array-elements+))
         (start (maxalign (+ 24 (ceiling count 8))))
         (bad (make-array (- start 4) :element-type '(unsigned-byte 8) :initial-element 0)))
    (page-set-u32 bad 0 1) (page-set-u32 bad 4 start) (page-set-u32 bad 8 17)
    (page-set-u32 bad 12 count) (page-set-u32 bad 16 1)
    (let ((before (sb-ext:get-bytes-consed)))
      (rove:ok (handler-case (progn (sql-varlena-array-decode bad :bytea) nil)
                 (pg-error (condition) (string= (pg-error-sqlstate condition) "54000"))))
      (rove:ok (< (- (sb-ext:get-bytes-consed) before) (* 16 1024 1024)))))
  (let* ((array (make-sql-array :element-type-id :json :elements (vector "{}")
                                :dimensions '(1) :lower-bounds '(1)))
         (encoded (sql-varlena-array-encode array :json)))
    (dolist (octet '(255 120))
      (let ((bad (copy-seq encoded)))
        (setf (aref bad 24) octet)
        (rove:ok (handler-case (progn (sql-varlena-array-decode bad :json) nil)
                   (pg-error (condition) (string= (pg-error-sqlstate condition) "XX001"))))))))

(rove:deftest test-varlena-array-codec-interrupts
    (let* ((items (make-array 5000 :initial-element +null+))
           (array (make-sql-array :element-type-id :bytea :elements items
                                  :dimensions '(5000) :lower-bounds '(1)))
           (encoded (sql-varlena-array-encode array :bytea))
           (old (symbol-function 'check-for-interrupts))
           (polls 0))
      (unwind-protect
           (progn
             (setf (symbol-function 'check-for-interrupts)
                   (lambda () (when (= (incf polls) 3) (error "injected cancellation"))))
             (dolist (operation (list (lambda () (sql-varlena-array-encode array :bytea))
                                      (lambda () (sql-varlena-array-decode encoded :bytea))))
               (setf polls 0)
               (rove:ok (handler-case (progn (funcall operation) nil)
                          (error (condition) (search "injected cancellation" (princ-to-string condition)))))))
        (setf (symbol-function 'check-for-interrupts) old))))

(rove:deftest test-varlena-arrays-in-heap-tuples
    (let* ((types '(:bytea-array :json-array :jsonb-array))
           (elements '(:bytea :json :jsonb))
           (columns (coerce (loop for type in types for i from 1
                                  collect (make-pg-column :name (format nil "c~d" i) :type type
                                                          :typmod -1 :attnum i)) 'vector))
           (values (vector (make-sql-array :element-type-id :bytea :elements (vector (make-array 3 :element-type '(unsigned-byte 8) :initial-contents '(0 128 255)))
                                           :dimensions '(1) :lower-bounds '(1))
                           (make-sql-array :element-type-id :json :elements (vector "{ \"a\": 1 }")
                                           :dimensions '(1) :lower-bounds '(1))
                           (make-sql-array :element-type-id :jsonb :elements (vector (sql-jsonb-input "{\"b\":2}"))
                                           :dimensions '(1) :lower-bounds '(1))))
           (tuple (form-heap-tuple values columns 42 0 1 0 0)))
      (multiple-value-bind (decoded) (deform-heap-tuple tuple columns)
        (loop for expected across values for actual across decoded for element in elements
              do (rove:ok (eq element (sql-array-element-type-id actual)))
                 (rove:ok (equalp (sql-varlena-array-encode expected element)
                                  (sql-varlena-array-encode actual element)))))
      (rove:ok (toast-table-needed-p columns))
      (multiple-value-bind (physical indexes)
          (toast-plan-tuple values columns :external-p t)
        (declare (ignore physical))
        (rove:ok (null indexes))))
  (let* ((bytes (make-array 10000 :element-type '(unsigned-byte 8)))
         (array (make-sql-array :element-type-id :bytea :elements (vector bytes)
                                :dimensions '(1) :lower-bounds '(1)))
         (columns (vector (make-pg-column :name "payload" :type :bytea-array :typmod -1 :attnum 1)))
         (state 12345))
    (dotimes (i (length bytes))
      (setf state (logand #xffffffff (+ (* state 1664525) 1013904223))
            (aref bytes i) (ldb (byte 8 24) state)))
    (multiple-value-bind (physical indexes)
        (toast-plan-tuple (vector array) columns :external-p t)
      (rove:ok (equal '(0) indexes))
      (rove:ok (heap-external-varlena-p (aref physical 0))))))

(rove:deftest test-tuple-roundtrip
    (let* ((cols (coerce
                  (list (make-pg-column :name "a" :type :int4 :typmod -1
                                        :attnum 1 :notnull nil)
                        (make-pg-column :name "b" :type :varchar :typmod 8
                                        :attnum 2 :notnull nil)
                        (make-pg-column :name "c" :type :int8 :typmod -1
                                        :attnum 3 :notnull nil))
                  'vector))
           (vals (vector 42 "hello" 1234567890123))
           (bytes (form-heap-tuple vals cols 7 0 1 0 0)))
      (multiple-value-bind (got xmin xmax cid infomask)
          (deform-heap-tuple bytes cols)
        (declare (ignore infomask))
        (rove:ok (= xmin 7) "xmin round-trips")
        (rove:ok (= xmax 0) "xmax round-trips")
        (rove:ok (= cid 1) "cid round-trips")
        (rove:ok (= (aref got 0) 42) "int4 round-trips")
        (rove:ok (string= (aref got 1) "hello") "varchar round-trips")
        (rove:ok (= (aref got 2) 1234567890123) "int8 round-trips")))
  ;; NULLs must survive the round trip too.
  (let* ((cols (coerce
                (list (make-pg-column :name "a" :type :int4 :typmod -1
                                      :attnum 1 :notnull nil)
                      (make-pg-column :name "b" :type :varchar :typmod 8
                                      :attnum 2 :notnull nil))
                'vector))
         (vals (vector +null+ "x"))
         (bytes (form-heap-tuple vals cols 7 0 1 0 0)))
    (multiple-value-bind (got xmin xmax cid infomask)
        (deform-heap-tuple bytes cols)
      (declare (ignore xmin xmax cid infomask))
      (rove:ok (eq (aref got 0) +null+) "null int4 round-trips")
      (rove:ok (string= (aref got 1) "x") "varchar after null"))))

(rove:deftest test-full-xid-tuple-format
    (let* ((columns (vector (make-pg-column :name "value" :type :int4
                                            :typmod -1 :attnum 1
                                            :notnull nil)))
           (full-xmin (+ +xid-cycle+ 41))
           (full-xmax (+ +xid-cycle+ 42))
           (bytes (form-heap-tuple (vector 7) columns full-xmin full-xmax 0 0 0)))
      (rove:ok (= +size-of-heap-tuple-header+ 23)
               "heap tuple header has PostgreSQL's 23-byte size")
      (rove:ok (equal (list +heap-tuple-xmin-off+ +heap-tuple-xmax-off+
                            +heap-tuple-cid-off+ +heap-tuple-ctid-block-off+
                            +heap-tuple-ctid-offnum-off+ +heap-tuple-natts-off+
                            +heap-tuple-infomask-off+ +heap-tuple-hoff-off+)
                      '(0 4 8 12 16 18 20 22))
               "heap tuple header offsets match HeapTupleHeaderData")
      (rove:ok (= (page-u32 bytes +heap-tuple-xmin-off+) 41)
               "tuple xmin stores the low 32-bit TransactionId")
      (rove:ok (= (page-u32 bytes +heap-tuple-xmax-off+) 42)
               "tuple xmax stores the low 32-bit TransactionId")
      (multiple-value-bind (values xmin xmax)
          (deform-heap-tuple bytes columns)
        (rove:ok (= (aref values 0) 7) "wide-XID tuple keeps its attributes")
        (rove:ok (= (full-xid-from-32 xmin (+ +xid-cycle+ 100)) full-xmin)
                 "tuple xmin reconstructs in the current epoch")
        (rove:ok (= (full-xid-from-32 xmax (+ +xid-cycle+ 100)) full-xmax)
                 "tuple xmax reconstructs in the current epoch")))
  (rove:ok (= (advance-full-xid (1- +xid-cycle+))
              (+ +xid-cycle+ +first-normal-xid+))
           "FullXID advance skips special low XIDs at wrap")
  (rove:ok (= (full-xid-from-32 #xFFFFFFFE (+ +xid-cycle+ 3))
              #xFFFFFFFE)
           "tuple XIDs below the new epoch resolve to the prior epoch"))
