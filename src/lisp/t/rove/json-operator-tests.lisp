;;;; SQL JSONB field and array extraction.
(in-package #:pg)

(defun json-test-evaluate (sql)
  (let* ((statement (first (parse-statements sql)))
         (target (first (getf statement :targets)))
         (expr (analyze-expr (getf target :expr) nil)))
    (values (eval-expr expr nil) (expr-type expr))))

(rove:deftest test-json-inspection-functions
    (dolist (case '(("select json_typeof('[1,2]'::json)" "array" :text)
                    ("select jsonb_typeof('{\"a\":1}'::jsonb)" "object" :text)
                    ("select json_typeof('null'::json)" "null" :text)
                    ("select jsonb_typeof('true'::jsonb)" "boolean" :text)
                    ("select json_typeof('1e999999'::json)" "number" :text)
                    ("select json_typeof('\"x\"'::json)" "string" :text)
                    ("select json_array_length('[]'::json)" 0 :int4)
                    ("select json_array_length('[1, [2,3], {\"a\":\",\"}]'::json)" 3 :int4)
                    ("select jsonb_array_length('[1, [2,3], null]'::jsonb)" 3 :int4)
                    ("select json_typeof(null::json)" :null :text)
                    ("select jsonb_typeof(null)" :null :text)
                    ("select json_array_length(null)" :null :int4)
                    ("select jsonb_array_length(null)" :null :int4)
                    ("select json_typeof('[]')" "array" :text)
                    ("select jsonb_typeof('\"hi\"')" "string" :text)
                    ("select jsonb_typeof('12')" "number" :text)
                    ("select jsonb_typeof('null')" "null" :text)
                    ("select jsonb_typeof('[]')" "array" :text)
                    ("select json_array_length('[  ]')" 0 :int4)
                    ("select json_array_length('[[], {}, \"\\u0000\"]')" 3 :int4)))
      (multiple-value-bind (value type) (json-test-evaluate (first case))
        (rove:ok (equal value (if (eq (second case) :null) +null+ (second case))))
        (rove:ok (eq type (third case)))))
  (dolist (sql '("select json_array_length('{}'::json)"
                 "select jsonb_array_length('1'::jsonb)"))
    (let ((condition (handler-case (progn (json-test-evaluate sql) nil)
                       (pg-error (error) error))))
      (rove:ok (and condition (string= (pg-error-sqlstate condition) "22023"))))))

(rove:deftest test-json-inspection-resolution-and-folding
    (dolist (case '(("select json_typeof(DISTINCT 'invalid')" "42809")
                    ("select json_array_length('[]'::text)" "42883")
                    ("select jsonb_typeof('{}'::json)" "42883")
                    ("select json_typeof()" "42883")))
      (let ((condition (handler-case (progn (json-test-evaluate (first case)) nil)
                         (pg-error (error) error))))
        (rove:ok (and condition (string= (pg-error-sqlstate condition) (second case))))))
  (dolist (name '("json_typeof" "jsonb_typeof" "json_array_length" "jsonb_array_length"))
    (rove:ok (having-immutable-function-p name))
    (rove:ok (not (analyzed-expression-volatile-p (list :func name nil)))))
  (let* ((statement (first (parse-statements "select json_array_length('{}'::json)")))
         (expression (analyze-expr (getf (first (getf statement :targets)) :expr) nil))
         (condition (handler-case (progn (fold-column-default expression) nil)
                      (pg-error (error) error))))
    (rove:ok (and condition (string= (pg-error-sqlstate condition) "22023")))))

(rove:deftest test-jsonb-deletion
    (dolist (case '(("select '{\"a\":1,\"b\":2}'::jsonb - 'a'" "{\"b\": 2}")
                    ("select '[\"a\",1,\"a\",\"b\"]'::jsonb - 'a'" "[1, \"b\"]")
                    ("select '[1,2,3]'::jsonb - -1" "[1, 2]")
                    ("select '[1,2,3]'::jsonb - 9" "[1, 2, 3]")
                    ("select '[1,2,3]'::jsonb - -2147483648" "[1, 2, 3]")
                    ("select '{\"a\":1,\"b\":2}'::jsonb - ARRAY['a'::varchar]" "{\"b\": 2}")
                    ("select '{\"a\":1,\"b\":2}'::jsonb - ARRAY['a',NULL]::text[]" "{\"b\": 2}")
                    ("select '{\"a\":[1,2]}'::jsonb #- '{a,-1}'" "{\"a\": [1]}")
                    ("select '{\"a\":1}'::jsonb #- '{missing,NULL}'" "{\"a\": 1}")
                    ("select '{}'::jsonb #- '{NULL}'" "{}")
                    ("select '{}' #- '{a}'" "{}")
                    ("select '{\"a\":1}' - 'a'::text" "{}")
                    ("select '{\"a\":1}' - ARRAY['a']::text[]" "{}")))
      (multiple-value-bind (value type) (json-test-evaluate (first case))
        (rove:ok (eq type :jsonb))
        (rove:ok (string= (sql-jsonb-output value) (second case)))))
  (dolist (case '(("select '{}' - 'a'" "42725")
                  ("select 'not-json' #- 1" "42883")
                  ("select '{}' - '{}'::jsonb" "42883")
                  ("select 'bad' - 'a'::text" "22P02")
                  ("select '1'::jsonb - 'a'" "22023")
                  ("select '{}'::jsonb - 0" "22023")
                  ("select '1'::jsonb #- '{}'" "22023")
                  ("select '{\"a\":1}'::jsonb #- '{a,NULL}'" "22004")
                  ("select '[1]'::jsonb #- '{x}'" "22P02")
                  ("select '{}'::jsonb - ARRAY[['a'],['b']]::text[]" "2202E")))
    (let ((condition (handler-case (progn (json-test-evaluate (first case)) nil)
                       (pg-error (error) error))))
      (rove:ok (and condition (string= (pg-error-sqlstate condition) (second case))))))
  (rove:ok (eq +null+ (json-test-evaluate "select '{}'::jsonb - null")))
  (rove:ok (= 2 (json-test-evaluate "select 5 - 3")))
  (let* ((source (sql-jsonb-input "{\"a\":[1,2]}"))
         (result (sql-jsonb-delete-path source #("a" "-1"))))
    (rove:ok (string= "{\"a\": [1, 2]}" (sql-jsonb-output source)))
    (rove:ok (string= "{\"a\": [1]}" (sql-jsonb-output result)))))

