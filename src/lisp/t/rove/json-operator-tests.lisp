  (rove:ok (not (analyzed-expression-volatile-p (list :func "jsonb_insert" nil))))
  (let* ((source (sql-jsonb-input "[1,2]"))
         (result (sql-jsonb-set source #("0") (sql-jsonb-input "3") t :insert-p t)))
    (rove:ok (string= "[1, 2]" (sql-jsonb-output source)))
    (rove:ok (string= "[3, 1, 2]" (sql-jsonb-output result)))))

