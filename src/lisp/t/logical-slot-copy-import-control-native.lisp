(in-package #:pg)

(defun logical-import-control-test-write (path bytes)
  (with-open-file (out path :direction :io :if-exists :overwrite :if-does-not-exist :error
                            :element-type '(unsigned-byte 8))
    (write-sequence bytes out)
    (force-output out)
    (sb-posix:ftruncate (sb-sys:fd-stream-fd out) (length bytes))
    (fsync-stream out)))

(defun logical-import-control-test-run (mode)
  (let* ((directory *pgdata*) (count (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t)))
                              (fsync (symbol-function 'sb-posix:fsync)) (close (symbol-function 'sb-posix:close))
                              (read (symbol-function 'sb-posix:read)) (open (symbol-function 'physical-image-openat))
                              (unlink (symbol-function 'logical-slot-copy-unlinkat))
                              (execute (symbol-function 'logical-slot-copy-import-control-execute))
                              (proof (symbol-function 'logical-slot-copy-import-control-check-proof))
                              (store-close (symbol-function 'physical-store-close))
                              (root-scope (symbol-function 'call-with-physical-directory-root))
                              (saved nil) (created nil) (swapped nil) (close-target nil) (root-target nil)
                              (fired nil) (executed nil) (sticky nil) (syncs 0) (closes 0)
                              (failure nil) (result nil)
                              (fenced (or (and (symbolp mode) (search "LATE-" (symbol-name mode)))
                                          (member mode '(:fsync :absent-fsync :unlink :close :close-interrupt
                                                         :store-close :outer-root-close :post-unlink-source
                                                         :throw-after :final-check)))))
    (labels ((record () (cdar *logical-slot-copy-import-control-states*))
             (path (relative) (merge-pathnames relative directory))
             (change (relative &optional same)
               (let* ((target (path relative))
                      (bytes (read-bounded-regular-file target (* 32 1024 1024))))
                 (unless (assoc target saved :test #'equal) (push (cons target (copy-seq bytes)) saved))
                 (unless same (setf (aref bytes 0) (logxor 1 (aref bytes 0))))
                 (logical-import-control-test-write target bytes)))
             (extent ()
               (let ((names (directory (path "pg_physical_retained/extent-*.wal"))))
                 (assert (= 1 (length names)))
                 (enough-namestring (first names) directory)))
             (restartpoint ()
               (let ((names (directory (path "pg_physical_restartpoints/*.rp"))))
                 (assert (= 1 (length names)))
                 (enough-namestring (first names) directory)))
             (child ()
               (first (find-if (lambda (row) (uiop:string-suffix-p (first row) ".wal"))
                               (logical-slot-copy-import-control-state-child-observations (record)))))
             (create (relative bytes)
               (let ((target (path relative)))
                 (with-open-file (out target :direction :output :if-exists :error
                                             :element-type '(unsigned-byte 8))
                   (write-sequence bytes out) (fsync-stream out))
                 (sb-posix:chmod (namestring target) #o600)
                 (push target created)))
             (inject (point context)
               (declare (ignore context))
               (when (eq point :after-import-control-open)
                 (setf close-target (logical-slot-copy-import-control-state-fd (record)))
                 (assert (= 1 (length (logical-import-source-test-reader-keys))))
                 (when close-target
                   (assert (logbitp 0 (sb-posix:fcntl close-target sb-posix:f-getfd)))
                   (assert (zerop (logand 3 (sb-posix:fcntl close-target sb-posix:f-getfl))))
                   (assert (not (zerop (logand sb-posix:o-nonblock
                                               (sb-posix:fcntl close-target sb-posix:f-getfl))))))
                 (when (member mode '(:global-swap :root-swap))
                   (let* ((target (if (eq mode :global-swap) (path "global/") directory))
                          (backup (if (eq mode :global-swap) (path "global.saved/") (merge-pathnames "data.saved/" (uiop:pathname-parent-directory-pathname directory)))))
                     (sb-posix:rename (namestring target) (namestring backup))
                     (sb-posix:mkdir (namestring target) #o700)
                     (setf swapped (cons target backup) fired t))))
               (when (and (consp mode) (eq (first mode) :kill) (eq point (second mode)))
                 (format t "~&CONTROL-TEMP-KILL ~s~%" (second mode))
                 (finish-output)
                 (sb-posix:kill (sb-posix:getpid) 9))
               (when (and (eq point :before-import-control-unlink) (not fired))
                 (case mode
                   (:source (change (extent)) (setf fired t))
                   (:restartpoint (change (restartpoint)) (setf fired t))
                   (:pending (change "logical-slot-copy.import" t) (setf fired t))
                   (:evidence (change "logical-slot-copy.evidence" t) (setf fired t))
                   (:child (change (child) t) (setf fired t))
                   (:parent (change "global/pg_wal_control" t) (setf fired t))
                   (:temp (change "global/pg_wal_control.tmp") (setf fired t))
                   (:extra (create "global/foreign" (string->bytes "untouched")) (setf fired t))
                   (:caught
                    (let* ((source (logical-slot-copy-import-control-state-source (record)))
                           (name (caar (getf source :slots))) (character (char name 0)))
                      (setf (char name 0) #\A)
                      (assert (handler-case (progn (funcall proof (record)) nil) (error () t)))
                      (setf (char name 0) character)
                      (setf sticky (handler-case (progn (funcall proof (record)) nil) (error () t))
                            fired t)))
                   (:throw-before (setf fired t) (throw 'control-cut :cut))))
               (when (eq point :after-import-control-unlink)
                 (case mode
                   (:post-unlink-source (change (extent)) (setf fired t))
                   (:throw-after (setf fired t) (throw 'control-cut :cut))))
               (when (and (eq point :after-import-source-scan) executed (not fired))
                 (case mode
                   (:late-source (change (extent)) (setf fired t))
                   (:late-restartpoint (change (restartpoint)) (setf fired t))
                   (:late-pending (change "logical-slot-copy.import" t) (setf fired t))
                   (:late-evidence (change "logical-slot-copy.evidence" t) (setf fired t))
                   (:late-child (change (child) t) (setf fired t))
                   (:late-parent (change "global/pg_wal_control" t) (setf fired t))
                   (:late-temp
                    (create "global/pg_wal_control.tmp"
                            (logical-slot-copy-import-control-state-expected (record)))
                    (setf fired t))
                   (:late-extra (create "global/foreign" (string->bytes "untouched")) (setf fired t))))))
      (unwind-protect
           (progn
             (setf (symbol-function 'sb-posix:fsync)
                   (lambda (fd)
                     (when (and (record) (eql fd (logical-slot-copy-import-control-state-global (record))))
                       (incf syncs)
                       (when (and (member mode '(:fsync :absent-fsync)) (not fired))
                         (setf fired t) (error "control directory sync cut")))
                     (funcall fsync fd))
                   (symbol-function 'sb-posix:close)
                   (lambda (fd)
                     (cond
                       ((and close-target (= fd close-target))
                        (setf close-target nil) (incf closes)
                        (when (eq mode :close-interrupt)
                          (setf fired t)
                          (sb-thread:interrupt-thread sb-thread:*current-thread*
                                                      (lambda () (error "control close interrupt cut"))))
                        (funcall close fd)
                        (when (eq mode :close) (setf fired t) (error "control close cut")))
                       ((and root-target (= fd root-target) (eq mode :outer-root-close))
                        (setf root-target nil fired t)
                        (funcall close fd) (error "control outer root close cut"))
                       (t (funcall close fd))))
                   (symbol-function 'sb-posix:read)
                   (lambda (fd buffer size)
                     (when (and (record) (eql fd (logical-slot-copy-import-control-state-fd (record)))
                                (eq mode :read))
                       (setf fired t close-target fd) (error "control read cut"))
                     (funcall read fd buffer size))
                   (symbol-function 'physical-image-openat)
                   (lambda (parent name flags permissions)
                     (if (and (record) (eq mode :open) (equal name "pg_wal_control.tmp"))
                         (progn (setf fired t) (sb-alien:set-errno sb-posix:eacces) -1)
                         (funcall open parent name flags permissions)))
                   (symbol-function 'logical-slot-copy-unlinkat)
                   (lambda (parent name flags)
                     (if (and (eq mode :unlink) (equal name "pg_wal_control.tmp"))
                         (progn (setf fired t) (sb-alien:set-errno sb-posix:eacces) -1)
                         (funcall unlink parent name flags)))
                   (symbol-function 'logical-slot-copy-import-control-execute)
                   (lambda (state) (multiple-value-prog1 (funcall execute state) (setf executed t)))
                   (symbol-function 'logical-slot-copy-import-control-check-proof)
                   (lambda (state &key (source t))
                     (when (and (eq mode :final-check) (not source))
                       (setf fired t) (error "control final metadata cut"))
                     (funcall proof state :source source))
                   (symbol-function 'physical-store-close)
                   (lambda (store)
                     (funcall store-close store)
                     (when (and (record) (eq mode :store-close))
                       (setf fired t) (error "control store close cut")))
                   (symbol-function 'call-with-physical-directory-root)
                   (lambda (owner function)
                     (funcall root-scope owner
                              (lambda (fd root)
                                (when (logical-slot-copy-import-control-owner-p owner) (setf root-target fd))
                                (funcall function fd root)))))
             (let ((*logical-slot-copy-verification-test-hook* #'inject))
               (handler-case
                   (setf result (catch 'control-cut (logical-slot-copy-import-reconcile-parent-control-temp)))
                 (error (condition) (setf failure (princ-to-string condition)))))
             (cond
               ((member mode '(:full :empty :partial :orphan))
                (assert (and (null failure) (eq :removed result))))
               ((eq mode :absent) (assert (and (null failure) (eq :absent result))))
               ((member mode '(:throw-before :throw-after))
                (assert (and fired (eq :cut result) (null failure))))
               (t (assert failure)))
             (assert (eq (not (null fenced)) (not (null *physical-recovery-failed-p*))))
             (when (member mode '(:source :restartpoint :pending :evidence :child :parent :temp :extra
                                  :caught :throw-before :throw-after :post-unlink-source :read :open
                                  :unlink :fsync :absent-fsync :close :close-interrupt :store-close
                                  :outer-root-close :final-check :global-swap :root-swap
                                  :late-source :late-restartpoint :late-pending :late-evidence
                                  :late-child :late-parent :late-temp :late-extra))
               (assert fired))
             (when (eq mode :caught) (assert sticky))
             (when (member mode '(:close :close-interrupt)) (assert (= 1 closes)))
             (when (member mode '(:full :empty :partial :orphan :absent)) (assert (= 1 syncs)))
             (when fenced
               (assert (handler-case (progn (logical-slot-copy-import-reconcile-parent-control-temp) nil)
                         (error () t))))
             (assert (and (null *physical-recovery-state*) (null *physical-receive-store*) (not *wal-ready*)
                          (null *catalog*) (null *wal-output-stream*) (null *clog-stream*)
                          (zerop *n-backends*) (zerop (hash-table-count *relation-streams*))
                          (zerop (hash-table-count *wal-replication-slots*))
                          (null *logical-slot-copy-import-control-states*)
                          (= count (length (directory-entry-names "/proc/self/fd/" :follow-symlinks t)))))
             (format t "~&CONTROL-TEMP-RESULT ~s ~s failure=~s fenced=~s fired=~s syncs=~d closes=~d~%"
                     mode result failure *physical-recovery-failed-p* fired syncs closes)
             (finish-output))
        (sb-sys:without-interrupts
          (setf (symbol-function 'sb-posix:fsync) fsync
                (symbol-function 'sb-posix:close) close
                (symbol-function 'sb-posix:read) read
                (symbol-function 'physical-image-openat) open
                (symbol-function 'logical-slot-copy-unlinkat) unlink
                (symbol-function 'logical-slot-copy-import-control-execute) execute
                (symbol-function 'logical-slot-copy-import-control-check-proof) proof
                (symbol-function 'physical-store-close) store-close
                (symbol-function 'call-with-physical-directory-root) root-scope))
        (when swapped
          (sb-posix:rmdir (namestring (car swapped)))
          (sb-posix:rename (namestring (cdr swapped)) (namestring (car swapped))))
        (dolist (entry saved) (logical-import-control-test-write (car entry) (cdr entry)))
        (dolist (target created) (delete-file target))))))
