;;;; Private task-owned control hooks. This file is not a network WAL protocol.
(in-package #:pg)

(defun physical-test-export-wal (start-lsn path)
  (sb-thread:with-mutex (*wal-lock*)
    (with-open-file (out path :direction :output :element-type '(unsigned-byte 8)
                              :if-exists :supersede)
      (wal-scan
       (lambda (record)
         (let* ((start (wal-record-start record))
                (length (- (wal-record-end record) start))
                (header (make-array 12 :element-type '(unsigned-byte 8)))
                (bytes (make-array length :element-type '(unsigned-byte 8))))
           (with-open-file (input (wal-segment-path (floor start +wal-segment-size+))
                                  :element-type '(unsigned-byte 8))
             (file-position input (mod start +wal-segment-size+))
             (assert (= length (read-sequence bytes input))))
           (wal-set-u64 header 0 start)
           (wal-set-u32 header 8 length)
           (write-sequence header out)
           (write-sequence bytes out)))
       start-lsn :end-lsn *wal-durable-lsn*)))
  *wal-durable-lsn*)

(defun physical-test-receive-file (path &key omit-last only-last)
  (let ((frames nil))
    (with-open-file (input path :element-type '(unsigned-byte 8))
      (loop while (< (file-position input) (file-length input))
            do (let ((header (make-array 12 :element-type '(unsigned-byte 8))))
                 (assert (= 12 (read-sequence header input)))
                 (let ((bytes (make-array (wal-u32 header 8) :element-type '(unsigned-byte 8))))
                   (assert (= (length bytes) (read-sequence bytes input)))
                   (push (cons (wal-u64 header 0) bytes) frames)))))
    (setf frames (nreverse frames))
    (dolist (frame (cond (omit-last (butlast frames))
                         (only-last (last frames))
                         (t frames)))
      (physical-recovery-receive (car frame) (cdr frame)))
    (physical-recovery-flush)))

(defun physical-test-crash-after-redo ()
  (let ((saw-pages nil))
    (setf *physical-replay-test-hook*
          (lambda (point record)
            (when (and (eq point :before-record)
                       (= (wal-record-type record) +wal-record-pages+))
              (setf saw-pages t))
            (when (and (eq point :after-redo) saw-pages)
              (sb-posix:kill (sb-posix:getpid) sb-posix:sigkill))))))

(defun physical-test-error-after-redo ()
  (setf *physical-replay-test-hook*
        (lambda (point record)
          (declare (ignore record))
          (when (eq point :after-redo)
            (error "injected redo failure after mutation")))))

(defun physical-test-hide-disk-table (directory name)
  "Damage only an offline test clone: omit a base table without catalog WAL."
  (let* ((*pgdata* (uiop:ensure-directory-pathname directory))
         (*catalog* (load-catalog))
         (database (gethash "postgres" (catalog-databases *catalog*))))
    (unless (remhash name (database-tables database))
      (error "test clone has no table ~a" name))
    (wal-atomic-write-bytes (catalog-path) (catalog-image-bytes))))
