(deftest physical-backup-command-requires-exact-native-negotiation
    (let* ((query (format nil "BASE_BACKUP_NATIVE (native_format '~a')" pg::+physical-native-format+))
           (command (pg::parse-replication-command query)))
      (ok (eq :physical-backup (pg::logical-replication-command-type command)))
      (ok (equal pg::+physical-native-format+ (pg::physical-stream-option command "native_format"))))
  (dolist (query (list "BASE_BACKUP_NATIVE"
                       "BASE_BACKUP_NATIVE ()"
                       "BASE_BACKUP_NATIVE (native_format 'wrong')"
                       (format nil "BASE_BACKUP_NATIVE (native_format '~a', other 'x')" pg::+physical-native-format+)
                       (format nil "BASE_BACKUP_NATIVE (native_format '~a', native_format '~a')"
                               pg::+physical-native-format+ pg::+physical-native-format+)))
    (ok (intake-fails-p (lambda () (pg::parse-replication-command query))))))

(deftest physical-backup-wire-dispatch-requires-physical-sender-and-no-transaction
    (let* ((query (format nil "BASE_BACKUP_NATIVE (native_format '~a')" pg::+physical-native-format+))
           (command (pg::parse-replication-command query))
           (pg::*wal-replication-slots* (make-hash-table :test #'equal))
           (pg::*wal-sender-registry* (make-hash-table :test #'eq))
           (pg::*physical-recovery-state* nil))
      (ok (pg::replication-query-payload-p (pg::string->bytes query)))
      (dolist (backend (list nil (pg::make-backend :pid 177 :replication-mode :database)
                             (pg::make-backend :pid 178 :replication-mode :physical)))
        (let ((pg::*backend* backend))
          (ok (intake-fails-p (lambda () (pg::start-native-physical-backup nil command))))
          (ok (zerop (hash-table-count pg::*wal-replication-slots*)))))
      (let ((pg::*backend* (pg::make-backend :pid 179 :replication-mode :physical :explicit t)))
        (ok (intake-fails-p (lambda () (pg::validate-replication-command-context command)))))))

(deftest physical-bootstrap-never-starts-writable
    (with-physical-store-directory (root)
      (let ((pg::*pgdata* root))
        (ok (not (intake-fails-p #'pg::physical-bootstrap-check-startup)))
        (pg::physical-bootstrap-mark-target root)
        (ok (probe-file (merge-pathnames "recovery.required" root)))
        (ok (intake-fails-p #'pg::physical-bootstrap-check-startup))
        (delete-file (merge-pathnames "recovery.required" root))
        (with-open-file (stream (merge-pathnames "physical-backup.manifest" root)
                                :direction :output)
          (write-line "incomplete manifest" stream))
        (ok (intake-fails-p #'pg::physical-bootstrap-check-startup)))))

(deftest native-basebackup-cli-accepts-patroni-arguments-and-rejects-unsupported-modes
    (let ((long '("--pgdata=/tmp/clone" "-X" "stream" "--dbname=host=example dbname=postgres"))
          (short '("-D" "/tmp/clone" "-d" "postgres://example/postgres" "--no-password")))
      (ok (equal '("/tmp/clone" "host=example dbname=postgres")
                 (multiple-value-list (pg::native-basebackup-options long))))
      (ok (equal '("/tmp/clone" "postgres://example/postgres")
                 (multiple-value-list (pg::native-basebackup-options short)))))
  (dolist (arguments '(nil ("-D") ("-D" "/tmp/clone" "-X" "fetch")
                       ("--pgdata=/tmp/clone" "--format=tar") ("--dbname=secret")))
    (ok (intake-fails-p (lambda () (pg::native-basebackup-options arguments))))))

(deftest physical-backup-destination-allows-only-absent-or-empty-directories
    (with-physical-store-directory (root)
      (let* ((target (merge-pathnames "target/" root))
             (link (merge-pathnames "link" root)))
        (ok (equal target (pg::physical-backup-destination target)))
        (ensure-directories-exist (merge-pathnames "unused" target))
        (ok (equal target (pg::physical-backup-destination target)))
        (with-open-file (out (merge-pathnames ".witness" target) :direction :output)
          (write-line "preserve" out))
        (ok (intake-fails-p (lambda () (pg::physical-backup-destination target))))
        (delete-file (merge-pathnames ".witness" target))
        (sb-posix:symlink "/missing-native-backup-target" (namestring link))
        (ok (intake-fails-p (lambda () (pg::physical-backup-destination link))))
        (sb-posix:unlink (namestring link))
        (sb-posix:symlink (namestring target) (namestring link))
        (ok (intake-fails-p (lambda () (pg::physical-backup-destination link)))))))

(deftest physical-standard-recovery-signals-cannot-create-native-base-provenance
