(require :asdf)
(load (merge-pathnames "system-test-runner.lisp"
                       (uiop:pathname-directory-pathname *load-truename*)))

(defparameter *manifest-read-executed* nil)

(let* ((root (uiop:ensure-directory-pathname
              (sb-posix:mkdtemp
               (namestring (merge-pathnames "manifest-contract.XXXXXX" (uiop:temporary-directory))))))
       (output-variable "PG_TEST_CONTRACT_OUTPUT")
       (expected-variable "PG_TEST_CONTRACT_EXPECTED")
       (counter 0)
       (expected (merge-pathnames "expected.log" root))
       (actual '(:format 1 :suite "PG" :registered ("PG::A" "PG::B") :selected ("PG::A")))
       (keys '(:format :suite :registered)))
  (labels ((check (value)
             (sb-posix:setenv output-variable
                              (namestring (merge-pathnames (format nil "actual-~d.log" (incf counter)) root)) 1)
             (pg-test-record-manifest value output-variable expected-variable keys))
           (reject (function)
             (assert (handler-case (progn (funcall function) nil) (error () t)))))
    (unwind-protect
         (progn
           (sb-posix:unsetenv expected-variable)
           (check actual)
           (uiop:copy-file (uiop:getenv output-variable) expected)
           (sb-posix:setenv expected-variable (namestring expected) 1)
           (check '(:format 1 :suite "PG" :registered ("PG::A" "PG::B") :selected ("PG::B" "PG::A")))
           (reject (lambda () (check '(:format 1 :suite "PG" :registered ("PG::A")))))
           (reject (lambda () (check '(:format 1.0 :suite "PG" :registered ("PG::A" "PG::B")))))
           (with-open-file (stream expected :direction :output :if-exists :supersede)
             (write actual :stream stream)
             (write-string " NIL" stream))
           (reject (lambda () (check actual)))
           (with-open-file (stream expected :direction :output :if-exists :supersede)
             (write-string "#.(progn (setf cl-user::*manifest-read-executed* t) nil)" stream))
           (reject (lambda () (check actual)))
           (assert (not *manifest-read-executed*))
           (let ((asdf/output-translations:*output-translations* nil)
                 (asdf/output-translations:*output-translations-parameter* nil))
             (pg-test-configure-parent-cache root)
             (let ((one (asdf:apply-output-translations #P"/one/package.fasl"))
                   (two (asdf:apply-output-translations #P"/two/package.fasl")))
               (assert (not (equal one two)))
               (assert (uiop:subpathp one root))
               (assert (uiop:subpathp two root))))
           (format t "~&TEST-CAMPAIGN-MANIFEST-CONTRACTS-PASS~%"))
      (sb-posix:unsetenv output-variable)
      (sb-posix:unsetenv expected-variable))))
