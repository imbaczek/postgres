(require :asdf)

(asdf:load-asd (merge-pathnames "../pg.asd" *load-truename*))

(asdf:load-system "pg")

(defun run-libpq-startup-failure-fixture (mode)
  (let ((published nil) (failed nil))
    (handler-case
        (if (equal mode "cancelled")
            (pg::physical-libpq-open-channel
             (uiop:getenv "PG_LIBPQ_HELPER")
             :on-spawn (lambda (channel)
                         (setf published channel)
                         (pg::physical-libpq-stop channel)))
            (pg::physical-libpq-connect
             (uiop:getenv "PG_LIBPQ_HELPER")
             (pg::make-physical-libpq-profile "unknown_secret_option=private-marker")
             :on-spawn (lambda (channel) (setf published channel))))
      (error (condition)
        (assert (not (search "private-marker" (princ-to-string condition))))
        (setf failed t)))
    (assert failed)
    (assert published)
    (assert (pg::physical-libpq-channel-closed published))
    (assert (null (pg::physical-libpq-channel-pidfd published)))
    (assert (zerop (hash-table-count pg::*physical-libpq-channels*)))
    (format t "libpq-bridge ~a: PASS~%" mode)))

(defun check-libpq-bridge-metadata (channel)
  (let* ((info (pg::physical-libpq-channel-info channel))
         (public (pg::physical-libpq-public-connection-info info)))
    (assert (equalp (pg::string->bytes "127.0.0.1") (pg::physical-libpq-connection-info-hostaddr info)))
    (assert (= (parse-integer (uiop:getenv "PG_LIBPQ_TEST_PORT"))
               (pg::physical-libpq-connection-info-port info)))
    (assert (equalp (pg::string->bytes "private-secret")
                    (second (assoc "password" (pg::physical-libpq-connection-info-parameters info)
                                   :test #'equal))))
    (assert (equalp (concatenate '(vector (unsigned-byte 8))
                                 (pg::string->bytes "/tmp/pg-libpq-nonutf8-") #(255))
                    (second (assoc "passfile" (pg::physical-libpq-connection-info-parameters info)
                                   :test #'equal))))
    (assert (not (search "private-secret" public)))
    (assert (not (search "private-options" public)))
    (assert (not (search "private-secret" (princ-to-string info))))
    (assert (search "application_name='bridge-explicit'" public))))

(defun run-libpq-bridge-fixture ()
  (when (member (uiop:getenv "PG_LIBPQ_TEST_MODE") '("cancelled" "connect-failure") :test #'equal)
    (return-from run-libpq-bridge-fixture
      (run-libpq-startup-failure-fixture (uiop:getenv "PG_LIBPQ_TEST_MODE"))))
  (let* ((mode (uiop:getenv "PG_LIBPQ_TEST_MODE"))
         (profile (pg::make-physical-libpq-profile
                   (format nil "host=127.0.0.1 port=~a user=postgres dbname=postgres sslmode=disable gssencmode=disable application_name=bridge-explicit password=private-secret options='-c secret.foo=private-options'"
                           (uiop:getenv "PG_LIBPQ_TEST_PORT"))
                   :fallback "cluster-fallback"))
         (channel (pg::physical-libpq-connect (uiop:getenv "PG_LIBPQ_HELPER") profile)))
    (unwind-protect
         (progn
           (check-libpq-bridge-metadata channel)
           (cond
             ((equal mode "frozen")
              (let* ((snapshot (pg::make-physical-libpq-frozen-profile
                                (pg::physical-libpq-channel-info channel)))
                     (*read-eval* nil)
                     (datum (read-from-string
                             (write-to-string (pg::physical-libpq-frozen-profile-datum snapshot)
                                              :readably t)))
                     (reloaded (pg::physical-libpq-frozen-profile-from-datum datum)))
                (assert (equalp (pg::physical-libpq-frozen-profile-body snapshot)
                                (pg::physical-libpq-frozen-profile-body reloaded)))
                (pg::physical-libpq-exchange channel #\X (pg::make-payload) '(#\A) 0)
                (pg::physical-client-close channel)
                (sb-posix:setenv "PGSERVICE" "must-not-resolve" 1)
                (sb-posix:setenv "PGHOST" "wrong.invalid" 1)
                (sb-posix:setenv "PGPORT" "1" 1)
                (setf channel (pg::physical-libpq-connect-frozen
                               (uiop:getenv "PG_LIBPQ_HELPER") reloaded))
                (check-libpq-bridge-metadata channel)
                (assert (equalp #("42")
                                (pg::physical-client-query channel "IDENTIFY_SYSTEM"
                                                           '(("systemid" 25)) "IDENTIFY_SYSTEM")))
                (pg::physical-libpq-exchange channel #\X (pg::make-payload) '(#\A) 0)))
             ((equal mode "identity")
              (assert (equalp #("42" "1" "0/40" "postgres")
                              (pg::physical-client-identity-row channel)))
              (pg::physical-libpq-exchange channel #\X (pg::make-payload) '(#\A) 0))
             ((equal mode "idle")
              (assert (eq :copy-both (pg::physical-client-start channel "START_STREAMING")))
              (multiple-value-bind (kind body) (pg::physical-client-receive channel)
                (assert (eq kind :idle))
                (assert (null body)))
              (pg::physical-client-feedback channel (pg::string->bytes "idle-feedback"))
              (multiple-value-bind (kind body) (pg::physical-client-receive channel)
                (assert (eq kind :done))
                (assert (null body)))
              (pg::physical-client-feedback channel (pg::string->bytes "final-feedback"))
              (assert (equal '(:switch 2 64) (pg::physical-client-finish channel 2 64)))
              (pg::physical-libpq-exchange channel #\X (pg::make-payload) '(#\A) 0))
             ((equal mode "query")
              (assert (equalp #("42")
                              (pg::physical-client-query channel "IDENTIFY_SYSTEM"
                                                         '(("systemid" 25)) "IDENTIFY_SYSTEM")))
              (pg::physical-libpq-exchange channel #\X (pg::make-payload) '(#\A) 0))
             ((equal mode "immediate")
              (assert (equal '(:switch 2 64) (pg::physical-client-start channel "START_STREAMING")))
              (pg::physical-libpq-exchange channel #\X (pg::make-payload) '(#\A) 0))
             ((equal mode "copy")
              (assert (eq :copy-both (pg::physical-client-start channel "START_STREAMING")))
              (multiple-value-bind (kind body) (pg::physical-client-receive channel)
                (assert (eq kind :data))
                (assert (= (length body) (+ 25 65536)))
                (assert (= (aref body 0) (char-code #\w)))
                (assert (every (lambda (byte) (= byte (char-code #\z))) (subseq body 25))))
              (multiple-value-bind (kind body) (pg::physical-client-receive channel)
                (assert (eq kind :done))
                (assert (zerop (length body))))
              (pg::physical-client-feedback channel (pg::string->bytes "truthful-feedback"))
              (assert (equal '(:switch 2 64) (pg::physical-client-finish channel 2 64)))
              (pg::physical-libpq-exchange channel #\X (pg::make-payload) '(#\A) 0))
             (t (error "unknown libpq bridge fixture"))))
      (pg::physical-libpq-close channel))
    (assert (zerop (hash-table-count pg::*physical-libpq-channels*)))
    (format t "libpq-bridge ~a: PASS~%" mode)))

(run-libpq-bridge-fixture)
